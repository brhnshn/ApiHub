# Bu dosyayi kopyalayip .env olarak kaydedin ve gercek degerlerinizi girin
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=dp_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=dockerpanel_db

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_here

# Firebase (opsiyonel - bildirim ozelligi icin)
# firebase-service-account.json dosyasini Firebase Console'dan indirin
