@page "/guide"
@attribute [Authorize]
@inject PlatformInfo PlatformInfo
@inject NavigationManager NavigationManager

<PageTitle>Uygulama Rehberi - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex justify-between items-start gap-4 flex-wrap">
        <div>
            <div class="eyebrow">Yardım & Dokümantasyon</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">Uygulama Rehberi & Kılavuz</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">ApiHub sisteminin çalışma mekanizmasını ve tüm yönetim modüllerini yakından tanıyın.</p>
        </div>
        <div class="pill pill-azure text-xs">
            <i class="fa-solid fa-book-open text-xs mr-1"></i> Kılavuz
        </div>
    </div>

    <!-- Acil Durdurma Bento Kartı -->
    <div class="card bg-[var(--rose-bg)] border-[var(--rose)]/30 space-y-3">
        <div class="flex items-start gap-4">
            <div class="p-3 bg-[var(--rose-bg)] text-[var(--rose)] rounded-xl shrink-0 text-2xl">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div class="space-y-2 flex-1">
                <h3 class="font-serif font-bold text-base text-[var(--rose)] uppercase tracking-wider flex items-center gap-2">
                    Acil Durdurma (Panic Stop) Mekanizması
                </h3>
                <p class="text-xs leading-relaxed text-[var(--ink)]">
                    Kırmızı ünlem logolu <strong>"Acil Durdurma"</strong> butonu, sunucunuzda olağanüstü bir durum (güvenlik ihlali, aşırı kaynak tüketimi, siber saldırı) algılandığında sistemi anında ve güvenli bir şekilde kilitlemek için tasarlanmış bir <strong>siber savunma kalkanıdır</strong>.
                </p>
                
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3 pt-2 text-xs">
                    <div class="p-3 bg-[var(--paper)] border border-[var(--rose)]/20 rounded-xl space-y-1">
                        <span class="font-bold text-[var(--rose)] block text-[11px] uppercase">1. Konteyner Kilidi</span>
                        <p class="text-[var(--ink-soft)] text-[11px] leading-snug">Çalışan tüm Docker konteynerleri asenkron <code>docker-compose stop</code> komutuyla anında durdurulur.</p>
                    </div>
                    <div class="p-3 bg-[var(--paper)] border border-[var(--rose)]/20 rounded-xl space-y-1">
                        <span class="font-bold text-[var(--rose)] block text-[11px] uppercase">2. Native Kapatma</span>
                        <p class="text-[var(--ink-soft)] text-[11px] leading-snug">Sunucuda koşan native web servisleri, süreç yöneticisi tarafından <code>kill -9</code> sinyaliyle sonlandırılır.</p>
                    </div>
                    <div class="p-3 bg-[var(--paper)] border border-[var(--rose)]/20 rounded-xl space-y-1">
                        <span class="font-bold text-[var(--rose)] block text-[11px] uppercase">3. Proxy Askısı</span>
                        <p class="text-[var(--ink-soft)] text-[11px] leading-snug">Tüm Nginx subdomain vhost yönlendirmeleri sıfır gecikmeyle askıya alınarak gelen istekler durdurulur.</p>
                    </div>
                    <div class="p-3 bg-[var(--paper)] border border-[var(--rose)]/20 rounded-xl space-y-1">
                        <span class="font-bold text-[var(--rose)] block text-[11px] uppercase">4. Güvenlik Duvarı</span>
                        <p class="text-[var(--ink-soft)] text-[11px] leading-snug">Host UFW güvenlik duvarı tüm dış erişim portlarını kapatır ve güvenli uyku moduna geçirir.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid Modül Açıklamaları -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Genel Bakış -->
        <div class="card flex items-start gap-4">
            <div class="p-3 bg-[var(--accent-bg)] rounded-xl text-[var(--azure)] shrink-0 text-xl">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <div class="space-y-1">
                <h4 class="font-serif font-bold text-sm text-[var(--navy)]">Genel Bakış (Dashboard)</h4>
                <p class="text-xs leading-relaxed text-[var(--ink-soft)]">
                    Sunucunun genel işlemci (CPU), bellek (RAM), disk tüketim verilerini ve aktif servis sayılarını tek bir ekrandan izlemenizi sağlar. Arka plandaki <strong>SignalR veri hattı</strong> sayesinde donanım tüketimi her 3 saniyede bir grafiklere canlı yansır.
                </p>
            </div>
        </div>

        <!-- Konteyner & Proje Yönetimi -->
        <div class="card flex items-start gap-4">
            <div class="p-3 bg-[var(--moss-bg)] rounded-xl text-[var(--moss)] shrink-0 text-xl">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div class="space-y-1">
                <h4 class="font-serif font-bold text-sm text-[var(--navy)]">Konteyner ve Servis Yönetimi</h4>
                <p class="text-xs leading-relaxed text-[var(--ink-soft)]">
                    Sunucudaki izole Docker konteynerlerini, native olarak barındırılan ZIP projelerinizi ve statik web sitelerinizi kontrol etmenizi sağlar. Tek dokunuşla servislerinizi asenkron reload edebilirsiniz.
                </p>
            </div>
        </div>

        <!-- Domain & Nginx Proxy -->
        <div class="card flex items-start gap-4">
            <div class="p-3 bg-[var(--accent-bg)] rounded-xl text-[var(--azure)] shrink-0 text-xl">
                <i class="fa-solid fa-network-wired"></i>
            </div>
            <div class="space-y-1">
                <h4 class="font-serif font-bold text-sm text-[var(--navy)]">Subdomain & SSL / DNS Ayarları</h4>
                <p class="text-xs leading-relaxed text-[var(--ink-soft)]">
                    Host üzerinde koşan bare-metal Nginx Gateway proxy sunucusunu yönetir. Zero-downtime Nginx reload yeteneğiyle alt alan adlarınızı Let's Encrypt SSL sertifikalarıyla güvenli hale getirebilir, <strong>Cloudflare v4 API</strong> bağlantısını entegre edebilirsiniz.
                </p>
            </div>
        </div>

        <!-- PostgreSQL -->
        <div class="card flex items-start gap-4">
            <div class="p-3 bg-[var(--moss-bg)] rounded-xl text-[var(--moss)] shrink-0 text-xl">
                <i class="fa-solid fa-database"></i>
            </div>
            <div class="space-y-1">
                <h4 class="font-serif font-bold text-sm text-[var(--navy)]">PostgreSQL Veritabanı Yönetimi</h4>
                <p class="text-xs leading-relaxed text-[var(--ink-soft)]">
                    PostgreSQL master sunucusu üzerinde dış dünyaya tamamen izole, şifreli şemalar oluşturmanızı ve bağımsız kullanıcı yetkilendirmeleri atamanızı sağlar.
                </p>
            </div>
        </div>

        <!-- E-Posta Sunucusu -->
        <div class="card flex items-start gap-4">
            <div class="p-3 bg-[var(--accent-bg)] rounded-xl text-[var(--azure)] shrink-0 text-xl">
                <i class="fa-solid fa-envelope"></i>
            </div>
            <div class="space-y-1">
                <h4 class="font-serif font-bold text-sm text-[var(--navy)]">E-Posta Hesapları & Webmail</h4>
                <p class="text-xs leading-relaxed text-[var(--ink-soft)]">
                    Postfix, Dovecot ve SpamAssassin entegreli kurumsal <strong>docker-mailserver</strong> posta kutularını yönetir. Entegre <strong>Webmail İstemcisi</strong> kararlı dosya ekleme altyapısına ve zengin metin düzenleyicisine sahiptir.
                </p>
            </div>
        </div>

        <!-- Yedekleme & VDS Taşıma -->
        <div class="card flex items-start gap-4">
            <div class="p-3 bg-[var(--amber-bg)] rounded-xl text-[var(--amber)] shrink-0 text-xl">
                <i class="fa-solid fa-box-archive"></i>
            </div>
            <div class="space-y-1">
                <h4 class="font-serif font-bold text-sm text-[var(--navy)]">Uzak SSH Yedekleme & Kurtarma</h4>
                <p class="text-xs leading-relaxed text-[var(--ink-soft)]">
                    Sunucudaki tüm dosyaları, veri tabanını ve Nginx konfigürasyonlarını sıkıştırarak yedek arşivleri oluşturur. <strong>Tek Tıkla Kurtarma (restore-all.sh)</strong> script'i sayesinde, yeni aldığınız tertemiz bir VDS sunucusuna tüm yedeğinizi ve paneli 2 dakika içinde eksiksiz taşıyabilirsiniz.
                </p>
            </div>
        </div>

    </div>

    <!-- Alt Kapatma Eylemi -->
    <div class="pt-4 text-center">
        <button @onclick='() => NavigationManager.NavigateTo("/")' class="btn-primary py-2.5 px-8 text-xs font-semibold">
            Rehberi Tamamla & Ana Sayfaya Dön
        </button>
    </div>
</div>
