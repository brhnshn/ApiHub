@code {
    private int _runningContainerCount = 0;
    private double _systemCpu = 0;
    private string _terminalCommand = string.Empty;
    private bool _isExecutingCommand = false;
    private List<SshEntry> _sshHistory = new();
    private string _terminalWorkingDir = "/root";

    private bool _isTerminalLocked = true;
    private string _terminalPassword = string.Empty;
    private bool _isUnlocking = false;
    private string _unlockErrorMessage = string.Empty;

    private async Task UnlockTerminal()
    {
        if (string.IsNullOrWhiteSpace(_terminalPassword)) return;
        _isUnlocking = true;
        _unlockErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/system/terminal/unlock", new { Password = _terminalPassword });
            if (response.IsSuccessStatusCode)
            {
                _isTerminalLocked = false;
                _terminalPassword = string.Empty;
                _sshHistory.Add(new SshEntry { Text = "Terminal kilidi başarıyla açıldı. Yetkili komutları çalıştırabilirsiniz.", IsCommand = false });
            }
            else
            {
                _unlockErrorMessage = "Geçersiz şifre!";
            }
        }
        catch (Exception ex)
        {
            _unlockErrorMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            _isUnlocking = false;
            StateHasChanged();
            if (!_isTerminalLocked)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("eval", "setTimeout(function() { var el = document.getElementById('ssh-input'); if(el) el.focus(); }, 100);");
                }
                catch { }
            }
        }
    }

    private async Task HandleUnlockKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await UnlockTerminal();
        }
    }

    public class SshEntry
    {
        public string Text { get; set; } = string.Empty;
        public bool IsCommand { get; set; }
        public bool IsError { get; set; }
    }

    private string GetPromptPath()
    {
        if (string.IsNullOrEmpty(_terminalWorkingDir)) return "~";
        // Show ~ for /root, otherwise show the path
        if (_terminalWorkingDir == "/root" || _terminalWorkingDir == "C:\\Users")
            return "~";
        return _terminalWorkingDir;
    }

    public class TerminalResponse
    {
        public List<string>? Output { get; set; }
        public string WorkingDir { get; set; } = string.Empty;
    }

    private async Task HandleTerminalKeyDown(KeyboardEventArgs e)
    {
        // Ctrl+C (Clear input / print ^C)
        if (e.CtrlKey && (e.Key == "c" || e.Key == "C"))
        {
            var cmd = _terminalCommand;
            _terminalCommand = string.Empty;
            _sshHistory.Add(new SshEntry { Text = cmd + "^C", IsCommand = true });
            StateHasChanged();
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('ssh-terminal-output'); if(el) el.scrollTop = el.scrollHeight;");
            }
            catch { }
            return;
        }

        // Ctrl+L (Clear screen)
        if (e.CtrlKey && (e.Key == "l" || e.Key == "L"))
        {
            await ClearTerminal();
            return;
        }

        // Ctrl+O (Lock terminal)
        if (e.CtrlKey && (e.Key == "o" || e.Key == "O"))
        {
            _isTerminalLocked = true;
            _terminalPassword = string.Empty;
            _unlockErrorMessage = string.Empty;
            StateHasChanged();
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "setTimeout(function() { var el = document.getElementById('ssh-input'); if(el) el.blur(); }, 50);");
            }
            catch { }
            return;
        }

        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_terminalCommand))
        {
            var cmd = _terminalCommand.Trim();
            _terminalCommand = string.Empty;
            _isExecutingCommand = true;

            _sshHistory.Add(new SshEntry { Text = cmd, IsCommand = true });
            StateHasChanged();

            try
            {
                var response = await Http.PostAsJsonAsync("api/system/terminal/run", new { Command = cmd });
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<TerminalResponse>();
                    if (result != null)
                    {
                        if (!string.IsNullOrEmpty(result.WorkingDir))
                        {
                            _terminalWorkingDir = result.WorkingDir;
                        }
                        if (result.Output != null)
                        {
                            foreach (var line in result.Output)
                            {
                                if (!string.IsNullOrEmpty(line))
                                    _sshHistory.Add(new SshEntry { Text = line, IsCommand = false, IsError = false });
                            }
                        }
                    }
                }
                else
                {
                    var err = await response.Content.ReadAsStringAsync();
                    _sshHistory.Add(new SshEntry { Text = $"bash: {err}", IsCommand = false, IsError = true });
                }
            }
            catch (Exception ex)
            {
                _sshHistory.Add(new SshEntry { Text = $"bash: {ex.Message}", IsCommand = false, IsError = true });
            }
            finally
            {
                _isExecutingCommand = false;
                StateHasChanged();
                try
                {
                    await JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('ssh-terminal-output'); if(el) el.scrollTop = el.scrollHeight;");
                }
                catch { }
            }
        }
    }

    // Mobil Uygulama Alanları
    private string _apkVersion = "v1.0.1";
    private string _apkSize = "24.0 MB";
    private string _apkLabel = "ApiHub Mobil Asistan";
    private bool _showQrCode = false;
    private string _qrCodeUrl = string.Empty;
    private string _qrToken = string.Empty;

    private async Task DownloadApkDirectly()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<QrTokenResponse>("api/downloads/qr-token");
            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                var downloadUrl = $"{Http.BaseAddress}api/downloads/apk/{response.Token}";
                await JSRuntime.InvokeVoidAsync("open", downloadUrl, "_blank");
                Snackbar.Add("APK indirme işlemi başlatıldı.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"APK indirilirken hata oluştu: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowDownloadQrCode()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<QrTokenResponse>("api/downloads/qr-token");
            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                _qrToken = response.Token;
                var downloadUrl = $"{Http.BaseAddress}api/downloads/apk/{_qrToken}";
                _qrCodeUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={Uri.EscapeDataString(downloadUrl)}";
                _showQrCode = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"QR kod üretilirken hata oluştu: {ex.Message}", Severity.Error);
        }
    }

    private void HideQrCode()
    {
        _showQrCode = false;
        _qrCodeUrl = string.Empty;
        _qrToken = string.Empty;
    }

    public class QrTokenResponse
    {
        public string Token { get; set; } = string.Empty;
        public DateTime ExpiresAt { get; set; }
    }
    private double _ramUsedGb = 0;
    private double _ramTotalGb = 8.0;
    private double _diskUsedPercentage = 0;
    private double _diskUsedGb = 0;
    private double _diskTotalGb = 0;
    private int _subdomainCount = 0;
    private int _cpuCount = 1;
    private string _cpuModel = "İşlemci...";

    private bool _dockerActive = false;
    private string _dockerVersion = "Bilinmiyor";
    private string _dockerApiVersion = "Bilinmiyor";
    private bool _nginxActive = false;
    private bool _mailServerActive = false;

    private List<double> _cpuHistory = new();
    private List<double> _ramHistory = new();
    private List<string> _systemLogs = new();
    private List<SubdomainDto> _subdomainsList = new();

    private List<AuditLogResponseDto> _latestAuditEvents = new();

    private bool _showMoreMenu = false;

    private void ToggleMoreMenu()
    {
        _showMoreMenu = !_showMoreMenu;
        StateHasChanged();
    }

    private void NavigateToMobilePage(string url)
    {
        _showMoreMenu = false;
        NavigationManager.NavigateTo(url);
    }

    protected override void OnInitialized()
    {
        AppState.OnStateChanged += SyncState;
        SyncState();
    }

    protected override async Task OnInitializedAsync()
    {
        // Cihaz tipi PlatformInfo singleton servisi üzerinden statik korunur.

        try
        {
            if (!AppState.IsInitialized)
            {
                await AppState.InitializeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] AppState initialization failed on load: {ex.Message}");
        }
        try
        {
            var meta = await Http.GetFromJsonAsync<ApkMetadataDto>("api/downloads/apk-metadata");
            if (meta != null)
            {
                _apkVersion = meta.Version;
                _apkSize = meta.FormattedSize;
                _apkLabel = meta.Label;
                StateHasChanged();
            }
        }
        catch
        {
            // Ignore, defaults are fine
        }

        try
        {
            var subdomains = await Http.GetFromJsonAsync<List<SubdomainDto>>("api/nginx");
            if (subdomains != null)
            {
                _subdomainsList = subdomains;
                StateHasChanged();
            }
        }
        catch
        {
            // Ignore
        }

        try
        {
            var logsResult = await Http.GetFromJsonAsync<PagedLogsDto>("api/audit-logs?page=1&pageSize=3");
            if (logsResult?.Items != null)
            {
                _latestAuditEvents = logsResult.Items;
                StateHasChanged();
            }
        }
        catch
        {
            // Ignore
        }

        if (PlatformInfo.IsMobileApp)
        {
            try
            {
                string? token = null;
                if (PlatformInfo.GetFcmTokenFunc != null)
                {
                    token = await PlatformInfo.GetFcmTokenFunc();
                }

                if (string.IsNullOrEmpty(token))
                {
                    token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "fallback_device_token");
                    if (string.IsNullOrEmpty(token))
                    {
                        token = "fcm_fallback_" + Guid.NewGuid().ToString("N");
                        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "fallback_device_token", token);
                    }
                }

                string deviceName = PlatformInfo.GetDeviceNameFunc?.Invoke() ?? "Bilinmeyen Android";
                if (!deviceName.Contains("Mobil"))
                {
                    deviceName = "Mobil - " + deviceName;
                }

                var regRequest = new 
                { 
                    Token = token, 
                    Platform = "Android", 
                    DeviceName = deviceName 
                };

                var regResponse = await Http.PostAsJsonAsync("api/devices/register", regRequest);
                if (regResponse.IsSuccessStatusCode)
                {
                    Console.WriteLine($"Cihaz başarıyla kaydedildi: {deviceName}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Cihaz kaydı sırasında hata oluştu: {ex.Message}");
            }
        }
    }

    private void SyncState()
    {
        _runningContainerCount = AppState.RunningContainerCount;
        _systemCpu = AppState.SystemCpu;
        _ramUsedGb = AppState.RamUsedGb;
        _ramTotalGb = AppState.RamTotalGb;
        _diskUsedPercentage = AppState.DiskUsedPercentage;
        _diskUsedGb = AppState.DiskUsedGb;
        _diskTotalGb = AppState.DiskTotalGb;
        _subdomainCount = AppState.SubdomainCount;
        _cpuCount = AppState.CpuCount;
        _cpuModel = AppState.CpuModel;
        _dockerActive = AppState.DockerActive;
        _dockerVersion = AppState.DockerVersion;
        _dockerApiVersion = AppState.DockerApiVersion;
        _nginxActive = AppState.NginxActive;
        _mailServerActive = AppState.MailServerActive;
        
        // Expose thread-safe copies of histories and logs
        _cpuHistory = AppState.GetCpuHistory();
        _ramHistory = AppState.GetRamHistory();
        _systemLogs = AppState.GetSystemLogs();

        InvokeAsync(StateHasChanged);
    }

    private string GetSvgPath(List<double> history)
    {
        if (history.Count < 2) return "";
        var points = new List<string>();
        double stepX = 500.0 / (history.Count - 1);
        double max = 100.0;
        for (int i = 0; i < history.Count; i++)
        {
            string x = (i * stepX).ToString(System.Globalization.CultureInfo.InvariantCulture);
            string y = (150 - (history[i] / max) * 150).ToString(System.Globalization.CultureInfo.InvariantCulture);
            points.Add($"{x},{y}");
        }
        return string.Join(" ", points);
    }

    private async Task ClearTerminal()
    {
        _sshHistory.Clear();
        _terminalWorkingDir = "/root";
        AppState.ClearTerminal();
        try
        {
            await Http.PostAsync("api/system/terminal/reset", null);
        }
        catch { }
        StateHasChanged();
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= SyncState;
    }

