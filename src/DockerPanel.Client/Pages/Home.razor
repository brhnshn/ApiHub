@page "/"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject DockerPanel.Client.Services.AppState AppState
@inject PlatformInfo PlatformInfo
@inject JwtAuthenticationStateProvider AuthProvider
@implements IDisposable

<PageTitle>Genel Bakış - ApiHub</PageTitle>

@if (PlatformInfo.IsMobileApp)
{
    <!-- STITCH MOBILE PREMIUM GLASSMORPHISM VIEW -->
    <div class="space-y-6 text-[#e1e2ec] font-sans">
        <!-- Page Actions Top Bar -->
        <div class="flex justify-between items-center bg-[#1d2027]/40 p-4 rounded-2xl border border-white/5 shadow-lg">
            <div class="flex items-center gap-3">
                <svg class="text-[#3b82f6]" fill="none" height="24" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 5C4 4.44772 4.44772 4 5 4H9C9.55228 4 10 4.44772 10 5V11C10 11.5523 9.55228 12 9 12H5C4.44772 12 4 11.5523 4 11V5Z" fill="currentColor"></path>
                    <path d="M4 15C4 14.4477 4.44772 14 5 14H9C9.55228 14 10 14.4477 10 15V19C10 19.5523 9.55228 20 9 20H5C4.44772 20 4 19.5523 4 19V15Z" fill="currentColor" fill-opacity="0.6"></path>
                    <path d="M14 5C14 4.44772 14.4477 4 15 4H19C19.5523 4 20 4.44772 20 5V9C20 9.55228 19.5523 10 19 10H15C14.4477 10 14 9.55228 14 9V5Z" fill="currentColor" fill-opacity="0.6"></path>
                    <path d="M14 13C14 12.4477 14.4477 12 15 12H19C19.5523 12 20 12.4477 20 13V19C20 19.5523 19.5523 20 19 20H15C14.4477 20 14 19.5523 14 19V13Z" fill="currentColor" fill-opacity="0.4"></path>
                </svg>
                <h1 class="text-base font-bold tracking-tight">Genel Bakış</h1>
            </div>
            <div class="bg-[#191b23] px-3 py-1.5 rounded-full flex items-center gap-2 border border-white/5">
                <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
                <span class="text-[10px] font-bold text-[#10b981] tracking-wider uppercase">Uptime: 18G 5S</span>
            </div>
        </div>

        <main class="space-y-6">

            <!-- BEGIN: MetricsSection -->
            <section class="grid grid-cols-3 gap-3" data-purpose="metrics-dashboard">
                <!-- CPU Gauge -->
                <div class="bg-[#191b23] border border-white/5 rounded-2xl p-4 flex flex-col items-center gap-3">
                    <div class="relative w-20 h-20 flex items-center justify-center">
                        <svg class="w-20 h-20 absolute -rotate-90" viewBox="0 0 100 100">
                            <circle class="stroke-[#2d3139] fill-none" stroke-width="6" cx="50" cy="50" r="40"></circle>
                            <circle class="stroke-[#3b82f6] fill-none stroke-linecap-round transition-all duration-500" stroke-width="6" cx="50" cy="50" r="40" stroke-dasharray="251.2" stroke-dashoffset="@(251.2 - (251.2 * _systemCpu) / 100)"></circle>
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center">
                            @if (!AppState.IsSignalRConnected && _systemCpu == 0)
                            {
                                <span class="text-sm font-bold text-gray-400">--</span>
                            }
                            else
                            {
                                <span class="text-sm font-bold">@_systemCpu.ToString("0")%</span>
                            }
                        </div>
                    </div>
                    <span class="text-xs font-medium text-gray-400">CPU</span>
                </div>
                <!-- Bellek Gauge -->
                <div class="bg-[#191b23] border border-white/5 rounded-2xl p-4 flex flex-col items-center gap-3">
                    <div class="relative w-20 h-20 flex items-center justify-center">
                        <svg class="w-20 h-20 absolute -rotate-90" viewBox="0 0 100 100">
                            <circle class="stroke-[#2d3139] fill-none" stroke-width="6" cx="50" cy="50" r="40"></circle>
                            <circle class="stroke-[#10b981] fill-none stroke-linecap-round transition-all duration-500" stroke-width="6" cx="50" cy="50" r="40" stroke-dasharray="251.2" stroke-dashoffset="@(251.2 - (251.2 * (_ramTotalGb > 0 ? (_ramUsedGb / _ramTotalGb) * 100 : 0)) / 100)"></circle>
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center">
                            @if (!AppState.IsSignalRConnected && _ramUsedGb == 0)
                            {
                                <span class="text-sm font-bold text-gray-400">--</span>
                            }
                            else
                            {
                                <span class="text-sm font-bold">@((_ramTotalGb > 0 ? (_ramUsedGb / _ramTotalGb) * 100 : 0).ToString("0"))%</span>
                            }
                        </div>
                    </div>
                    <span class="text-xs font-medium text-gray-400">Bellek</span>
                </div>
                <!-- Disk Gauge -->
                <div class="bg-[#191b23] border border-white/5 rounded-2xl p-4 flex flex-col items-center gap-3">
                    <div class="relative w-20 h-20 flex items-center justify-center">
                        <svg class="w-20 h-20 absolute -rotate-90" viewBox="0 0 100 100">
                            <circle class="stroke-[#2d3139] fill-none" stroke-width="6" cx="50" cy="50" r="40"></circle>
                            <circle class="stroke-[#f59e0b] fill-none stroke-linecap-round transition-all duration-500" stroke-width="6" cx="50" cy="50" r="40" stroke-dasharray="251.2" stroke-dashoffset="@(251.2 - (251.2 * _diskUsedPercentage) / 100)"></circle>
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center">
                            @if (!AppState.IsSignalRConnected && _diskUsedPercentage == 0)
                            {
                                <span class="text-sm font-bold text-gray-400">--</span>
                            }
                            else
                            {
                                <span class="text-sm font-bold">@_diskUsedPercentage.ToString("0")%</span>
                            }
                        </div>
                    </div>
                    <span class="text-xs font-medium text-gray-400">Disk</span>
                </div>
            </section>
            <!-- END: MetricsSection -->

            <!-- BEGIN: SubdomainsSection -->
            <section class="mt-4" data-purpose="active-subdomains">
                <h2 class="text-sm font-bold tracking-widest text-gray-200 mb-3 px-1">AKTİF ALT ALAN ADLARI (@_subdomainCount)</h2>
                <div class="flex gap-2 overflow-x-auto no-scrollbar pb-2">
                    @if (!_subdomainsList.Any())
                    {
                        <div class="flex-shrink-0 px-4 py-2 bg-[#1c1f26] border border-white/10 rounded-xl text-[13px] text-gray-400 font-mono">
                            Kayıtlı alt alan adı yok
                        </div>
                    }
                    else
                    {
                        @foreach (var sub in _subdomainsList)
                        {
                            <div class="flex-shrink-0 px-4 py-2 bg-[#1c1f26] border border-white/10 rounded-xl text-[13px] text-gray-400 font-mono">
                                @(string.IsNullOrWhiteSpace(sub.SubdomainName) ? sub.DomainName : $"{sub.SubdomainName}.{sub.DomainName}")
                            </div>
                        }
                    }
                </div>
            </section>
            <!-- END: SubdomainsSection -->

            <!-- BEGIN: OrchestrationSection -->
            <section class="mt-6" data-purpose="orchestration-services">
                <h2 class="text-sm font-bold tracking-widest text-gray-200 mb-3 px-1">ORKESTRASYON SERVİSLERİ</h2>
                <div class="bg-[#191b23] border border-white/5 rounded-2xl overflow-hidden">
                    <!-- Docker Engine Card -->
                    <div class="flex items-center p-4 gap-4 border-b border-white/5">
                        <div class="w-12 h-12 bg-slate-800 rounded-xl flex items-center justify-center">
                            <svg fill="none" height="24" stroke="#60a5fa" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24">
                                <rect height="14" rx="2" ry="2" width="20" x="2" y="3"></rect>
                                <line x1="8" x2="16" y1="21" y2="21"></line>
                                <line x1="12" x2="12" y1="17" y2="21"></line>
                                <polyline points="7 8 10 11 7 14"></polyline>
                                <line x1="13" x2="17" y1="14" y2="14"></line>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-sm font-semibold">Docker Engine</h3>
                            <p class="text-xs text-gray-500">v@_dockerVersion</p>
                        </div>
                        <div class="@(_dockerActive ? "bg-[#10b981]/10 text-[#10b981]" : "bg-rose-500/10 text-rose-500") px-3 py-1 rounded-full flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full @(_dockerActive ? "bg-[#10b981]" : "bg-rose-500")"></span>
                            <span class="text-[11px] font-bold uppercase">@(_dockerActive ? "Aktif" : "Kapalı")</span>
                        </div>
                    </div>
                    <!-- Nginx Gateway Card -->
                    <div class="flex items-center p-4 gap-4 border-b border-white/5">
                        <div class="w-12 h-12 bg-orange-900/30 rounded-xl flex items-center justify-center">
                            <svg fill="none" height="24" stroke="#fb923c" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24">
                                <rect height="8" rx="2" ry="2" width="20" x="2" y="2"></rect>
                                <rect height="8" rx="2" ry="2" width="20" x="2" y="14"></rect>
                                <line x1="6" x2="6" y1="6" y2="6.01"></line>
                                <line x1="6" x2="6" y1="18" y2="18.01"></line>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-sm font-semibold">Nginx Gateway</h3>
                            <p class="text-xs text-gray-500">L7 Proxy</p>
                        </div>
                        <div class="@(_nginxActive ? "bg-[#10b981]/10 text-[#10b981]" : "bg-rose-500/10 text-rose-500") px-3 py-1 rounded-full flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full @(_nginxActive ? "bg-[#10b981]" : "bg-rose-500")"></span>
                            <span class="text-[11px] font-bold uppercase">@(_nginxActive ? "Aktif" : "Kapalı")</span>
                        </div>
                    </div>
                    <!-- Docker Mail Server Card -->
                    <div class="flex items-center p-4 gap-4">
                        <div class="w-12 h-12 bg-red-900/30 rounded-xl flex items-center justify-center">
                            <svg fill="none" height="24" stroke="#f87171" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-sm font-semibold">Docker Mail Server</h3>
                            <p class="text-xs text-gray-500">SMTP/IMAP</p>
                        </div>
                        <div class="@(_mailServerActive ? "bg-[#10b981]/10 text-[#10b981]" : "bg-rose-500/10 text-rose-500") px-3 py-1 rounded-full flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full @(_mailServerActive ? "bg-[#10b981]" : "bg-rose-500")"></span>
                            <span class="text-[11px] font-bold uppercase">@(_mailServerActive ? "Aktif" : "Kapalı")</span>
                        </div>
                    </div>
                </div>
            </section>
            <!-- END: OrchestrationSection -->
        </main>
    </div>
}
else
{
<div class="space-y-5 w-full max-w-full overflow-x-hidden pb-4">
    <!-- Üst Başlık ve Butonlar -->
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <h2 class="text-2xl font-extrabold text-[#0b1c30] tracking-tight">Genel Bakış</h2>
            <p class="text-xs text-slate-400 font-medium mt-1">Sunucu donanım durumunu ve konteyner orkestrasyonunu anlık takip edin.</p>
        </div>
        <div>
            <button @onclick="@(() => NavigationManager.NavigateTo("/deploy-wizard"))" class="text-sm font-bold text-white hover:opacity-90 transition-all py-2.5 px-5 rounded-lg bg-[#4f46e5] flex items-center gap-2 shadow-lg">
                <i class="fa-solid fa-rocket"></i> Yeni Deploy
            </button>
        </div>
    </div>

    <!-- Üst Bilgi Kartları Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 w-full min-w-0">
        <!-- CPU Kullanımı -->
        <div class="bg-white border border-[#bbcabf]/30 p-5 rounded-xl flex items-center justify-between shadow-sm min-w-0">
            <div class="space-y-2 min-w-0">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">CPU KULLANIMI</p>
                <p class="text-3xl font-extrabold text-[#0b1c30]">%@_systemCpu.ToString("0.0")</p>
                <p class="text-xs text-slate-400 font-semibold font-mono truncate" title="@_cpuCount vCPU / @_cpuModel">@_cpuCount vCPU / @_cpuModel</p>
            </div>
            <div class="bg-indigo-500/10 p-3.5 rounded-xl text-indigo-600 flex-shrink-0">
                <i class="fa-solid fa-microchip text-xl"></i>
            </div>
        </div>

        <!-- Bellek Kullanımı -->
        <div class="bg-white border border-[#bbcabf]/30 p-5 rounded-xl flex flex-col justify-between shadow-sm min-w-0">
            <div class="flex items-center justify-between min-w-0">
                <div class="space-y-2 min-w-0">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">BELLEK KULLANIMI</p>
                    <p class="text-3xl font-extrabold text-[#0b1c30]">@_ramUsedGb.ToString("0.00") GB</p>
                </div>
                <div class="bg-emerald-500/10 p-3.5 rounded-xl text-emerald-600 flex-shrink-0">
                    <i class="fa-solid fa-database text-xl"></i>
                </div>
            </div>
            <!-- Progress Bar -->
            <div class="mt-3">
                <div class="w-full bg-slate-100 rounded-full h-1.5">
                    <div class="h-1.5 rounded-full bg-emerald-500 transition-all duration-700" style="width: @((_ramTotalGb > 0 ? (_ramUsedGb / _ramTotalGb) * 100 : 0).ToString("0"))%"></div>
                </div>
                <div class="flex justify-between items-center mt-1 text-[10px] text-slate-400 font-mono">
                    <span>Limit: @_ramTotalGb.ToString("0.0") GB</span>
                    <span>(@((_ramTotalGb > 0 ? (_ramUsedGb / _ramTotalGb) * 100 : 0).ToString("0"))%)</span>
                </div>
            </div>
        </div>

        <!-- Disk Kullanımı -->
        <div class="bg-white border border-[#bbcabf]/30 p-5 rounded-xl flex flex-col justify-between shadow-sm min-w-0">
            <div class="flex items-center justify-between min-w-0">
                <div class="space-y-2 min-w-0">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">DİSK KULLANIMI</p>
                    <p class="text-3xl font-extrabold text-[#0b1c30]">%@_diskUsedPercentage.ToString("0.0")</p>
                </div>
                <div class="bg-blue-500/10 p-3.5 rounded-xl text-blue-600 flex-shrink-0">
                    <i class="fa-solid fa-hard-drive text-xl"></i>
                </div>
            </div>
            <!-- Progress Bar -->
            <div class="mt-3">
                <div class="w-full bg-slate-100 rounded-full h-1.5">
                    <div class="h-1.5 rounded-full bg-blue-500 transition-all duration-700" style="width: @_diskUsedPercentage.ToString("0")%"></div>
                </div>
                <div class="flex justify-between items-center mt-1 text-[10px] text-slate-400 font-mono">
                    <span>@_diskUsedGb.ToString("0.0") GB / @_diskTotalGb.ToString("0.0") GB</span>
                </div>
            </div>
        </div>

        <!-- Aktif Subdomain -->
        <div class="bg-white border border-[#bbcabf]/30 p-5 rounded-xl flex items-center justify-between shadow-sm min-w-0">
            <div class="space-y-2 min-w-0">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">AKTİF SUBDOMAIN</p>
                <p class="text-3xl font-extrabold text-[#0b1c30]">@_subdomainCount</p>
                <p class="text-xs text-emerald-600 flex items-center gap-1 font-bold">
                    <i class="fa-solid fa-circle-check text-xs"></i> SSL: Let's Encrypt
                </p>
            </div>
            <div class="bg-purple-500/10 p-3.5 rounded-xl text-purple-600 flex-shrink-0">
                <i class="fa-solid fa-globe text-xl"></i>
            </div>
        </div>
    </div>

    <!-- Grafik ve Altyapı Düzeni Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 w-full min-w-0 overflow-hidden">
        <!-- Sol Sütun: Altyapı ve Mobil Uygulama -->
        <div class="space-y-6 min-w-0">
            <!-- Orkestrasyon Altyapısı -->
            <div class="bg-white border border-[#bbcabf]/30 rounded-xl p-5 flex flex-col justify-between shadow-sm">
                <div>
                    <h3 class="font-bold text-[#0b1c30] mb-4 text-xs uppercase tracking-wider">Orkestrasyon Altyapısı</h3>
                    <div class="space-y-3 font-medium">
                        <!-- Docker Engine Status -->
                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-200">
                            <div class="flex items-center gap-3">
                                <i class="fa-brands fa-docker text-2xl text-blue-500"></i>
                                <div>
                                    <p class="text-xs font-bold text-[#0b1c30]">Docker Engine</p>
                                    <p class="text-[10px] text-slate-400">v@_dockerVersion API: @_dockerApiVersion</p>
                                </div>
                            </div>
                            <span class="bg-emerald-50 text-emerald-600 text-[10px] px-2 py-0.5 rounded-full border border-emerald-200 font-bold">ÇALIŞIYOR</span>
                        </div>

                        <!-- Nginx Gateway -->
                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-200">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-network-wired text-lg text-emerald-600"></i>
                                <div>
                                    <p class="text-xs font-bold text-[#0b1c30]">Nginx Gateway</p>
                                    <p class="text-[10px] text-slate-400">Proxy Port: 80/443</p>
                                </div>
                            </div>
                            <span class="bg-emerald-50 text-emerald-600 text-[10px] px-2 py-0.5 rounded-full border border-emerald-200 font-bold">ÇALIŞIYOR</span>
                        </div>

                        <!-- MailServer -->
                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-200">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-envelope-open-text text-lg text-blue-600"></i>
                                <div>
                                    <p class="text-xs font-bold text-[#0b1c30]">Docker Mailserver</p>
                                    <p class="text-[10px] text-slate-400">SMTP, IMAP, SpamAssassin</p>
                                </div>
                            </div>
                            <span class="bg-emerald-50 text-emerald-600 text-[10px] px-2 py-0.5 rounded-full border border-emerald-200 font-bold">ÇALIŞIYOR</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Android Mobil Uygulama Widget -->
            <div class="bg-white border border-[#bbcabf]/30 rounded-xl p-5 flex flex-col justify-between shadow-sm">
                <div>
                    <h3 class="font-bold text-[#0b1c30] mb-1 text-xs uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-brands fa-android text-emerald-600 text-lg"></i>
                        Android Mobil Uygulama
                    </h3>
                    <p class="text-[11px] text-slate-400 mb-3 font-semibold">@_apkVersion • @_apkSize • @_apkLabel</p>
                    <p class="text-xs text-slate-500 mb-4">ApiHub Mobil Asistan ile tüm yetenekler cebinizde.</p>
                    
                    <div class="space-y-2 mt-2">
                        <button @onclick="DownloadApkDirectly" class="w-full text-xs font-bold text-white hover:opacity-95 transition-all py-2.5 px-3 rounded-lg bg-[#4f46e5] flex items-center justify-center gap-2 shadow-md">
                            <i class="fa-solid fa-download"></i> APK İndir
                        </button>
                        
                        <button @onclick="ShowDownloadQrCode" class="w-full text-xs font-bold text-[#0b1c30] hover:bg-slate-50 transition-all py-2.5 px-3 rounded-lg bg-white border border-slate-200 flex items-center justify-center gap-2">
                            <i class="fa-solid fa-qrcode"></i> QR Kod ile İndir
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Sütun: SSH Terminal -->
        <div class="lg:col-span-2 rounded-xl flex flex-col min-w-0 overflow-hidden shadow-xl relative border" style="background:#04020a; border-color: var(--border-color); height:460px;">
            <!-- Terminal Başlık Çubuğu -->
            <div class="flex items-center justify-between px-4 py-2.5 border-b" style="background:var(--bg-sub); border-color:var(--border-color);">
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-full inline-block" style="background:#ff5f57;"></span>
                    <span class="w-3 h-3 rounded-full inline-block" style="background:#febc2e;"></span>
                    <span class="w-3 h-3 rounded-full inline-block" style="background:#28c840;"></span>
                    <span class="ml-4 text-xs font-mono" style="color:#8b949e;">root&#64;apiserver: @GetPromptPath()</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-[10px] font-mono" style="color:#3fb950;">
                        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:#3fb950;"></span>
                        SSH BAĞLANDI
                    </span>
                    @if (!_isTerminalLocked)
                    {
                        <button @onclick="@(() => { _isTerminalLocked = true; _terminalPassword = string.Empty; })" class="text-[10px] font-mono hover:opacity-75 transition-opacity flex items-center gap-1" style="color:#8b949e;">
                            <i class="fa-solid fa-lock text-[9px]"></i> Kilitle (Ctrl+O)
                        </button>
                    }
                    <button @onclick="ClearTerminal" class="text-[10px] font-mono hover:opacity-75 transition-opacity flex items-center gap-1" style="color:#8b949e;">
                        <i class="fa-solid fa-eraser text-[9px]"></i> Temizle
                    </button>
                </div>
            </div>

            <!-- Terminal Çıktı Alanı -->
            <div class="flex-1 overflow-y-auto px-4 py-3 font-mono text-xs leading-relaxed" id="ssh-terminal-output"
                 style="background:#04020a; color:var(--accent-success);">
                @if (!_sshHistory.Any())
                {
                    <div class="mb-1" style="color:#8b949e;">Welcome to Ubuntu 22.04 LTS (GNU/Linux x86_64)</div>
                    <div class="mb-3" style="color:#8b949e;">Komut girin ve Enter'a basın...</div>
                }
                @foreach (var entry in _sshHistory)
                {
                    @if (entry.IsCommand)
                    {
                        <div class="flex items-center gap-0 mb-0.5">
                            <span style="color:#3fb950; white-space:nowrap; flex-shrink:0;">root&#64;apiserver</span><span style="color:#8b949e; flex-shrink:0;">:</span><span style="color:#58a6ff; flex-shrink:0;">~</span><span style="color:#e6edf3; flex-shrink:0;" class="mr-1.5">$</span>
                            <span style="color:#e6edf3; word-break:break-all;">@entry.Text</span>
                        </div>
                    }
                    else
                    {
                        <div class="mb-0.5 whitespace-pre-wrap break-words @(entry.IsError ? "ssh-out-error" : "ssh-out-normal")">@entry.Text</div>
                    }
                }
                @if (_isExecutingCommand)
                {
                    <div class="flex items-center gap-1.5 mt-1" style="color:#8b949e;">
                        <span class="w-3 h-3 border border-current border-t-transparent rounded-full animate-spin inline-block" style="flex-shrink:0;"></span>
                        <span>&#x00e7;alıştırılıyor...</span>
                    </div>
                }
            </div>

            <!-- Komut Giriş Satırı -->
            <div class="flex items-center px-4 py-2.5 border-t font-mono text-xs" style="background:#161b22; border-color:#30363d;">
                <span style="color:#3fb950; white-space:nowrap; flex-shrink:0;">root&#64;apiserver</span>
                <span style="color:#8b949e; flex-shrink:0;">:</span>
                <span style="color:#58a6ff; flex-shrink:0;">@GetPromptPath()</span>
                <span style="color:#e6edf3; flex-shrink:0;" class="mr-2">$</span>
                <input @bind="_terminalCommand"
                       @bind:event="oninput"
                       @onkeydown="HandleTerminalKeyDown"
                       disabled="@(_isTerminalLocked || _isExecutingCommand)"
                       id="ssh-input"
                       class="flex-grow bg-transparent border-none outline-none focus:ring-0 min-w-0"
                       style="color:#e6edf3; caret-color:#58a6ff; font-family:'JetBrains Mono',monospace; font-size:12px;"
                       autocomplete="off"
                       spellcheck="false" />
            </div>

            <!-- Şifre Giriş Maskesi (Overlay) -->
            @if (_isTerminalLocked)
            {
                <div class="absolute inset-0 z-10 flex flex-col items-center justify-center p-6 text-center animate-fade-in" style="background: rgba(13, 17, 23, 0.92); backdrop-filter: blur(8px);">
                    <div class="w-full max-w-xs space-y-5">
                        <div class="flex flex-col items-center gap-2">
                            <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 animate-pulse">
                                <i class="fa-solid fa-lock text-lg"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-200 tracking-wider">GÜVENLİ TERMİNAL</h3>
                            <p class="text-[11px] text-slate-400">Komut çalıştırmak için kullanıcı şifrenizi girin</p>
                        </div>

                        <div class="space-y-3">
                            <div class="relative">
                                <input type="password" 
                                       @bind="_terminalPassword"
                                       @bind:event="oninput"
                                       @onkeydown="HandleUnlockKeyDown"
                                       placeholder="Şifre girin..." 
                                       class="w-full bg-[#161b22] border border-[#30363d] focus:border-[#58a6ff] focus:ring-1 focus:ring-[#58a6ff] rounded-lg px-3 py-2 text-center text-sm text-slate-200 placeholder-slate-500 outline-none transition-all"
                                       disabled="@_isUnlocking" />
                            </div>

                            @if (!string.IsNullOrEmpty(_unlockErrorMessage))
                            {
                                <p class="text-xs text-red-400 font-semibold">@_unlockErrorMessage</p>
                            }

                            <button @onclick="UnlockTerminal" 
                                    disabled="@_isUnlocking"
                                    class="w-full bg-red-600 hover:bg-red-500 disabled:opacity-50 text-white text-xs font-bold py-2 rounded-lg transition-colors shadow-lg shadow-red-950/20">
                                @if (_isUnlocking)
                                {
                                    <span class="w-3.5 h-3.5 border border-current border-t-transparent rounded-full animate-spin inline-block mr-1"></span>
                                    <span>Doğrulanıyor...</span>
                                }
                                else
                                {
                                    <span>Kilidi Aç</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
}

