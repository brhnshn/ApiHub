@page "/login"
@attribute [AllowAnonymous]
@layout MainLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject JwtAuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject PlatformInfo Platform

<PageTitle>@( _setupRequired ? "İlk Kurulum - ApiHub" : "Oturum Aç - ApiHub" )</PageTitle>

<div class="min-h-screen flex items-center justify-center p-4 bg-[var(--cream)] relative">
    <main class="w-full max-w-md z-10">
        <div class="card p-8 md:p-10 flex flex-col items-center shadow-lg border border-[var(--line)]">
            
            <!-- Brand Identity -->
            <div class="mb-6 text-center">
                <div class="w-20 h-20 mb-4 mx-auto rounded-2xl overflow-hidden bg-white shadow-sm border border-[var(--line)] flex items-center justify-center">
                    <img alt="ApiHub Logo" class="w-full h-full object-cover" src="ApiHub.jpg">
                </div>
                <div class="eyebrow">Cloud & Docker Hub</div>
                <h1 class="text-2xl font-serif font-bold text-[var(--navy)]">ApiHub</h1>
                
                @if (_setupRequired)
                {
                    <p class="text-[var(--azure)] text-[11px] font-bold uppercase tracking-wider mt-1">Sistem İlk Kurulum Sihirbazı</p>
                    <p class="text-[var(--ink-soft)] text-xs mt-2 leading-relaxed">Lütfen panelinizin ana yönetici (Administrator) hesabını oluşturun.</p>
                }
                else
                {
                    <p class="text-[var(--ink-soft)] text-xs mt-1">Güvenli Yönetim Giriş Paneli</p>
                }
            </div>

            <!-- Error Banner -->
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="w-full p-3.5 mb-5 flex items-center gap-2.5 bg-[var(--rose-bg)] border border-[var(--rose)]/30 text-[var(--rose)] text-xs rounded-xl">
                    <i class="fa-solid fa-triangle-exclamation text-base shrink-0"></i>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (_setupRequired)
            {
                <!-- Setup Form -->
                <EditForm Model="@_registerModel" OnValidSubmit="HandleRegister" class="w-full space-y-4 text-xs">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-1">
                        <label class="block text-[10px] font-bold text-[var(--ink-soft)] uppercase tracking-wider" for="reg-username">Yönetici Kullanıcı Adı</label>
                        <input class="w-full px-3.5 py-2.5 rounded-lg outline-none bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:border-[var(--azure)]" id="reg-username" placeholder="örn: admin, root" type="text" @bind-value="_registerModel.Username">
                        <ValidationMessage For="@(() => _registerModel.Username)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div class="space-y-1">
                        <label class="block text-[10px] font-bold text-[var(--ink-soft)] uppercase tracking-wider" for="reg-password">Güçlü Şifre</label>
                        <input class="w-full px-3.5 py-2.5 rounded-lg outline-none bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] font-mono focus:border-[var(--azure)]" id="reg-password" placeholder="••••••••" type="password" @bind-value="_registerModel.Password">
                        <ValidationMessage For="@(() => _registerModel.Password)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div class="space-y-1">
                        <label class="block text-[10px] font-bold text-[var(--ink-soft)] uppercase tracking-wider" for="reg-confpassword">Şifreyi Tekrarlayın</label>
                        <input class="w-full px-3.5 py-2.5 rounded-lg outline-none bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] font-mono focus:border-[var(--azure)]" id="reg-confpassword" placeholder="••••••••" type="password" @bind-value="_registerModel.ConfirmPassword">
                        <ValidationMessage For="@(() => _registerModel.ConfirmPassword)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div class="pt-2">
                        <button class="btn-primary w-full py-3 text-xs flex items-center justify-center gap-2" type="submit" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                                <span>Kurulum Yapılıyor...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-user-plus text-xs"></i>
                                <span>Yönetici Kurulumunu Tamamla</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <!-- Login Form -->
                <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" class="w-full space-y-4 text-xs">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-1">
                        <label class="block text-[10px] font-bold text-[var(--ink-soft)] uppercase tracking-wider" for="username">Kullanıcı Adı</label>
                        <input class="w-full px-3.5 py-2.5 rounded-lg outline-none bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:border-[var(--azure)]" id="username" name="username" placeholder="Kullanıcı adınız" type="text" @bind-value="_loginModel.Username">
                        <ValidationMessage For="@(() => _loginModel.Username)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div class="space-y-1">
                        <label class="block text-[10px] font-bold text-[var(--ink-soft)] uppercase tracking-wider" for="password">Şifre</label>
                        <input class="w-full px-3.5 py-2.5 rounded-lg outline-none bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] font-mono focus:border-[var(--azure)]" id="password" name="password" placeholder="••••••••" type="password" @bind-value="_loginModel.Password">
                        <ValidationMessage For="@(() => _loginModel.Password)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div class="pt-2">
                        <button class="btn-primary w-full py-3 text-xs flex items-center justify-center gap-2" type="submit" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                                <span>Giriş Yapılıyor...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-right-to-bracket text-xs"></i>
                                <span>Oturum Aç</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }

            @if (Platform.IsMobileApp)
            {
                <button class="mt-6 flex items-center text-[var(--ink-soft)] hover:text-[var(--navy)] transition-colors text-xs font-semibold" @onclick="@(() => _showServerSettings = !_showServerSettings)">
                    <i class="fa-solid fa-gear mr-1.5 text-xs"></i>
                    Sunucu Bağlantı Ayarları
                </button>
            }
        </div>

        <!-- Footer Security Notice -->
        <div class="mt-6 text-center">
            <p class="text-[var(--ink-soft)] text-xs flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-shield-halved text-[var(--moss)] text-xs"></i>
                End-to-End Encrypted Session &middot; ApiHub Security
            </p>
        </div>
    </main>
</div>

<!-- BEGIN: ServerSettingsModal (Interactive Popup overlay preventing layout shifts) -->
@if (_showServerSettings && Platform.IsMobileApp)
{
    <div class="fixed inset-0 bg-[#07090d]/80 backdrop-blur-md z-[99999] flex items-center justify-center p-4 animate-fade-in">
        <div class="glass-card max-w-sm w-full rounded-3xl bg-[#13161f]/95 border border-white/10 p-6 text-slate-200 shadow-2xl relative space-y-4" style="border-radius: 20px;">
             <div class="flex items-center gap-3">
                <div class="p-3 bg-blue-500/10 rounded-xl text-blue-400 flex-shrink-0" style="border-radius: 12px;">
                    <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                    </svg>
                </div>
                <div class="text-left">
                    <h3 class="text-sm font-extrabold text-white" style="margin: 0;">Sunucu Bağlantı Ayarları</h3>
                    <p class="text-[10px] text-slate-400" style="margin: 2px 0 0 0;">ApiHub Server URL</p>
                </div>
            </div>

            <p class="text-[11px] text-slate-300 leading-relaxed text-left">
                Mobil uygulamanın bağlanacağı ApiHub sunucu adresini (Domain veya IP) tanımlayın:
            </p>

             <div class="relative flex items-center bg-black/40 border border-white/10 rounded-xl px-3 py-2.5" style="border-radius: 10px;">
                <svg class="w-4 h-4 text-blue-400 mr-2 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
                <input class="bg-transparent border-none focus:ring-0 w-full text-xs text-slate-200 outline-none p-0 font-mono"
                       type="text"
                       @bind-value="_mobileServerUrl"
                       placeholder="https://api.domain.com" />
            </div>

            <div class="flex gap-2 pt-2">
                <button @onclick='() => _showServerSettings = false' disabled="@_isSavingSettings"
                        class="flex-1 text-xs font-bold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 py-2.5 rounded-xl transition-all" style="border-radius: 10px;">
                    İptal Et
                </button>
                <button @onclick="SaveServerSettings" disabled="@_isSavingSettings"
                        class="flex-1 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 py-2.5 rounded-xl transition-all shadow-lg shadow-blue-600/20 flex items-center justify-center gap-2" style="border-radius: 10px;">
                    @if (_isSavingSettings)
                    {
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Kaydediliyor...</span>
                    }
                     else
                    {
                        <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                        </svg>
                        <span>Kaydet & Bağlan</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly LoginRequest _loginModel = new();
    private readonly RegisterFormModel _registerModel = new();
    private bool _isLoading = false;
    private bool _setupRequired = false;
    private string? _errorMessage;

    private string _mobileServerUrl = "";
    private bool _showServerSettings = false;
    private bool _isSavingSettings = false;

    private async Task SaveServerSettings()
    {
        if (string.IsNullOrWhiteSpace(_mobileServerUrl))
        {
            Snackbar.Add("Sunucu adresi boş olamaz!", Severity.Warning);
            return;
        }

        _isSavingSettings = true;
        try
        {
            if (Platform.SaveServerUrlFunc != null)
            {
                await Platform.SaveServerUrlFunc(_mobileServerUrl.Trim());
                if (Platform.GetServerUrlFunc != null)
                {
                    _mobileServerUrl = await Platform.GetServerUrlFunc();
                }

                Snackbar.Add("Bağlantı ayarları güncellendi! Sunucu bağlantısı kuruluyor...", Severity.Success);
                _showServerSettings = false;
                StateHasChanged();
                
                await Task.Delay(1000);
                await JSRuntime.InvokeVoidAsync("location.reload");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingSettings = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("hideLoader");
            }
            catch
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("window.hideLoader");
                }
                catch
                {
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/", replace: true);
            return;
        }

        if (Platform.IsMobileApp && Platform.GetServerUrlFunc != null)
        {
            _mobileServerUrl = await Platform.GetServerUrlFunc();
        }

        // Sisteme daha önce hiç kullanıcı kaydedilmemiş mi (ilk kurulum) sorgula - Maksimum 3.5 saniye zaman aşımı
        try
        {
            using var cts = new System.Threading.CancellationTokenSource(3500);
            var status = await Http.GetFromJsonAsync<SetupStatusResponse>("api/auth/setup-status", cts.Token);
            if (status != null)
            {
                _setupRequired = status.SetupRequired;
            }
        }
        catch (Exception)
        {
            // Sunucuya erişilemiyorsa ve mobil cihazdaysak ayar panelini aç
            if (Platform.IsMobileApp)
            {
                _showServerSettings = true;
                Snackbar.Add("API sunucusuna bağlanılamadı. Lütfen sunucu adresini doğrulayın.", Severity.Warning);
            }
        }
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", _loginModel);
            if (response.IsSuccessStatusCode)
            {
                var loginResponse = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (loginResponse != null && !string.IsNullOrEmpty(loginResponse.Token))
                {
                    await AuthProvider.LoginAsync(loginResponse.Token);
                    Snackbar.Add("Başarıyla giriş yapıldı!", Severity.Success);
                    NavigationManager.NavigateTo("/", replace: true);
                }
                else
                {
                    _errorMessage = "Sunucudan geçersiz bir anahtar yanıtı döndü.";
                }
            }
            else
            {
                _errorMessage = "Giriş başarısız! Kullanıcı adı veya şifre hatalı.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Sunucu bağlantı hatası: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleRegister()
    {
        if (_registerModel.Password != _registerModel.ConfirmPassword)
        {
            _errorMessage = "Girdiğiniz şifreler birbiriyle uyuşmuyor!";
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var payload = new
            {
                Username = _registerModel.Username,
                Password = _registerModel.Password
            };

            var response = await Http.PostAsJsonAsync("api/auth/register", payload);
            if (response.IsSuccessStatusCode)
            {
                // Kurulum tamamlandıktan sonra otomatik giriş yap
                var loginPayload = new LoginRequest
                {
                    Username = _registerModel.Username,
                    Password = _registerModel.Password
                };

                var loginResponse = await Http.PostAsJsonAsync("api/auth/login", loginPayload);
                if (loginResponse.IsSuccessStatusCode)
                {
                    var loginData = await loginResponse.Content.ReadFromJsonAsync<LoginResponse>();
                    if (loginData != null && !string.IsNullOrEmpty(loginData.Token))
                    {
                        await AuthProvider.LoginAsync(loginData.Token);
                        Snackbar.Add("Yönetici hesabı başarıyla kuruldu ve oturum açıldı!", Severity.Success);
                        NavigationManager.NavigateTo("/", replace: true);
                    }
                }
                else
                {
                    _setupRequired = false; // Giriş formuna geç
                    Snackbar.Add("Kurulum başarılı! Lütfen giriş yapın.", Severity.Success);
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Kurulum başarısız oldu: {errorText}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Kurulum sırasında ağ hatası oluştu: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class SetupStatusResponse
    {
        public bool SetupRequired { get; set; }
    }

    public class LoginRequest
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Kullanıcı adı alanı zorunludur!")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre alanı zorunludur!")]
        public string Password { get; set; } = string.Empty;
    }

    public class RegisterFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Yönetici kullanıcı adı zorunludur!")]
        [System.ComponentModel.DataAnnotations.MinLength(3, ErrorMessage = "Kullanıcı adı en az 3 karakter olmalıdır.")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre alanı zorunludur!")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Şifre en az 6 karakter olmalıdır.")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre tekrarı zorunludur!")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }
}
