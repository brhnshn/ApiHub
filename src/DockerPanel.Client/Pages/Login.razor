@page "/login"
@attribute [AllowAnonymous]
@layout MainLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject JwtAuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject PlatformInfo Platform

<PageTitle>@( _setupRequired ? "İlk Kurulum - ApiHub" : "Oturum Aç - ApiHub" )</PageTitle><style>
    /* Deep navy background with subtle grid pattern */
    .login-container-bg {
      background: radial-gradient(circle at center, #090c15 0%, #030408 100%) !important;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      position: relative;
      overflow: hidden;
    }

    .cyber-grid-overlay {
        position: absolute;
        inset: 0;
        background-image: 
            linear-gradient(rgba(59, 130, 246, 0.035) 1px, transparent 1px),
            linear-gradient(90deg, rgba(59, 130, 246, 0.035) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 1;
    }

    /* Glassmorphism card effect */
    .glass-card {
      background: rgba(255, 255, 255, 0.03) !important;
      backdrop-filter: blur(12px) !important;
      -webkit-backdrop-filter: blur(12px) !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8) !important;
    }

    /* Custom focus states for inputs */
    .input-group:focus-within {
      border-color: #3b82f6 !important;
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2) !important;
    }

    /* Smooth transitions */
    .transition-all {
      transition: all 0.3s ease;
    }

    /* Spinner animation */
    @@keyframes spin {
      to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
      animation: spin 1s linear infinite;
    }

    /* Clean inputs with absolute color safety */
    .input-group input {
        background-color: transparent !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        color: #f1f5f9 !important;
    }
    
    .input-group input::placeholder {
        color: #475569 !important;
    }

    /* Override browser autofill styles */
    input:-webkit-autofill,
    input:-webkit-autofill:hover, 
    input:-webkit-autofill:focus, 
    input:-webkit-autofill:active {
        -webkit-background-clip: text;
        -webkit-text-fill-color: #f1f5f9 !important;
        transition: background-color 5000s ease-in-out 0s;
        box-shadow: inset 0 0 20px 20px #090c15 !important;
    }
</style>



<div class="login-container-bg">
    <div class="cyber-grid-overlay"></div>
    
    <main class="w-full max-w-md z-10" data-purpose="login-wrapper">
        <div class="glass-card rounded-3xl p-8 md:p-10 flex flex-col items-center" style="border-radius: 24px;">
            
            <!-- BEGIN: BrandIdentity -->
            <div class="mb-8 text-center" data-purpose="logo-section">
                <div class="relative w-24 h-24 mb-4 mx-auto rounded-2xl overflow-hidden bg-[#10131a] shadow-inner border border-white/10 flex items-center justify-center" style="border-radius: 16px;">
                    <!-- Using our custom ApiHub logo image -->
                    <img alt="ApiHub Logo" class="w-full h-full object-cover" src="ApiHub.jpg">
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-white font-sans">ApiHub</h1>
                
                @if (_setupRequired)
                {
                    <p class="text-[#3b82f6] text-[11px] font-black uppercase tracking-widest mt-1">Sistem İlk Kurulum Sihirbazı</p>
                    <p class="text-slate-400 text-xs mt-2 leading-relaxed">Lütfen panelinizin ana yönetici (Administrator) hesabını oluşturun.</p>
                }
                else
                {
                    <p class="text-slate-400 text-sm mt-1">Güvenli Yönetim Giriş Paneli</p>
                }
            </div>
            <!-- END: BrandIdentity -->

            <!-- Error Banner -->
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="w-full p-4 mb-6 flex items-center gap-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs text-left" style="border-radius: 10px;">
                    <svg class="w-5 h-5 text-rose-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (_setupRequired)
            {
                <!-- BEGIN: SetupForm -->
                <EditForm Model="@_registerModel" OnValidSubmit="HandleRegister" class="w-full">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-5">
                        <!-- Username Field -->
                        <div class="space-y-2 text-left">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1" for="reg-username">Yönetici Kullanıcı Adı</label>
                            <div class="input-group flex items-center bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 transition-all" style="border-radius: 12px;">
                                <svg class="w-5 h-5 text-slate-500 mr-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <input class="bg-transparent border-none focus:ring-0 w-full text-slate-100 placeholder-slate-600 p-0 text-sm outline-none" id="reg-username" placeholder="örn: admin, root" type="text" @bind-value="_registerModel.Username">
                            </div>
                            <ValidationMessage For="@(() => _registerModel.Username)" class="text-rose-400 text-[10px] mt-1 ml-1" />
                        </div>

                        <!-- Password Field -->
                        <div class="space-y-2 text-left">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1" for="reg-password">Güçlü Şifre</label>
                            <div class="input-group flex items-center bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 transition-all" style="border-radius: 12px;">
                                <svg class="w-5 h-5 text-slate-500 mr-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                                <input class="bg-transparent border-none focus:ring-0 w-full text-slate-100 placeholder-slate-600 p-0 text-sm outline-none" id="reg-password" placeholder="••••••••" type="password" @bind-value="_registerModel.Password">
                            </div>
                            <ValidationMessage For="@(() => _registerModel.Password)" class="text-rose-400 text-[10px] mt-1 ml-1" />
                        </div>

                        <!-- Confirm Password Field -->
                        <div class="space-y-2 text-left">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1" for="reg-confpassword">Şifreyi Tekrarlayın</label>
                            <div class="input-group flex items-center bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 transition-all" style="border-radius: 12px;">
                                <svg class="w-5 h-5 text-slate-500 mr-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 7.89M9 11l3 3L22 4" />
                                </svg>
                                <input class="bg-transparent border-none focus:ring-0 w-full text-slate-100 placeholder-slate-600 p-0 text-sm outline-none" id="reg-confpassword" placeholder="••••••••" type="password" @bind-value="_registerModel.ConfirmPassword">
                            </div>
                            <ValidationMessage For="@(() => _registerModel.ConfirmPassword)" class="text-rose-400 text-[10px] mt-1 ml-1" />
                        </div>

                        <!-- Submit Button -->
                        <button class="w-full bg-[#3b82f6] hover:bg-blue-600 active:scale-[0.98] text-white font-bold py-4 rounded-xl shadow-lg shadow-blue-500/20 transition-all flex items-center justify-center gap-2" type="submit" disabled="@_isLoading" style="border-radius: 12px;">
                            @if (_isLoading)
                            {
                                <div class="mr-2 h-5 w-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                                <span>Kurulum Yapılıyor...</span>
                            }
                            else
                            {
                                <span>Yönetici Kurulumunu Tamamla</span>
                            }
                        </button>
                    </div>
                </EditForm>
                <!-- END: SetupForm -->
            }
            else
            {
                <!-- BEGIN: LoginForm -->
                <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" class="w-full">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-5">
                        <!-- Username Field -->
                        <div class="space-y-2 text-left">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1" for="username">Kullanıcı Adı</label>
                            <div class="input-group flex items-center bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 transition-all" style="border-radius: 12px;">
                                <svg class="w-5 h-5 text-slate-500 mr-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <input class="bg-transparent border-none focus:ring-0 w-full text-slate-100 placeholder-slate-600 p-0 text-sm outline-none" id="username" name="username" placeholder="Username" type="text" @bind-value="_loginModel.Username">
                            </div>
                            <ValidationMessage For="@(() => _loginModel.Username)" class="text-rose-400 text-[10px] mt-1 ml-1" />
                        </div>

                        <!-- Password Field -->
                        <div class="space-y-2 text-left">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1" for="password">Şifre</label>
                            <div class="input-group flex items-center bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 transition-all" style="border-radius: 12px;">
                                <svg class="w-5 h-5 text-slate-500 mr-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                                <input class="bg-transparent border-none focus:ring-0 w-full text-slate-100 placeholder-slate-600 p-0 text-sm outline-none" id="password" name="password" placeholder="Password" type="password" @bind-value="_loginModel.Password">
                            </div>
                            <ValidationMessage For="@(() => _loginModel.Password)" class="text-rose-400 text-[10px] mt-1 ml-1" />
                        </div>

                        <!-- Submit Button -->
                        <button class="w-full bg-[#3b82f6] hover:bg-blue-600 active:scale-[0.98] text-white font-bold py-4 rounded-xl shadow-lg shadow-blue-500/20 transition-all flex items-center justify-center gap-2" type="submit" disabled="@_isLoading" style="border-radius: 12px;">
                            @if (_isLoading)
                            {
                                <div class="mr-2 h-5 w-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                                <span>Giriş Yapılıyor...</span>
                            }
                            else
                            {
                                <span>Oturum Aç</span>
                            }
                        </button>
                    </div>
                </EditForm>
                <!-- END: LoginForm -->
            }

            <!-- BEGIN: SettingsToggle -->
             @if (Platform.IsMobileApp)
            {
                <button class="mt-8 flex items-center text-slate-500 hover:text-slate-300 transition-colors text-xs font-semibold uppercase tracking-wider" data-purpose="toggle-settings" @onclick="@(() => _showServerSettings = !_showServerSettings)">
                    <svg class="w-4 h-4 mr-2 shrink-0 animate-spin-slow text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Sunucu Bağlantı Ayarları
                </button>
            }
            <!-- END: SettingsToggle -->

        </div>

        <!-- Footer Security Notice -->
        <div class="mt-8 text-center" data-purpose="footer-info">
            <p class="text-slate-500 text-xs flex items-center justify-center">
                <svg class="w-3.5 h-3.5 mr-1.5 text-green-500/70" fill="currentColor" viewBox="0 0 20 20"><path clip-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 4.925-3.467 9.47-8 10.655C5.467 16.47 2 11.925 2 7a11.931 11.931 0 00.166-2.001zM10 4.5a.5.5 0 00-.5.5v2.5a.5.5 0 001 0V5a.5.5 0 00-.5-.5zm0 5a.5.5 0 00-.5.5v2a.5.5 0 001 0v-2a.5.5 0 00-.5-.5z" fill-rule="evenodd"></path></svg>
                End-to-End Encrypted Session
            </p>
        </div>
    </main>
</div>

<!-- BEGIN: ServerSettingsModal (Interactive Popup overlay preventing layout shifts) -->
@if (_showServerSettings && Platform.IsMobileApp)
{
    <div class="fixed inset-0 bg-[#07090d]/80 backdrop-blur-md z-[99999] flex items-center justify-center p-4 animate-fade-in">
        <div class="glass-card max-w-sm w-full rounded-3xl bg-[#13161f]/95 border border-white/10 p-6 text-slate-200 shadow-2xl relative space-y-4" style="border-radius: 20px;">
             <div class="flex items-center gap-3">
                <div class="p-3 bg-blue-500/10 rounded-xl text-blue-400 flex-shrink-0" style="border-radius: 12px;">
                    <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                    </svg>
                </div>
                <div class="text-left">
                    <h3 class="text-sm font-extrabold text-white" style="margin: 0;">Sunucu Bağlantı Ayarları</h3>
                    <p class="text-[10px] text-slate-400" style="margin: 2px 0 0 0;">ApiHub Server URL</p>
                </div>
            </div>

            <p class="text-[11px] text-slate-300 leading-relaxed text-left">
                Mobil uygulamanın bağlanacağı ApiHub sunucu adresini (Domain veya IP) tanımlayın:
            </p>

             <div class="relative flex items-center bg-black/40 border border-white/10 rounded-xl px-3 py-2.5" style="border-radius: 10px;">
                <svg class="w-4 h-4 text-blue-400 mr-2 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
                <input class="bg-transparent border-none focus:ring-0 w-full text-xs text-slate-200 outline-none p-0 font-mono"
                       type="text"
                       @bind-value="_mobileServerUrl"
                       placeholder="https://api.domain.com" />
            </div>

            <div class="flex gap-2 pt-2">
                <button @onclick='() => _showServerSettings = false' disabled="@_isSavingSettings"
                        class="flex-1 text-xs font-bold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 py-2.5 rounded-xl transition-all" style="border-radius: 10px;">
                    İptal Et
                </button>
                <button @onclick="SaveServerSettings" disabled="@_isSavingSettings"
                        class="flex-1 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 py-2.5 rounded-xl transition-all shadow-lg shadow-blue-600/20 flex items-center justify-center gap-2" style="border-radius: 10px;">
                    @if (_isSavingSettings)
                    {
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Kaydediliyor...</span>
                    }
                     else
                    {
                        <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                        </svg>
                        <span>Kaydet & Bağlan</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly LoginRequest _loginModel = new();
    private readonly RegisterFormModel _registerModel = new();
    private bool _isLoading = false;
    private bool _setupRequired = false;
    private string? _errorMessage;

    private string _mobileServerUrl = "";
    private bool _showServerSettings = false;
    private bool _isSavingSettings = false;

    private async Task SaveServerSettings()
    {
        if (string.IsNullOrWhiteSpace(_mobileServerUrl))
        {
            Snackbar.Add("Sunucu adresi boş olamaz!", Severity.Warning);
            return;
        }

        _isSavingSettings = true;
        try
        {
            if (Platform.SaveServerUrlFunc != null)
            {
                await Platform.SaveServerUrlFunc(_mobileServerUrl.Trim());
                if (Platform.GetServerUrlFunc != null)
                {
                    _mobileServerUrl = await Platform.GetServerUrlFunc();
                }

                Snackbar.Add("Bağlantı ayarları güncellendi! Sunucu bağlantısı kuruluyor...", Severity.Success);
                _showServerSettings = false;
                StateHasChanged();
                
                await Task.Delay(1000);
                await JSRuntime.InvokeVoidAsync("location.reload");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingSettings = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("hideLoader");
            }
            catch
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("window.hideLoader");
                }
                catch
                {
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/", replace: true);
            return;
        }

        if (Platform.IsMobileApp && Platform.GetServerUrlFunc != null)
        {
            _mobileServerUrl = await Platform.GetServerUrlFunc();
        }

        // Sisteme daha önce hiç kullanıcı kaydedilmemiş mi (ilk kurulum) sorgula - Maksimum 3.5 saniye zaman aşımı
        try
        {
            using var cts = new System.Threading.CancellationTokenSource(3500);
            var status = await Http.GetFromJsonAsync<SetupStatusResponse>("api/auth/setup-status", cts.Token);
            if (status != null)
            {
                _setupRequired = status.SetupRequired;
            }
        }
        catch (Exception)
        {
            // Sunucuya erişilemiyorsa ve mobil cihazdaysak ayar panelini aç
            if (Platform.IsMobileApp)
            {
                _showServerSettings = true;
                Snackbar.Add("API sunucusuna bağlanılamadı. Lütfen sunucu adresini doğrulayın.", Severity.Warning);
            }
        }
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", _loginModel);
            if (response.IsSuccessStatusCode)
            {
                var loginResponse = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (loginResponse != null && !string.IsNullOrEmpty(loginResponse.Token))
                {
                    await AuthProvider.LoginAsync(loginResponse.Token);
                    Snackbar.Add("Başarıyla giriş yapıldı!", Severity.Success);
                    NavigationManager.NavigateTo("/", replace: true);
                }
                else
                {
                    _errorMessage = "Sunucudan geçersiz bir anahtar yanıtı döndü.";
                }
            }
            else
            {
                _errorMessage = "Giriş başarısız! Kullanıcı adı veya şifre hatalı.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Sunucu bağlantı hatası: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleRegister()
    {
        if (_registerModel.Password != _registerModel.ConfirmPassword)
        {
            _errorMessage = "Girdiğiniz şifreler birbiriyle uyuşmuyor!";
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var payload = new
            {
                Username = _registerModel.Username,
                Password = _registerModel.Password
            };

            var response = await Http.PostAsJsonAsync("api/auth/register", payload);
            if (response.IsSuccessStatusCode)
            {
                // Kurulum tamamlandıktan sonra otomatik giriş yap
                var loginPayload = new LoginRequest
                {
                    Username = _registerModel.Username,
                    Password = _registerModel.Password
                };

                var loginResponse = await Http.PostAsJsonAsync("api/auth/login", loginPayload);
                if (loginResponse.IsSuccessStatusCode)
                {
                    var loginData = await loginResponse.Content.ReadFromJsonAsync<LoginResponse>();
                    if (loginData != null && !string.IsNullOrEmpty(loginData.Token))
                    {
                        await AuthProvider.LoginAsync(loginData.Token);
                        Snackbar.Add("Yönetici hesabı başarıyla kuruldu ve oturum açıldı!", Severity.Success);
                        NavigationManager.NavigateTo("/", replace: true);
                    }
                }
                else
                {
                    _setupRequired = false; // Giriş formuna geç
                    Snackbar.Add("Kurulum başarılı! Lütfen giriş yapın.", Severity.Success);
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Kurulum başarısız oldu: {errorText}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Kurulum sırasında ağ hatası oluştu: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

