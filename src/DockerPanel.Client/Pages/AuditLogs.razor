@page "/audit-logs"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject PlatformInfo PlatformInfo
@inject DockerPanel.Client.Services.AppState AppState
@implements IDisposable
@using System.Text.Json



<PageTitle>Denetim Kayıtları - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="eyebrow">Güvenlik & İzleme</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">Denetim Kayıtları (Audit Logs)</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">Sunucu ve panel üzerinde gerçekleştirilen tüm yönetimsel ve kullanıcı işlemlerinin detaylı kayıtları.</p>
        </div>
    </div>

    <!-- İstatistik Kartları -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-lbl">Bugünkü Toplam İşlem</div>
            <div class="stat-val">@_totalToday</div>
            <div class="stat-sub">Bugün kaydedilen eylemler</div>
        </div>

        <div class="stat-card md:col-span-2">
            <div class="stat-lbl">En Sık Gerçekleşen Eylemler</div>
            <div class="flex flex-wrap gap-1.5 mt-2">
                @if (!_popularActions.Any())
                {
                    <span class="text-xs text-[var(--ink-soft)]">Veri yükleniyor...</span>
                }
                else
                {
                    @foreach (var act in _popularActions)
                    {
                        <span class="pill pill-azure text-[11px]">
                            @act.Action <span class="opacity-75 font-mono ml-0.5">(@act.Count)</span>
                        </span>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Filtreleme Bölümü -->
    <div class="card">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
                <label class="block text-[10px] text-[var(--ink-soft)] font-bold uppercase tracking-wider mb-1">Eylem Tipi (Action)</label>
                <select @bind="_actionFilter" @bind:after="OnFilterChanged"
                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg px-2.5 py-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] font-medium">
                    <option value="">Tümü (Tüm Eylemler)</option>
                    <option value="UserLogin">UserLogin (Giriş)</option>
                    <option value="ContainerCreated">ContainerCreated (Oluşturma)</option>
                    <option value="ContainerStarted">ContainerStarted (Başlatma)</option>
                    <option value="ContainerStopped">ContainerStopped (Durdurma)</option>
                    <option value="ContainerDeleted">ContainerDeleted (Silme)</option>
                    <option value="NativeProjectDeployed">NativeProjectDeployed (Deploy)</option>
                    <option value="StaticSiteDeployed">StaticSiteDeployed (Statik Deploy)</option>
                    <option value="LimitsUpdated">LimitsUpdated (Limit Güncelleme)</option>
                    <option value="SubdomainCreated">SubdomainCreated (Subdomain Ekleme)</option>
                    <option value="SubdomainDeleted">SubdomainDeleted (Subdomain Silme)</option>
                    <option value="DatabaseCreated">DatabaseCreated (Database Ekleme)</option>
                    <option value="DatabaseDeleted">DatabaseDeleted (Database Silme)</option>
                </select>
            </div>
            <div>
                <label class="block text-[10px] text-[var(--ink-soft)] font-bold uppercase tracking-wider mb-1">Bileşen (Entity)</label>
                <select @bind="_entityFilter" @bind:after="OnFilterChanged"
                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg px-2.5 py-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] font-medium">
                    <option value="">Tümü (Tüm Bileşenler)</option>
                    <option value="User">User (Kullanıcı)</option>
                    <option value="Project">Project (Proje)</option>
                    <option value="Subdomain">Subdomain (Proxy)</option>
                    <option value="DnsRecord">DnsRecord (DNS)</option>
                    <option value="DatabaseSchema">DatabaseSchema (Database)</option>
                    <option value="MailAccount">MailAccount (E-Posta)</option>
                    <option value="Backup">Backup (Yedekleme)</option>
                </select>
            </div>
            <div class="flex items-end">
                <button @onclick="ResetFilters" class="btn-secondary w-full py-2 text-xs justify-center">
                    <i class="fa-solid fa-filter-circle-xmark mr-1"></i> Filtreleri Temizle
                </button>
            </div>
        </div>
    </div>

    <!-- Denetim Kayıtları Tablosu -->
    <div class="card space-y-4">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-[var(--line)] text-[var(--ink-soft)] font-semibold">
                        <th class="pb-3 w-8"></th>
                        <th class="pb-3">Eylem</th>
                        <th class="pb-3">Kullanıcı</th>
                        <th class="pb-3">IP Adresi</th>
                        <th class="pb-3">Cihaz / Tarayıcı</th>
                        <th class="pb-3">Tarih</th>
                        <th class="pb-3 text-right">Detaylar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--line)] text-[var(--ink)]">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-[var(--ink-soft)]">
                                <span class="w-5 h-5 border-2 border-[var(--azure)] border-t-transparent rounded-full animate-spin inline-block align-middle mr-2"></span>
                                Log kayıtları yükleniyor...
                            </td>
                        </tr>
                    }
                    else if (!_logs.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-6 text-center text-[var(--ink-soft)]">Kayıtlı denetim günlüğü bulunmamaktadır.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in _logs)
                        {
                            var isExpanded = _expandedLogIds.Contains(log.Id);
                            <tr class="hover:bg-[var(--cream)] transition-colors">
                                <td class="py-3">
                                    <button @onclick="@(() => ToggleExpand(log.Id))" class="text-[var(--ink-soft)] hover:text-[var(--navy)] transition-colors p-1">
                                        <i class="fa-solid @(isExpanded ? "fa-chevron-down" : "fa-chevron-right") text-[11px]"></i>
                                    </button>
                                </td>
                                <td class="py-3">
                                    <span class="@GetActionBadgeClass(log.Action)">
                                        @log.Action
                                    </span>
                                </td>
                                <td class="py-3 font-semibold text-[var(--navy)]">@log.Username</td>
                                <td class="py-3 font-mono text-[11px] text-[var(--ink-soft)]">@log.IpAddress</td>
                                <td class="py-3 text-[11px] text-[var(--ink-soft)]" title="@log.UserAgent">@TruncateUa(log.UserAgent)</td>
                                <td class="py-3 text-[var(--ink-soft)] font-mono">@log.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="py-3 text-right">
                                    <span class="pill text-[10px] bg-[var(--cream)] text-[var(--navy)] font-mono">
                                        @log.TargetEntity
                                    </span>
                                </td>
                            </tr>
                            @if (isExpanded)
                            {
                                <tr>
                                    <td colspan="7" class="bg-[var(--cream)] p-4 font-mono text-xs text-[var(--ink)] border-l-2 border-[var(--azure)]">
                                        <div class="space-y-2">
                                            <div>
                                                <span class="font-bold text-[var(--ink-soft)] uppercase tracking-wider text-[10px]">Hedef ID:</span>
                                                <span class="text-[var(--navy)] ml-1">@(log.TargetId?.ToString() ?? "Yok")</span>
                                            </div>
                                            <div>
                                                <span class="font-bold text-[var(--ink-soft)] uppercase tracking-wider text-[10px] block mb-1">Eylem Detayları (JSON):</span>
                                                <pre class="bg-[#1C2630] text-[#8FD6B4] p-3 rounded-lg overflow-x-auto text-[11px] max-h-48 border border-[var(--navy)]">@FormatJson(log.Details)</pre>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Sayfalama (Pagination) -->
        @if (_totalPages > 1)
        {
            <div class="flex items-center justify-between border-t border-[var(--line)] pt-3 text-xs">
                <span class="text-[var(--ink-soft)] font-medium">Toplam @_totalItems kayıttan @((_currentPage - 1) * _pageSize + 1) - @(Math.Min(_currentPage * _pageSize, _totalItems)) arası gösteriliyor</span>
                <div class="flex items-center gap-1">
                    <button @onclick="PrevPage" disabled="@(_currentPage == 1)"
                        class="btn-secondary py-1 px-3 text-xs">
                        Önceki
                    </button>
                    <span class="px-2 font-semibold text-[var(--navy)] font-mono">@_currentPage / @_totalPages</span>
                    <button @onclick="NextPage" disabled="@(_currentPage == _totalPages)"
                        class="btn-secondary py-1 px-3 text-xs">
                        Sonraki
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<AuditLogResponseDto> _logs = new();
    private List<PopularActionDto> _popularActions = new();
    private HashSet<Guid> _expandedLogIds = new();
    private int _totalToday = 0;

    private string _actionFilter = "";
    private string _entityFilter = "";
    private int _currentPage = 1;
    private int _pageSize = 15;
    private int _totalItems = 0;
    private int _totalPages => (int)Math.Ceiling((double)_totalItems / _pageSize);
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnPullToRefresh += HandlePullToRefresh;
        await HandlePullToRefresh();
    }

    private async Task HandlePullToRefresh()
    {
        await LoadStats();
        await LoadLogs();
    }

    public void Dispose()
    {
        AppState.OnPullToRefresh -= HandlePullToRefresh;
    }

    private async Task LoadStats()
    {
        try
        {
            var stats = await Http.GetFromJsonAsync<AuditStatsDto>("api/audit-logs/stats");
            if (stats != null)
            {
                _totalToday = stats.TotalToday;
                _popularActions = stats.PopularActions ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"İstatistik yüklenirken hata: {ex.Message}");
        }
    }

    private async Task LoadLogs()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var url = $"api/audit-logs?page={_currentPage}&pageSize={_pageSize}&actionType={Uri.EscapeDataString(_actionFilter)}&entityType={Uri.EscapeDataString(_entityFilter)}";
            var result = await Http.GetFromJsonAsync<PagedLogsDto>(url);
            if (result != null)
            {
                _logs = result.Items ?? new();
                _totalItems = result.TotalItems;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kayıtlar yüklenemedi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilterChanged()
    {
        _currentPage = 1;
        _expandedLogIds.Clear();
        await LoadLogs();
    }

    private async Task ResetFilters()
    {
        _actionFilter = "";
        _entityFilter = "";
        _currentPage = 1;
        _expandedLogIds.Clear();
        await LoadLogs();
    }

    private void ToggleExpand(Guid id)
    {
        if (_expandedLogIds.Contains(id))
        {
            _expandedLogIds.Remove(id);
        }
        else
        {
            _expandedLogIds.Add(id);
        }
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadLogs();
        }
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            await LoadLogs();
        }
    }

    private string GetActionBadgeClass(string action)
    {
        if (action.Contains("Created") || action.Contains("Deployed") || action.Contains("Added"))
        {
            return "pill pill-moss text-[10.5px]";
        }
        if (action.Contains("Deleted") || action.Contains("Stopped") || action.Contains("Removed"))
        {
            return "pill pill-rose text-[10.5px]";
        }
        if (action.Contains("Login"))
        {
            return "pill pill-azure text-[10.5px]";
        }
        return "pill text-[10.5px] bg-[var(--cream)] text-[var(--ink-soft)]";
    }

    private string TruncateUa(string ua)
    {
        if (string.IsNullOrEmpty(ua)) return "Bilinmeyen Cihaz";
        if (ua.Contains("Android")) return "Android Mobil";
        if (ua.Contains("iPhone") || ua.Contains("iPad")) return "iOS Mobil";
        if (ua.Contains("Windows")) return "Windows PC";
        if (ua.Contains("Linux")) return "Linux PC";
        if (ua.Contains("Macintosh")) return "macOS PC";
        return ua.Length > 20 ? ua.Substring(0, 17) + "..." : ua;
    }

    private string FormatJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "{}";
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    // DTO Classes
    private class PagedLogsDto
    {
        public int TotalItems { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public List<AuditLogResponseDto>? Items { get; set; }
    }

    private class AuditLogResponseDto
    {
        public Guid Id { get; set; }
        public Guid UserId { get; set; }
        public string Username { get; set; } = string.Empty;
        public string Action { get; set; } = string.Empty;
        public string TargetEntity { get; set; } = string.Empty;
        public Guid? TargetId { get; set; }
        public string Details { get; set; } = string.Empty;
        public string IpAddress { get; set; } = string.Empty;
        public string UserAgent { get; set; } = string.Empty;
        public DateTimeOffset Timestamp { get; set; }
    }

    private class AuditStatsDto
    {
        public int TotalToday { get; set; }
        public List<PopularActionDto>? PopularActions { get; set; }
    }

    private class PopularActionDto
    {
        public string Action { get; set; } = string.Empty;
        public int Count { get; set; }
    }
}
