@page "/audit-logs"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject PlatformInfo PlatformInfo
@inject DockerPanel.Client.Services.AppState AppState
@implements IDisposable
@using System.Text.Json



<PageTitle>Denetim Kayıtları - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div>
        <h2 class="text-2xl font-extrabold text-[#0b1c30] tracking-tight">Denetim Kayıtları (Audit Logs)</h2>
        <p class="text-xs text-slate-500 font-medium mt-1">Sunucu ve panel üzerinde gerçekleştirilen tüm yönetimsel ve kullanıcı işlemlerinin detaylı kayıtları.</p>
    </div>

    <!-- İstatistik Kartları -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Bugün Toplam Eylem -->
        <div class="bg-white border border-[#bbcabf]/30 rounded-xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600 border border-indigo-100">
                <i class="fa-solid fa-calendar-day text-lg"></i>
            </div>
            <div>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Bugünkü Toplam İşlem</p>
                <h3 class="text-2xl font-black text-[#0b1c30] mt-0.5">@_totalToday</h3>
            </div>
        </div>

        <!-- En Çok Yapılan İşlem -->
        <div class="bg-white border border-[#bbcabf]/30 rounded-xl p-5 shadow-sm md:col-span-2 flex items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600 border border-emerald-100">
                    <i class="fa-solid fa-bolt text-lg"></i>
                </div>
                <div>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">En Sık Gerçekleşen Eylemler</p>
                    <div class="flex flex-wrap gap-1.5 mt-1">
                        @if (!_popularActions.Any())
                        {
                            <span class="text-xs text-slate-400">Veri yükleniyor...</span>
                        }
                        else
                        {
                            @foreach (var act in _popularActions)
                            {
                                <span class="bg-slate-100 text-slate-700 text-[10px] px-2.5 py-0.5 rounded-full font-bold border border-slate-200">
                                    @act.Action (@act.Count)
                                </span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtreleme Bölümü -->
    <div class="bg-white border border-[#bbcabf]/30 rounded-xl p-4 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
                <label class="block text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-1">Eylem Tipi (Action)</label>
                <select @bind="_actionFilter" @bind:after="OnFilterChanged"
                    class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-700 focus:outline-none focus:border-indigo-500 font-medium">
                    <option value="">Tümü (Tüm Eylemler)</option>
                    <option value="UserLogin">UserLogin (Giriş)</option>
                    <option value="ContainerCreated">ContainerCreated (Oluşturma)</option>
                    <option value="ContainerStarted">ContainerStarted (Başlatma)</option>
                    <option value="ContainerStopped">ContainerStopped (Durdurma)</option>
                    <option value="ContainerDeleted">ContainerDeleted (Silme)</option>
                    <option value="NativeProjectDeployed">NativeProjectDeployed (Deploy)</option>
                    <option value="StaticSiteDeployed">StaticSiteDeployed (Statik Deploy)</option>
                    <option value="LimitsUpdated">LimitsUpdated (Limit Güncelleme)</option>
                    <option value="SubdomainCreated">SubdomainCreated (Subdomain Ekleme)</option>
                    <option value="SubdomainDeleted">SubdomainDeleted (Subdomain Silme)</option>
                    <option value="DatabaseCreated">DatabaseCreated (Database Ekleme)</option>
                    <option value="DatabaseDeleted">DatabaseDeleted (Database Silme)</option>
                </select>
            </div>
            <div>
                <label class="block text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-1">Bileşen (Entity)</label>
                <select @bind="_entityFilter" @bind:after="OnFilterChanged"
                    class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-700 focus:outline-none focus:border-indigo-500 font-medium">
                    <option value="">Tümü (Tüm Bileşenler)</option>
                    <option value="User">User (Kullanıcı)</option>
                    <option value="Project">Project (Proje)</option>
                    <option value="Subdomain">Subdomain (Proxy)</option>
                    <option value="DnsRecord">DnsRecord (DNS)</option>
                    <option value="DatabaseSchema">DatabaseSchema (Database)</option>
                    <option value="MailAccount">MailAccount (E-Posta)</option>
                    <option value="Backup">Backup (Yedekleme)</option>
                </select>
            </div>
            <div class="flex items-end">
                <button @onclick="ResetFilters"
                    class="w-full bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 text-xs font-bold py-2 rounded-lg transition-colors flex items-center justify-center gap-1">
                    <i class="fa-solid fa-filter-circle-xmark"></i> Filtreleri Temizle
                </button>
            </div>
        </div>
    </div>

    <!-- Denetim Kayıtları Tablosu -->
    <div class="bg-white border border-[#bbcabf]/30 rounded-xl p-5 shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-200 text-slate-400">
                        <th class="pb-3 font-semibold w-8"></th>
                        <th class="pb-3 font-semibold">Eylem</th>
                        <th class="pb-3 font-semibold">Kullanıcı</th>
                        <th class="pb-3 font-semibold">IP Adresi</th>
                        <th class="pb-3 font-semibold">Cihaz / Tarayıcı</th>
                        <th class="pb-3 font-semibold">Tarih</th>
                        <th class="pb-3 font-semibold text-right">Detaylar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-600">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-400">
                                <span class="w-6 h-6 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin inline-block align-middle mr-2"></span>
                                Log kayıtları yükleniyor...
                            </td>
                        </tr>
                    }
                    else if (!_logs.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-6 text-center text-slate-400">Kayıtlı denetim günlüğü bulunmamaktadır.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in _logs)
                        {
                            var isExpanded = _expandedLogIds.Contains(log.Id);
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="py-3">
                                    <button @onclick="@(() => ToggleExpand(log.Id))" class="text-slate-400 hover:text-[#0b1c30] transition-colors p-1">
                                        <i class="fa-solid @(isExpanded ? "fa-chevron-down" : "fa-chevron-right")"></i>
                                    </button>
                                </td>
                                <td class="py-3">
                                    <span class="@GetActionBadgeClass(log.Action)">
                                        @log.Action
                                    </span>
                                </td>
                                <td class="py-3 font-semibold text-[#0b1c30]">@log.Username</td>
                                <td class="py-3 font-mono text-[11px]">@log.IpAddress</td>
                                <td class="py-3 text-[11px]" title="@log.UserAgent">@TruncateUa(log.UserAgent)</td>
                                <td class="py-3 text-slate-400">@log.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="py-3 text-right">
                                    <span class="bg-slate-100 text-slate-500 text-[10px] px-2 py-0.5 rounded-full font-bold">
                                        @log.TargetEntity
                                    </span>
                                </td>
                            </tr>
                            @if (isExpanded)
                            {
                                <tr>
                                    <td colspan="7" class="bg-slate-50 p-4 font-mono text-[11px] text-slate-700 border-l-2 border-indigo-500">
                                        <div class="space-y-2">
                                            <div>
                                                <span class="font-bold text-slate-500 uppercase tracking-wider">Hedef ID:</span>
                                                <span class="text-[#0b1c30]">@(log.TargetId?.ToString() ?? "Yok")</span>
                                            </div>
                                            <div>
                                                <span class="font-bold text-slate-500 uppercase tracking-wider block mb-1">Eylem Detayları (JSON):</span>
                                                <pre class="bg-slate-900 text-emerald-400 p-3 rounded-lg overflow-x-auto text-[10px] max-h-48">@FormatJson(log.Details)</pre>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Sayfalama (Pagination) -->
        @if (_totalPages > 1)
        {
            <div class="flex items-center justify-between border-t border-slate-100 pt-4 mt-4 text-xs">
                <span class="text-slate-500 font-medium">Toplam @_totalItems kayıttan @((_currentPage - 1) * _pageSize + 1) - @(Math.Min(_currentPage * _pageSize, _totalItems)) arası gösteriliyor</span>
                <div class="flex items-center gap-1">
                    <button @onclick="PrevPage" disabled="@(_currentPage == 1)"
                        class="bg-slate-100 hover:bg-slate-200 disabled:opacity-40 disabled:hover:bg-slate-100 text-slate-700 px-3 py-1.5 rounded font-bold transition-all">
                        Önceki
                    </button>
                    <span class="px-3 font-semibold text-slate-700">Sayfa @_currentPage / @_totalPages</span>
                    <button @onclick="NextPage" disabled="@(_currentPage == _totalPages)"
                        class="bg-slate-100 hover:bg-slate-200 disabled:opacity-40 disabled:hover:bg-slate-100 text-slate-700 px-3 py-1.5 rounded font-bold transition-all">
                        Sonraki
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<AuditLogResponseDto> _logs = new();
    private List<PopularActionDto> _popularActions = new();
    private HashSet<Guid> _expandedLogIds = new();
    private int _totalToday = 0;

    private string _actionFilter = "";
    private string _entityFilter = "";
    private int _currentPage = 1;
    private int _pageSize = 15;
    private int _totalItems = 0;
    private int _totalPages => (int)Math.Ceiling((double)_totalItems / _pageSize);
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnPullToRefresh += HandlePullToRefresh;
        await HandlePullToRefresh();
    }

    private async Task HandlePullToRefresh()
    {
        await LoadStats();
        await LoadLogs();
    }

    public void Dispose()
    {
        AppState.OnPullToRefresh -= HandlePullToRefresh;
    }

    private async Task LoadStats()
    {
        try
        {
            var stats = await Http.GetFromJsonAsync<AuditStatsDto>("api/audit-logs/stats");
            if (stats != null)
            {
                _totalToday = stats.TotalToday;
                _popularActions = stats.PopularActions ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"İstatistik yüklenirken hata: {ex.Message}");
        }
    }

    private async Task LoadLogs()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var url = $"api/audit-logs?page={_currentPage}&pageSize={_pageSize}&actionType={Uri.EscapeDataString(_actionFilter)}&entityType={Uri.EscapeDataString(_entityFilter)}";
            var result = await Http.GetFromJsonAsync<PagedLogsDto>(url);
            if (result != null)
            {
                _logs = result.Items ?? new();
                _totalItems = result.TotalItems;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kayıtlar yüklenemedi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilterChanged()
    {
        _currentPage = 1;
        _expandedLogIds.Clear();
        await LoadLogs();
    }

    private async Task ResetFilters()
    {
        _actionFilter = "";
        _entityFilter = "";
        _currentPage = 1;
        _expandedLogIds.Clear();
        await LoadLogs();
    }

    private void ToggleExpand(Guid id)
    {
        if (_expandedLogIds.Contains(id))
        {
            _expandedLogIds.Remove(id);
        }
        else
        {
            _expandedLogIds.Add(id);
        }
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadLogs();
        }
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            await LoadLogs();
        }
    }

    private string GetActionBadgeClass(string action)
    {
        if (action.Contains("Created") || action.Contains("Deployed") || action.Contains("Added"))
        {
            return "bg-emerald-50 text-emerald-600 border border-emerald-200 text-[10px] px-2 py-0.5 rounded-full font-bold";
        }
        if (action.Contains("Deleted") || action.Contains("Stopped") || action.Contains("Removed"))
        {
            return "bg-rose-50 text-rose-600 border border-rose-200 text-[10px] px-2 py-0.5 rounded-full font-bold";
        }
        if (action.Contains("Login"))
        {
            return "bg-indigo-50 text-indigo-600 border border-indigo-200 text-[10px] px-2 py-0.5 rounded-full font-bold";
        }
        return "bg-slate-100 text-slate-600 border border-slate-200 text-[10px] px-2 py-0.5 rounded-full font-bold";
    }

    private string TruncateUa(string ua)
    {
        if (string.IsNullOrEmpty(ua)) return "Bilinmeyen Cihaz";
        if (ua.Contains("Android")) return "Android Mobil";
        if (ua.Contains("iPhone") || ua.Contains("iPad")) return "iOS Mobil";
        if (ua.Contains("Windows")) return "Windows PC";
        if (ua.Contains("Linux")) return "Linux PC";
        if (ua.Contains("Macintosh")) return "macOS PC";
        return ua.Length > 20 ? ua.Substring(0, 17) + "..." : ua;
    }

    private string FormatJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "{}";
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    // DTO Classes
    private class PagedLogsDto
    {
        public int TotalItems { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public List<AuditLogResponseDto>? Items { get; set; }
    }

    private class AuditLogResponseDto
    {
        public Guid Id { get; set; }
        public Guid UserId { get; set; }
        public string Username { get; set; } = string.Empty;
        public string Action { get; set; } = string.Empty;
        public string TargetEntity { get; set; } = string.Empty;
        public Guid? TargetId { get; set; }
        public string Details { get; set; } = string.Empty;
        public string IpAddress { get; set; } = string.Empty;
        public string UserAgent { get; set; } = string.Empty;
        public DateTimeOffset Timestamp { get; set; }
    }

    private class AuditStatsDto
    {
        public int TotalToday { get; set; }
        public List<PopularActionDto>? PopularActions { get; set; }
    }

    private class PopularActionDto
    {
        public string Action { get; set; } = string.Empty;
        public int Count { get; set; }
    }
}
