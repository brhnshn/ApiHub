@page "/backups"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject DockerPanel.Client.Security.IAuthTokenStore TokenStore
@inject PlatformInfo PlatformInfo
@using DockerPanel.Domain.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable



<PageTitle>Yedekleme Yönetimi - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex justify-between items-center flex-wrap gap-4">
        <div>
            <div class="eyebrow">Sistem & Güvenlik</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">Yedekleme & Geri Yükleme</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">Sistemin tüm veritabanını, projelerini ve Nginx ayarlarını yedekleyin veya eski bir yedekten geri yükleyin.</p>
        </div>
        <div class="flex items-center gap-2">
            <button @onclick="OpenRecoveryGuide" type="button" class="btn-secondary text-xs py-2 px-3.5 flex items-center gap-1.5">
                <i class="fa-solid fa-book-medical text-[var(--azure)]"></i>
                <span>Kurtarma Rehberi</span>
            </button>
            <button @onclick="TriggerManualBackup" disabled="@_isProcessing" class="btn-primary text-xs py-2 px-3.5 flex items-center gap-1.5">
                @if (_isProcessing)
                {
                    <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                    <span>Yedekleme Başlatılıyor...</span>
                }
                else
                {
                    <i class="fa-solid fa-cloud-arrow-up text-xs"></i>
                    <span>Şimdi Manuel Yedekle</span>
                }
            </button>
        </div>
    </div>

    <!-- Yedek Listesi -->
    <div class="card space-y-4">
        <div class="border-b border-[var(--line)] pb-3">
            <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Alınan Sistem Yedekleri</h3>
            <p class="text-xs text-[var(--ink-soft)] mt-0.5">Yerel ve uzak depolama arşivleri</p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-[var(--line)] text-[var(--ink-soft)] font-semibold">
                        <th class="pb-3 font-semibold">Tarih / Saat</th>
                        <th class="pb-3 font-semibold">Toplam Boyut</th>
                        <th class="pb-3 font-semibold">Veritabanı</th>
                        <th class="pb-3 font-semibold">Projeler</th>
                        <th class="pb-3 font-semibold">Nginx Yapılandırmaları</th>
                        <th class="pb-3 font-semibold">E-Posta / Mail</th>
                        <th class="pb-3 font-semibold text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--line)] text-[var(--ink)]">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-[var(--ink-soft)]">
                                <span class="w-5 h-5 border-2 border-[var(--azure)] border-t-transparent rounded-full animate-spin inline-block align-middle mr-2"></span>
                                Yedek listesi yükleniyor...
                            </td>
                        </tr>
                    }
                    else if (!_backups.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-6 text-center text-[var(--ink-soft)]">Kayıtlı yedekleme dosyası bulunmamaktadır.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var bk in _backups.OrderByDescending(b => b.Timestamp))
                        {
                            <tr class="hover:bg-[var(--cream)] transition-colors">
                                <td class="py-3 font-semibold text-[var(--navy)] flex items-center gap-2">
                                    @if (bk.Status.Equals("success", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="w-2 h-2 rounded-full bg-[var(--moss)]" title="Başarılı"></span>
                                    }
                                    else if (bk.Status.Equals("processing", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="w-2 h-2 rounded-full bg-[var(--amber)] animate-pulse" title="Yedekleme Devam Ediyor..."></span>
                                    }
                                    else
                                    {
                                        <span class="w-2 h-2 rounded-full bg-[var(--rose)]" title="Başarısız/Hatalı"></span>
                                    }
                                    @bk.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm:ss")
                                </td>
                                <td class="py-3 font-bold font-mono text-[var(--azure)]">@bk.TotalSize</td>
                                <td class="py-3 text-[var(--ink-soft)] font-mono">@bk.DatabaseSize</td>
                                <td class="py-3 text-[var(--ink-soft)] font-mono">@bk.ProjectsSize</td>
                                <td class="py-3 text-[var(--ink-soft)] font-mono">@bk.NginxSize</td>
                                <td class="py-3 text-[var(--ink-soft)] font-mono">@bk.MailSize</td>
                                <td class="py-3 text-right">
                                    @if (bk.Status.Equals("success", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="flex items-center justify-end gap-2">
                                            <!-- İndir Dropdown -->
                                            <MudMenu Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Label="İndir" Class="text-xs">
                                                <MudMenuItem OnClick="@(() => DownloadFile(bk.FolderName, "database"))">Veritabanı (.sql.gz)</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => DownloadFile(bk.FolderName, "projects"))">Proje Dosyaları (.tar.gz)</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => DownloadFile(bk.FolderName, "nginx"))">Nginx Konfigürasyonları (.tar.gz)</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => DownloadFile(bk.FolderName, "mail"))">E-Posta Dosyaları (.tar.gz)</MudMenuItem>
                                            </MudMenu>

                                            <span class="text-[var(--line)]">|</span>

                                            <!-- Geri Yükle Dropdown -->
                                            <MudMenu Icon="@Icons.Material.Filled.SettingsBackupRestore" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Label="Geri Yükle">
                                                <MudMenuItem OnClick="@(() => ConfirmRestore(bk.FolderName, "database"))" Class="text-amber-600 font-bold">Veritabanını Geri Yükle</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => ConfirmRestore(bk.FolderName, "projects"))" Class="text-amber-600 font-bold">Projeleri Geri Yükle</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => ConfirmRestore(bk.FolderName, "nginx"))" Class="text-amber-600 font-bold">Nginx Ayarlarını Geri Yükle</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => ConfirmRestore(bk.FolderName, "mail"))" Class="text-amber-600 font-bold">E-Postaları Geri Yükle</MudMenuItem>
                                            </MudMenu>

                                            <span class="text-[var(--line)]">|</span>

                                            <!-- Sil -->
                                            <button @onclick="@(() => ConfirmDelete(bk.FolderName))" class="text-[var(--rose)] hover:underline font-bold text-xs p-1" title="Yedeği Sunucudan Kalıcı Olarak Sil">
                                                <i class="fa-solid fa-trash-can"></i> Sil
                                            </button>
                                        </div>
                                    }
                                    else if (bk.Status.Equals("processing", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="flex items-center justify-end gap-1.5 text-[var(--amber)] font-bold text-[10px] uppercase tracking-wider">
                                            <span class="w-3.5 h-3.5 border-2 border-[var(--amber)] border-t-transparent rounded-full animate-spin inline-block align-middle"></span>
                                            <span>Yedekleniyor...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center justify-between gap-4 w-full">
                                            <span class="text-[var(--rose)] font-bold text-[10px] uppercase tracking-wider text-left block break-words max-w-[500px]" style="white-space: normal;" title="@bk.ErrorMessage">HATA: @bk.ErrorMessage</span>
                                            <div class="flex items-center gap-1.5 shrink-0">
                                                <span class="text-[var(--line)]">|</span>
                                                <button @onclick="@(() => ConfirmDelete(bk.FolderName))" class="text-[var(--rose)] hover:underline font-bold text-xs p-1">
                                                    <i class="fa-solid fa-trash-can"></i> Sil/Temizle
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
 
    <!-- Otomatik Yedek Bilgi Kartı -->
    <div class="card space-y-3">
        <h3 class="text-sm font-serif font-bold text-[var(--navy)] flex items-center gap-2">
            <i class="fa-solid fa-clock-rotate-left text-[var(--azure)]"></i> Otomatik Yedekleme Politikası
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs pt-1">
            <div class="space-y-1">
                <span class="block uppercase font-bold text-[10px] text-[var(--ink-soft)] tracking-wider">Periyot</span>
                <span class="font-medium text-[var(--navy)]">Her Gece 03:00'te otomatik yedek alınır.</span>
            </div>
            <div class="space-y-1">
                <span class="block uppercase font-bold text-[10px] text-[var(--ink-soft)] tracking-wider">Saklama Kuralı</span>
                <span class="font-medium text-[var(--navy)]">Son 7 günün yedekleri saklanır, eskiler otomatik temizlenir.</span>
            </div>
            <div class="space-y-1">
                <span class="block uppercase font-bold text-[10px] text-[var(--ink-soft)] tracking-wider">Yedekleme Dizini</span>
                <span class="font-mono font-medium text-[var(--navy)]">/opt/dockerpanel/backups/</span>
            </div>
        </div>
    </div>

    <!-- Uzak VDS SSH Yedekleme Ayarları -->
    <div class="card space-y-4">
        <!-- Başlık (Tıklanabilir Accordion Header) -->
        <div class="flex justify-between items-center cursor-pointer select-none border-b border-[var(--line)] pb-3"
             @onclick="() => _sshSettingsExpanded = !_sshSettingsExpanded">
            <h3 class="text-sm font-serif font-bold text-[var(--navy)] flex items-center gap-2 m-0">
                <i class="fa-solid fa-server text-[var(--azure)]"></i> Uzak VDS SSH Eşitleme Ayarları
                @if (_settings.Enabled)
                {
                    <span class="pill pill-moss text-[10px] ml-1">AKTİF</span>
                }
                else
                {
                    <span class="pill text-[10px] bg-[var(--cream)] text-[var(--ink-soft)] ml-1">PASİF</span>
                }
            </h3>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5" @onclick:stopPropagation="true">
                    <span class="text-xs font-bold text-[var(--ink-soft)]">Otomatik Aktarım:</span>
                    <MudSwitch T="bool" @bind-Value="_settings.Enabled" Color="Color.Success" />
                </div>
                <i class="fa-solid @(_sshSettingsExpanded ? "fa-chevron-up" : "fa-chevron-down") text-[var(--ink-soft)] text-xs transition-transform"></i>
            </div>
        </div>

        @if (_sshSettingsExpanded)
        {
        <div class="w-full max-w-full overflow-hidden">
        <EditForm Model="@_settings" OnValidSubmit="SaveRemoteSettings">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs">
                <div>
                    <label class="block font-bold text-[10px] uppercase tracking-wider mb-1 text-[var(--ink-soft)]">Sunucu IP (Host)</label>
                    <MudTextField @bind-Value="_settings.Host" Placeholder="örn: 192.168.1.50" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <div>
                    <label class="block font-bold text-[10px] uppercase tracking-wider mb-1 text-[var(--ink-soft)]">SSH Port</label>
                    <MudTextField @bind-Value="_settings.Port" Placeholder="22" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <div>
                    <label class="block font-bold text-[10px] uppercase tracking-wider mb-1 text-[var(--ink-soft)]">Kullanıcı (User)</label>
                    <MudTextField @bind-Value="_settings.User" Placeholder="root" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <div>
                    <label class="block font-bold text-[10px] uppercase tracking-wider mb-1 text-[var(--ink-soft)]">Hedef Klasör Yolu</label>
                    <MudTextField @bind-Value="_settings.RemotePath" Placeholder="/opt/dockerpanel/backups/" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
            </div>

            <!-- Kimlik Doğrulama Tipi Seçimi -->
            <div class="mt-5 space-y-2">
                <label class="block font-bold text-[10px] uppercase tracking-wider text-[var(--ink-soft)]">Kimlik Doğrulama Yöntemi</label>
                <div class="flex items-center gap-2 bg-[var(--cream)] p-1 rounded-xl border border-[var(--line)] w-fit">
                    <button type="button" @onclick='() => SetAuthType("key")' 
                        class='@( _settings.AuthType == "key" ? "btn-primary" : "btn-ghost" ) text-xs py-1.5 px-3'>
                        <i class="fa-solid fa-key mr-1"></i> SSH Anahtarı
                    </button>
                    <button type="button" @onclick='() => SetAuthType("password")' 
                        class='@( _settings.AuthType == "password" ? "btn-primary" : "btn-ghost" ) text-xs py-1.5 px-3'>
                        <i class="fa-solid fa-lock mr-1"></i> Şifre ile Bağlan
                    </button>
                </div>
            </div>

            @if (_settings.AuthType == "password")
            {
                <div class="mt-4 max-w-md">
                    <label class="block font-bold text-[10px] uppercase tracking-wider mb-1 text-[var(--ink-soft)]">SSH Şifresi (Password)</label>
                    <MudTextField @bind-Value="_settings.Password" InputType="@_passwordInput" Adornment="Adornment.End" 
                        AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="TogglePasswordVisibility" 
                        Placeholder="Uzak sunucunun root/kullanıcı şifresi" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <p class="text-[10px] text-[var(--ink-soft)] mt-1">Not: Şifre yönteminin çalışabilmesi için panel sunucusunda <code>sshpass</code> paketinin kurulu olması gerekir.</p>
                </div>
            }
            else
            {
                <div class="mt-4 space-y-4">
                    <!-- SSH Anahtar Kaynağı Seçici -->
                    <div class="flex items-center gap-2 bg-[var(--cream)] p-1 rounded-xl border border-[var(--line)] w-fit">
                        <span class="text-[10px] font-bold text-[var(--ink-soft)] uppercase tracking-wider ml-2">Anahtar:</span>
                        <button type="button" @onclick="() => SetUseCustomKey(false)" 
                            class='@( !_useCustomKey ? "btn-primary" : "btn-ghost" ) text-[11px] py-1 px-3'>
                            Panelin Otomatik Anahtarı
                        </button>
                        <button type="button" @onclick="() => SetUseCustomKey(true)" 
                            class='@( _useCustomKey ? "btn-primary" : "btn-ghost" ) text-[11px] py-1 px-3'>
                            Özel Private Key Yapıştır
                        </button>
                    </div>

                    @if (_useCustomKey)
                    {
                        <div class="space-y-1">
                            <label class="block font-bold text-[10px] uppercase tracking-wider text-[var(--ink-soft)]">Özel SSH Private Key (PEM veya OpenSSH Formatında)</label>
                            <MudTextField @bind-Value="_settings.KeyContent" Lines="6" 
                                Placeholder="-----BEGIN OPENSSH PRIVATE KEY-----&#10;...&#10;-----END OPENSSH PRIVATE KEY-----" 
                                Variant="Variant.Outlined" Class="font-mono text-[11px] bg-[var(--cream)]" />
                            <p class="text-[10px] text-[var(--ink-soft)] mt-1">Yapıştırdığınız özel anahtar sunucuda güvenli bir şekilde saklanacak ve otomatik olarak dosya izinleri ayarlanacaktır.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Otomatik Anahtar Durumu ve Public Key Box -->
                        <div class="p-4 rounded-xl border border-[var(--line)] bg-[var(--cream)] space-y-3">
                            <div class="flex justify-between items-center flex-wrap gap-2">
                                <span class="text-xs font-bold text-[var(--navy)] flex items-center gap-1.5">
                                    <i class="fa-solid fa-circle-info text-[var(--azure)]"></i> Panelin SSH Genel Anahtarı (Public Key)
                                </span>
                                <button type="button" @onclick="CopyPublicKeyToClipboard" class="btn-secondary text-[11px] py-1.5 px-3">
                                    <i class="fa-regular fa-copy mr-1"></i> Genel Anahtarı Kopyala
                                </button>
                            </div>
                            <p class="text-[11px] text-[var(--ink-soft)] leading-relaxed m-0">
                                Bu sunucunun otomatik oluşturulan genel anahtarını kopyalayın ve aşağıdaki rehberi izleyerek karşı sunucuya tanımlayın. Böylece yedekler şifresiz ve güvenli aktarılır.
                            </p>
                            <div class="bg-[#1C2630] text-[#8FD6B4] font-mono text-[10px] p-2.5 rounded-lg border border-[var(--navy)] select-all break-all max-h-24 overflow-y-auto w-full max-w-full" style="word-break: break-all; white-space: pre-wrap;">
                                @_publicKey
                            </div>

                            <!-- Adım Adım Entegrasyon Rehberi -->
                            <div class="mt-2 bg-[var(--paper)] border border-[var(--line)] p-3.5 rounded-xl space-y-2 text-[var(--navy)]">
                                <span class="font-bold text-[10px] uppercase tracking-wider text-[var(--navy)] flex items-center gap-1">
                                    <i class="fa-solid fa-graduation-cap text-[var(--azure)]"></i> Hedef Sunucuya Anahtar Ekleme Rehberi
                                </span>
                                <ol class="list-decimal list-inside space-y-1.5 text-[11px] text-[var(--ink-soft)] leading-normal pl-1">
                                    <li>Yukarıdaki <strong>"Genel Anahtarı Kopyala"</strong> butonuna tıklayarak anahtarı panoya kopyalayın.</li>
                                    <li><strong>Hedef (Yedek) VDS sunucunuza</strong> terminalden (SSH ile) bağlanın.</li>
                                    <li>Aşağıdaki komutu hedef sunucuda çalıştırarak kopyaladığınız anahtarı yetkilendirilen anahtarlar listesine ekleyin:
                                        <div class="bg-[#1C2630] text-[#8FD6B4] font-mono text-[10px] p-2 rounded my-1 select-all break-all leading-normal w-full max-w-full" style="word-break: break-all; white-space: pre-wrap;">
                                            echo "KOPYALANAN_ANAHTAR" >> ~/.ssh/authorized_keys
                                        </div>
                                    </li>
                                    <li>Klasör izinlerini ayarlayın:
                                        <div class="bg-[#1C2630] text-[#8FD6B4] font-mono text-[10px] p-2 rounded my-1 select-all leading-normal">
                                            chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys
                                        </div>
                                    </li>
                                </ol>
                            </div>
                        </div>

                        <div class="max-w-md">
                            <label class="block font-bold text-[10px] uppercase tracking-wider mb-1 text-[var(--ink-soft)]">SSH Anahtar Dosya Yolu</label>
                            <MudTextField @bind-Value="_settings.KeyPath" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="font-mono text-xs bg-[var(--cream)]" />
                        </div>
                    }
                </div>
            }

            <!-- Alt Butonlar -->
            <div class="flex justify-between items-center mt-6 pt-4 border-t border-[var(--line)] flex-wrap gap-3">
                <button type="button" @onclick="TestSshConnection" disabled="@_isTestingConnection" class="btn-secondary text-xs py-2 px-4 flex items-center gap-1.5">
                    @if (_isTestingConnection)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
                        <span>Bağlantı Test Ediliyor...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-check text-xs"></i>
                        <span>Bağlantıyı Test Et</span>
                    }
                </button>
                <button type="submit" disabled="@_isSavingSettings" class="btn-primary text-xs py-2 px-4 flex items-center gap-1.5">
                    @if (_isSavingSettings)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-floppy-disk text-xs"></i>
                        <span>Bağlantı Bilgilerini Kaydet</span>
                    }
                </button>
            </div>
        </EditForm>
        </div>
        }
    </div>
</div>

<!-- ONAY MODALLARI -->
@if (_restoreDialogVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                <h3 class="text-base font-serif font-bold text-[var(--rose)] flex items-center gap-2">
                    <i class="fa-solid fa-triangle-exclamation"></i> Geri Yükleme Onayı
                </h3>
            </div>
            
            <div class="space-y-3 text-xs">
                <p class="font-bold text-[var(--navy)]">Seçilen yedeği geri yüklemek üzeresiniz:</p>
                <div class="bg-[var(--cream)] p-3 rounded-lg border border-[var(--line)] font-mono text-xs text-[var(--ink)]">
                    <div><span class="font-bold text-[var(--ink-soft)]">YEDEK:</span> @_targetFolder</div>
                    <div><span class="font-bold text-[var(--ink-soft)]">TİP:</span> <span class="uppercase font-bold text-[var(--azure)]">@_targetType</span></div>
                </div>
                <p class="text-[var(--rose)] font-semibold leading-relaxed">
                    <i class="fa-solid fa-circle-exclamation mr-1"></i> UYARI: Bu işlem geri döndürülemez! Seçilen geri yükleme tipi kapsamındaki tüm güncel verileriniz silinecek ve bu yedekle değiştirilecektir!
                </p>
            </div>

            <div class="flex justify-end gap-2 pt-4 border-t border-[var(--line)]">
                <button type="button" @onclick="CloseRestoreDialog" class="btn-secondary py-2 px-4 text-xs">İptal</button>
                <button type="button" @onclick="ExecuteRestore" disabled="@_isRestoring" class="btn-danger py-2 px-4 text-xs flex items-center gap-1.5">
                    @if (_isRestoring)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Geri Yükleniyor...</span>
                    }
                    else
                    {
                        <span>Evet, Geri Yükle</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- KURTARMA REHBERİ MODALI -->
@if (_recoveryGuideVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-4xl max-h-[85vh] flex flex-col overflow-hidden p-0">
            <!-- Modal Başlık -->
            <div class="flex items-center justify-between border-b border-[var(--line)] px-6 py-4 bg-[var(--cream)]">
                <h3 class="text-base font-serif font-bold text-[var(--navy)] flex items-center gap-2 m-0">
                    <i class="fa-solid fa-book-medical text-[var(--azure)] text-base"></i> VDS Taşıma & Hızlı Kurtarma Kılavuzu
                </h3>
                <button type="button" @onclick="CloseRecoveryGuide" class="btn-ghost p-1 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal İçerik (Scrollable) -->
