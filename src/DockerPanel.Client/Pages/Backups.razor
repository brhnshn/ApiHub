            <!-- Alt Buton -->
            <div class="border-t border-[var(--line)] px-6 py-3 bg-[var(--cream)] flex justify-end">
                <button type="button" @onclick="CloseRecoveryGuide" class="btn-primary text-xs py-2 px-4">
                    Kılavuzu Kapat
                </button>
            </div>
        </div>
    </div>
}


@code {
    private List<BackupInfoDto> _backups = new();
    private bool _isLoading = false;
