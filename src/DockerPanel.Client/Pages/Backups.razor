    // Restore Dialog
    private bool _restoreDialogVisible = false;
    private bool _isRestoring = false;
    private string _targetFolder = "";
    private string _targetType = "";

    // Uzak VDS SSH Eşitleme Ayarları
    private RemoteBackupSettingsDto _settings = new();
    private bool _isSavingSettings = false;
    private bool _sshSettingsExpanded = false;
    private string _publicKey = "Yükleniyor...";
    private bool _useCustomKey = false;
