                <!-- Script Başlığı ve Terminal Gösterici -->
                <div class="space-y-2">
                    <div class="flex justify-between items-center">
                        <h4 class="font-serif font-bold text-xs text-[var(--navy)] flex items-center gap-1.5 m-0">
                            <i class="fa-solid fa-code text-[var(--azure)]"></i> Tek Tıkla Kurtarma Scripti (<code>restore-all.sh</code>)
