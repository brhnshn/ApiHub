    // Kurtarma Kılavuzu
    private bool _recoveryGuideVisible = false;

    private const string _restoreScriptText = @"#!/bin/bash
# ==============================================================================
# DockerPanel - Tek Tıkla VDS Taşıma & Tam Kurtarma Scripti
# ==============================================================================
set -e

# --- ÖZELLEŞTİRİLEBİLİR AYARLAR ---
MAIL_HOSTNAME=""mail.burhansahin.com.tr""
MAIL_DOMAIN=""burhansahin.com.tr""
DB_USER=""dp_admin""
DB_PASSWORD=""dp_admin_password""
DB_NAME=""dockerpanel_db""
# ----------------------------------

# Renkli Çıktılar
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

# Kullanıcı Girişi & Yedek Klasörü Kontrolü
BACKUP_FOLDER=$1
if [ -z ""$BACKUP_FOLDER"" ]; then
    echo -e ""${RED}Hata: Lütfen yedek klasörünün yolunu belirtin!${NC}""
    echo ""Kullanım: sudo ./restore-all.sh /yol/to/backup_YYYY-MM-DD_HH-mm-ss""
    exit 1
fi

if [ ! -d ""$BACKUP_FOLDER"" ]; then
    echo -e ""${RED}Hata: Belirtilen yedek klasörü bulunamadı: $BACKUP_FOLDER${NC}""
    exit 1
fi

echo -e ""${BLUE}[1/6] Bağımlılıklar Kuruluyor (Docker, Nginx, Tar, Gzip, Certbot)...${NC}""
sudo apt update
sudo apt install -y docker.io docker-compose nginx tar gzip pg-client-common python3-certbot-dns-cloudflare

# Docker Panel Dizin Yapısı Kuruluyor
sudo mkdir -p /opt/dockerpanel/projects
sudo mkdir -p /opt/dockerpanel/backups
sudo mkdir -p /opt/dockerpanel/mail
sudo mkdir -p /var/log/project-manager

# Segmentasyon için Global Docker Ağı Oluşturuluyor
echo -e ""${BLUE}-> Global Docker ağ köprüsü kuruluyor...${NC}""
sudo docker network create dockerpanel-global-net || true

echo -e ""${BLUE}[2/6] Dosya Arşivleri Çıkarılıyor...${NC}""

# Proje Dosyaları Geri Yükleniyor
if [ -f ""$BACKUP_FOLDER/projects.tar.gz"" ]; then
    echo ""-> Müşteri projeleri geri yükleniyor...""
    sudo rm -rf /opt/dockerpanel/projects/*
    sudo tar -xzf ""$BACKUP_FOLDER/projects.tar.gz"" -C /opt/dockerpanel/projects/
fi

# Nginx Konfigürasyonları Geri Yükleniyor
if [ -f ""$BACKUP_FOLDER/nginx.tar.gz"" ]; then
    echo ""-> Nginx yönlendirme ayarları geri yükleniyor...""
    sudo rm -rf /etc/nginx/sites-available/*
    sudo tar -xzf ""$BACKUP_FOLDER/nginx.tar.gz"" -C /etc/nginx/sites-available/
fi

# Mail Sunucusu Verileri Geri Yükleniyor
if [ -f ""$BACKUP_FOLDER/mail.tar.gz"" ]; then
    echo ""-> E-posta sunucu verileri ve kutuları geri yükleniyor...""
    sudo rm -rf /opt/dockerpanel/mail/*
    sudo tar -xzf ""$BACKUP_FOLDER/mail.tar.gz"" -C /opt/dockerpanel/mail/
fi

echo -e ""${BLUE}[3/6] Docker Altyapısı Başlatılıyor...${NC}""
# docker-compose.yml dosyasını oluştur veya kopyala
cat << EOF > /opt/dockerpanel/docker-compose.yml
version: '3.9'
services:
  db:
    image: postgres:16-alpine
    container_name: dockerpanel-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: \${DB_USER}
      POSTGRES_PASSWORD: \${DB_PASSWORD}
      POSTGRES_DB: \${DB_NAME}
    volumes:
      - pgdata:/var/lib/postgresql/data
    ports:
      - ""5432:5432""
    networks:
      - dockerpanel-net

  mailserver:
    image: mailserver/docker-mailserver:latest
    container_name: dockerpanel-mailserver
    hostname: \${MAIL_HOSTNAME}
    domainname: \${MAIL_DOMAIN}
    ports:
      - ""25:25""
      - ""143:143""
      - ""587:587""
      - ""993:993""
    volumes:
      - /opt/dockerpanel/mail/data:/var/mail
      - /opt/dockerpanel/mail/state:/var/mail-state
      - /opt/dockerpanel/mail/config:/tmp/docker-mailserver
    restart: always
    environment:
      - ENABLE_SPAMASSASSIN=1
      - ENABLE_CLAMAV=0
      - ENABLE_FAIL2BAN=1
      - ONE_DIR=1
    networks:
      - dockerpanel-net

networks:
  dockerpanel-net:
    name: dockerpanel-global-net
    external: true

volumes:
  pgdata:
    driver: local
EOF

cd /opt/dockerpanel
sudo docker-compose down || true
sudo docker-compose up -d

echo -e ""${BLUE}[4/6] Veritabanı Yedeği SQL Dump Olarak Geri Yükleniyor...${NC}""
# Veritabanının hazır olmasını bekle (max 15 sn)
echo ""PostgreSQL servisinin hazır olması bekleniyor...""
sleep 10

if [ -f ""$BACKUP_FOLDER/database.sql.gz"" ]; then
    # SQL dump basılıyor
    gunzip -c ""$BACKUP_FOLDER/database.sql.gz"" | sudo docker exec -i dockerpanel-db psql -U \${DB_USER} -d \${DB_NAME}
    echo -e ""${GREEN}Veritabanı başarıyla restore edildi.${NC}""
else
    echo -e ""${RED}Uyarı: database.sql.gz bulunamadı!${NC}""
fi

echo -e ""${BLUE}[5/6] Nginx Gateway Symlink'leri ve SSL Kontrolleri Yapılıyor...${NC}""
sudo rm -rf /etc/nginx/sites-enabled/*
for conf in /etc/nginx/sites-available/*.conf; do
    if [ -f ""$conf"" ]; then
        sudo ln -sf ""$conf"" ""/etc/nginx/sites-enabled/\$(basename ""\$conf"")""
    fi
done

# Nginx Test & Restart
sudo nginx -t
sudo systemctl restart nginx

echo -e ""${BLUE}[6/6] Sahiplik İzinleri & API Servisi Yapılandırılıyor...${NC}""
if id ""dockerpanel_api"" &>/dev/null; then
    sudo chown -R dockerpanel_api:dockerpanel_api /opt/dockerpanel
    sudo chown -R dockerpanel_api:dockerpanel_api /var/log/project-manager
    sudo chmod 755 /var/log/project-manager
    echo ""-> Dosya sahiplik izinleri başarıyla aktarıldı.""
else
    echo ""-> Uyarı: dockerpanel_api kullanıcısı bulunamadı.""
fi

sudo systemctl restart dockerpanel-api || true

echo -e ""${GREEN}==============================================================================${NC}""
echo -e ""${GREEN}Tebrikler! DockerPanel Taşıma ve Kurtarma İşlemi Başarıyla Tamamlandı.${NC}""
echo -e ""${GREEN}==============================================================================${NC}""";

    private void OpenRecoveryGuide()
    {
        _recoveryGuideVisible = true;
        StateHasChanged();
    }

    private void CloseRecoveryGuide()
    {
        _recoveryGuideVisible = false;
        StateHasChanged();
    }

    private async Task CopyRestoreScriptToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _restoreScriptText);
            Snackbar.Add("Tek tıkla kurtarma scripti (restore-all.sh) panoya kopyalandı!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kopyalama başarısız: {ex.Message}", Severity.Warning);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBackups();
        await LoadRemoteSettingsAsync();
        await LoadSshPublicKeyAsync();

        // SignalR Hub bağlantısını ve canlı dinleyicileri kur
        try
        {
            var baseUri = Http.BaseAddress?.ToString() ?? NavigationManager.BaseUri;
            var hubUrl = baseUri.TrimEnd('/') + "/hubs/metriclog";

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.Transports =
                        Microsoft.AspNetCore.Http.Connections.HttpTransportType.WebSockets |
                        Microsoft.AspNetCore.Http.Connections.HttpTransportType.LongPolling;
                    options.AccessTokenProvider = async () =>
                        await TokenStore.GetTokenAsync();
                })
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("ReceiveBackupUpdated", () =>
            {
                InvokeAsync(async () =>
                {
                    await LoadBackups();
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR Hub connection error in backups: {ex.Message}");
        }
    }

    private void SetAuthType(string type)
    {
        _settings.AuthType = type;
        StateHasChanged();
    }

    private void SetUseCustomKey(bool use)
    {
        _useCustomKey = use;
        StateHasChanged();
    }

    private void TogglePasswordVisibility()
    {
        if (_showPassword)
        {
            _showPassword = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _showPassword = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
        StateHasChanged();
    }

    private async Task CopyPublicKeyToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _publicKey);
            Snackbar.Add("SSH Genel Anahtarı panoya kopyalandı!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kopyalama başarısız: {ex.Message}", Severity.Warning);
        }
    }

    private async Task LoadSshPublicKeyAsync()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<SshPublicKeyResult>("api/backups/ssh-public-key");
            if (res != null)
            {
                _publicKey = res.PublicKey;
            }
        }
        catch (Exception ex)
        {
            _publicKey = "SSH anahtarı yüklenemedi.";
            Console.WriteLine($"SSH public key loading error: {ex.Message}");
        }
    }

    private async Task TestSshConnection()
    {
        _isTestingConnection = true;
        StateHasChanged();
        try
        {
            if (string.IsNullOrWhiteSpace(_settings.Host))
            {
                Snackbar.Add("Lütfen önce Sunucu IP (Host) adresini girin.", Severity.Warning);
                return;
            }

            if (_settings.AuthType == "key" && _useCustomKey && string.IsNullOrWhiteSpace(_settings.KeyContent))
            {
                Snackbar.Add("Lütfen test etmeden önce özel anahtarınızı yapıştırın.", Severity.Warning);
                return;
            }

            if (_settings.AuthType == "password" && string.IsNullOrWhiteSpace(_settings.Password))
            {
                Snackbar.Add("Lütfen test etmeden önce SSH şifrenizi girin.", Severity.Warning);
                return;
            }

            var response = await Http.PostAsJsonAsync("api/backups/test-ssh", _settings);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<TestSshResult>();
                if (result != null && result.Success)
                {
                    Snackbar.Add(result.Message, Severity.Success);
                }
                else
                {
                    var msg = result?.Message ?? "Bağlantı testi başarısız.";
                    Snackbar.Add(msg, Severity.Error);
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Bağlantı testi sırasında sunucu hatası oluştu: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı testi sırasında hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTestingConnection = false;
            StateHasChanged();
        }
    }

    private async Task LoadRemoteSettingsAsync()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<RemoteBackupSettingsDto>("api/backups/remote-settings");
            if (res != null)
            {
                _settings = res;
                _useCustomKey = !string.IsNullOrWhiteSpace(_settings.KeyContent);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Uzak yedekleme SSH ayarları yüklenemedi: {ex.Message}", Severity.Warning);
        }
    }

    public class SshPublicKeyResult
    {
        public string PublicKey { get; set; } = string.Empty;
    }

    public class TestSshResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    private async Task SaveRemoteSettings()
    {
        _isSavingSettings = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsJsonAsync("api/backups/remote-settings", _settings);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Uzak yedekleme SSH ayarları başarıyla kaydedildi!", Severity.Success);
                _sshSettingsExpanded = false;
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Ayarlar kaydedilemedi: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingSettings = false;
            StateHasChanged();
        }
    }

    private async Task LoadBackups()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<List<BackupInfoDto>>("api/backups");
            _backups = result ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Yedek listesi yüklenemedi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task TriggerManualBackup()
    {
        _isProcessing = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsync("api/backups/trigger", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Yedekleme işlemi arka planda başlatıldı! Kısa bir süre sonra liste güncellenecektir.", Severity.Success);
                // Wait 3 seconds and reload
                _ = Task.Run(async () =>
                {
                    await Task.Delay(3500);
                    await InvokeAsync(async () =>
                    {
                        await LoadBackups();
                    });
                });
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Yedekleme başlatılamadı: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Yedekleme başlatılamadı: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DownloadFile(string folderName, string type)
    {
        try
        {
            var token = await TokenStore.GetTokenAsync() ?? "";
            var downloadUrl = $"{Http.BaseAddress}api/backups/{folderName}/download/{type}?access_token={Uri.EscapeDataString(token)}";
            await JSRuntime.InvokeVoidAsync("open", downloadUrl, "_blank");
            Snackbar.Add("Yedek dosyası indirme başlatıldı.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"İndirme başlatılamadı: {ex.Message}", Severity.Error);
        }
    }

    private void ConfirmRestore(string folderName, string type)
    {
        _targetFolder = folderName;
        _targetType = type;
        _restoreDialogVisible = true;
    }

    private void CloseRestoreDialog()
    {
        _restoreDialogVisible = false;
    }

    private async Task ExecuteRestore()
    {
        _isRestoring = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsync($"api/backups/{_targetFolder}/restore/{_targetType}", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"{_targetType.ToUpper()} başarıyla yedekten geri yüklendi!", Severity.Success);
                CloseRestoreDialog();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Geri yükleme başarısız: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Geri yükleme hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRestoring = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete(string folderName)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Seçilen yedek dosyasını ({folderName}) tamamen silmek istediğinize emin misiniz?");

        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/backups/{folderName}");
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Yedek başarıyla silindi.", Severity.Success);
                    await LoadBackups();
                }
                else
                {
                    var err = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Yedek silinemedi: {err}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Yedek silme hatası: {ex.Message}", Severity.Error);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
