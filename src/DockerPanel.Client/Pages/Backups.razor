                    <div class="bg-[#1C2630] text-[#F4F8FD] font-mono text-[10px] p-4 rounded-xl border border-[var(--navy)] max-h-64 overflow-y-auto leading-relaxed select-all">
                        <pre style="margin:0; font-family: monospace; white-space: pre-wrap; word-break: break-all;">@_restoreScriptText</pre>
