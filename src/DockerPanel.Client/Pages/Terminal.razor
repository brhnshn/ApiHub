@page "/terminal"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject DockerPanel.Client.Security.IAuthTokenStore TokenStore
@implements IAsyncDisposable

<PageTitle>Canlı Terminal & Sistem Logları - ApiHub</PageTitle>



<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="eyebrow">İzleme ve Telemetri</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">Canlı Terminal & Sistem Logları</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">
                Gerçek zamanlı sunucu sistem günlüğü, orkestratör ve proje loglarını canlı izleyin.
            </p>
        </div>
        <button @onclick="ClearTerminal" class="btn-secondary text-xs py-2 px-3.5 flex items-center gap-1.5">
            <i class="fa-solid fa-trash-can text-xs"></i> Temizle
        </button>
    </div>

    <!-- Kontrol Paneli -->
    <div class="card">
        <div class="flex items-center justify-between gap-4 flex-wrap">
            <div class="flex items-center gap-4 flex-1 flex-wrap">
                <div class="min-w-[240px]">
                    <label class="block text-[10px] font-bold text-[var(--ink-soft)] uppercase tracking-wider mb-1">Log Kaynağı</label>
                    <select value="@_selectedSource" @onchange="@(e => OnSourceChanged(e.Value?.ToString() ?? "orchestrator"))"
                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]">
                        <option value="orchestrator">Orkestrasyon Olayları (cpanel-orchestrator)</option>
                        <option value="syslog">Sunucu Sistem Günlüğü (syslog)</option>
                        <option value="nginx-access">Nginx Erişim Logları (access.log)</option>
                        <option value="nginx-error">Nginx Hata Logları (error.log)</option>
                        <option value="project-manager">Süreç Yöneticisi Logları (project-manager.log)</option>
                        <option value="project">Proje / Konteyner Logları (Canlı)</option>
                    </select>
                </div>

                @if (_selectedSource == "project")
                {
                    <div class="min-w-[240px] animate-fade-in">
                        <label class="block text-[10px] font-bold text-[var(--ink-soft)] uppercase tracking-wider mb-1">Hedef Proje</label>
                        <select value="@(_selectedProjectId?.ToString() ?? "")" @onchange="@(e => OnProjectChangedSelect(e.Value?.ToString()))"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]">
                            <option value="">Lütfen bir proje seçin...</option>
                            @foreach (var p in _activeContainers)
                            {
                                <option value="@p.Id">@p.Name (Port: @p.HostPort)</option>
                            }
                        </select>
                    </div>
                }
            </div>

            <div class="flex items-center gap-3">
                @if (IsLiveSource())
                {
                    <span class="pill pill-moss text-xs"><span class="dot"></span>CANLI AKIŞ AKTİF</span>
                }
                else
                {
                    <span class="pill text-xs bg-[var(--cream)] text-[var(--ink-soft)]">STATİK GÖRÜNÜM (GEÇMİŞ)</span>
                }

                <button @onclick="ReloadLogsAsync" disabled="@_isLoading" class="btn-primary text-xs py-2 px-3.5 flex items-center gap-1.5">
                    <i class="fa-solid fa-arrows-rotate text-xs"></i> Yenile
                </button>
            </div>
        </div>
    </div>

    <!-- Terminal Konsolu -->
    <div class="terminal-card flex flex-col" style="min-height: calc(100vh - 320px);">
        <div class="term-top justify-between">
            <div class="flex items-center gap-2">
                <div class="term-dot" style="background:#E0685A;"></div>
                <div class="term-dot" style="background:#E0B15A;"></div>
                <div class="term-dot" style="background:#6FAE72;"></div>
                <span class="ml-2 font-mono text-xs">apihub@server: ~/logs# (@_selectedSource)</span>
            </div>
            <span class="text-[11px] text-[#8FA6BB] font-mono">@_logs.Count satır</span>
        </div>

        <div class="flex-1 p-4 font-mono text-xs leading-relaxed overflow-y-auto max-h-[600px] flex flex-col gap-1 text-[#F4F8FD]">
            @if (_isLoading)
            {
                <div class="text-[#8FA6BB] flex items-center gap-2">
                    <span class="w-3.5 h-3.5 border-2 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></span>
                    <span>Log verileri yükleniyor...</span>
                </div>
            }
            else if (!_logs.Any())
            {
                <div class="text-[#8FA6BB] italic">
                    @if (_selectedSource == "project" && !_selectedProjectId.HasValue)
                    {
                        <span>[!] Lütfen yukarıdaki menüden loglarını izlemek istediğiniz projeyi seçin.</span>
                    }
                    else
                    {
                        <span>[OK] Log kanalı dinleniyor. Akış bekleniyor veya kayıtlı log bulunmamaktadır...</span>
                    }
                </div>
            }
            else
            {
                @foreach (var log in _logs)
                {
                    <div>
                        <span class="text-[#8FA6BB]">[@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")]</span>
                        <span style="color: @GetLogLevelColor(log.Level);" class="font-bold mx-1">[@log.Level.ToUpper()]</span>
                        <span class="text-[#F4F8FD]">@log.Message</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<TerminalLogLine> _logs = new();
    private List<ContainerSelectDto> _activeContainers = new();
    private string _selectedSource = "orchestrator";
    private Guid? _selectedProjectId;
    private bool _isLoading = false;
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        // 1. Aktif Proje Listesini Yükle
        try
        {
            var rawProjects = await Http.GetFromJsonAsync<List<ContainerSelectDto>>("api/projects");
            _activeContainers = rawProjects ?? new List<ContainerSelectDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Proje listesi yüklenirken hata oluştu: {ex.Message}", Severity.Error);
        }

        // 2. SignalR ile Canlı Sistem Loglarına Bağlan
        try
        {
            var baseUri = Http.BaseAddress?.ToString() ?? NavigationManager.BaseUri;
            var hubUrl = baseUri.TrimEnd('/') + "/hubs/metriclog";

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.Transports =
                        Microsoft.AspNetCore.Http.Connections.HttpTransportType.WebSockets |
                        Microsoft.AspNetCore.Http.Connections.HttpTransportType.LongPolling;
                    options.AccessTokenProvider = async () =>
                        await TokenStore.GetTokenAsync();
                })
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<List<SystemLogLineDto>>("ReceiveSystemLogs", (logLines) =>
            {
                InvokeAsync(() =>
                {
                    foreach (var line in logLines)
                    {
                        if (_selectedSource == "syslog" && line.Level == "syslog")
                        {
                            AddLogLine("info", line.Message, line.Timestamp.LocalDateTime);
                        }
                        else if (_selectedSource == "orchestrator" && line.Level != "syslog")
                        {
                            AddLogLine(line.Level, line.Message, line.Timestamp.LocalDateTime);
                        }
                    }
                });
            });

            _hubConnection.On<ProjectLogsDto>("ReceiveProjectLogs", (dto) =>
            {
                if (_selectedSource == "project" && _selectedProjectId.HasValue && dto.ProjectId == _selectedProjectId.Value)
                {
                    InvokeAsync(() =>
                    {
                        foreach (var log in dto.Logs)
                        {
                            AddLogLine("info", log);
                        }
                    });
                }
            });

            await _hubConnection.StartAsync();
            AddLogLine("info", "Orkestrasyon SignalR gerçek zamanlı log kanalı başarıyla bağlandı.");
        }
        catch (Exception ex)
        {
            AddLogLine("warning", $"Canlı SignalR log kanalına bağlanılamadı: {ex.Message}. Yeniden bağlanmayı bekliyor...");
        }

        _isLoading = false;
        await LoadInitialLogsAsync();
    }

    private async Task OnSourceChanged(string source)
    {
        if (_selectedSource == "project" && _selectedProjectId.HasValue && _hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                await _hubConnection.SendAsync("LeaveProjectGroup", _selectedProjectId.Value.ToString());
            }
            catch { }
        }

        _selectedSource = source;
        _logs.Clear();
        _selectedProjectId = null;

        if (source != "project")
        {
            await LoadInitialLogsAsync();
        }
        else
        {
            AddLogLine("info", "Lütfen yukarıdaki menüden loglarını izlemek istediğiniz projeyi seçin.");
        }
    }

    private async Task OnProjectChangedSelect(string? val)
    {
        Guid? parsed = null;
        if (!string.IsNullOrEmpty(val) && Guid.TryParse(val, out var g))
        {
            parsed = g;
        }
        await OnProjectChanged(parsed);
    }

    private async Task OnProjectChanged(Guid? projectId)
    {
        if (_selectedProjectId.HasValue && _hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                await _hubConnection.SendAsync("LeaveProjectGroup", _selectedProjectId.Value.ToString());
            }
            catch { }
        }

        _selectedProjectId = projectId;
        _logs.Clear();

        if (_selectedProjectId.HasValue)
        {
            _isLoading = true;
            StateHasChanged();
            try
            {
                if (_hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
                {
                    await _hubConnection.SendAsync("JoinProjectGroup", _selectedProjectId.Value.ToString());
                }

                var initialLogs = await Http.GetFromJsonAsync<List<string>>($"api/projects/{_selectedProjectId.Value}/logs?tail=100");
                if (initialLogs != null && initialLogs.Any())
                {
                    foreach (var log in initialLogs)
                    {
                        AddLogLine("info", log);
                    }
                }
                else
                {
                    AddLogLine("info", "Projede henüz kayıtlı log bulunmamaktadır.");
                }
            }
            catch (Exception ex)
            {
                AddLogLine("warning", $"Proje logları yüklenirken hata oluştu: {ex.Message}");
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadInitialLogsAsync()
    {
        if (_selectedSource == "project") return;

        _isLoading = true;
        _logs.Clear();
        StateHasChanged();

        try
        {
            if (_selectedSource == "orchestrator")
            {
                AddLogLine("info", "Orkestrasyon canlı log kanalı dinleniyor. Akış bekleniyor...");
            }
            else
            {
                var lines = await Http.GetFromJsonAsync<string[]>($"api/system/logs?source={_selectedSource}&tail=100");
                if (lines != null)
                {
                    foreach (var line in lines)
                    {
                        AddLogLine("info", line);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            AddLogLine("warning", $"Loglar yüklenirken hata oluştu: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReloadLogsAsync()
    {
        if (_selectedSource == "project")
        {
            await OnProjectChanged(_selectedProjectId);
        }
        else
        {
            await LoadInitialLogsAsync();
        }
    }

    private bool IsLiveSource()
    {
        return _selectedSource == "orchestrator" || _selectedSource == "syslog" || (_selectedSource == "project" && _selectedProjectId.HasValue);
    }

    private void AddLogLine(string level, string message, DateTime? timestamp = null)
    {
        _logs.Add(new TerminalLogLine
        {
            Timestamp = timestamp ?? DateTime.Now,
            Level = level,
            Message = message
        });

        if (_logs.Count > 300)
        {
            _logs.RemoveAt(0);
        }
        StateHasChanged();
    }

    private string GetLogLevelColor(string level)
    {
        return level.ToLower() switch
        {
            "error" => "#E0685A",   // Rose Red
            "warning" => "#E0B15A", // Amber Warning
            "info" => "#8FD6B4",    // Mint Green
            _ => "#8FA6BB"
        };
    }

    private void ClearTerminal()
    {
        _logs.Clear();
    }

    public async ValueTask DisposeAsync()
    {
        if (_selectedProjectId.HasValue && _hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                await _hubConnection.SendAsync("LeaveProjectGroup", _selectedProjectId.Value.ToString());
            }
            catch { }
        }

        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    public class TerminalLogLine
    {
        public DateTime Timestamp { get; set; }
        public string Level { get; set; } = "info";
        public string Message { get; set; } = string.Empty;
    }

    public class SystemLogLineDto
    {
        public DateTimeOffset Timestamp { get; set; }
        public string Level { get; set; } = "info";
        public string Message { get; set; } = string.Empty;
    }

    public class ContainerSelectDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int HostPort { get; set; }
    }

    public class ProjectLogsDto
    {
        public Guid ProjectId { get; set; }
        public List<string> Logs { get; set; } = new();
    }
}
