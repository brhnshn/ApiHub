    private void UpdateDbDefaults()
    {
        var baseName = GetSafeProjectName();
        var cleanBase = new string(baseName.Where(c => char.IsLetterOrDigit(c) || c == '_').ToArray());
        _dbName = $"{cleanBase}_db";
        _dbUser = $"{cleanBase}_user";
        if (string.IsNullOrEmpty(_dbPassword)) GenerateDbPassword();
        StateHasChanged();
    }

    private async Task OnZipFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        if (_selectedFile != null && !string.IsNullOrWhiteSpace(_selectedFile.Name))
        {
            var cleanName = System.IO.Path.GetFileNameWithoutExtension(_selectedFile.Name)
                .ToLower().Replace(" ", "-").Replace("_", "-");

            _projectName = new string(cleanName.Where(c => char.IsLetterOrDigit(c) || c == '-' || c == '_').ToArray());
            if (!_projectName.StartsWith("b")) _projectName = "b" + _projectName;
            UpdateDbDefaults();

            try
            {
                // Canlı analiz yapıp runtime ve entry file'ı otomatik tespit edelim
                var result = await JSRuntime.InvokeAsync<ZipAnalysisResult>("eval", "window.analyzeZipFile(document.getElementById('wizard-zip-input'))");
                if (result != null && result.Success)
                {
                    if (!string.IsNullOrEmpty(result.DetectedRuntime) && result.DetectedRuntime != "unknown")
                    {
                        _runtimeType = result.DetectedRuntime;

                        if (result.DetectedRuntime == "static")
                        {
                            _deployMode = "static";
                        }
                        else
                        {
                            _deployMode = "native";
                        }
                    }

                    if (!string.IsNullOrEmpty(result.DetectedName))
                    {
                        var cleanDetected = new string(result.DetectedName.ToLower()
                            .Replace(" ", "-").Replace("_", "-")
                            .Where(c => char.IsLetterOrDigit(c) || c == '-' || c == '_').ToArray());
                        if (!string.IsNullOrEmpty(cleanDetected))
                        {
                            _projectName = cleanDetected.StartsWith("b") ? cleanDetected : "b" + cleanDetected;
                            UpdateDbDefaults();
                        }
                    }

                    if (!string.IsNullOrEmpty(result.DetectedEntryFile))
                    {
                        _entryFile = result.DetectedEntryFile;
                    }
                }
            }
            catch (Exception ex)
            {
                SystemLogQueue.Log("warning", $"[DeployWizard] ZIP analizi esnasında hata: {ex.Message}");
            }
        }
    }

    private string GetStepClass(int step)
    {
        if (_activePipelineStep == 0) return "bg-[var(--cream)] border-[var(--line)] text-[var(--ink-soft)]";
        if (_activePipelineStep > step) return "bg-[var(--moss-bg)] border-[var(--moss)] text-[var(--moss)] font-bold";
        if (_activePipelineStep == step)
        {
            return _executionSuccess == false
                ? "bg-[var(--rose-bg)] border-[var(--rose)] text-[var(--rose)] font-bold animate-pulse"
                : "bg-[var(--accent-bg)] border-[var(--azure)] text-[var(--navy)] font-bold animate-pulse";
        }
        return "bg-[var(--cream)] border-[var(--line)] text-[var(--ink-soft)]";
    }

