@page "/deploy-wizard"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<PageTitle>Canlı Dağıtım Sihirbazı - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h2 class="text-2xl font-extrabold text-white tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles text-indigo-400 animate-pulse"></i> 
                Süper Canlı Dağıtım Sihirbazı
            </h2>
            <p class="text-xs text-slate-400 font-medium mt-1">
                ZIP dosyalarınızı yükleyin, port ve alan adı bilgilerini girin; gerisini ApiHub sunucuda tamamen otomatik yürütsün!
            </p>
        </div>
        
        <!-- Step Indicator -->
        <div class="flex bg-slate-950 p-1.5 rounded-xl border border-slate-800 items-center gap-1">
            @for (int i = 1; i <= 8; i++)
            {
                var stepNum = i;
                <button type="button" @onclick="() => GoToStep(stepNum)" disabled="@(stepNum > _maxReachedStep)"
                    class="w-7 h-7 rounded-lg text-xs font-bold transition-all flex items-center justify-center @(GetStepIndicatorClass(stepNum))">
                    @stepNum
                </button>
            }
        </div>
    </div>

    <!-- WIZARD STEP BODY CONTAINER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left: Step panel -->
        <div class="lg:col-span-8 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl relative overflow-hidden backdrop-blur-md flex flex-col justify-between min-h-[550px]">
            
            <div>
                <!-- Step Titles -->
                <div class="flex items-center gap-3 border-b border-slate-800 pb-3 mb-6">
                    <span class="w-8 h-8 rounded-xl bg-indigo-600/20 text-indigo-400 font-extrabold flex items-center justify-center text-sm border border-indigo-500/20">@_currentStep</span>
                    <div>
                        <h3 class="font-bold text-white text-sm">@GetStepTitle()</h3>
                        <p class="text-[10px] text-slate-400 font-medium mt-0.5">@GetStepSub()</p>
                    </div>
                </div>

                <!-- STEP 1: Proje Bilgileri -->
                @if (_currentStep == 1)
                {
                    <div class="space-y-4 animate-fade-in">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Proje Adı</label>
                                <input type="text" @bind="_projectName" placeholder="örn: burhanlife-api" 
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500 transition-colors">
                                <p class="text-[8px] text-slate-500 mt-1">Sadece küçük harfler, rakamlar ve tire (-).</p>
                            </div>
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Logo / İkon</label>
                                <select @bind="_logo" class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500">
                                    <option value="fa-cube">Küp (Varsayılan)</option>
                                    <option value="fa-database">Veritabanı</option>
                                    <option value="fa-server">Sunucu</option>
                                    <option value="fa-globe">Küre</option>
                                    <option value="fa-robot">AI Robot</option>
                                    <option value="fa-code">Kod</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Açıklama</label>
                            <textarea @bind="_description" placeholder="Proje hakkında açıklama girin..." rows="3"
                                class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-medium focus:outline-none focus:border-indigo-500 transition-colors"></textarea>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Çalışma Zamanı (Runtime)</label>
                                <select @bind="_runtimeType" class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500">
                                    <option value="dotnet">.NET</option>
                                    <option value="node">Node.js</option>
                                    <option value="bun">Bun</option>
                                    <option value="python">Python</option>
                                    <option value="php">PHP</option>
                                    <option value="java">Java</option>
                                    <option value="custom">Özel Komut (Custom)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Çalışma Sürümü (Framework Version)</label>
                                <input type="text" @bind="_frameworkVersion" placeholder="örn: .NET 8, Node 22" 
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500 transition-colors">
                            </div>
                        </div>
                    </div>
                }
                else if (_currentStep == 2)
                {
                    <div class="space-y-4 animate-fade-in">
                        <div class="grid grid-cols-3 gap-4">
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">İç Port Numarası</label>
                                <input type="number" @bind="_port" min="1024" max="65535" 
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-emerald-400 font-bold focus:outline-none focus:border-indigo-500">
                            </div>
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">RAM Limiti (MB)</label>
                                <input type="number" @bind="_memoryLimitMb" min="64" max="16384"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-indigo-500 font-semibold">
                            </div>
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">CPU Çekirdek Limiti</label>
                                <input type="number" @bind="_cpuCount" min="0.1" max="32" step="0.1"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-indigo-500 font-semibold">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Sağlık Kontrolü Endpoint (Health Check)</label>
                                <input type="text" @bind="_healthCheckEndpoint" placeholder="/health veya /api/status" 
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-mono focus:outline-none focus:border-indigo-500">
                            </div>
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Çalıştırma Kullanıcısı (Run User)</label>
                                <input type="text" @bind="_runUser" placeholder="root" 
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-mono focus:outline-none focus:border-indigo-500">
                            </div>
                        </div>

                        <div class="flex items-center justify-between bg-slate-950/40 p-3 rounded-lg border border-slate-850">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-rotate-left text-indigo-400"></i>
                                <div>
                                    <div class="text-xs text-slate-200 font-bold leading-none">Otomatik Yeniden Başlat (Auto Restart)</div>
                                    <span class="text-[8px] text-slate-500">Hata durumunda veya sistem açılışında otomatik başlatır</span>
                                </div>
                            </div>
                            <input type="checkbox" @bind="_autoRestart" class="w-4 h-4 bg-slate-950 border-slate-800 rounded text-indigo-600 focus:ring-indigo-500">
                        </div>
                    </div>
                }
                else if (_currentStep == 3)
                {
                    <div class="space-y-4 animate-fade-in">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase">Subdomain</label>
                                <input type="text" @bind="_subdomain" placeholder="api" 
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-indigo-500">
                            </div>
                            <div>
                                <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase">Ana Domain</label>
                                <select @bind="_domain" @bind:after="ApplySelectedRootDomainDefaults"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-indigo-500">
                                    <option value="">Seçiniz...</option>
                                    @foreach (var rd in _rootDomains)
                                    {
                                        <option value="@rd.Name">@rd.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="border-t border-slate-850 pt-4 space-y-3">
                            <div class="flex items-center justify-between bg-slate-950/40 p-3 rounded-lg border border-slate-850">
                                <div class="flex items-center gap-2">
                                    <i class="fa-brands fa-cloudflare text-orange-400"></i>
                                    <div>
                                        <div class="text-xs text-slate-200 font-bold leading-none">Cloudflare DNS A Kaydı Oluştur</div>
                                        <span class="text-[8px] text-slate-500">Subdomain'i sunucu IP'sine otomatik yönlendirir</span>
                                    </div>
                                </div>
                                <input type="checkbox" @bind="_createDnsRecord" class="w-4 h-4 bg-slate-950 border-slate-800 rounded text-indigo-600 focus:ring-indigo-500">
                            </div>

                            @if (_createDnsRecord)
                            {
                                <div class="p-3 bg-slate-950/60 border border-slate-850 rounded-xl space-y-2 font-mono text-xs">
                                    <div>
                                        <label class="block text-[8px] text-slate-400 font-bold uppercase mb-0.5">Sunucu IP</label>
                                        <input type="text" @bind="_serverIp" class="w-full bg-slate-900 border border-slate-800 rounded p-1.5 text-white">
                                    </div>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="block text-[8px] text-slate-400 font-bold uppercase mb-0.5">CF API Token</label>
                                            <input type="password" @bind="_cfToken" class="w-full bg-slate-900 border border-slate-800 rounded p-1.5 text-white">
                                        </div>
                                        <div>
                                            <label class="block text-[8px] text-slate-400 font-bold uppercase mb-0.5">Zone ID</label>
                                            <input type="text" @bind="_cfZoneId" class="w-full bg-slate-900 border border-slate-800 rounded p-1.5 text-white">
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="flex items-center justify-between bg-slate-950/40 p-3 rounded-lg border border-slate-850">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-shield-halved text-emerald-400"></i>
                                    <div>
                                        <div class="text-xs text-slate-200 font-bold leading-none">SSL Sertifikasını Otomatik Oluştur (Let's Encrypt)</div>
                                        <span class="text-[8px] text-slate-500">Güvenli HTTPS bağlantısı kurar</span>
                                    </div>
                                </div>
                                <input type="checkbox" @bind="_sslEnabled" class="w-4 h-4 bg-slate-950 border-slate-800 rounded text-indigo-600 focus:ring-indigo-500">
                            </div>
                        </div>
                    </div>
                }
                else if (_currentStep == 4)
                {
                    <div class="space-y-4 animate-fade-in">
                        <div class="flex items-center justify-between bg-slate-950/40 p-3 rounded-lg border border-slate-850">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-database text-indigo-400"></i>
                                <div>
                                    <div class="text-xs text-slate-200 font-bold leading-none">PostgreSQL Veritabanı Oluşturulsun</div>
                                    <span class="text-[8px] text-slate-500">Bu projeye özel yeni veritabanı şeması ve kullanıcısı oluşturur</span>
                                </div>
                            </div>
                            <input type="checkbox" @bind="_createDatabase" @bind:after="UpdateDbDefaults" class="w-4 h-4 bg-slate-950 border-slate-800 rounded text-indigo-600 focus:ring-indigo-500">
                        </div>

                        @if (_createDatabase)
                        {
                            <div class="p-4 bg-slate-950/60 border border-slate-850 rounded-xl space-y-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Veritabanı Adı</label>
                                        <input type="text" @bind="_dbName" class="w-full bg-slate-900 border border-slate-800 rounded p-2 text-xs text-white font-mono">
                                    </div>
                                    <div>
                                        <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Kullanıcı Adı</label>
                                        <input type="text" @bind="_dbUser" class="w-full bg-slate-900 border border-slate-800 rounded p-2 text-xs text-white font-mono">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Veritabanı Şifresi</label>
                                    <div class="flex gap-2">
                                        <input type="text" @bind="_dbPassword" class="flex-1 bg-slate-900 border border-slate-800 rounded p-2 text-xs text-emerald-400 font-mono font-bold">
                                        <button type="button" @onclick="GenerateDbPassword" 
                                            class="bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-400 border border-indigo-500/30 px-3 rounded-lg text-xs font-bold transition-colors">
                                            Şifre Üret
                                        </button>
                                    </div>
                                </div>
                                <div class="p-3 bg-emerald-950/20 border border-emerald-500/10 rounded-lg text-[10px] text-emerald-400 font-semibold flex items-center gap-2">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <span>Bağlantı parametreleri ve veritabanı yetkileri otomatik ayarlanıp projeye eklenecektir.</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_currentStep == 5)
                {
                    <div class="space-y-4 animate-fade-in">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Giriş Dosyası (Entry File)</label>
                                <input type="text" @bind="_entryFile" placeholder="örn: server.js veya Proje.dll"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-mono focus:outline-none focus:border-indigo-500">
                            </div>
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Çalışma Dizini (Working Directory)</label>
                                <input type="text" @bind="_workingDirectory" placeholder="Varsayılan proje dizini"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white font-mono focus:outline-none focus:border-indigo-500">
                            </div>
                        </div>

                        <div>
                            <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Başlatma Komutu (Start Command)</label>
                            <input type="text" @bind="_customCommand" placeholder="örn: node server.js veya dotnet Proje.dll"
                                class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-indigo-300 font-mono font-bold focus:outline-none focus:border-indigo-500">
                        </div>

                        <div>
                            <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Ortam (Environment)</label>
                            <div class="grid grid-cols-3 gap-2">
                                <button type="button" @onclick='() => _environment = "Production"'
                                    class="py-2.5 rounded-lg text-xs font-bold transition-all border @(_environment == "Production" ? "bg-indigo-600/20 text-indigo-400 border-indigo-500" : "bg-slate-950 border-slate-850 text-slate-400 hover:text-slate-200")">
                                    Production
                                </button>
                                <button type="button" @onclick='() => _environment = "Staging"'
                                    class="py-2.5 rounded-lg text-xs font-bold transition-all border @(_environment == "Staging" ? "bg-indigo-600/20 text-indigo-400 border-indigo-500" : "bg-slate-950 border-slate-850 text-slate-400 hover:text-slate-200")">
                                    Staging
                                </button>
                                <button type="button" @onclick='() => _environment = "Development"'
                                    class="py-2.5 rounded-lg text-xs font-bold transition-all border @(_environment == "Development" ? "bg-indigo-600/20 text-indigo-400 border-indigo-500" : "bg-slate-950 border-slate-850 text-slate-400 hover:text-slate-200")">
                                    Development
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else if (_currentStep == 6)
                {
                    <div class="space-y-4 animate-fade-in">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Çevre Değişkenleri Listesi</span>
                            <button type="button" @onclick="AddEnvVar" class="text-xs text-indigo-400 hover:text-indigo-300 font-bold flex items-center gap-1">
                                <i class="fa-solid fa-plus"></i> Değişken Ekle
                            </button>
                        </div>

                        <div class="max-h-[220px] overflow-y-auto space-y-2 pr-1">
                            @if (!_envVars.Any())
                            {
                                <div class="p-6 text-center border border-dashed border-slate-800 rounded-xl text-slate-500 text-xs">
                                    Henüz bir çevre değişkeni eklenmedi. Proje veritabanı oluşturulursa `DATABASE_URL` otomatik buraya eklenecektir.
                                </div>
                            }
                            else
                            {
                                @foreach (var ev in _envVars)
                                {
                                    <div class="flex gap-2 items-center animate-fade-in">
                                        <input type="text" @bind="ev.Key" placeholder="ANAHTAR (örn: JWT_SECRET)"
                                            class="w-1/2 bg-slate-950 border border-slate-850 rounded-lg p-2 text-xs text-white font-mono font-bold">
                                        <input type="text" @bind="ev.Value" placeholder="Değer (örn: supersecret)"
                                            class="w-1/2 bg-slate-950 border border-slate-850 rounded-lg p-2 text-xs text-emerald-400 font-mono">
                                        <button type="button" @onclick="() => RemoveEnvVar(ev)" class="p-2 text-rose-500 hover:bg-rose-500/10 rounded-lg">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
                else if (_currentStep == 7)
                {
                    <div class="space-y-4 animate-fade-in">
                        <!-- ZIP Uploader -->
                        <div class="relative border-2 border-dashed rounded-xl transition-all flex flex-col items-center justify-center p-6 min-h-[140px] @(_selectedFile != null ? "border-emerald-500/40 bg-emerald-950/5" : "border-slate-800 hover:border-indigo-500/40 bg-slate-950/50")">
                            @if (_selectedFile == null)
                            {
                                <i class="fa-regular fa-file-zip text-4xl text-slate-500 animate-bounce mb-2"></i>
                                <span class="text-xs text-slate-300 font-bold">Dağıtım ZIP arşivini buraya bırakın veya tıklayın</span>
                                <span class="text-[9px] text-slate-500 font-semibold mt-1">Yalnızca .zip uzantılı (Maksimum 200MB)</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-file-circle-check text-4xl text-emerald-400 mb-2"></i>
                                <span class="text-xs text-slate-200 font-bold">@_selectedFile.Name</span>
                                <span class="text-[9px] text-emerald-400 font-semibold mt-1">@((_selectedFile.Size / 1024.0 / 1024.0).ToString("F2")) MB - Dosya Hazır</span>
                            }
                            <InputFile id="wizard-zip-input" OnChange="OnZipFileSelected" accept=".zip"
                                style="position: absolute; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer;" />
                        </div>

                        <!-- Pre-deploy Checks -->
                        @if (_selectedFile != null)
                        {
                            <div class="p-4 bg-slate-950/80 rounded-xl border border-slate-850 space-y-2">
                                <div class="flex justify-between items-center text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-2">
                                    <span>Deployment Ön Kontrolleri</span>
                                    <button type="button" @onclick="VerifyUploadedZip" disabled="@_isCheckingZip"
                                        class="bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-400 border border-indigo-500/30 px-3 py-1 rounded text-[10px] font-bold">
                                        @(_isCheckingZip ? "Doğrulanıyor..." : "Doğrulamayı Yeniden Çalıştır")
                                    </button>
                                </div>

                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <div class="flex items-center justify-between p-2 bg-slate-900 rounded border border-slate-850">
                                        <span class="text-slate-300">1. ZIP Dosyası Sağlam</span>
                                        @if (_zipCheckRun)
                                        {
                                            <i class="fa-solid @(_zipCorrupt ? "fa-circle-xmark text-rose-500" : "fa-circle-check text-emerald-400")"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-circle-question text-slate-600"></i>
                                        }
                                    </div>
                                    <div class="flex items-center justify-between p-2 bg-slate-900 rounded border border-slate-850">
                                        <span class="text-slate-300">2. DLL Mevcut (.NET)</span>
                                        @if (_zipCheckRun)
                                        {
                                            <i class="fa-solid @(_hasDll ? "fa-circle-check text-emerald-400" : "fa-circle-exclamation text-amber-500")"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-circle-question text-slate-600"></i>
                                        }
                                    </div>
                                    <div class="flex items-center justify-between p-2 bg-slate-900 rounded border border-slate-850">
                                        <span class="text-slate-300">3. Giriş Dosyası Mevcut</span>
                                        @if (_zipCheckRun)
                                        {
                                            <i class="fa-solid @(_hasStartup ? "fa-circle-check text-emerald-400" : "fa-circle-exclamation text-amber-500")"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-circle-question text-slate-600"></i>
                                        }
                                    </div>
                                    <div class="flex items-center justify-between p-2 bg-slate-900 rounded border border-slate-850">
                                        <span class="text-slate-300">4. Yapılandırma Dosyası (appsettings/package)</span>
                                        @if (_zipCheckRun)
                                        {
                                            <i class="fa-solid @(_hasAppSettings ? "fa-circle-check text-emerald-400" : "fa-circle-question text-slate-500")"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-circle-question text-slate-600"></i>
                                        }
                                    </div>
                                </div>
                                <div class="flex items-center justify-between p-2.5 bg-slate-900 rounded border border-slate-850 text-xs">
                                    <span class="text-slate-300 font-semibold">5. Hedef Port Boş ve Müsait</span>
                                    @if (_zipCheckRun)
                                    {
                                        <span class="font-bold font-mono @(_isPortEmpty ? "text-emerald-400" : "text-rose-500")">
                                            @(_isPortEmpty ? "BOŞ (Hazır)" : "DOLU (Lütfen başka port seçin)")
                                        </span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-circle-question text-slate-600"></i>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_currentStep == 8)
                {
                    <div class="space-y-4 animate-fade-in">
                        <div class="grid grid-cols-2 gap-4">
                            <!-- Genel & Konfigürasyon Bilgileri -->
                            <div class="p-4 bg-slate-950/40 rounded-xl border border-slate-850 space-y-2 text-xs">
                                <h4 class="font-bold text-indigo-400 mb-2 uppercase text-[10px] tracking-wider border-b border-slate-800 pb-1">Uygulama & Limit</h4>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Proje Adı:</span>
                                    <span class="text-white font-bold">@_projectName</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Çalışma Zamanı:</span>
                                    <span class="text-emerald-400 font-bold">@_runtimeType (@_frameworkVersion)</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Port Numarası:</span>
                                    <span class="text-white font-bold">@_port</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">CPU / RAM Limiti:</span>
                                    <span class="text-white font-bold">@_cpuCount Çekirdek / @_memoryLimitMb MB</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Giriş Dosyası:</span>
                                    <span class="text-white font-mono text-[10px]">@_entryFile</span>
                                </div>
                            </div>

                            <!-- Domain & Servisler -->
                            <div class="p-4 bg-slate-950/40 rounded-xl border border-slate-850 space-y-2 text-xs">
                                <h4 class="font-bold text-indigo-400 mb-2 uppercase text-[10px] tracking-wider border-b border-slate-800 pb-1">Bağlantı & Domain</h4>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Erişim Adresi:</span>
                                    <span class="text-emerald-400 font-bold">https://@(string.IsNullOrEmpty(_subdomain) ? _domain : $"{_subdomain}.{_domain}")</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Otomatik SSL:</span>
                                    <span class="font-bold @(_sslEnabled ? "text-emerald-400" : "text-slate-500")">@(_sslEnabled ? "Aktif" : "Pasif")</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">CF DNS Kaydı:</span>
                                    <span class="font-bold @(_createDnsRecord ? "text-emerald-400" : "text-slate-500")">@(_createDnsRecord ? "Aktif" : "Pasif")</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">PostgreSQL Veritabanı:</span>
                                    <span class="font-bold @(_createDatabase ? "text-emerald-400" : "text-slate-500")">
                                        @(_createDatabase ? $"Oluşturulacak ({_dbName})" : "Pasif")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Paketi Dağıtmaya Başla Uyarısı -->
                        <div class="p-4 bg-indigo-950/20 border border-indigo-500/20 rounded-xl flex items-center gap-3">
                            <i class="fa-solid fa-circle-info text-indigo-400 text-lg animate-pulse"></i>
                            <div class="text-xs text-slate-300">
                                <strong>Dağıtıma Hazır!</strong> "Dağıtımı Başlat" butonuna tıklayarak projenizi sunucumuzda ayağa kaldırabilirsiniz.
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Navigation Buttons -->
            <div class="flex justify-between items-center border-t border-slate-850 pt-4 mt-6">
                <button type="button" @onclick="PrevStep" disabled="@(_currentStep == 1 || _isDeploying)"
                    class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-lg transition-colors disabled:opacity-30">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Geri
                </button>

                @if (_currentStep < 8)
                {
                    <button type="button" @onclick="NextStep" disabled="@(!CanProceedToNextStep())"
                        class="px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-lg transition-colors disabled:opacity-40">
                        İleri <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                }
                else
                {
                    <button type="button" @onclick="StartAutomatedDeployment" disabled="@_isDeploying"
                        class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-extrabold rounded-lg shadow-lg shadow-emerald-600/20 transition-all flex items-center gap-2">
                        @if (_isDeploying)
                        {
                            <span class="w-4 h-4 rounded-full border-2 border-t-transparent border-white animate-spin"></span>
                            <span>Dağıtılıyor...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                            <span>Dağıtımı Başlat!</span>
                        }
                    </button>
                }
            </div>

        </div>

        <!-- Right: Deployment pipeline and Console -->
        <div class="lg:col-span-4 bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col justify-between min-h-[550px]">
            
            <div>
                <div class="flex items-center gap-2 border-b border-slate-850 pb-3 mb-4">
                    <i class="fa-solid fa-network-wired text-indigo-400"></i>
                    <h3 class="font-bold text-white text-sm">Dağıtım Boru Hattı</h3>
                </div>

                <!-- Pipeline list -->
                <div class="space-y-3 mb-4">
                    <div class="flex items-center justify-between p-2.5 rounded-lg border text-xs @(GetPipelineStepClass(1))">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-database"></i> 1. DB Şeması Oluştur
                        </span>
                        <span class="text-[9px] uppercase font-bold">@GetPipelineStatusText(1)</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 rounded-lg border text-xs @(GetPipelineStepClass(2))">
                        <span class="flex items-center gap-2">
                            <i class="fa-brands fa-cloudflare"></i> 2. Cloudflare DNS Tescili
                        </span>
                        <span class="text-[9px] uppercase font-bold">@GetPipelineStatusText(2)</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 rounded-lg border text-xs @(GetPipelineStepClass(3))">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-file-zip"></i> 3. ZIP Çıkar & Geri Yükle
                        </span>
                        <span class="text-[9px] uppercase font-bold">@GetPipelineStatusText(3)</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 rounded-lg border text-xs @(GetPipelineStepClass(4))">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-cube"></i> 4. Servis Başlat (Native)
                        </span>
                        <span class="text-[9px] uppercase font-bold">@GetPipelineStatusText(4)</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 rounded-lg border text-xs @(GetPipelineStepClass(5))">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-server"></i> 5. Nginx vHost Yapılandırma
                        </span>
                        <span class="text-[9px] uppercase font-bold">@GetPipelineStatusText(5)</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 rounded-lg border text-xs @(GetPipelineStepClass(6))">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-shield-halved"></i> 6. Let's Encrypt SSL
                        </span>
                        <span class="text-[9px] uppercase font-bold">@GetPipelineStatusText(6)</span>
                    </div>
                </div>
            </div>

            <!-- Console Log Panel -->
            <div class="space-y-1">
                <span class="text-[9px] text-slate-500 uppercase font-black">Stdout Log Konsolu</span>
                <div class="bg-slate-950 border border-slate-850 p-3 rounded-lg font-mono text-[9px] text-emerald-400 min-h-[140px] max-h-[180px] overflow-y-auto space-y-1">
                    @if (!_terminalLogs.Any())
                    {
                        <span class="text-slate-600">// Loglar dağıtım başladığında burada akacaktır.</span>
                    }
                    else
                    {
                        @foreach (var log in _terminalLogs)
                        {
                            <div>@log</div>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<!-- PostgreSQL Database generated credentials display modal -->
@if (_executionSuccess == true && _createDatabase)
{
    <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-[9999] flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-indigo-500/20 max-w-md w-full rounded-2xl p-6 space-y-4 shadow-2xl text-left">
            <h3 class="text-base font-extrabold text-white flex items-center gap-2">
                <i class="fa-solid fa-database text-emerald-400"></i> PostgreSQL Veritabanı Bilgileri
            </h3>
            <p class="text-xs text-slate-300">Projeniz için veritabanı başarıyla oluşturuldu. Bağlantı dizesi parametreleri aşağıdadır:</p>

            <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-850 font-mono text-xs text-emerald-400 space-y-1.5">
                <div>Host: <span class="text-white ml-2">127.0.0.1</span></div>
                <div>Veritabanı: <span class="text-white ml-2">@_dbName</span></div>
                <div>Kullanıcı: <span class="text-white ml-2">@_dbUser</span></div>
                <div>Şifre: <span class="text-white ml-2">@_dbPassword</span></div>
