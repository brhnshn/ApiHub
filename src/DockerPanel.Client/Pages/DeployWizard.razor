    private async Task DetectContainerPortAsync()
    {
        if (string.IsNullOrWhiteSpace(_dockerImageName)) return;
        _isDetectingPort = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsJsonAsync("api/projects/image-exposed-port",
                new { ImageName = _dockerImageName });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ImageExposedPortResult>();
                if (result?.ExposedPort.HasValue == true)
                {
                    _containerPort = result.ExposedPort.Value;
                    Snackbar.Add($"EXPOSE portu otomatik algilandi: {result.ExposedPort.Value}", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Bu image icin EXPOSE portu bulunamadi. Lutfen manuel girin.", Severity.Warning);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Port algilama hatasi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDetectingPort = false;
            StateHasChanged();
        }
    }

