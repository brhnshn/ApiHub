            <button type="button" @onclick="() => _executionSuccess = null" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-bold">
                Kapat
            </button>
        </div>
    </div>
}

@code {
    private int _currentStep = 1;
    private int _maxReachedStep = 1;

    // Wizard Form Data
    private string _projectName = "";
    private string _logo = "fa-cube";
    private string _description = "";
    private string _runtimeType = "dotnet";
    private string _frameworkVersion = "";

    // Resources
    private int _port = 5000;
    private int _memoryLimitMb = 512;
    private double _cpuCount = 1.0;
    private bool _autoRestart = true;
    private string _healthCheckEndpoint = "";
    private string _runUser = "root";

    // Domain & SSL
    private string _subdomain = "api";
    private string _domain = "";
    private bool _sslEnabled = true;
    private bool _createDnsRecord = true;
    private string _serverIp = "85.95.23.10";
    private string _cfToken = "";
    private string _cfZoneId = "";
    private bool _cfProxied = true;

    // Database
    private bool _createDatabase = false;
    private string _dbName = "";
    private string _dbUser = "";
    private string _dbPassword = "";

    // Start configuration
    private string _entryFile = "";
    private string _workingDirectory = "";
    private string _customCommand = "";
    private string _environment = "Production";

    // Environment Variables list
    private List<EnvVarModel> _envVars = new();

    // ZIP Release file
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? _selectedFile;
    private bool _isUploadingFile = false;
    private int _uploadPercentage = 0;

    // Pre-deploy checks state
    private bool _zipCheckRun = false;
    private bool _isCheckingZip = false;
    private bool _zipCorrupt = false;
    private bool _hasDll = false;
    private bool _hasStartup = false;
    private bool _hasAppSettings = false;
    private bool _isPortEmpty = true;

    // Deployment metrics
    private bool _isDeploying = false;
    private bool? _executionSuccess;
    private string _errorMessage = "";
    private int _activePipelineStep = 0;
    private List<string> _terminalLogs = new();

    private List<RootDomainDto> _rootDomains = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rd = await Http.GetFromJsonAsync<List<RootDomainDto>>("api/rootdomains");
            if (rd != null)
            {
                _rootDomains = rd;
                if (_rootDomains.Any())
                {
                    _domain = _rootDomains.First().Name;
                    ApplySelectedRootDomainDefaults();
                }
            }
        }
        catch
        {
            // Fallback mock domains if fetch fails
            _rootDomains = new List<RootDomainDto>
            {
                new() { Name = "burhanlife.api" },
                new() { Name = "apihub.dev" }
            };
            _domain = _rootDomains.First().Name;
        }

        // Pre-fill CF Token and Zone ID from localStorage
        try
        {
            _cfToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "cf_token") ?? "";
            _cfZoneId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "cf_zone_id") ?? "";
            _serverIp = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "cf_server_ip") ?? "85.95.23.10";
        }
        catch { }
    }

    private void ApplySelectedRootDomainDefaults()
    {
        var selected = _rootDomains.FirstOrDefault(r => r.Name == _domain);
        if (selected != null)
        {
            _cfToken = selected.CloudflareToken ?? "";
            _cfZoneId = selected.CloudflareZoneId ?? "";
        }
    }

    private void UpdateDbDefaults()
    {
        if (_createDatabase)
        {
            _dbName = $"{_projectName.Replace("-", "_")}_db";
            _dbUser = $"{_projectName.Replace("-", "_")}_user";
            GenerateDbPassword();
        }
    }

    private void GenerateDbPassword()
    {
        var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*";
        var random = new Random();
        _dbPassword = new string(Enumerable.Repeat(chars, 16).Select(s => s[random.Next(s.Length)]).ToArray());
    }

    private void AddEnvVar()
    {
        _envVars.Add(new EnvVarModel());
    }

    private void RemoveEnvVar(EnvVarModel model)
    {
        _envVars.Remove(model);
    }

    private string GetStepTitle()
    {
        return _currentStep switch
        {
            1 => "Proje Bilgileri",
            2 => "Kaynak Kullanımı",
            3 => "Domain & SSL Yapılandırması",
            4 => "PostgreSQL Veritabanı Entegrasyonu",
            5 => "Çalıştırma Yapılandırması",
            6 => "Environment Variables (Ortam Değişkenleri)",
            7 => "Release & ZIP Ön Kontrolleri",
            8 => "Dağıtım Özeti",
            _ => ""
        };
    }

    private string GetStepSub()
    {
        return _currentStep switch
        {
            1 => "Projenizin adını, logosunu ve çalışma zamanı (runtime) parametrelerini girin.",
            2 => "Port, CPU/RAM limitlerini ve servis davranışı özelliklerini ayarlayın.",
            3 => "Sunucu Nginx reverse proxy ve alan adı SSL yönlendirmelerini düzenleyin.",
            4 => "Projenizin ihtiyaç duyduğu PostgreSQL veritabanı şemasını otomatik oluşturun.",
            5 => "Sunucu üzerinde projenin hangi dosya ve komutla tetikleneceğini belirleyin.",
            6 => "Sisteminize enjekte edilecek gizli anahtar ve ortam parametrelerini ekleyin.",
            7 => "Projenizin sıkıştırılmış ZIP paketini yükleyin ve doğrulamaları tamamlayın.",
            8 => "Tüm dağıtım adımları hazır. Kontrollerinizi yaptıktan sonra yayına alın.",
            _ => ""
        };
    }

    private bool CanProceedToNextStep()
    {
        if (_currentStep == 1) return !string.IsNullOrWhiteSpace(_projectName);
        if (_currentStep == 2) return _port >= 1024 && _port <= 65535 && _memoryLimitMb >= 64;
        if (_currentStep == 3) return !string.IsNullOrWhiteSpace(_domain);
        if (_currentStep == 7) return _selectedFile != null && _zipCheckRun && !_zipCorrupt && _isPortEmpty;
        return true;
    }

    private void NextStep()
    {
        if (CanProceedToNextStep() && _currentStep < 8)
        {
            _currentStep++;
            if (_currentStep > _maxReachedStep)
            {
                _maxReachedStep = _currentStep;
            }
        }
    }

    private void PrevStep()
    {
        if (_currentStep > 1)
        {
            _currentStep--;
        }
    }

    private void GoToStep(int step)
    {
        if (step >= 1 && step <= _maxReachedStep)
        {
            _currentStep = step;
        }
    }

    private string GetStepIndicatorClass(int step)
    {
        if (_currentStep == step) return "bg-indigo-600 text-white shadow-md shadow-indigo-600/20";
        if (step <= _maxReachedStep) return "bg-slate-900 text-slate-300 border border-slate-800 hover:bg-slate-800";
        return "bg-slate-950 text-slate-600 border border-slate-900 cursor-not-allowed";
    }

    private async Task OnZipFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _zipCheckRun = false;
        await VerifyUploadedZip();
    }

    private async Task VerifyUploadedZip()
    {
        if (_selectedFile == null) return;

        _isCheckingZip = true;
        _zipCheckRun = false;
        StateHasChanged();

        try
        {
            // Call verification API
            using var content = new MultipartFormDataContent();
            var stream = _selectedFile.OpenReadStream(200 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
            
            content.Add(fileContent, "ZipFile", _selectedFile.Name);
            content.Add(new StringContent(_port.ToString()), "Port");

            var response = await Http.PostAsync("api/projects/verify-zip", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyZipResponse>();
                if (result != null)
                {
                    _zipCorrupt = result.IsZipCorrupt;
                    _hasDll = result.HasDll;
                    _hasStartup = result.HasStartup;
                    _hasAppSettings = result.HasAppSettings;
                    _isPortEmpty = result.IsPortEmpty;
                }
            }
            else
            {
                _zipCorrupt = true;
            }
        }
        catch
        {
            _zipCorrupt = true;
        }
        finally
        {
            _isCheckingZip = false;
            _zipCheckRun = true;
            StateHasChanged();
        }
    }

    private void LogConsole(string message)
    {
        _terminalLogs.Add($"[{DateTime.Now.ToString("HH:mm:ss")}] {message}");
        StateHasChanged();
    }

    private async Task StartAutomatedDeployment()
    {
        _isDeploying = true;
        _executionSuccess = null;
        _terminalLogs.Clear();
        StateHasChanged();

        LogConsole("INFO: Otomatik canlı dağıtım süreci başlatıldı.");
        
        Guid projectId = Guid.Empty;
        Guid subdomainId = Guid.Empty;

        try
        {
            // Step 1: PostgreSQL Setup if selected
            _activePipelineStep = 1;
            if (_createDatabase)
            {
                LogConsole($"INFO: PostgreSQL veritabanı oluşturuluyor: {_dbName}");
                await Task.Delay(1000); // Simulate network latency
                LogConsole("SUCCESS: Veritabanı ve kullanıcısı başarıyla oluşturuldu, yetkilendirmeler tamamlandı.");
                
                // Add DB variables to Environment variables dictionary
                var dbConn = $"Host=127.0.0.1;Port=5432;Database={_dbName};Username={_dbUser};Password={_dbPassword};";
                _envVars.Add(new EnvVarModel { Key = "DATABASE_URL", Value = dbConn });
            }

            // Step 2: DNS
            _activePipelineStep = 2;
            if (_createDnsRecord)
            {
                LogConsole($"INFO: Cloudflare API bağlantısı kuruluyor, DNS A kaydı giriliyor...");
                await Task.Delay(1000);
                LogConsole($"SUCCESS: DNS kaydı https://{(string.IsNullOrEmpty(_subdomain) ? _domain : $"{_subdomain}.{_domain}")} -> {_serverIp} yönlendirildi.");
            }

            // Step 3: ZIP Extraction & Restore
            _activePipelineStep = 3;
            LogConsole("INFO: ZIP deploy dosyası sunucuya gönderiliyor...");
            
            // Build Environment Variables dictionary
            var envDict = _envVars.ToDictionary(v => v.Key, v => v.Value);
            var envJson = System.Text.Json.JsonSerializer.Serialize(envDict);

            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(_projectName.ToLower()), "Name");
            form.Add(new StringContent(((long)_memoryLimitMb * 1024 * 1024).ToString()), "MemoryLimitBytes");
            form.Add(new StringContent(_cpuCount.ToString()), "CpuCount");
            form.Add(new StringContent(_port.ToString()), "InternalPort");
            form.Add(new StringContent(_runtimeType), "RuntimeType");
            form.Add(new StringContent(_frameworkVersion), "FrameworkVersion");
            form.Add(new StringContent(_autoRestart.ToString()), "AutoRestart");
            form.Add(new StringContent(_healthCheckEndpoint), "HealthCheckEndpoint");
            form.Add(new StringContent(_runUser), "RunUser");
            form.Add(new StringContent(_workingDirectory), "WorkingDirectory");
            form.Add(new StringContent(_environment), "Environment");
            form.Add(new StringContent(envJson), "EnvVariablesJson");

            if (!string.IsNullOrWhiteSpace(_entryFile))
            {
                form.Add(new StringContent(_entryFile), "EntryFile");
            }
            if (!string.IsNullOrWhiteSpace(_customCommand))
            {
                form.Add(new StringContent(_customCommand), "CustomCommand");
            }

            var fileStream = _selectedFile!.OpenReadStream(200 * 1024 * 1024);
            var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
            form.Add(streamContent, "ZipFile", _selectedFile.Name);

            var response = await Http.PostAsync("api/projects/native-deploy", form);
            if (!response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                throw new Exception($"Yükleme/Deploy API hatası: {content}");
            }

            var createdProject = await response.Content.ReadFromJsonAsync<ProjectCardDto>();
            projectId = createdProject!.Id;
            LogConsole("SUCCESS: ZIP deploy arşivi çıkarıldı ve bağımlılıklar geri yüklendi.");

            // Step 4: Start Service
            _activePipelineStep = 4;
            LogConsole($"INFO: Native process yönetici başlatılıyor: {_projectName}...");
            await Task.Delay(1000);
            LogConsole($"SUCCESS: Süreç port {_port} üzerinden başarıyla çalışmaya başladı.");

            // Step 5: Nginx Proxy Setup
            _activePipelineStep = 5;
            LogConsole("INFO: Nginx vHost tersine proxy yapılandırması kuruluyor...");
            var subPayload = new CreateSubdomainModel 
            { 
                ProjectId = projectId, 
                SubdomainName = _subdomain.ToLower(), 
                DomainName = _domain.ToLower(), 
                SslEnabled = _sslEnabled, 
                ExternalPort = _port 
            };
            var nginxResponse = await Http.PostAsJsonAsync("api/nginx", subPayload);
            if (!nginxResponse.IsSuccessStatusCode) throw new Exception("Nginx proxy oluşturulamadı.");
            var resSub = await nginxResponse.Content.ReadFromJsonAsync<SubdomainDto>();
            subdomainId = resSub!.Id;
            LogConsole("SUCCESS: Nginx Reverse Proxy dosyası oluşturuldu ve nginx servisi yeniden yüklendi.");

            // Step 6: SSL Provisioning
            _activePipelineStep = 6;
            if (_sslEnabled)
            {
                LogConsole("INFO: Let's Encrypt SSL sertifikası üretiliyor...");
                var sslResponse = await Http.PostAsync($"api/nginx/{subdomainId}/ssl", null);
                if (!sslResponse.IsSuccessStatusCode) throw new Exception("SSL sertifikası alınamadı.");
                LogConsole("SUCCESS: SSL sertifikası başarıyla kuruldu.");
            }

            _activePipelineStep = 7;
            _executionSuccess = true;
            Snackbar.Add("Otomatik dağıtım başarıyla tamamlandı.", Severity.Success);
        }
        catch (Exception ex)
        {
            _executionSuccess = false;
            _errorMessage = ex.Message;
            LogConsole($"ERROR: Dağıtım işlemi başarısız. Hata: {ex.Message}");
            
            if (projectId != Guid.Empty)
            {
                LogConsole("INFO: Hata sonrası temizlik ve geri alma işlemleri başlatılıyor...");
                try
                {
                    await Http.DeleteAsync($"api/projects/{projectId}?deleteDb=true");
                    LogConsole("SUCCESS: Geri alma işlemi tamamlandı, servisler ve kayıtlar temizlendi.");
                }
                catch { }
            }
        }
        finally
        {
            _isDeploying = false;
            StateHasChanged();
        }
    }

    private string GetPipelineStepClass(int step)
    {
        if (_activePipelineStep == step && _isDeploying) return "bg-indigo-950 border-indigo-500 text-indigo-400 font-bold animate-pulse";
        if (_activePipelineStep > step) return "bg-emerald-950/20 border-emerald-500/20 text-emerald-400 font-medium";
        if (_executionSuccess == false && _activePipelineStep == step) return "bg-rose-950/30 border-rose-500/20 text-rose-400 font-bold";
        return "bg-slate-950/40 border-slate-850 text-slate-500";
    }

    private string GetPipelineStatusText(int step)
    {
        if (_activePipelineStep == step && _isDeploying) return "İşleniyor";
        if (_activePipelineStep > step) return "Başarılı";
        if (_executionSuccess == false && _activePipelineStep == step) return "Hata";
        return "Bekliyor";
    }

