    {
        public int? ExposedPort { get; set; }
    }

    private async Task OnComposeFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var reader = new System.IO.StreamReader(stream, System.Text.Encoding.UTF8);
                _composeContent = await reader.ReadToEndAsync();
                Snackbar.Add($"'{file.Name}' dosyası okundu.", Severity.Info);
                await AnalyzeComposeAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Dosya okuma hatasi: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task AnalyzeComposeAsync()
    {
        if (string.IsNullOrWhiteSpace(_composeContent)) return;
        _isAnalyzingCompose = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsJsonAsync("api/deployments/analyze-compose", new { Content = _composeContent });
            if (response.IsSuccessStatusCode)
            {
                _composeAnalysis = await response.Content.ReadFromJsonAsync<ComposeAnalysisResultDto>();
                if (_composeAnalysis != null)
                {
                    _composeEnvValues.Clear();
                    foreach (var v in _composeAnalysis.Variables)
                    {
                        if (!string.IsNullOrEmpty(v.DefaultValue))
                            _composeEnvValues[v.Name] = v.DefaultValue;
                    }

                    if (_composeAnalysis.Services.Any())
                    {
                        var webService = _composeAnalysis.Services.FirstOrDefault(s =>
                            s.Name.Contains("web", StringComparison.OrdinalIgnoreCase) ||
                            s.Name.Contains("app", StringComparison.OrdinalIgnoreCase) ||
                            s.Name.Contains("api", StringComparison.OrdinalIgnoreCase) ||
                            s.Ports.Any()) ?? _composeAnalysis.Services.First();

                        _selectedProxyService = webService.Name;
                        if (webService.Ports.Any())
                        {
                            _port = webService.Ports.First();
                        }
                    }

                    Snackbar.Add($"Compose içeriği başarıyla ayrıştırıldı. {_composeAnalysis.Services.Count} servis bulundu.", Severity.Success);
                }
            }
            else
            {
                var err = await ParseErrorAsync(response);
                Snackbar.Add($"Compose ayrıştırma hatası: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Analiz hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isAnalyzingCompose = false;
            StateHasChanged();
        }
    }

    private void OnProxyServiceChanged()
    {
        if (_composeAnalysis != null && !string.IsNullOrWhiteSpace(_selectedProxyService))
        {
            var selected = _composeAnalysis.Services.FirstOrDefault(s => s.Name == _selectedProxyService);
            if (selected != null && selected.Ports.Any())
            {
                _port = selected.Ports.First();
            }
        }
    }

    private bool ValidateDeploymentRequest()
    {
        if (string.IsNullOrWhiteSpace(_projectName))
        {
            Snackbar.Add("Lutfen proje adini girin.", Severity.Warning);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_domain))
        {
            Snackbar.Add("Lutfen yayinlanacak ana domaini secin.", Severity.Warning);
            return false;
        }

        if (_deployMode != "static" && (_port < 1 || _port > 65535))
        {
            Snackbar.Add("Port 1 ile 65535 arasinda olmali.", Severity.Warning);
            return false;
        }

        if (_deployMode == "docker" && _containerPort.HasValue && (_containerPort.Value < 1 || _containerPort.Value > 65535))
        {
            Snackbar.Add("Container Port 1 ile 65535 arasinda olmali.", Severity.Warning);
            return false;
        }

        if ((_deployMode == "native" || _deployMode == "static") && _selectedFile == null)
        {
            Snackbar.Add("ZIP deploy dosyasini secin.", Severity.Warning);
            return false;
        }

        if (_deployMode == "docker" && string.IsNullOrWhiteSpace(_dockerImageName))
        {
            Snackbar.Add("Docker imaj adini girin.", Severity.Warning);
            return false;
        }

        if (_deployMode == "compose" && string.IsNullOrWhiteSpace(_composeContent))
        {
            Snackbar.Add("Lütfen docker-compose.yml içeriğini girin veya dosya yükleyin.", Severity.Warning);
            return false;
        }

        if (_createDnsRecord)
        {
            if (string.IsNullOrWhiteSpace(_serverIp) || !System.Net.IPAddress.TryParse(_serverIp.Trim(), out _))
            {
                Snackbar.Add("Cloudflare DNS icin gecerli bir sunucu IP adresi girin.", Severity.Warning);
                return false;
            }

            if (string.IsNullOrWhiteSpace(_cfToken) || string.IsNullOrWhiteSpace(_cfZoneId))
            {
                Snackbar.Add("Cloudflare DNS icin API token ve Zone ID gerekli.", Severity.Warning);
                return false;
            }
        }

        if (_createDatabase && (string.IsNullOrWhiteSpace(_dbName) || string.IsNullOrWhiteSpace(_dbUser) || string.IsNullOrWhiteSpace(_dbPassword)))
        {
            Snackbar.Add("Veritabani olusturmak icin ad, kullanici ve sifre girin.", Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task StartAutomatedDeployment()
    {
        if (!ValidateDeploymentRequest())
        {
            return;
        }

        ClearConsole();
        _isDeploying = true;
        _executionSuccess = null;
        StateHasChanged();

        Guid projectId = Guid.Empty;
        Guid subdomainId = Guid.Empty;

        try
        {
            // ADIM 3 & 4: Proje / Konteyner Ayağa Kaldırma
            _activePipelineStep = 3;
            ProjectCardDto? createdProject = null;

            if (_deployMode == "docker")
            {
                LogConsole($"INFO: Docker imajı çekiliyor ve konteyner hazırlanıyor: {_dockerImageName}");

                var dockerPayload = new CreateDockerModel
                {
                    Name = _projectName.ToLower(),
                    ImageName = _dockerImageName.Trim(),
                    MemoryLimitBytes = (long)_memoryLimitMb * 1048576,
                    CpuCount = _cpuCount,
                    HostPort = _port,
                    ContainerPort = _containerPort
                };

                var dockerResponse = await Http.PostAsJsonAsync("api/projects/container", dockerPayload);
                if (!dockerResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(dockerResponse));

                createdProject = await dockerResponse.Content.ReadFromJsonAsync<ProjectCardDto>();
                if (createdProject == null) throw new Exception("Geçersiz API yanıtı.");
                projectId = createdProject.Id;

                _activePipelineStep = 4;
                LogConsole($"SUCCESS: Docker Konteyner başarıyla ayağa kalktı.");
            }
            else if (_deployMode == "compose")
            {
                LogConsole($"INFO: Docker Compose projesi sunucuya aktarılıyor ve ayağa kaldırılıyor: {_projectName}");

                var composePayload = new ComposeDeployModel
                {
                    ProjectName = _projectName.ToLower(),
                    ComposeContent = _composeContent,
                    Environment = _composeEnvValues,
                    ProxyService = string.IsNullOrWhiteSpace(_selectedProxyService) ? null : _selectedProxyService,
                    DomainName = _domain.ToLower(),
                    SubdomainName = string.IsNullOrWhiteSpace(_subdomain) ? null : _subdomain.ToLower(),
                    ProxyPort = _port,
                    SslEnabled = _sslEnabled
                };

                var composeResponse = await Http.PostAsJsonAsync("api/deployments/compose", composePayload);
                if (!composeResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(composeResponse));

                var deployRes = await composeResponse.Content.ReadFromJsonAsync<DeploymentResponseDto>();
                if (deployRes == null) throw new Exception("Geçersiz API yanıtı.");

                var deploymentId = deployRes.Id;
                LogConsole($"INFO: Compose dağıtım görevi sıraya alındı (ID: {deploymentId:N}). Sunucuda container'lar çekiliyor...");

                _activePipelineStep = 4;
                bool isDone = false;
                for (int i = 0; i < 60 && !isDone; i++)
                {
                    await Task.Delay(2000);
                    var statusRes = await Http.GetAsync($"api/deployments/{deploymentId}");
                    if (statusRes.IsSuccessStatusCode)
                    {
                        var currentDep = await statusRes.Content.ReadFromJsonAsync<DeploymentResponseDto>();
                        if (currentDep != null)
                        {
                            if (currentDep.Status == "Succeeded")
                            {
                                isDone = true;
                                LogConsole($"SUCCESS: Docker Compose konteyner kümesi başarıyla ayağa kalktı.");
                            }
                            else if (currentDep.Status == "Failed" || currentDep.Status == "RollbackPending" || currentDep.Status == "RollbackFailed")
                            {
                                throw new Exception(currentDep.ErrorMessage ?? "Compose dağıtımı zaman aşımına uğradı veya başarısız oldu.");
                            }
                        }
                    }
                }
            }
            else if (_deployMode == "static")
            {
                using var staticContent = new MultipartFormDataContent();
                staticContent.Add(new StringContent(_projectName.ToLower()), "Name");
                staticContent.Add(new StringContent(_enablePhp.ToString()), "EnablePhp");

                _uploadPercentage = 0;
                _isUploadingFile = true;
                StateHasChanged();

                var fileStream = _selectedFile!.OpenReadStream(maxAllowedSize: MaxZipUploadBytes);
                var progressStream = new ProgressStream(fileStream, async (bytesRead, totalBytes) =>
                {
                    _uploadPercentage = (int)((bytesRead * 100) / totalBytes);
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1);
                });

                var streamContent = new StreamContent(progressStream);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
                staticContent.Add(streamContent, "ZipFile", _selectedFile.Name);

                LogConsole($"INFO: Statik ZIP arşivi yükleniyor...");

                var requestMessage = new HttpRequestMessage(HttpMethod.Post, "api/projects/static-deploy")
                {
                    Content = staticContent
                };

                var projectResponse = await Http.SendAsync(requestMessage);

                _isUploadingFile = false;
                StateHasChanged();

                if (!projectResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(projectResponse));

                createdProject = await projectResponse.Content.ReadFromJsonAsync<ProjectCardDto>();
                projectId = createdProject!.Id;

                _activePipelineStep = 4;
                LogConsole($"SUCCESS: Statik ZIP sunucuya açıldı.");
            }
            else
            {
                using var nativeContent = new MultipartFormDataContent();
                nativeContent.Add(new StringContent(_projectName.ToLower()), "Name");
                nativeContent.Add(new StringContent(((long)_memoryLimitMb * 1048576).ToString()), "MemoryLimitBytes");
                nativeContent.Add(new StringContent(_cpuCount.ToString()), "CpuCount");
                nativeContent.Add(new StringContent(_port.ToString()), "HostPort");
                nativeContent.Add(new StringContent(_runtimeType ?? "dotnet"), "RuntimeType");

                if (!string.IsNullOrWhiteSpace(_entryFile))
                {
                    nativeContent.Add(new StringContent(_entryFile.Trim()), "EntryFile");
                }
                if (!string.IsNullOrWhiteSpace(_customCommand))
                {
                    nativeContent.Add(new StringContent(_customCommand.Trim()), "CustomCommand");
                }

                _uploadPercentage = 0;
                _isUploadingFile = true;
                StateHasChanged();

                var fileStream = _selectedFile!.OpenReadStream(maxAllowedSize: MaxZipUploadBytes);
                var progressStream = new ProgressStream(fileStream, async (bytesRead, totalBytes) =>
                {
                    _uploadPercentage = (int)((bytesRead * 100) / totalBytes);
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1); // Yield thread to allow Blazor to redraw UI progress bar
                });

                var streamContent = new StreamContent(progressStream);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
                nativeContent.Add(streamContent, "ZipFile", _selectedFile.Name);

                LogConsole($"INFO: ZIP arşivi yükleniyor...");

                var requestMessage = new HttpRequestMessage(HttpMethod.Post, "api/projects/native-deploy")
                {
                    Content = nativeContent
                };

                var projectResponse = await Http.SendAsync(requestMessage);

                _isUploadingFile = false;
                StateHasChanged();

                if (!projectResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(projectResponse));

                createdProject = await projectResponse.Content.ReadFromJsonAsync<ProjectCardDto>();
                projectId = createdProject!.Id;

                _activePipelineStep = 4;
                LogConsole($"SUCCESS: ZIP sunucuya açıldı.");
            }

            // ADIM 1: DB Yaratma
            _activePipelineStep = 1;
            if (_createDatabase)
            {
                LogConsole($"INFO: PostgreSQL veritabanı oluşturuluyor... {_dbName}");
                var dbPayload = new CreateDatabaseModel { ProjectId = projectId, DbName = _dbName, DbUser = _dbUser, DbPassword = _dbPassword };
                var dbResponse = await Http.PostAsJsonAsync("api/databases", dbPayload);
                if (!dbResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(dbResponse));
                LogConsole($"SUCCESS: Veritabanı oluşturuldu.");
            }

            // ADIM 2: DNS
            _activePipelineStep = 2;
            if (_createDnsRecord)
            {
                await SaveCloudflareSettingsAsync();
                var dnsName = string.IsNullOrWhiteSpace(_subdomain) ? _domain : $"{_subdomain}.{_domain}";
                var dnsPayload = new CreateDnsModel { ProjectId = projectId, Name = dnsName, Value = _serverIp, Proxied = _cfProxied, UseCloudflare = true, CloudflareToken = _cfToken, CloudflareZoneId = _cfZoneId };
                var dnsResponse = await Http.PostAsJsonAsync("api/dns", dnsPayload);
                if (!dnsResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(dnsResponse));
                LogConsole($"SUCCESS: DNS A kaydı tescil edildi.");
            }

            // ADIM 5: Nginx Proxy
            _activePipelineStep = 5;
            var subdomainPayload = new CreateSubdomainModel { ProjectId = projectId, SubdomainName = _subdomain.ToLower(), DomainName = _domain.ToLower(), SslEnabled = _sslEnabled, ExternalPort = _port };
            var nginxResponse = await Http.PostAsJsonAsync("api/nginx", subdomainPayload);
            if (!nginxResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(nginxResponse));

            var resSub = await nginxResponse.Content.ReadFromJsonAsync<SubdomainDto>();
            subdomainId = resSub!.Id;
            LogConsole("SUCCESS: Nginx Reverse Proxy yapılandırıldı.");

            // ADIM 6: SSL
            _activePipelineStep = 6;
            if (_sslEnabled)
            {
                var sslResponse = await Http.PostAsync($"api/nginx/{subdomainId}/ssl", null);
                if (!sslResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(sslResponse));
                LogConsole("SUCCESS: Let's Encrypt SSL aktif edildi.");
            }

            _activePipelineStep = 7;
            _executionSuccess = true;
            Snackbar.Add("Otomatik dağıtım başarıyla tamamlandı.", Severity.Success);
        }
        catch (Exception ex)
        {
            _executionSuccess = false;
            _errorMessage = ex.Message;
            LogConsole($"ERROR: İşlem başarısız. Hata: {ex.Message}");

            // Hatalı biten dağıtımlarda yapılan tüm işlemleri ve projeyi silerek rollback yap
            if (projectId != Guid.Empty)
            {
                LogConsole("INFO: Hata sonrası yapılan işlemler geri alınıyor (Rollback)...");
                try
                {
                    var rollbackResponse = await Http.DeleteAsync($"api/projects/{projectId}?deleteDb=true");
                    if (rollbackResponse.IsSuccessStatusCode)
                    {
                        LogConsole("SUCCESS: Hatalı dağıtıma ait tüm servisler, Nginx kayıtları, DNS tescilleri ve veritabanı başarıyla temizlendi.");
                    }
                    else
                    {
                        LogConsole("WARNING: Geri alma işlemi kısmen başarısız oldu.");
                    }
                }
                catch (Exception rollbackEx)
                {
                    LogConsole($"WARNING: Geri alma işlemi sırasında hata oluştu: {rollbackEx.Message}");
                }
            }
        }
        finally
        {
            _isUploadingFile = false;
            _isDeploying = false;
            StateHasChanged();
        }
    }

    private string GetSafeProjectName() => string.IsNullOrWhiteSpace(_projectName) ? "proje" : _projectName.Trim();

    private async Task<string> ParseErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var content = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(content))
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(content);
                    if (doc.RootElement.TryGetProperty("message", out var msg)) return msg.GetString() ?? content;
                    if (doc.RootElement.TryGetProperty("Message", out var msg2)) return msg2.GetString() ?? content;
                }
                catch
                {
                    // JSON ayrıştırılamadıysa (örneğin HTML dönmüşse) ham içeriği göster veya HTTP kodunu dön
                    return string.IsNullOrWhiteSpace(content) ? $"HTTP {(int)response.StatusCode}" : content;
                }
            }
            return string.IsNullOrWhiteSpace(content) ? $"HTTP {(int)response.StatusCode}" : content;
        }
        catch { return $"HTTP {(int)response.StatusCode}"; }
    }

    private string GetNginxConfig()
    {
        var serverName = string.IsNullOrWhiteSpace(_subdomain) ? _domain : $"{_subdomain}.{_domain}";
        return $@"server {{
    listen 80;
    server_name {serverName};
    location / {{
        proxy_pass http://127.0.0.1:{_port};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }}
}}";
    }

