    private string GetReadableUploadedSize()
    {
        if (_selectedFile == null) return "0 B";
        long uploaded = (long)(_selectedFile.Size * (_uploadPercentage / 100.0));
        return GetReadableBytes(uploaded);
    }

    private string GetReadableFileSize()
    {
        if (_selectedFile == null) return "0 B";
        return GetReadableBytes(_selectedFile.Size);
    }

    private string GetReadableBytes(long bytes)
    {
        string[] suffix = { "B", "KB", "MB", "GB", "TB" };
        int i;
        double dblBytes = bytes;
        for (i = 0; i < suffix.Length && bytes >= 1024; i++, bytes /= 1024)
        {
            dblBytes = bytes / 1024.0;
        }
        return $"{dblBytes:0.##} {suffix[i]}";
    }

    public class ProgressStream : System.IO.Stream
    {
        private readonly System.IO.Stream _innerStream;
        private readonly long _length;
        private readonly Func<long, long, Task> _onProgressAsync;
        private long _totalBytesRead = 0;

        public ProgressStream(System.IO.Stream innerStream, Func<long, long, Task> onProgressAsync)
        {
            _innerStream = innerStream;
            _length = innerStream.Length;
            _onProgressAsync = onProgressAsync;
        }

        public override bool CanRead => _innerStream.CanRead;
        public override bool CanSeek => _innerStream.CanSeek;
        public override bool CanWrite => _innerStream.CanWrite;
        public override long Length => _length;
        public override long Position
        {
            get => _innerStream.Position;
            set => _innerStream.Position = value;
        }

        public override void Flush() => _innerStream.Flush();

        public override int Read(byte[] buffer, int offset, int count)
        {
            int bytesRead = _innerStream.Read(buffer, offset, count);
            ReportProgressAsync(bytesRead).GetAwaiter().GetResult();
            return bytesRead;
        }

        public override async Task<int> ReadAsync(byte[] buffer, int offset, int count, CancellationToken cancellationToken)
        {
            int bytesRead = await _innerStream.ReadAsync(buffer, offset, count, cancellationToken);
            await ReportProgressAsync(bytesRead);
            return bytesRead;
        }

        public override async ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
        {
            int bytesRead = await _innerStream.ReadAsync(buffer, cancellationToken);
            await ReportProgressAsync(bytesRead);
            return bytesRead;
        }

        public override long Seek(long offset, SeekOrigin origin) => _innerStream.Seek(offset, origin);
        public override void SetLength(long value) => _innerStream.SetLength(value);
        public override void Write(byte[] buffer, int offset, int count) => _innerStream.Write(buffer, offset, count);

        private async Task ReportProgressAsync(int bytesRead)
        {
            if (bytesRead > 0)
            {
                _totalBytesRead += bytesRead;
                await _onProgressAsync(_totalBytesRead, _length);
            }
        }
    }
