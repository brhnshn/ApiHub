@page "/deploy-wizard"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<PageTitle>Canlı Dağıtım Sihirbazı - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık ve Tanıtım -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h2 class="text-2xl font-extrabold text-white tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles text-indigo-400 animate-pulse"></i> 
                Süper Canlı Dağıtım Sihirbazı
            </h2>
            <p class="text-xs text-slate-400 font-medium mt-1">
                ZIP dosyalarınızı yükleyin, port ve alan adı bilgilerini girin; gerisini ApiHub sunucuda tamamen otomatik yürütsün!
            </p>
        </div>
        
        <!-- Sekme Seçici (Dual Mode Toggle) -->
        <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800">
            <button @onclick='() => SetTab("auto")'
                class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(_activeTab == "auto" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/20" : "text-slate-400 hover:text-slate-200")">
                <i class="fa-solid fa-bolt"></i> Otomatik Dağıtım
            </button>
            <button @onclick='() => SetTab("manual")'
                class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(_activeTab == "manual" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/20" : "text-slate-400 hover:text-slate-200")">
                <i class="fa-solid fa-book-open"></i> Manuel Kılavuz
            </button>
        </div>
    </div>

    @if (_activeTab == "auto")
    {
        <!-- OTOMATİK CANLI DAĞITIM SİHİRBAZI -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Sol Sütun: Dağıtım Ayarları Formu -->
            <div class="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden backdrop-blur-md">
                <div class="flex items-center gap-2 border-b border-slate-850 pb-3 mb-4">
                    <i class="fa-solid fa-sliders text-indigo-400"></i>
                    <h3 class="font-bold text-white text-sm">1. Uygulama ve Domain Bilgileri</h3>
                </div>

                <div class="space-y-4">
                    <!-- Dağıtım Modu Seçici -->
                    <div>
                        <label class="block text-[10px] text-slate-400 font-semibold mb-1.5 uppercase tracking-wider">Dağıtım Modu</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" @onclick='() => _deployMode = "docker"'
                                class="@ModeButtonClass("docker")">
                                <i class="fa-brands fa-docker text-sm"></i>
                                <div class="text-left">
                                    <div class="text-[11px] font-extrabold leading-none">Docker</div>
                                    <div class="text-[8px] opacity-70 mt-0.5">Konteyner</div>
                                </div>
                            </button>
                            <button type="button" @onclick='() => _deployMode = "native"'
                                class="@ModeButtonClass("native")">
                                <i class="fa-regular fa-file-zip text-sm"></i>
                                <div class="text-left">
                                    <div class="text-[11px] font-extrabold leading-none">Native ZIP</div>
                                    <div class="text-[8px] opacity-70 mt-0.5">Süreç Yönetici</div>
                                </div>
                            </button>
                            <button type="button" @onclick='() => _deployMode = "static"'
                                class="@ModeButtonClass("static")">
                                <i class="fa-solid fa-code text-sm"></i>
                                <div class="text-left">
                                    <div class="text-[11px] font-extrabold leading-none">Statik Web</div>
                                    <div class="text-[8px] opacity-70 mt-0.5">Nginx Direct</div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Proje Adı -->
                    <div>
                        <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">Uygulama Adı</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500 text-xs">
                                <i class="fa-solid fa-cube"></i>
                            </span>
                            <input type="text" @bind="_projectName" @bind:event="oninput" placeholder="örn: bprojem" disabled="@_isDeploying"
                                class="w-full bg-slate-950 border border-slate-850 rounded-lg pl-9 pr-3 py-2 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500 transition-colors disabled:opacity-50">
                        </div>
                        <p class="text-[9px] text-slate-500 mt-1">Sadece küçük harfler, rakamlar, tire (-) veya alt çizgi (_).</p>
                    </div>

                    @if (_deployMode != "static")
                    {
                        <!-- Port Numarası -->
                        <div>
                            <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">İç Port Numarası</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500 text-xs">
                                    <i class="fa-solid fa-network-wired"></i>
                                </span>
                                <input type="number" @bind="_port" @bind:event="oninput" min="1024" max="65535" disabled="@_isDeploying"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg pl-9 pr-3 py-2 text-xs text-emerald-400 font-bold focus:outline-none focus:border-indigo-500 transition-colors disabled:opacity-50">
                            </div>
                            <p class="text-[9px] text-slate-500 mt-1">Sunucuda çalışacak projenizin dinleyeceği benzersiz boş bir port.</p>
                        </div>

                        <!-- CPU ve RAM Limitleri -->
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">RAM Limiti (MB)</label>
                                <input type="number" @bind="_memoryLimitMb" min="64" max="16384" disabled="@_isDeploying"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-semibold">
                            </div>
                            <div>
                                <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase tracking-wider">CPU Çekirdek</label>
                                <input type="number" @bind="_cpuCount" min="0.1" max="32" step="0.1" disabled="@_isDeploying"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-semibold">
                            </div>
                        </div>
                    }

                    <!-- Domain & Subdomain Bilgileri -->
                    <div class="border-t border-slate-850 pt-3 mt-1 space-y-3">
                        <label class="block text-[10px] text-indigo-400 font-bold uppercase tracking-wider">Nginx Subdomain Yönlendirmesi</label>
                        
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase">Subdomain</label>
                                <input type="text" @bind="_subdomain" @bind:event="oninput" placeholder="api" disabled="@_isDeploying"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50">
                            </div>
                            <div>
                                <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase">Ana Alan Adı (Domain)</label>
                                <select @bind="_domain" @bind:after="ApplySelectedRootDomainDefaults" disabled="@_isDeploying"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50">
                                    <option value="">Seçiniz...</option>
                                    @foreach (var rd in _rootDomains)
                                    {
                                        <option value="@rd.Name">@rd.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Let's Encrypt SSL Seçici -->
                        <div class="flex items-center justify-between bg-slate-950/40 p-2.5 rounded-lg border border-slate-850">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-shield-halved text-indigo-400 text-xs"></i>
                                <div>
                                    <div class="text-[10px] text-slate-200 font-bold leading-none">Let's Encrypt SSL Aktif Edilsin</div>
                                    <span class="text-[8px] text-slate-500">Alan adı için güvenli HTTPS bağlantısı kurar</span>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" @bind="_sslEnabled" id="sslCheckbox" disabled="@_isDeploying"
                                    class="w-4 h-4 bg-slate-950 border-slate-800 rounded focus:ring-indigo-500 text-indigo-600 disabled:opacity-50">
                            </div>
                        </div>
                    </div>

                    <!-- Cloudflare DNS A Kaydı Seçici -->
                    <div class="border-t border-slate-850 pt-3 mt-1 space-y-3">
                        <div class="flex items-center justify-between bg-slate-950/40 p-2.5 rounded-lg border border-slate-850">
                            <div class="flex items-center gap-2">
                                <i class="fa-brands fa-cloudflare text-orange-400 text-xs"></i>
                                <div>
                                    <div class="text-[10px] text-slate-200 font-bold leading-none">Cloudflare DNS A Kaydı Oluşturulsun</div>
                                    <span class="text-[8px] text-slate-500">Subdomain'i otomatik olarak sunucu IP'sine yönlendirir</span>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" @bind="_createDnsRecord" @bind:after="ApplySelectedRootDomainDefaults" id="cfDnsCheckbox" disabled="@_isDeploying"
                                    class="w-4 h-4 bg-slate-950 border-slate-800 rounded focus:ring-indigo-500 text-indigo-600 disabled:opacity-50">
                            </div>
                        </div>

                        @if (_createDnsRecord)
                        {
                            <div class="p-3 bg-slate-950/60 border border-slate-850/80 rounded-xl space-y-2 animate-fade-in">
                                <div>
                                    <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase">Sunucu IP Adresi</label>
                                    <input type="text" @bind="_serverIp" placeholder="örn: 85.95.23.10" disabled="@_isDeploying"
                                        class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-mono">
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase">Cloudflare API Token</label>
                                        <input type="password" @bind="_cfToken" placeholder="Token girin" disabled="@_isDeploying"
                                            class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-mono">
                                    </div>
                                    <div>
                                        <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase">Cloudflare Zone ID</label>
                                        <input type="text" @bind="_cfZoneId" placeholder="Zone ID girin" disabled="@_isDeploying"
                                            class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-mono">
                                    </div>
                                </div>
                                <div class="flex items-center justify-between bg-slate-900/60 p-2 rounded border border-slate-800">
                                    <span class="text-[9px] text-slate-400 font-bold uppercase">Cloudflare CDN Proxy (Proxied)</span>
                                    <input type="checkbox" @bind="_cfProxied" disabled="@_isDeploying"
                                        class="w-3.5 h-3.5 bg-slate-950 border-slate-800 rounded text-indigo-600 focus:ring-indigo-500">
                                </div>
                            </div>
                        }
                    </div>

                    <!-- PostgreSQL Veritabanı Seçici -->
                    <div class="border-t border-slate-850 pt-3 mt-1 space-y-3">
                        <div class="flex items-center justify-between bg-slate-950/40 p-2.5 rounded-lg border border-slate-850">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-database text-indigo-400 text-xs"></i>
                                <div>
                                    <div class="text-[10px] text-slate-200 font-bold leading-none">PostgreSQL Veritabanı Oluşturulsun</div>
                                    <span class="text-[8px] text-slate-500">Projeye özel veritabanı şeması ve kullanıcısı oluşturur</span>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" @bind="_createDatabase" @bind:after="UpdateDbDefaults" id="dbCheckbox" disabled="@_isDeploying"
                                    class="w-4 h-4 bg-slate-950 border-slate-800 rounded focus:ring-indigo-500 text-indigo-600 disabled:opacity-50">
                            </div>
                        </div>

                        @if (_createDatabase)
                        {
                            <div class="p-3 bg-slate-950/60 border border-slate-850/80 rounded-xl space-y-2 animate-fade-in">
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Veritabanı İsmi</label>
                                        <input type="text" @bind="_dbName" placeholder="örn: bprojem_db" disabled="@_isDeploying"
                                            class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-mono">
                                    </div>
                                    <div>
                                        <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Kullanıcı İsmi</label>
                                        <input type="text" @bind="_dbUser" placeholder="örn: bprojem_user" disabled="@_isDeploying"
                                            class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-mono">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Kullanıcı Şifresi</label>
                                    <div class="flex gap-1.5">
                                        <input type="text" @bind="_dbPassword" placeholder="Güçlü şifre girin veya üretin" disabled="@_isDeploying"
                                            class="flex-1 bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-emerald-400 focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-mono font-bold">
                                        <button type="button" @onclick="GenerateDbPassword" disabled="@_isDeploying"
                                            class="bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-400 border border-indigo-500/30 px-3 rounded-lg text-[10px] font-bold transition-colors">
                                            <i class="fa-solid fa-key"></i> Şifre Üret
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_deployMode == "docker")
                    {
                        <!-- Docker İmaj Adı -->
                        <div class="border-t border-slate-850 pt-3 mt-1">
                            <label class="block text-[10px] text-slate-400 font-semibold mb-1.5 uppercase tracking-wider">Docker İmaj Adı</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500 text-xs">
                                    <i class="fa-brands fa-docker"></i>
                                </span>
                                <input type="text" @bind="_dockerImageName" @bind:event="oninput" placeholder="örn: nginx:alpine, node:20-alpine" disabled="@_isDeploying"
                                    class="w-full bg-slate-950 border border-slate-850 rounded-lg pl-9 pr-3 py-2 text-xs text-indigo-300 font-mono font-bold focus:outline-none focus:border-indigo-500 transition-colors disabled:opacity-50">
                            </div>
                            <p class="text-[9px] text-slate-500 mt-1">Docker Hub imajı ve etiket — örn: <span class="font-mono text-indigo-400">node:20-alpine</span>, <span class="font-mono text-indigo-400">nginx:alpine</span></p>
                        </div>
                    }

                    @if (_deployMode == "native")
                    {
                        <!-- Çalışma Zamanı (Runtime) ve Başlangıç Ayarları -->
                        <div class="border-t border-slate-850 pt-3 mt-1 space-y-3">
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Çullanma Zamanı (Runtime)</label>
                                    <select @bind="_runtimeType" disabled="@_isDeploying"
                                        class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50">
                                        <option value="dotnet">.NET / C#</option>
                                        <option value="node">Node.js</option>
                                        <option value="python">Python</option>
                                        <option value="custom">Özel Komut (Custom)</option>
                                    </select>
                                </div>
                                
                                @if (_runtimeType == "custom")
                                {
                                    <div>
                                        <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Özel Çalıştırma Komutu</label>
                                        <input type="text" @bind="_customCommand" placeholder="örn: node index.js" disabled="@_isDeploying"
                                            class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-mono">
                                    </div>
                                }
                                else
                                {
                                    <div>
                                         <label class="block text-[9px] text-slate-400 font-semibold mb-1 uppercase font-bold">Giriş Dosyası (Entry File)</label>
                                         <input type="text" @bind="_entryFile" placeholder="@(_runtimeType == "dotnet" ? "örn: KütüphaneTakipWeb.dll (Uzantısız yazılırsa .dll otomatik eklenir)" : "örn: server.js veya app.py")" disabled="@_isDeploying"
                                             class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-indigo-500 disabled:opacity-50 font-mono">
                                     </div>
                                }
                            </div>
                        </div>
                    }

                    @if (_deployMode == "native" || _deployMode == "static")
                    {

                        <!-- ZIP Dosya Yükleyici -->
                        <div class="border-t border-slate-850 pt-3">
                            <label class="block text-[10px] text-slate-400 font-semibold mb-2 uppercase tracking-wider">Proje ZIP Arşivi</label>
                            
                            <div class="relative border-2 border-dashed rounded-xl transition-all flex flex-col items-center justify-center p-4 min-h-[90px] @(_isDeploying ? "pointer-events-none opacity-50" : "") @(_selectedFile != null ? "border-emerald-500/40 bg-emerald-950/5" : "border-slate-800 hover:border-indigo-500/40 bg-slate-950/50")">
                                @if (_selectedFile == null)
                                {
                                    <i class="fa-regular fa-file-zip text-2xl text-slate-500 animate-bounce mb-1"></i>
                                    <span class="text-[10px] text-slate-400 font-bold">Projeyi ZIP olarak buraya sürükleyin veya tıklayın</span>
                                    <span class="text-[8px] text-slate-600 font-semibold mt-0.5">Sadece .zip uzantılı (Max 200MB)</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-file-circle-check text-2xl text-emerald-400 mb-1"></i>
                                    <span class="text-[10px] text-slate-200 font-bold">@_selectedFile.Name</span>
                                    <span class="text-[8px] text-emerald-400 font-semibold mt-0.5">@((_selectedFile.Size / 1024.0 / 1024.0).ToString("F2")) MB - Dosya Hazır</span>
                                }
                                <InputFile OnChange="OnZipFileSelected" accept=".zip"
                                    style="position: absolute; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer;" />
                            </div>

                            @if (_isUploadingFile)
                            {
                                <div class="mt-2 bg-slate-950/60 border border-slate-850 p-2.5 rounded-xl space-y-1.5 animate-pulse">
                                    <div class="flex justify-between items-center text-[9px] font-bold uppercase tracking-wider">
                                        <span class="flex items-center gap-1.5 text-indigo-400">
                                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-ping"></span>
                                            Sunucuya Yükleniyor...
                                        </span>
                                        <span class="text-white font-mono font-bold">%@_uploadPercentage</span>
                                    </div>
                                    <div class="w-full bg-slate-900 h-1.5 rounded-full overflow-hidden border border-slate-800">
                                        <div class="bg-gradient-to-r from-indigo-500 to-emerald-400 h-full transition-all duration-300" style="width: @_uploadPercentage%"></div>
                                    </div>
                                    <div class="text-[8px] text-slate-500 font-semibold flex justify-between">
                                        <span>Sıkıştırılmış Paket</span>
                                        <span>@GetReadableUploadedSize() / @GetReadableFileSize()</span>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (_deployMode == "static")
                        {
                            <!-- PHP Desteği Switch Butonu (DeployWizard Uyumlu) -->
                            <div class="flex items-center justify-between bg-emerald-950/10 p-2.5 rounded-lg border border-emerald-500/10 mt-2">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-code text-emerald-400 text-xs"></i>
                                    <div>
                                        <div class="text-[10px] text-emerald-200 font-bold leading-none">PHP Desteği Aktif Edilsin</div>
                                        <span class="text-[8px] text-slate-500">Statik sitede upload.php gibi dinamik kodların çalışmasını sağlar</span>
                                    </div>
                                </div>
                                <div class="flex items-center">
                                    <input type="checkbox" @bind="_enablePhp" id="phpSupportCheckbox" disabled="@_isDeploying"
                                        class="w-4 h-4 bg-slate-950 border-slate-800 rounded focus:ring-emerald-500 text-emerald-600 disabled:opacity-50">
                                </div>
                            </div>
                        }
                    }

                    <!-- Çalıştırma Butonu -->
                    <button @onclick="StartAutomatedDeployment" disabled="@IsDeployDisabled"
                        class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs py-3 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 disabled:opacity-40 disabled:hover:bg-indigo-600 shadow-indigo-600/10">
                        @if (_isDeploying)
                        {
                            <span class="w-4 h-4 rounded-full border-2 border-t-transparent border-white animate-spin"></span>
                            <span>Dağıtım Sürüyor...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-play text-xs"></i>
                            <span>@DeployButtonText</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Sağ Sütun: Canlı Boru Hattı & Siber Terminal Konsolu -->
            <div class="lg:col-span-7 bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden flex flex-col min-h-[500px]">
                <div class="flex items-center justify-between border-b border-slate-850 pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-network-wired text-indigo-400"></i>
                        <h3 class="font-bold text-white text-sm">2. Canlı Dağıtım Boru Hattı</h3>
                    </div>
                    @if (_isDeploying)
                    {
                        <span class="text-[10px] bg-indigo-500/10 text-indigo-400 border border-indigo-500/25 px-2 py-0.5 rounded font-extrabold animate-pulse">AKTİF İŞLEM</span>
                    }
                    else if (_executionSuccess == true)
                    {
                        <span class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 px-2 py-0.5 rounded font-extrabold">BAŞARILI</span>
                    }
                    else if (_executionSuccess == false)
                    {
                        <span class="text-[10px] bg-rose-500/10 text-rose-400 border border-rose-500/25 px-2 py-0.5 rounded font-extrabold">HATA OLUŞTU</span>
                    }
                    else
                    {
                        <span class="text-[10px] text-slate-500 font-extrabold uppercase">Beklemede</span>
                    }
                </div>

                <!-- 6 Aşamalı Pipeline Görsel Aşamaları -->
                <div class="grid grid-cols-6 gap-1.5 mb-5">
                    <div class="p-1.5 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(1))">
                        <i class="fa-solid fa-database text-xs mb-0.5"></i>
                        <span class="text-[8px] font-bold leading-tight">1. DB Yarat</span>
                        <span class="text-[6px] opacity-70 mt-0.5">PostgreSQL</span>
                    </div>

                    <div class="p-1.5 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(2))">
                        <i class="fa-brands fa-cloudflare text-xs mb-0.5"></i>
                        <span class="text-[8px] font-bold leading-tight">2. DNS Ekle</span>
                        <span class="text-[6px] opacity-70 mt-0.5">Cloudflare</span>
                    </div>

                    <div class="p-1.5 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(3))">
                        <i class="@Step3Icon text-xs mb-0.5"></i>
                        <span class="text-[8px] font-bold leading-tight">@Step3Label</span>
                        <span class="text-[6px] opacity-70 mt-0.5">@Step3Sub</span>
                    </div>

                    <div class="p-1.5 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(4))">
                        <i class="@Step4Icon text-xs mb-0.5"></i>
                        <span class="text-[8px] font-bold leading-tight">@Step4Label</span>
                        <span class="text-[6px] opacity-70 mt-0.5">@Step4Sub</span>
                    </div>

                    <div class="p-1.5 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(5))">
                        <i class="fa-solid fa-server text-xs mb-0.5"></i>
                        <span class="text-[8px] font-bold leading-tight">5. Nginx vHost</span>
                        <span class="text-[6px] opacity-70 mt-0.5">Proxy</span>
                    </div>

                    <div class="p-1.5 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(6))">
                        <i class="fa-solid fa-shield-halved text-xs mb-0.5"></i>
                        <span class="text-[8px] font-bold leading-tight">6. SSL Kur</span>
                        <span class="text-[6px] opacity-70 mt-0.5">Let's Encrypt</span>
                    </div>
                </div>

                <!-- Canlı Siber-Terminal Log Kutusu -->
                <div class="flex-1 flex flex-col min-h-[220px]">
                    <div class="flex justify-between items-center text-[10px] text-slate-500 font-extrabold uppercase mb-1">
                        <span>Sunucu Dağıtım Konsolu (Stdout Log Akışı)</span>
                        <button @onclick="ClearConsole" disabled="@_isDeploying" class="hover:text-indigo-400 font-bold">Konsolu Temizle</button>
                    </div>

                    <div class="flex-1 bg-slate-950 border border-slate-850 p-4 rounded-xl shadow-inner font-mono text-[11px] leading-relaxed overflow-y-auto max-h-[300px] flex flex-col gap-1 text-emerald-400 cyber-terminal shadow-black/40">
                        @if (_terminalLogs.Count == 0)
                        {
                            <span class="text-slate-500 italic text-[10px]">// Otomatik dağıtımı başlattığınızda canlı işlem logları burada akacaktır.</span>
                        }
                        else
                        {
                            @foreach (var log in _terminalLogs)
                            {
                                @if (log.Contains("SUCCESS"))
                                {
                                    <span class="text-emerald-400 font-semibold">@log</span>
                                }
                                else if (log.Contains("ERROR") || log.Contains("HATA") || log.Contains("FAILD"))
                                {
                                    <span class="text-rose-400 font-semibold">@log</span>
                                }
                                else if (log.StartsWith("["))
                                {
                                    <span class="text-slate-400 font-bold">@log</span>
                                }
                                else
                                {
                                    <span class="text-indigo-300 font-medium">@log</span>
                                }
                            }
                        }
                    </div>
                </div>

                <!-- PostgreSQL Bağlantı Detayları (Konsolun Hemen Altında) -->
                @if (_executionSuccess == true && _createDatabase)
                {
                    <div class="mt-4 p-3 bg-slate-950/80 rounded-xl space-y-2" style="background-color: #040815 !important; border: 1.5px solid rgba(99, 102, 241, 0.2) !important;">
                        <div class="flex justify-between items-center text-[9px] text-indigo-400 font-bold uppercase tracking-wider">
                            <span class="flex items-center gap-1.5"><i class="fa-solid fa-database animate-pulse"></i> PostgreSQL Bağlantı Detayları</span>
                            <button @onclick='() => CopyText($"Host=127.0.0.1;Port=5432;Database={_dbName};Username={_dbUser};Password={_dbPassword};")'
                                class="hover:text-white transition-colors text-[8px] bg-indigo-600/25 px-2 py-0.5 rounded border border-indigo-500/25 font-bold">
                                <i class="fa-regular fa-copy"></i> Bağlantı Metnini Kopyala
                            </button>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-[10px] leading-relaxed">
                            <div class="p-1.5 rounded border" style="background-color: #0c1225 !important; color: #e2e8f0 !important; border: 1px solid #1e293b !important;">
                                <span class="text-slate-400 font-semibold">DB Adı:</span> <span class="text-emerald-400 font-mono font-bold ml-1">@_dbName</span>
                            </div>
                            <div class="p-1.5 rounded border" style="background-color: #0c1225 !important; color: #e2e8f0 !important; border: 1px solid #1e293b !important;">
                                <span class="text-slate-400 font-semibold">Kullanıcı:</span> <span class="text-emerald-400 font-mono font-bold ml-1">@_dbUser</span>
                            </div>
                        </div>
                        <div class="p-1.5 rounded border text-[10px] flex justify-between items-center" style="background-color: #0c1225 !important; color: #e2e8f0 !important; border: 1px solid #1e293b !important;">
                            <div>
                                <span class="text-slate-400 font-semibold">Şifre:</span> <span class="text-emerald-400 font-mono font-bold ml-1">@_dbPassword</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Sonuç & Canlı Link Kartı -->
                @if (_executionSuccess == true)
                {
                    <div class="mt-4 p-4 bg-emerald-950/20 border border-emerald-500/20 rounded-xl flex flex-col gap-3 animate-fade-in text-left">
                        <div class="flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <span class="w-8 h-8 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
                                    <i class="fa-solid fa-circle-check animate-bounce"></i>
                                </span>
                                <div>
                                    <h4 class="text-xs font-extrabold text-white uppercase tracking-wider">Tebrikler! Dağıtım Tamamlandı</h4>
                                    <p class="text-[10px] text-slate-400 mt-0.5">Uygulama başarıyla sunucuya kuruldu ve internete açıldı.</p>
                                    <a href="https://@_subdomain.@_domain" target="_blank" class="text-xs text-emerald-400 hover:text-emerald-300 font-bold underline inline-flex items-center gap-1 mt-1">
                                        https://@_subdomain.@_domain <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                                    </a>
                                </div>
                            </div>
                            <button @onclick='() => SetTab("manual")' class="bg-indigo-600/10 hover:bg-indigo-600/20 text-indigo-400 text-[10px] border border-indigo-500/20 px-3 py-1.5 rounded-lg font-bold shrink-0">
                                Manuel Kılavuza Git
                            </button>
                        </div>
                    </div>
                }
                else if (_executionSuccess == false)
                {
                    <div class="mt-4 p-4 bg-rose-950/20 border border-rose-500/20 rounded-xl flex items-center gap-3 animate-fade-in">
                        <span class="w-8 h-8 rounded-full bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </span>
                        <div>
                            <h4 class="text-xs font-extrabold text-white uppercase tracking-wider">Dağıtım Başarısız Oldu</h4>
                            <p class="text-[10px] text-rose-300 font-medium mt-0.5">@_errorMessage</p>
                            <span class="text-[9px] text-slate-500">Lütfen yukarıdaki hata loglarını ve port doluluk durumunu kontrol ederek tekrar deneyin.</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- MANUEL DAĞITIM KILAVUZU -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl backdrop-blur-md mb-6">
            <div class="flex justify-between items-center border-b border-slate-850 pb-3 mb-4">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-book text-indigo-400"></i>
                    <h3 class="font-bold text-white text-sm">3. Manuel Dağıtım Kılavuz Modu</h3>
                </div>
                <button @onclick='() => SetTab("auto")' class="text-indigo-400 hover:text-indigo-300 font-bold text-xs">
                    <i class="fa-solid fa-arrow-left"></i> Otomatik Moda Dön
                </button>
            </div>
            
            <!-- İnteraktif Parametre Formu -->
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-850/80 mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase">Proje / Uygulama Adı</label>
                    <input type="text" @bind="_projectName" @bind:event="oninput" placeholder="bTest"
                        class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase">Çalışma Portu</label>
                    <input type="number" @bind="_port" @bind:event="oninput"
                        class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-emerald-400 font-bold focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-[10px] text-slate-400 font-semibold mb-1 uppercase">Subdomain / Domain</label>
                    <div class="flex gap-1">
                        <input type="text" @bind="_subdomain" @bind:event="oninput" placeholder="api" class="w-1/3 bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white">
                        <select @bind="_domain" @bind:after="ApplySelectedRootDomainDefaults" class="w-2/3 bg-slate-900 border border-slate-800 rounded-lg p-2 text-xs text-white">
                            <option value="">Seçiniz...</option>
                            @foreach (var rd in _rootDomains)
                            {
                                <option value="@rd.Name">@rd.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Adım Stepper Görünümü -->
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Sol Menü: Adım Seçici -->
                <div class="lg:col-span-1 space-y-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var stepIndex = i;
                        <button @onclick="() => SetStep(stepIndex)" class="w-full text-left p-3 rounded-xl border transition-all duration-200 flex items-center gap-3 @( _currentStep == stepIndex ? "bg-indigo-600 border-indigo-500 text-white shadow-lg" : "bg-slate-950 border-slate-850 text-slate-400 hover:text-slate-200" )">
                            <span class="w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold @( _currentStep == stepIndex ? "bg-white text-indigo-600" : "bg-slate-800 text-slate-400" )">@stepIndex</span>
                            <div>
                                <div class="text-[11px] font-bold leading-none">Adım @stepIndex: @GetStepTitle(stepIndex)</div>
                            </div>
                        </button>
                    }
                </div>

                <!-- Sağ Detay -->
                <div class="lg:col-span-3 bg-slate-950 border border-slate-850 rounded-xl p-5 shadow-2xl min-h-[360px] flex flex-col justify-between">
                    <div>
                        @if (_currentStep == 1)
                        {
                            <div class="space-y-3">
                                <h4 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-file-arrow-up text-indigo-400"></i> Dizin Hazırlığı</h4>
                                <pre class="bg-slate-900 border border-slate-800 p-3 rounded-lg text-[10px] text-slate-300 font-mono overflow-x-auto">cd /var/www/apps && mkdir -p @GetSafeProjectName()</pre>
                            </div>
                        }
                        else if (_currentStep == 2)
                        {
                            <div class="space-y-3">
                                <h4 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-vial text-emerald-400"></i> Port Atama</h4>
                                <p class="text-xs text-slate-400">Port hedefi: @_port</p>
                            </div>
                        }
                        else if (_currentStep == 3)
                        {
                            <div class="space-y-3">
                                <h4 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-brands fa-docker text-indigo-400"></i> Entegrasyon</h4>
                                <p class="text-xs text-slate-400">Docker imajı arka planda çekilecek: @_dockerImageName</p>
                            </div>
                        }
                        else if (_currentStep == 4)
                        {
                            <div class="space-y-3">
                                <h4 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-arrows-spin text-indigo-400"></i> Servis Yönetimi</h4>
                                <pre class="bg-slate-900 border border-slate-800 p-3 rounded-lg text-[10px] text-slate-300 font-mono">docker ps -a</pre>
                            </div>
                        }
                        else if (_currentStep == 5)
                        {
                            <div class="space-y-3">
                                <h4 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-share-nodes text-indigo-400"></i> Nginx Yapılandırması</h4>
                                <pre class="bg-slate-900 border border-slate-800 p-2.5 rounded-lg text-[9px] text-slate-400 font-mono leading-tight h-32 overflow-y-auto">@GetNginxConfig()</pre>
                            </div>
                        }
                    </div>

                    <!-- Kılavuz Alt Butonlar -->
                    <div class="flex justify-between items-center border-t border-slate-800 pt-3 mt-4">
                        <button @onclick="PrevStep" disabled="@(_currentStep == 1)" class="bg-slate-850 hover:bg-slate-800 text-slate-300 disabled:opacity-40 text-[10px] font-bold px-3 py-1.5 rounded-lg flex items-center gap-1 transition-all">Önceki</button>
                        <span class="text-[10px] text-slate-500 font-extrabold">@_currentStep / 5</span>
                        <button @onclick="NextStep" disabled="@(_currentStep == 5)" class="bg-indigo-600 hover:bg-indigo-500 text-white text-[10px] font-bold px-3 py-1.5 rounded-lg flex items-center gap-1 transition-all">Sonraki</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _activeTab = "auto";
    private int _currentStep = 1;

    private string _deployMode = "docker";
    private string _dockerImageName = "nginx:alpine";

    private string _projectName = "btest";
    private string _subdomain = "api";
    private string _domain = "";
    private int _port = 80;

    private List<RootDomainDto> _rootDomains = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rawRoots = await Http.GetFromJsonAsync<List<RootDomainDto>>("api/domains/roots");
            _rootDomains = rawRoots ?? new List<RootDomainDto>();
            if (_rootDomains.Any())
            {
                _domain = _rootDomains.First().Name;
                ApplySelectedRootDomainDefaults();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading root domains: {ex.Message}");
        }
    }
    private int _memoryLimitMb = 512;
    private double _cpuCount = 1.0;
    private bool _sslEnabled = true;

    private bool _createDnsRecord = false;
    private string _serverIp = string.Empty;
    private string _cfToken = string.Empty;
    private string _cfZoneId = string.Empty;
    private bool _cfProxied = true;

    private bool _createDatabase = false;
    private string _dbName = string.Empty;
    private string _dbUser = string.Empty;
    private string _dbPassword = string.Empty;

    private string _runtimeType = "dotnet";
    private string _entryFile = string.Empty;
    private string _customCommand = string.Empty;
    private bool _enablePhp = false;

    private IBrowserFile? _selectedFile;

    private bool _isDeploying = false;
    private int _activePipelineStep = 0; 
    private List<string> _terminalLogs = new();
    private bool? _executionSuccess = null;
    private string _errorMessage = string.Empty;
    private int _uploadPercentage = 0;
    private bool _isUploadingFile = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (await LoadSavedCloudflareSettingsAsync())
                {
                    StateHasChanged();
                }
            }
            catch
            {
                // JS Interop fallback
            }
        }
    }

    private void SetTab(string tab) => _activeTab = tab;
    private void SetStep(int step) => _currentStep = step;
    private void PrevStep() { if (_currentStep > 1) _currentStep--; }
    private void NextStep() { if (_currentStep < 5) _currentStep++; }

    private async Task<bool> LoadSavedCloudflareSettingsAsync()
    {
        var savedToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "cf_token");
        var savedZoneId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "cf_zone_id");
        var savedIp = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "cf_server_ip");

        var updated = false;
        if (string.IsNullOrWhiteSpace(_cfToken) && !string.IsNullOrWhiteSpace(savedToken)) { _cfToken = savedToken; updated = true; }
        if (string.IsNullOrWhiteSpace(_cfZoneId) && !string.IsNullOrWhiteSpace(savedZoneId)) { _cfZoneId = savedZoneId; updated = true; }
        if (string.IsNullOrWhiteSpace(_serverIp) && !string.IsNullOrWhiteSpace(savedIp)) { _serverIp = savedIp; updated = true; }

        return updated;
    }

    private void ApplySelectedRootDomainDefaults()
    {
        var selectedRoot = _rootDomains.FirstOrDefault(d => d.Name.Equals(_domain, StringComparison.OrdinalIgnoreCase));
        if (selectedRoot == null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(selectedRoot.CloudflareToken))
        {
            _cfToken = selectedRoot.CloudflareToken;
        }

        if (!string.IsNullOrWhiteSpace(selectedRoot.CloudflareZoneId))
        {
            _cfZoneId = selectedRoot.CloudflareZoneId;
        }
    }

    private void GenerateDbPassword()
    {
        const string chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        var random = new Random();
        _dbPassword = new string(Enumerable.Repeat(chars, 12).Select(s => s[random.Next(s.Length)]).ToArray());
        StateHasChanged();
    }

    private string ModeButtonClass(string mode)
    {
        const string active   = "p-2.5 rounded-xl border flex items-center gap-2 text-xs font-bold transition-all bg-indigo-600/15 border-indigo-500/40 text-indigo-300";
        const string inactive = "p-2.5 rounded-xl border flex items-center gap-2 text-xs font-bold transition-all bg-slate-950/60 border-slate-800 text-slate-500 hover:text-slate-300";
        return _deployMode == mode ? active : inactive;
    }

    private bool IsDeployDisabled =>
        _isDeploying ||
        (_deployMode == "native" && _selectedFile == null) ||
        (_deployMode == "static" && _selectedFile == null) ||
        (_deployMode == "docker" && string.IsNullOrWhiteSpace(_dockerImageName));

    private string DeployButtonText => _deployMode == "docker" ? "Docker Konteyner Kur & Yayınla" : (_deployMode == "static" ? "Statik Web Sitesi Kur & Yayınla" : "Otomatik Dağıtımı Başlat");
    private string Step3Icon  => _deployMode == "docker" ? "fa-brands fa-docker" : "fa-regular fa-file-zip";
    private string Step3Label => _deployMode == "docker" ? "3. Docker Pull" : "3. ZIP Çıkar";
    private string Step3Sub   => _deployMode == "docker" ? "hub.docker.com" : "/var/www/";
    private string Step4Icon  => _deployMode == "docker" ? "fa-solid fa-play" : (_deployMode == "static" ? "fa-solid fa-folder-open" : "fa-solid fa-gears");
    private string Step4Label => _deployMode == "docker" ? "4. Konteyner" : (_deployMode == "static" ? "4. Statik Dizin" : "4. Daemon");
    private string Step4Sub   => _deployMode == "docker" ? "docker run" : (_deployMode == "static" ? "Direct Serv" : "projects.conf");

    private string GetStepTitle(int step) => step switch {
        1 => "Dizin Hazırlığı",
        2 => _deployMode == "static" ? "Statik Ayarlar" : "Port Ayarları",
        3 => "Entegrasyon Hattı",
        4 => _deployMode == "static" ? "Statik Dizin" : "Servis Kontrolü",
        5 => "Nginx Proxy",
        _ => "Bilinmeyen Adım"
    };

    private void UpdateDbDefaults()
    {
        var baseName = GetSafeProjectName();
        var cleanBase = new string(baseName.Where(c => char.IsLetterOrDigit(c) || c == '_').ToArray());
        _dbName = $"{cleanBase}_db";
        _dbUser = $"{cleanBase}_user";
        if (string.IsNullOrEmpty(_dbPassword)) GenerateDbPassword();
        StateHasChanged();
    }

    private void OnZipFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        if (_selectedFile != null && !string.IsNullOrWhiteSpace(_selectedFile.Name))
        {
            var cleanName = System.IO.Path.GetFileNameWithoutExtension(_selectedFile.Name)
                .ToLower().Replace(" ", "-").Replace("_", "-");
            
            _projectName = new string(cleanName.Where(c => char.IsLetterOrDigit(c) || c == '-' || c == '_').ToArray());
            if (!_projectName.StartsWith("b")) _projectName = "b" + _projectName;
            UpdateDbDefaults();
        }
    }

    private string GetStepClass(int step)
    {
        if (_activePipelineStep == 0) return "bg-slate-950/40 border-slate-850 text-slate-500";
        if (_activePipelineStep > step) return "bg-emerald-500/10 border-emerald-500/30 text-emerald-400 font-bold";
        if (_activePipelineStep == step)
        {
            return _executionSuccess == false 
                ? "bg-rose-500/10 border-rose-500/30 text-rose-400 font-bold animate-pulse" 
                : "bg-indigo-500/10 border-indigo-500/30 text-indigo-400 font-bold animate-pulse";
        }
        return "bg-slate-950/40 border-slate-850 text-slate-500";
    }

    private void LogConsole(string message)
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss");
        _terminalLogs.Add($"[{timestamp}] {message}");
        StateHasChanged();
    }

    private void ClearConsole()
    {
        _terminalLogs.Clear();
        _executionSuccess = null;
        _activePipelineStep = 0;
        _errorMessage = string.Empty;
    }

    private async Task StartAutomatedDeployment()
    {
        // ... Validasyon logicleri aynen korunuyor ...
        if (string.IsNullOrWhiteSpace(_projectName)) return; 

        ClearConsole();
        _isDeploying = true;
        _executionSuccess = null;
        StateHasChanged();

        Guid projectId = Guid.Empty;
        Guid subdomainId = Guid.Empty;

        try
        {
            // ADIM 3 & 4: Proje / Konteyner Ayağa Kaldırma
            _activePipelineStep = 3;
            ProjectCardDto? createdProject = null;

            if (_deployMode == "docker")
            {
                LogConsole($"INFO: Docker imajı çekiliyor ve konteyner hazırlanıyor: {_dockerImageName}");
                
                var dockerPayload = new CreateDockerModel
                {
                    Name = _projectName.ToLower(),
                    ImageName = _dockerImageName.Trim(),
                    MemoryLimitBytes = (long)_memoryLimitMb * 1048576,
                    CpuCount = _cpuCount,
                    InternalPort = _port
                };

                var dockerResponse = await Http.PostAsJsonAsync("api/projects/container", dockerPayload);
                if (!dockerResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(dockerResponse));

                createdProject = await dockerResponse.Content.ReadFromJsonAsync<ProjectCardDto>();
                if (createdProject == null) throw new Exception("Geçersiz API yanıtı.");
                projectId = createdProject.Id;

                _activePipelineStep = 4;
                LogConsole($"SUCCESS: Docker Konteyner başarıyla ayağa kalktı.");
            }
            else if (_deployMode == "static")
            {
                using var staticContent = new MultipartFormDataContent();
                staticContent.Add(new StringContent(_projectName.ToLower()), "Name");
                staticContent.Add(new StringContent(_enablePhp.ToString()), "EnablePhp");

                _uploadPercentage = 0;
                _isUploadingFile = true;
                StateHasChanged();

                var fileStream = _selectedFile!.OpenReadStream(maxAllowedSize: MaxZipUploadBytes);
                var progressStream = new ProgressStream(fileStream, async (bytesRead, totalBytes) =>
                {
                    _uploadPercentage = (int)((bytesRead * 100) / totalBytes);
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1);
                });

                var streamContent = new StreamContent(progressStream);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
                staticContent.Add(streamContent, "ZipFile", _selectedFile.Name);

                LogConsole($"INFO: Statik ZIP arşivi yükleniyor...");

                var requestMessage = new HttpRequestMessage(HttpMethod.Post, "api/projects/static-deploy")
                {
                    Content = staticContent
                };

                var projectResponse = await Http.SendAsync(requestMessage);
                
                _isUploadingFile = false;
                StateHasChanged();

                if (!projectResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(projectResponse));

                createdProject = await projectResponse.Content.ReadFromJsonAsync<ProjectCardDto>();
                projectId = createdProject!.Id;

                _activePipelineStep = 4;
                LogConsole($"SUCCESS: Statik ZIP sunucuya açıldı.");
            }
            else
            {
                using var nativeContent = new MultipartFormDataContent();
                nativeContent.Add(new StringContent(_projectName.ToLower()), "Name");
                nativeContent.Add(new StringContent(((long)_memoryLimitMb * 1048576).ToString()), "MemoryLimitBytes");
                nativeContent.Add(new StringContent(_cpuCount.ToString()), "CpuCount");
                nativeContent.Add(new StringContent(_port.ToString()), "InternalPort");
                nativeContent.Add(new StringContent(_runtimeType ?? "dotnet"), "RuntimeType");

                if (!string.IsNullOrWhiteSpace(_entryFile))
                {
                    nativeContent.Add(new StringContent(_entryFile.Trim()), "EntryFile");
                }
                if (!string.IsNullOrWhiteSpace(_customCommand))
                {
                    nativeContent.Add(new StringContent(_customCommand.Trim()), "CustomCommand");
                }

                _uploadPercentage = 0;
                _isUploadingFile = true;
                StateHasChanged();

                var fileStream = _selectedFile!.OpenReadStream(maxAllowedSize: MaxZipUploadBytes);
                var progressStream = new ProgressStream(fileStream, async (bytesRead, totalBytes) =>
                {
                    _uploadPercentage = (int)((bytesRead * 100) / totalBytes);
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1); // Yield thread to allow Blazor to redraw UI progress bar
                });

                var streamContent = new StreamContent(progressStream);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
                nativeContent.Add(streamContent, "ZipFile", _selectedFile.Name);

                LogConsole($"INFO: ZIP arşivi yükleniyor...");

                var requestMessage = new HttpRequestMessage(HttpMethod.Post, "api/projects/native-deploy")
                {
                    Content = nativeContent
                };

                var projectResponse = await Http.SendAsync(requestMessage);
                
                _isUploadingFile = false;
                StateHasChanged();

                if (!projectResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(projectResponse));

                createdProject = await projectResponse.Content.ReadFromJsonAsync<ProjectCardDto>();
                projectId = createdProject!.Id;

                _activePipelineStep = 4;
                LogConsole($"SUCCESS: ZIP sunucuya açıldı.");
            }

            // ADIM 1: DB Yaratma
            _activePipelineStep = 1;
            if (_createDatabase)
            {
                LogConsole($"INFO: PostgreSQL veritabanı oluşturuluyor... {_dbName}");
                var dbPayload = new CreateDatabaseModel { ProjectId = projectId, DbName = _dbName, DbUser = _dbUser, DbPassword = _dbPassword };
                var dbResponse = await Http.PostAsJsonAsync("api/databases", dbPayload);
                if (!dbResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(dbResponse));
                LogConsole($"SUCCESS: Veritabanı oluşturuldu.");
            }

            // ADIM 2: DNS
            _activePipelineStep = 2;
            if (_createDnsRecord)
            {
                await SaveCloudflareSettingsAsync();
                var dnsName = $"{_subdomain}.{_domain}";
                var dnsPayload = new CreateDnsModel { ProjectId = projectId, Name = dnsName, Value = _serverIp, Proxied = _cfProxied, UseCloudflare = true, CloudflareToken = _cfToken, CloudflareZoneId = _cfZoneId };
                var dnsResponse = await Http.PostAsJsonAsync("api/dns", dnsPayload);
                if (!dnsResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(dnsResponse));
                LogConsole($"SUCCESS: DNS A kaydı tescil edildi.");
            }

            // ADIM 5: Nginx Proxy
            _activePipelineStep = 5;
            var subdomainPayload = new CreateSubdomainModel { ProjectId = projectId, SubdomainName = _subdomain.ToLower(), DomainName = _domain.ToLower(), SslEnabled = _sslEnabled, ExternalPort = _port };
            var nginxResponse = await Http.PostAsJsonAsync("api/nginx", subdomainPayload);
            if (!nginxResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(nginxResponse));
            
            var resSub = await nginxResponse.Content.ReadFromJsonAsync<SubdomainDto>();
            subdomainId = resSub!.Id;
            LogConsole("SUCCESS: Nginx Reverse Proxy yapılandırıldı.");

            // ADIM 6: SSL
            _activePipelineStep = 6;
            if (_sslEnabled)
            {
                var sslResponse = await Http.PostAsync($"api/nginx/{subdomainId}/ssl", null);
                if (!sslResponse.IsSuccessStatusCode) throw new Exception(await ParseErrorAsync(sslResponse));
                LogConsole("SUCCESS: Let's Encrypt SSL aktif edildi.");
            }

            _activePipelineStep = 7;
            _executionSuccess = true;
            Snackbar.Add("Otomatik dağıtım başarıyla tamamlandı.", Severity.Success);
        }
        catch (Exception ex)
        {
            _executionSuccess = false;
            _errorMessage = ex.Message;
            LogConsole($"ERROR: İşlem başarısız. Hata: {ex.Message}");
        }
        finally
        {
            _isDeploying = false;
            StateHasChanged();
        }
    }

    private string GetSafeProjectName() => string.IsNullOrWhiteSpace(_projectName) ? "proje" : _projectName.Trim();

    private async Task<string> ParseErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var content = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(content))
            {
                using var doc = System.Text.Json.JsonDocument.Parse(content);
                if (doc.RootElement.TryGetProperty("message", out var msg)) return msg.GetString() ?? content;
            }
            return content;
        }
        catch { return $"HTTP {(int)response.StatusCode}"; }
    }

    private string GetNginxConfig() => $@"server {{
    listen 80;
    server_name {_subdomain}.{_domain};
    location / {{
        proxy_pass http://127.0.0.1:{_port};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }}
}}";

    private async Task CopyText(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Snackbar.Add("Kopyalandı!", Severity.Success);
    }

    // ─── Modeller ────────────────────────────────────────────────────────────
    private async Task SaveCloudflareSettingsAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "cf_token", _cfToken ?? string.Empty);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "cf_zone_id", _cfZoneId ?? string.Empty);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "cf_server_ip", _serverIp ?? string.Empty);
        }
        catch
        {
            // localStorage is a convenience cache; deployment should continue without it.
        }
    }

    public class ProjectCardDto { public Guid Id { get; set; } public string Name { get; set; } = ""; public string ImageOrPath { get; set; } = ""; public bool EnablePhp { get; set; } }
    public class CreateSubdomainModel { public Guid? ProjectId { get; set; } public string SubdomainName { get; set; } = ""; public string DomainName { get; set; } = ""; public bool SslEnabled { get; set; } public int? ExternalPort { get; set; } }
    public class SubdomainDto { public Guid Id { get; set; } public string SubdomainName { get; set; } = ""; public string DomainName { get; set; } = ""; }
    public class CreateDatabaseModel { public Guid? ProjectId { get; set; } public string DbName { get; set; } = ""; public string DbUser { get; set; } = ""; public string DbPassword { get; set; } = ""; }
    public class CreateDnsModel { public Guid? ProjectId { get; set; } public string Type { get; set; } = "A"; public string Name { get; set; } = ""; public string Value { get; set; } = ""; public int Ttl { get; set; } = 3600; public bool Proxied { get; set; } = true; public bool UseCloudflare { get; set; } = false; public string CloudflareToken { get; set; } = ""; public string CloudflareZoneId { get; set; } = ""; }
    public class CreateDockerModel { public string Name { get; set; } = ""; public string ImageName { get; set; } = ""; public long MemoryLimitBytes { get; set; } public double CpuCount { get; set; } public int InternalPort { get; set; } }
    public class RootDomainDto { public Guid Id { get; set; } public string Name { get; set; } = ""; public string? CloudflareToken { get; set; } public string? CloudflareZoneId { get; set; } }

    private const long MaxZipUploadBytes = 200L * 1024 * 1024;

    // ─── Yükleme Telemetrisi & Progress Stream Sınıfı ─────────────────────────
    private string GetReadableUploadedSize()
    {
        if (_selectedFile == null) return "0 B";
        long uploaded = (long)(_selectedFile.Size * (_uploadPercentage / 100.0));
        return GetReadableBytes(uploaded);
    }

    private string GetReadableFileSize()
    {
        if (_selectedFile == null) return "0 B";
        return GetReadableBytes(_selectedFile.Size);
    }

    private string GetReadableBytes(long bytes)
    {
        string[] suffix = { "B", "KB", "MB", "GB", "TB" };
        int i;
        double dblBytes = bytes;
        for (i = 0; i < suffix.Length && bytes >= 1024; i++, bytes /= 1024)
        {
            dblBytes = bytes / 1024.0;
        }
        return $"{dblBytes:0.##} {suffix[i]}";
    }

    public class ProgressStream : System.IO.Stream
    {
        private readonly System.IO.Stream _innerStream;
        private readonly long _length;
        private readonly Func<long, long, Task> _onProgressAsync;
        private long _totalBytesRead = 0;

        public ProgressStream(System.IO.Stream innerStream, Func<long, long, Task> onProgressAsync)
        {
            _innerStream = innerStream;
            _length = innerStream.Length;
            _onProgressAsync = onProgressAsync;
        }

        public override bool CanRead => _innerStream.CanRead;
        public override bool CanSeek => _innerStream.CanSeek;
        public override bool CanWrite => _innerStream.CanWrite;
        public override long Length => _length;
        public override long Position
        {
            get => _innerStream.Position;
            set => _innerStream.Position = value;
        }

        public override void Flush() => _innerStream.Flush();

        public override int Read(byte[] buffer, int offset, int count)
        {
            int bytesRead = _innerStream.Read(buffer, offset, count);
            ReportProgressAsync(bytesRead).GetAwaiter().GetResult();
            return bytesRead;
        }

        public override async Task<int> ReadAsync(byte[] buffer, int offset, int count, CancellationToken cancellationToken)
        {
            int bytesRead = await _innerStream.ReadAsync(buffer, offset, count, cancellationToken);
            await ReportProgressAsync(bytesRead);
            return bytesRead;
        }

        public override async ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
        {
            int bytesRead = await _innerStream.ReadAsync(buffer, cancellationToken);
            await ReportProgressAsync(bytesRead);
            return bytesRead;
        }

        public override long Seek(long offset, SeekOrigin origin) => _innerStream.Seek(offset, origin);
        public override void SetLength(long value) => _innerStream.SetLength(value);
        public override void Write(byte[] buffer, int offset, int count) => _innerStream.Write(buffer, offset, count);

        private async Task ReportProgressAsync(int bytesRead)
        {
            if (bytesRead > 0)
            {
                _totalBytesRead += bytesRead;
                await _onProgressAsync(_totalBytesRead, _length);
            }
        }
    }
}
