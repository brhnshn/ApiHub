@page "/deploy-wizard"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<PageTitle>Canlı Dağıtım Sihirbazı - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık ve Tanıtım -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="eyebrow">Dağıtım ve Yayına Alma</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">Canlı Dağıtım Sihirbazı</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">
                ZIP dosyalarınızı yükleyin, port ve alan adı bilgilerini girin; gerisini ApiHub sunucuda tamamen otomatik yürütsün!
            </p>
        </div>

        <!-- Sekme Seçici (Dual Mode Toggle) -->
        <div class="flex bg-[var(--cream)] p-1 rounded-xl border border-[var(--line)]">
            <button @onclick='() => SetTab("auto")'
                class="px-4 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 @(_activeTab == "auto" ? "bg-[var(--paper)] text-[var(--navy)] shadow-sm font-bold" : "text-[var(--ink-soft)] hover:text-[var(--navy)]")">
                <i class="fa-solid fa-bolt text-xs text-[var(--azure)]"></i>
                <span>Otomatik Dağıtım</span>
            </button>
            <button @onclick='() => SetTab("manual")'
                class="px-4 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 @(_activeTab == "manual" ? "bg-[var(--paper)] text-[var(--navy)] shadow-sm font-bold" : "text-[var(--ink-soft)] hover:text-[var(--navy)]")">
                <i class="fa-solid fa-book-open text-xs text-[var(--slate)]"></i>
                <span>Manuel Kılavuz</span>
            </button>
        </div>
    </div>

    @if (_activeTab == "auto")
    {
        <!-- OTOMATİK CANLI DAĞITIM SİHİRBAZI -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Sol Sütun: Dağıtım Ayarları Formu -->
            <div class="lg:col-span-5 card space-y-4">
                <div class="flex items-center gap-2 border-b border-[var(--line)] pb-3 mb-1">
                    <i class="fa-solid fa-sliders text-[var(--azure)] text-sm"></i>
                    <h3 class="font-serif font-semibold text-[var(--navy)] text-base">1. Uygulama ve Domain Bilgileri</h3>
                </div>

                <div class="space-y-4">
                    <!-- Dağıtım Modu Seçici -->
                    <div>
                        <label class="block text-[11px] text-[var(--ink-soft)] font-semibold mb-1.5 uppercase tracking-wider">Dağıtım Modu</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <button type="button" @onclick='() => _deployMode = "docker"'
                                class="@ModeButtonClass("docker")">
                                <i class="fa-brands fa-docker text-sm text-[var(--azure)]"></i>
                                <div class="text-left">
                                    <div class="text-[11px] font-bold leading-none">Docker</div>
                                    <div class="text-[9px] opacity-70 mt-0.5">Konteyner</div>
                                </div>
                            </button>
                            <button type="button" @onclick='() => _deployMode = "compose"'
                                class="@ModeButtonClass("compose")">
                                <i class="fa-solid fa-cubes text-sm text-[var(--slate)]"></i>
                                <div class="text-left">
                                    <div class="text-[11px] font-bold leading-none">Compose</div>
                                    <div class="text-[9px] opacity-70 mt-0.5">Çoklu Servis</div>
                                </div>
                            </button>
                            <button type="button" @onclick='() => _deployMode = "native"'
                                class="@ModeButtonClass("native")">
                                <i class="fa-regular fa-file-zip text-sm text-[var(--moss)]"></i>
                                <div class="text-left">
                                    <div class="text-[11px] font-bold leading-none">Native ZIP</div>
                                    <div class="text-[9px] opacity-70 mt-0.5">Süreç Yön.</div>
                                </div>
                            </button>
                            <button type="button" @onclick='() => _deployMode = "static"'
                                class="@ModeButtonClass("static")">
                                <i class="fa-solid fa-code text-sm text-[var(--azure)]"></i>
                                <div class="text-left">
                                    <div class="text-[11px] font-bold leading-none">Statik Web</div>
                                    <div class="text-[9px] opacity-70 mt-0.5">Nginx Direct</div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Proje Adı -->
                    <div>
                        <label class="block text-[11px] text-[var(--ink-soft)] font-semibold mb-1 uppercase tracking-wider">Uygulama Adı</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-[var(--ink-soft)] text-xs">
                                <i class="fa-solid fa-cube"></i>
                            </span>
                            <input type="text" @bind="_projectName" @bind:event="oninput" placeholder="örn: bprojem" disabled="@_isDeploying"
                                class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg pl-9 pr-3 py-2 text-xs text-[var(--navy)] font-bold focus:outline-none focus:border-[var(--azure)] transition-colors disabled:opacity-50">
                        </div>
                        <p class="text-[10px] text-[var(--ink-soft)] mt-1">Sadece küçük harfler, rakamlar, tire (-) veya alt çizgi (_).</p>
                    </div>

                    @if (_deployMode != "static")
                    {
                        <!-- Port Numaraları -->
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] text-[var(--ink-soft)] font-semibold mb-1 uppercase tracking-wider">Host Port (Dış)</label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-[var(--ink-soft)] text-xs">
                                        <i class="fa-solid fa-network-wired"></i>
                                    </span>
                                    <input type="number" @bind="_port" min="1" max="65535" disabled="@_isDeploying"
                                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg pl-9 pr-3 py-2 text-xs text-[var(--moss)] font-bold focus:outline-none focus:border-[var(--azure)] transition-colors disabled:opacity-50 font-mono">
                                </div>
                                <p class="text-[10px] text-[var(--ink-soft)] mt-1 font-medium">Sunucuda dışa açılacak port.</p>
                            </div>
                            
                            @if (_deployMode == "docker")
                            {
                                <div>
                                    <label class="block text-[11px] text-[var(--ink-soft)] font-semibold mb-1 uppercase tracking-wider">Container Port (İç)</label>
                                    <div class="flex gap-1 relative">
                                        <div class="relative w-full">
                                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-[var(--ink-soft)] text-xs">
                                                <i class="fa-solid fa-box"></i>
                                            </span>
                                            <input type="number" @bind="_containerPort" placeholder="Otomatik" min="1" max="65535" disabled="@_isDeploying"
                                                class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg pl-9 pr-3 py-2 text-xs text-[var(--ink)] font-semibold focus:outline-none focus:border-[var(--azure)] transition-colors disabled:opacity-50 font-mono">
                                        </div>
                                        <button type="button" @onclick="DetectContainerPortAsync" disabled="@(string.IsNullOrWhiteSpace(_dockerImageName) || _isDetectingPort || _isDeploying)"
                                            class="btn-secondary px-2.5 rounded-lg text-xs font-bold transition-all flex items-center justify-center disabled:opacity-50" style="min-width: 36px;">
                                            @if (_isDetectingPort)
                                            {
                                                <span class="w-3.5 h-3.5 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                            }
                                        </button>
                                    </div>
                                    <p class="text-[10px] text-[var(--ink-soft)] mt-1 font-medium">Girilmezse EXPOSE portu taranır.</p>
                                </div>
                            }
                        </div>

                        <!-- CPU ve RAM Limitleri -->
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] text-[var(--ink-soft)] font-semibold mb-1 uppercase tracking-wider">RAM Limiti (MB)</label>
                                <input type="number" @bind="_memoryLimitMb" min="64" max="16384" disabled="@_isDeploying"
                                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-semibold font-mono">
                            </div>
                            <div>
                                <label class="block text-[11px] text-[var(--ink-soft)] font-semibold mb-1 uppercase tracking-wider">CPU Çekirdek</label>
                                <input type="number" @bind="_cpuCount" min="0.1" max="32" step="0.1" disabled="@_isDeploying"
                                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-semibold font-mono">
                            </div>
                        </div>
                    }

                    <!-- Domain & Subdomain Bilgileri -->
                    <div class="border-t border-[var(--line)] pt-3 mt-1 space-y-3">
                        <label class="block text-[11px] text-[var(--azure)] font-bold uppercase tracking-wider">Nginx Subdomain Yönlendirmesi</label>

                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Subdomain</label>
                                <input type="text" @bind="_subdomain" @bind:event="oninput" placeholder="api" disabled="@_isDeploying"
                                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono">
                            </div>
                            <div>
                                <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Ana Alan Adı (Domain)</label>
                                <select @bind="_domain" @bind:after="ApplySelectedRootDomainDefaults" disabled="@_isDeploying"
                                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50">
                                    <option value="">Seçiniz...</option>
                                    @foreach (var rd in _rootDomains)
                                    {
                                        <option value="@rd.Name">@rd.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Let's Encrypt SSL Seçici -->
                        <div class="flex items-center justify-between bg-[var(--cream)] p-2.5 rounded-lg border border-[var(--line)]">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-shield-halved text-[var(--azure)] text-xs"></i>
                                <div>
                                    <div class="text-[11px] text-[var(--navy)] font-bold leading-none">Let's Encrypt SSL Aktif Edilsin</div>
                                    <span class="text-[9px] text-[var(--ink-soft)]">Alan adı için güvenli HTTPS bağlantısı kurar</span>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" @bind="_sslEnabled" id="sslCheckbox" disabled="@_isDeploying"
                                    class="w-4 h-4 rounded text-[var(--azure)] focus:ring-[var(--azure)] disabled:opacity-50">
                            </div>
                        </div>
                    </div>

                    <!-- Cloudflare DNS A Kaydı Seçici -->
                    <div class="border-t border-[var(--line)] pt-3 mt-1 space-y-3">
                        <div class="flex items-center justify-between bg-[var(--cream)] p-2.5 rounded-lg border border-[var(--line)]">
                            <div class="flex items-center gap-2">
                                <i class="fa-brands fa-cloudflare text-[var(--amber)] text-xs"></i>
                                <div>
                                    <div class="text-[11px] text-[var(--navy)] font-bold leading-none">Cloudflare DNS A Kaydı Oluşturulsun</div>
                                    <span class="text-[9px] text-[var(--ink-soft)]">Subdomain'i otomatik olarak sunucu IP'sine yönlendirir</span>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" @bind="_createDnsRecord" @bind:after="ApplySelectedRootDomainDefaults" id="cfDnsCheckbox" disabled="@_isDeploying"
                                    class="w-4 h-4 rounded text-[var(--azure)] focus:ring-[var(--azure)] disabled:opacity-50">
                            </div>
                        </div>

                        @if (_createDnsRecord)
                        {
                            <div class="p-3 bg-[var(--cream)] border border-[var(--line)] rounded-xl space-y-2 animate-fade-in">
                                <div>
                                    <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Sunucu IP Adresi</label>
                                    <input type="text" @bind="_serverIp" placeholder="örn: 85.95.23.10" disabled="@_isDeploying"
                                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono">
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Cloudflare API Token</label>
                                        <input type="password" @bind="_cfToken" placeholder="Token girin" disabled="@_isDeploying"
                                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Cloudflare Zone ID</label>
                                        <input type="text" @bind="_cfZoneId" placeholder="Zone ID girin" disabled="@_isDeploying"
                                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono">
                                    </div>
                                </div>
                                <div class="flex items-center justify-between bg-[var(--paper)] p-2 rounded border border-[var(--line)]">
                                    <span class="text-[10px] text-[var(--ink-soft)] font-bold uppercase">Cloudflare CDN Proxy (Proxied)</span>
                                    <input type="checkbox" @bind="_cfProxied" disabled="@_isDeploying"
                                        class="w-3.5 h-3.5 rounded text-[var(--azure)] focus:ring-[var(--azure)]">
                                </div>
                            </div>
                        }
                    </div>

                    <!-- PostgreSQL Veritabanı Seçici -->
                    <div class="border-t border-[var(--line)] pt-3 mt-1 space-y-3">
                        <div class="flex items-center justify-between bg-[var(--cream)] p-2.5 rounded-lg border border-[var(--line)]">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-database text-[var(--azure)] text-xs"></i>
                                <div>
                                    <div class="text-[11px] text-[var(--navy)] font-bold leading-none">PostgreSQL Veritabanı Oluşturulsun</div>
                                    <span class="text-[9px] text-[var(--ink-soft)]">Projeye özel veritabanı şeması ve kullanıcısı oluşturur</span>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" @bind="_createDatabase" @bind:after="UpdateDbDefaults" id="dbCheckbox" disabled="@_isDeploying"
                                    class="w-4 h-4 rounded text-[var(--azure)] focus:ring-[var(--azure)] disabled:opacity-50">
                            </div>
                        </div>

                        @if (_createDatabase)
                        {
                            <div class="p-3 bg-[var(--cream)] border border-[var(--line)] rounded-xl space-y-2 animate-fade-in">
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase font-bold">Veritabanı İsmi</label>
                                        <input type="text" @bind="_dbName" placeholder="örn: bprojem_db" disabled="@_isDeploying"
                                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase font-bold">Kullanıcı İsmi</label>
                                        <input type="text" @bind="_dbUser" placeholder="örn: bprojem_user" disabled="@_isDeploying"
                                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase font-bold">Kullanıcı Şifresi</label>
                                    <div class="flex gap-1.5">
                                        <input type="text" @bind="_dbPassword" placeholder="Güçlü şifre girin veya üretin" disabled="@_isDeploying"
                                            class="flex-1 bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--moss)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono font-bold">
                                        <button type="button" @onclick="GenerateDbPassword" disabled="@_isDeploying"
                                            class="btn-secondary px-3 rounded-lg text-[10px] font-bold">
                                            <i class="fa-solid fa-key"></i> Şifre Üret
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_deployMode == "docker")
                    {
                        <!-- Docker İmaj Adı -->
                        <div class="border-t border-[var(--line)] pt-3 mt-1">
                            <label class="block text-[11px] text-[var(--ink-soft)] font-semibold mb-1.5 uppercase tracking-wider">Docker İmaj Adı</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-[var(--ink-soft)] text-xs">
                                    <i class="fa-brands fa-docker"></i>
                                </span>
                                <input type="text" @bind="_dockerImageName" @bind:event="oninput" placeholder="örn: nginx:alpine, node:20-alpine" disabled="@_isDeploying"
                                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg pl-9 pr-3 py-2 text-xs text-[var(--navy)] font-mono font-bold focus:outline-none focus:border-[var(--azure)] transition-colors disabled:opacity-50">
                            </div>
                            <p class="text-[10px] text-[var(--ink-soft)] mt-1">Docker Hub imajı ve etiket — örn: <span class="font-mono text-[var(--navy)]">node:20-alpine</span>, <span class="font-mono text-[var(--navy)]">nginx:alpine</span></p>
                        </div>
                    }

                    @if (_deployMode == "compose")
                    {
                        <!-- Docker Compose YAML Düzenleyici & Yükleyici -->
                        <div class="border-t border-[var(--line)] pt-3 mt-1 space-y-3">
                            <div class="flex items-center justify-between">
                                <label class="block text-[11px] text-[var(--azure)] font-bold uppercase tracking-wider">docker-compose.yml İçeriği</label>
                                <button type="button" @onclick="AnalyzeComposeAsync" disabled="@(string.IsNullOrWhiteSpace(_composeContent) || _isAnalyzingCompose || _isDeploying)"
                                    class="btn-secondary py-1 px-2.5 text-[10px]">
                                    @if (_isAnalyzingCompose)
                                    {
                                        <span class="w-3 h-3 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
                                        <span>Ayrıştırılıyor...</span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
                                        <span>Ayrıştır & İncele</span>
                                    }
                                </button>
                            </div>

                            <div class="relative">
                                <textarea @bind="_composeContent" @bind:event="oninput" rows="7" placeholder="version: '3.8'&#10;services:&#10;  web:&#10;    image: nginx:alpine..." disabled="@_isDeploying"
                                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-xl p-3 text-xs text-[var(--navy)] font-mono focus:outline-none focus:border-[var(--azure)] transition-colors disabled:opacity-50 resize-y"></textarea>
                            </div>

                            <!-- Dosyadan Yükleme Seçeneği -->
                            <div class="relative border border-dashed border-[var(--line)] rounded-xl p-2.5 bg-[var(--cream)] flex items-center justify-between">
                                <div class="flex items-center gap-2 text-[10px] text-[var(--ink-soft)]">
                                    <i class="fa-solid fa-file-code text-[var(--azure)]"></i>
                                    <span>Veya <b>docker-compose.yml</b> dosyası yükleyin</span>
                                </div>
                                <InputFile OnChange="OnComposeFileSelected" accept=".yml,.yaml" class="text-xs text-[var(--ink-soft)] file:bg-[var(--paper)] file:text-[var(--navy)] file:border file:border-[var(--line)] file:rounded-lg file:px-2 file:py-1 file:text-[10px] cursor-pointer" />
                            </div>

                            @if (_composeAnalysis != null)
                            {
                                <div class="p-3 bg-[var(--cream)] border border-[var(--line)] rounded-xl space-y-3 animate-fade-in">
                                    <div class="flex items-center justify-between text-[10px] font-bold text-[var(--moss)]">
                                        <span><i class="fa-solid fa-check-circle"></i> Ayrıştırma Başarılı</span>
                                        <span class="text-[var(--ink-soft)] font-normal">@_composeAnalysis.Services.Count servis, @_composeAnalysis.Variables.Count değişken</span>
                                    </div>

                                    <!-- Nginx Yönlendirilecek Servis -->
                                    @if (_composeAnalysis.Services.Any())
                                    {
                                        <div>
                                            <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Nginx Yönlendirilecek Hedef Servis</label>
                                            <select @bind="_selectedProxyService" @bind:after="OnProxyServiceChanged" disabled="@_isDeploying"
                                                class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] font-mono">
                                                <option value="">Servis Seçin...</option>
                                                @foreach (var s in _composeAnalysis.Services)
                                                {
                                                    <option value="@s.Name">@s.Name @(s.Image != null ? $"({s.Image})" : "") @(s.Ports.Any() ? $"- Port: {string.Join(",", s.Ports)}" : "")</option>
                                                }
                                            </select>
                                        </div>
                                    }

                                    <!-- Tespit Edilen Ortam Değişkenleri (.env) -->
                                    @if (_composeAnalysis.Variables.Any())
                                    {
                                        <div class="space-y-2 border-t border-[var(--line)] pt-2">
                                            <label class="block text-[10px] text-[var(--navy)] font-bold uppercase">Tespit Edilen Ortam Değişkenleri (.env)</label>
                                            <div class="grid grid-cols-1 gap-2 max-h-48 overflow-y-auto pr-1">
                                                @foreach (var envVar in _composeAnalysis.Variables)
                                                {
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-[10px] text-[var(--ink-soft)] font-mono w-1/3 truncate" title="@envVar.Name">@envVar.Name:</span>
                                                        <input type="@(envVar.IsSecret ? "password" : "text")"
                                                            value="@(_composeEnvValues.TryGetValue(envVar.Name, out var val) ? val : envVar.DefaultValue)"
                                                            @onchange="@(e => _composeEnvValues[envVar.Name] = e.Value?.ToString() ?? "")"
                                                            placeholder="@(envVar.DefaultValue ?? (envVar.IsRequired ? "Zorunlu Değer" : "İsteğe Bağlı"))"
                                                            disabled="@_isDeploying"
                                                            class="flex-1 bg-[var(--paper)] border border-[var(--line)] rounded-lg p-1.5 text-xs text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]">
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (_deployMode == "native")
                    {
                        <!-- Çalışma Zamanı (Runtime) ve Başlangıç Ayarları -->
                        <div class="border-t border-[var(--line)] pt-3 mt-1 space-y-3">
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase font-bold">Çalışma Zamanı (Runtime)</label>
                                    <select @bind="_runtimeType" disabled="@_isDeploying"
                                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50">
                                        <option value="dotnet">.NET / C#</option>
                                        <option value="node">Node.js</option>
                                        <option value="python">Python</option>
                                        <option value="custom">Özel Komut (Custom)</option>
                                    </select>
                                </div>

                                @if (_runtimeType == "custom")
                                {
                                    <div>
                                        <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase font-bold">Özel Çalıştırma Komutu</label>
                                        <input type="text" @bind="_customCommand" placeholder="örn: node index.js" disabled="@_isDeploying"
                                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono">
                                    </div>
                                }
                                else
                                {
                                    <div>
                                         <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase font-bold">Giriş Dosyası (Entry File)</label>
                                         <input type="text" @bind="_entryFile" placeholder="@(_runtimeType == "dotnet" ? "örn: KütüphaneTakipWeb.dll" : "örn: server.js")" disabled="@_isDeploying"
                                             class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] disabled:opacity-50 font-mono">
                                     </div>
                                }
                            </div>
                        </div>
                    }

                    @if (_deployMode == "native" || _deployMode == "static")
                    {
                        <!-- ZIP Dosya Yükleyici -->
                        <div class="border-t border-[var(--line)] pt-3">
                            <label class="block text-[11px] text-[var(--ink-soft)] font-semibold mb-2 uppercase tracking-wider">Proje ZIP Arşivi</label>

                            <div class="relative border-2 border-dashed rounded-xl transition-all flex flex-col items-center justify-center p-4 min-h-[90px] @(_isDeploying ? "pointer-events-none opacity-50" : "") @(_selectedFile != null ? "border-[var(--moss)] bg-[var(--moss-bg)]" : "border-[var(--line)] hover:border-[var(--azure)] bg-[var(--cream)]")">
                                @if (_selectedFile == null)
                                {
                                    <i class="fa-regular fa-file-zip text-2xl text-[var(--slate)] mb-1"></i>
                                    <span class="text-xs text-[var(--navy)] font-bold">Projeyi ZIP olarak buraya sürükleyin veya tıklayın</span>
                                    <span class="text-[10px] text-[var(--ink-soft)] font-medium mt-0.5">Sadece .zip uzantılı (Max 200MB)</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-file-circle-check text-2xl text-[var(--moss)] mb-1"></i>
                                    <span class="text-xs text-[var(--navy)] font-bold">@_selectedFile.Name</span>
                                    <span class="text-[10px] text-[var(--moss)] font-semibold mt-0.5">@((_selectedFile.Size / 1024.0 / 1024.0).ToString("F2")) MB - Dosya Hazır</span>
                                }
                                <InputFile id="wizard-zip-input" OnChange="OnZipFileSelected" accept=".zip"
                                    style="position: absolute; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer;" />
                            </div>

                            @if (_isUploadingFile)
                            {
                                <div class="mt-2 bg-[var(--cream)] border border-[var(--line)] p-2.5 rounded-xl space-y-1.5">
                                    <div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
                                        <span class="flex items-center gap-1.5 text-[var(--azure)]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--azure)] animate-ping"></span>
                                            Sunucuya Yükleniyor...
                                        </span>
                                        <span class="text-[var(--navy)] font-mono font-bold">%@_uploadPercentage</span>
                                    </div>
                                    <div class="bar-track">
                                        <div class="bar-fill" style="width: @_uploadPercentage%"></div>
                                    </div>
                                    <div class="text-[9px] text-[var(--ink-soft)] font-semibold flex justify-between font-mono">
                                        <span>Sıkıştırılmış Paket</span>
                                        <span>@GetReadableUploadedSize() / @GetReadableFileSize()</span>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (_deployMode == "static")
                        {
                            <!-- PHP Desteği Switch Butonu -->
                            <div class="flex items-center justify-between bg-[var(--cream)] p-2.5 rounded-lg border border-[var(--line)] mt-2">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-code text-[var(--azure)] text-xs"></i>
                                    <div>
                                        <div class="text-[11px] text-[var(--navy)] font-bold leading-none">PHP Desteği Aktif Edilsin</div>
                                        <span class="text-[9px] text-[var(--ink-soft)]">Statik sitede dinamik kodların çalışmasını sağlar</span>
                                    </div>
                                </div>
                                <div class="flex items-center">
                                    <input type="checkbox" @bind="_enablePhp" id="phpSupportCheckbox" disabled="@_isDeploying"
                                        class="w-4 h-4 rounded text-[var(--azure)] focus:ring-[var(--azure)] disabled:opacity-50">
                                </div>
                            </div>
                        }
                    }

                    <!-- Çalıştırma Butonu -->
                    <button @onclick="StartAutomatedDeployment" disabled="@IsDeployDisabled"
                        class="btn-primary w-full py-3 text-xs justify-center">
                        @if (_isDeploying)
                        {
                            <span class="w-4 h-4 rounded-full border-2 border-t-transparent border-white animate-spin"></span>
                            <span>Dağıtım Sürüyor...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-play text-xs"></i>
                            <span>@DeployButtonText</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Sağ Sütun: Canlı Boru Hattı & Siber Terminal Konsolu -->
            <div class="lg:col-span-7 card flex flex-col min-h-[500px] justify-between">
                <div>
                    <div class="flex items-center justify-between border-b border-[var(--line)] pb-3 mb-4">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-network-wired text-[var(--azure)]"></i>
                            <h3 class="font-serif font-semibold text-[var(--navy)] text-base">2. Canlı Dağıtım Boru Hattı</h3>
                        </div>
                        @if (_isDeploying)
                        {
                            <span class="pill pill-azure text-[10.5px]"><span class="dot"></span>AKTİF İŞLEM</span>
                        }
                        else if (_executionSuccess == true)
                        {
                            <span class="pill pill-moss text-[10.5px]"><span class="dot"></span>BAŞARILI</span>
                        }
                        else if (_executionSuccess == false)
                        {
                            <span class="pill pill-rose text-[10.5px]"><span class="dot"></span>HATA OLUŞTU</span>
                        }
                        else
                        {
                            <span class="pill text-[10.5px] bg-[var(--cream)] text-[var(--ink-soft)]">Beklemede</span>
                        }
                    </div>

                    <!-- 6 Aşamalı Pipeline Görsel Aşamaları -->
                    <div class="grid grid-cols-6 gap-1.5 mb-4">
                        <div class="p-2 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(1))">
                            <i class="fa-solid fa-database text-xs mb-0.5"></i>
                            <span class="text-[9px] font-bold leading-tight">1. DB Yarat</span>
                            <span class="text-[7px] opacity-70 mt-0.5">PostgreSQL</span>
                        </div>

                        <div class="p-2 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(2))">
                            <i class="fa-brands fa-cloudflare text-xs mb-0.5"></i>
                            <span class="text-[9px] font-bold leading-tight">2. DNS Ekle</span>
                            <span class="text-[7px] opacity-70 mt-0.5">Cloudflare</span>
                        </div>

                        <div class="p-2 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(3))">
                            <i class="@Step3Icon text-xs mb-0.5"></i>
                            <span class="text-[9px] font-bold leading-tight">@Step3Label</span>
                            <span class="text-[7px] opacity-70 mt-0.5">@Step3Sub</span>
                        </div>

                        <div class="p-2 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(4))">
                            <i class="@Step4Icon text-xs mb-0.5"></i>
                            <span class="text-[9px] font-bold leading-tight">@Step4Label</span>
                            <span class="text-[7px] opacity-70 mt-0.5">@Step4Sub</span>
                        </div>

                        <div class="p-2 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(5))">
                            <i class="fa-solid fa-server text-xs mb-0.5"></i>
                            <span class="text-[9px] font-bold leading-tight">5. Nginx vHost</span>
                            <span class="text-[7px] opacity-70 mt-0.5">Proxy</span>
                        </div>

                        <div class="p-2 rounded-xl border flex flex-col items-center justify-center text-center transition-all @(GetStepClass(6))">
                            <i class="fa-solid fa-shield-halved text-xs mb-0.5"></i>
                            <span class="text-[9px] font-bold leading-tight">6. SSL Kur</span>
                            <span class="text-[7px] opacity-70 mt-0.5">Let's Encrypt</span>
                        </div>
                    </div>

                    <!-- Canlı Konsol Log Kutusu -->
                    <div class="terminal-card flex-1 flex flex-col min-h-[220px]">
                        <div class="term-top justify-between">
                            <div class="flex items-center gap-2">
                                <div class="term-dot" style="background:#E0685A;"></div>
                                <div class="term-dot" style="background:#E0B15A;"></div>
                                <div class="term-dot" style="background:#6FAE72;"></div>
                                <span class="ml-2">Sunucu Dağıtım Konsolu</span>
                            </div>
                            <button @onclick="ClearConsole" disabled="@_isDeploying" class="text-[11px] text-[#8FA6BB] hover:text-[#F4F8FD] font-mono">Konsolu Temizle</button>
                        </div>

                        <div class="flex-1 p-4 font-mono text-xs leading-relaxed overflow-y-auto max-h-[300px] flex flex-col gap-1 text-[#F4F8FD]">
                            @if (_terminalLogs.Count == 0)
                            {
                                <span class="text-[#8FA6BB] italic text-xs">// Otomatik dağıtımı başlattığınızda canlı işlem logları burada akacaktır.</span>
                            }
                            else
                            {
                                @foreach (var log in _terminalLogs)
                                {
                                    @if (log.Contains("SUCCESS"))
                                    {
                                        <span class="text-[#8FD6B4] font-semibold">@log</span>
                                    }
                                    else if (log.Contains("ERROR") || log.Contains("HATA") || log.Contains("FAILED"))
                                    {
                                        <span class="text-[var(--rose)] font-semibold">@log</span>
                                    }
                                    else if (log.StartsWith("["))
                                    {
                                        <span class="text-[#8FA6BB] font-bold">@log</span>
                                    }
                                    else
                                    {
                                        <span class="text-[#F4F8FD]">@log</span>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>

                @if (_createDatabase && !string.IsNullOrEmpty(_dbName))
                {
                    <div class="mt-3 p-3 bg-[var(--cream)] border border-[var(--line)] rounded-xl space-y-1 text-xs">
                        <div class="text-[10px] text-[var(--ink-soft)] font-bold uppercase tracking-wider mb-1">Oluşturulan PostgreSQL Parametreleri:</div>
                        <div class="grid grid-cols-2 gap-2 text-xs">
                            <div class="p-1.5 rounded bg-[var(--paper)] border border-[var(--line)]">
                                <span class="text-[var(--ink-soft)] font-semibold">DB Adı:</span> <span class="text-[var(--navy)] font-mono font-bold ml-1">@_dbName</span>
                            </div>
                            <div class="p-1.5 rounded bg-[var(--paper)] border border-[var(--line)]">
                                <span class="text-[var(--ink-soft)] font-semibold">Kullanıcı:</span> <span class="text-[var(--navy)] font-mono font-bold ml-1">@_dbUser</span>
                            </div>
                        </div>
                        <div class="p-1.5 rounded bg-[var(--paper)] border border-[var(--line)] text-xs flex justify-between items-center">
                            <div>
                                <span class="text-[var(--ink-soft)] font-semibold">Şifre:</span> <span class="text-[var(--navy)] font-mono font-bold ml-1">@_dbPassword</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Sonuç & Canlı Link Kartı -->
                @if (_executionSuccess == true)
                {
                    <div class="mt-3 p-4 bg-[var(--moss-bg)] border border-[var(--moss)] rounded-xl flex flex-col gap-2 animate-fade-in text-left">
                        <div class="flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <span class="w-8 h-8 rounded-full bg-white flex items-center justify-center text-[var(--moss)] shrink-0 shadow-sm">
                                    <i class="fa-solid fa-circle-check"></i>
                                </span>
                                <div>
                                    <h4 class="text-xs font-bold text-[var(--moss)] uppercase tracking-wider">Tebrikler! Dağıtım Tamamlandı</h4>
                                    <p class="text-xs text-[var(--ink-soft)] mt-0.5">Uygulama başarıyla sunucuya kuruldu ve internete açıldı.</p>
                                    <a href="https://@(string.IsNullOrWhiteSpace(_subdomain) ? _domain : $"{_subdomain}.{_domain}")" target="_blank" class="text-xs text-[var(--navy)] hover:text-[var(--azure)] font-bold underline inline-flex items-center gap-1 mt-1 font-mono">
                                        https://@(string.IsNullOrWhiteSpace(_subdomain) ? _domain : $"{_subdomain}.{_domain}") <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                    </a>
                                </div>
                            </div>
                            <button @onclick='() => SetTab("manual")' class="btn-secondary py-1.5 px-3 text-xs shrink-0">
                                Manuel Kılavuza Git
                            </button>
                        </div>
                    </div>
                }
                else if (_executionSuccess == false)
                {
                    <div class="mt-3 p-4 bg-[var(--rose-bg)] border border-[var(--rose)] rounded-xl flex items-center gap-3 animate-fade-in">
                        <span class="w-8 h-8 rounded-full bg-white flex items-center justify-center text-[var(--rose)] shrink-0 shadow-sm">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </span>
                        <div>
                            <h4 class="text-xs font-bold text-[var(--rose)] uppercase tracking-wider">Dağıtım Başarısız Oldu</h4>
                            <p class="text-xs text-[var(--ink)] font-medium mt-0.5">@_errorMessage</p>
                            <span class="text-[10px] text-[var(--ink-soft)]">Lütfen yukarıdaki hata loglarını ve port doluluk durumunu kontrol ederek tekrar deneyin.</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- MANUEL DAĞITIM KILAVUZU -->
        <div class="card space-y-4 mb-6">
            <div class="flex justify-between items-center border-b border-[var(--line)] pb-3">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-book text-[var(--azure)]"></i>
                    <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Manuel Dağıtım Kılavuz Modu</h3>
                </div>
                <button @onclick='() => SetTab("auto")' class="btn-ghost text-xs text-[var(--azure)] font-bold">
                    <i class="fa-solid fa-arrow-left"></i> Otomatik Moda Dön
                </button>
            </div>

            <!-- İnteraktif Parametre Formu -->
            <div class="bg-[var(--cream)] p-4 rounded-xl border border-[var(--line)] grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Proje / Uygulama Adı</label>
                    <input type="text" @bind="_projectName" @bind:event="oninput" placeholder="bTest"
                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--navy)] font-semibold focus:outline-none focus:border-[var(--azure)]">
                </div>
                <div>
                    <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Çalışma Portu</label>
                    <input type="number" @bind="_port" @bind:event="oninput"
                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--moss)] font-bold focus:outline-none focus:border-[var(--azure)] font-mono">
                </div>
                <div>
                    <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1 uppercase">Subdomain / Domain</label>
                    <div class="flex gap-1">
                        <input type="text" @bind="_subdomain" @bind:event="oninput" placeholder="api" class="w-1/3 bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] font-mono">
                        <select @bind="_domain" @bind:after="ApplySelectedRootDomainDefaults" class="w-2/3 bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)]">
                            <option value="">Seçiniz...</option>
                            @foreach (var rd in _rootDomains)
                            {
                                <option value="@rd.Name">@rd.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Adım Stepper Görünümü -->
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Sol Menü: Adım Seçici -->
                <div class="lg:col-span-1 space-y-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var stepIndex = i;
                        <button @onclick="() => SetStep(stepIndex)" class="w-full text-left p-3 rounded-xl border transition-all duration-200 flex items-center gap-3 @( _currentStep == stepIndex ? "bg-[var(--accent-bg)] border-[var(--azure)] text-[var(--navy)] font-bold" : "bg-[var(--paper)] border-[var(--line)] text-[var(--ink-soft)] hover:text-[var(--navy)]" )">
                            <span class="w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold @( _currentStep == stepIndex ? "bg-[var(--azure)] text-[var(--navy)]" : "bg-[var(--cream)] text-[var(--ink-soft)]" )">@stepIndex</span>
                            <div>
                                <div class="text-xs font-semibold leading-none">Adım @stepIndex: @GetStepTitle(stepIndex)</div>
                            </div>
                        </button>
                    }
                </div>

                <!-- Sağ Detay -->
                <div class="lg:col-span-3 bg-[var(--paper)] border border-[var(--line)] rounded-xl p-5 shadow-sm min-h-[360px] flex flex-col justify-between">
                    <div>
                        @if (_currentStep == 1)
                        {
                            <div class="space-y-3">
                                <h4 class="text-xs font-bold text-[var(--navy)] uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-file-arrow-up text-[var(--azure)]"></i> Dizin Hazırlığı</h4>
                                <pre class="bg-[var(--cream)] border border-[var(--line)] p-3 rounded-lg text-xs text-[var(--navy)] font-mono overflow-x-auto">cd /var/www/apps && mkdir -p @GetSafeProjectName()</pre>
                            </div>
                        }
                        else if (_currentStep == 2)
                        {
                            <div class="space-y-3">
                                <h4 class="text-xs font-bold text-[var(--navy)] uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-vial text-[var(--moss)]"></i> Port Atama</h4>
                                <p class="text-xs text-[var(--ink-soft)]">Port hedefi: @_port</p>
                            </div>
                        }
                        else if (_currentStep == 3)
                        {
                            <div class="space-y-3">
                                <h4 class="text-xs font-bold text-[var(--navy)] uppercase tracking-wider flex items-center gap-1.5"><i class="fa-brands fa-docker text-[var(--azure)]"></i> Entegrasyon</h4>
                                <p class="text-xs text-[var(--ink-soft)]">Docker imajı arka planda çekilecek: @_dockerImageName</p>
                            </div>
                        }
                        else if (_currentStep == 4)
                        {
                            <div class="space-y-3">
                                <h4 class="text-xs font-bold text-[var(--navy)] uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-arrows-spin text-[var(--azure)]"></i> Servis Yönetimi</h4>
                                <pre class="bg-[var(--cream)] border border-[var(--line)] p-3 rounded-lg text-xs text-[var(--navy)] font-mono">docker ps -a</pre>
                            </div>
                        }
                        else if (_currentStep == 5)
                        {
                            <div class="space-y-3">
                                <h4 class="text-xs font-bold text-[var(--navy)] uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-share-nodes text-[var(--azure)]"></i> Nginx Yapılandırması</h4>
                                <pre class="bg-[var(--cream)] border border-[var(--line)] p-2.5 rounded-lg text-xs text-[var(--navy)] font-mono leading-tight h-32 overflow-y-auto">@GetNginxConfig()</pre>
                            </div>
                        }
                    </div>

                    <!-- Kılavuz Alt Butonlar -->
                    <div class="flex justify-between items-center border-t border-[var(--line)] pt-3 mt-4">
                        <button @onclick="PrevStep" disabled="@(_currentStep == 1)" class="btn-secondary text-xs py-1.5 px-3">Önceki</button>
                        <span class="text-xs text-[var(--ink-soft)] font-bold">@_currentStep / 5</span>
                        <button @onclick="NextStep" disabled="@(_currentStep == 5)" class="btn-primary text-xs py-1.5 px-3">Sonraki</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _activeTab = "auto";
    private int _currentStep = 1;

    private string _deployMode = "docker";
    private string _dockerImageName = "nginx:alpine";

    private string _composeContent = @"version: '3.8'
services:
  web:
    image: nginx:alpine
    ports:
      - ""8080:80""";
    private bool _isAnalyzingCompose = false;
    private ComposeAnalysisResultDto? _composeAnalysis;
    private string _selectedProxyService = "";
    private Dictionary<string, string> _composeEnvValues = new();

    private string _projectName = "btest";
    private string _subdomain = "api";
    private string _domain = "";
    private int _port = 80;
    private int? _containerPort = null;
    private bool _isDetectingPort = false;

    private List<RootDomainDto> _rootDomains = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rawRoots = await Http.GetFromJsonAsync<List<RootDomainDto>>("api/domains/roots");
            _rootDomains = rawRoots ?? new List<RootDomainDto>();
            if (_rootDomains.Any())
            {
                _domain = _rootDomains.First().Name;
                ApplySelectedRootDomainDefaults();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading root domains: {ex.Message}");
        }
    }
