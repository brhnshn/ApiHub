@page "/firewall"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Güvenlik & Güvenlik Duvarı (UFW) - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="eyebrow">Ağ ve Güvenlik</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">Güvenlik & UFW Güvenlik Duvarı</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">
                Sunucu port erişim limitlerini, IP kurallarını ve işletim sistemi UFW filtreleme servislerini tek bir panelden güvenle yönetin.
            </p>
        </div>
    </div>

    @if (_isForbidden)
    {
        <!-- Yetkisiz Erişim Uyarısı (Customer Rolü İçin) -->
        <div class="bg-[var(--rose-bg)] border border-[var(--rose)] rounded-xl p-6 text-center space-y-4 max-w-2xl mx-auto shadow-sm">
            <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center mx-auto text-[var(--rose)] shadow-sm">
                <i class="fa-solid fa-shield-halved text-2xl"></i>
            </div>
            <h3 class="text-base font-serif font-bold text-[var(--rose)]">Yönetici Yetkisi Gerekli</h3>
            <p class="text-xs text-[var(--ink)] max-w-md mx-auto leading-relaxed">
                UFW Güvenlik Duvarı yönetimi sunucu genelinde kritik kuralları kapsadığı için sadece <strong>Administrator</strong> (Yönetici) rolündeki hesaplara açıktır. Müşteri hesapları bu sayfaya erişemez.
            </p>
            <div class="pt-2">
                <a href="" class="btn-secondary text-xs inline-flex items-center gap-1.5">
                    Genel Bakışa Dön
                </a>
            </div>
        </div>
    }
    else if (_isLoading)
    {
        <!-- Yükleniyor Spinner Ekranı -->
        <div class="flex flex-col items-center justify-center py-20 space-y-4">
            <div class="w-10 h-10 border-3 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></div>
            <p class="text-xs text-[var(--ink-soft)] font-medium">UFW Güvenlik Duvarı verileri çekiliyor...</p>
        </div>
    }
    else
    {
        <!-- DURUM VE ORKESTRASYON BARKODU -->
        <div class="card flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center text-xl shadow-sm @(_firewallActive ? "bg-[var(--moss-bg)] text-[var(--moss)] border border-[var(--moss)]" : "bg-[var(--rose-bg)] text-[var(--rose)] border border-[var(--rose)]")">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Sunucu Güvenlik Duvarı Durumu</h3>
                    <p class="text-xs text-[var(--ink-soft)] mt-0.5">
                        @if (_firewallActive)
                        {
                            <span>UFW Servisi şu anda aktif ve sunucunun dış kapılarını filtreliyor.</span>
                        }
                        else
                        {
                            <span>UFW şu anda kapalı. Tüm portlar dış dünyaya açık durumda (Kritik Güvenlik Riski)!</span>
                        }
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                @if (_firewallActive)
                {
                    <span class="pill pill-moss text-xs"><span class="dot"></span>AKTİF / KORUMADA</span>
                }
                else
                {
                    <span class="pill pill-rose text-xs"><span class="dot"></span>PASİF / GÜVENSİZ</span>
                }
                
                <button @onclick="ToggleFirewall" disabled="@_isProcessingToggle"
                    class="@(_firewallActive ? "btn-danger" : "btn-primary") text-xs py-2 px-3.5 flex items-center gap-2">
                    @if (_isProcessingToggle)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>İşleniyor...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-power-off text-xs"></i>
                        <span>@(_firewallActive ? "Güvenlik Duvarını Kapat" : "Güvenlik Duvarını Aç")</span>
                    }
                </button>
            </div>
        </div>

        <!-- UFW Kurallar Tablosu -->
        <div class="card space-y-4">
            <div class="flex justify-between items-center border-b border-[var(--line)] pb-3">
                <div>
                    <h3 class="font-serif font-semibold text-[var(--navy)] text-base">UFW Filtreleme ve Geçiş Kuralları</h3>
                    <p class="text-xs text-[var(--ink-soft)] mt-0.5">Belirli portların dış trafiğe izin verilmesi veya engellenmesi kuralları listesi</p>
                </div>
                <button @onclick="OpenAddRuleModal" class="btn-primary text-xs py-2 px-3.5 flex items-center gap-1.5">
                    <i class="fa-solid fa-plus text-xs"></i> Yeni Port Kuralı Ekle
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-[var(--line)] text-[var(--ink-soft)] font-semibold">
                            <th class="pb-3 w-12">#No</th>
                            <th class="pb-3">Hedef Port</th>
                            <th class="pb-3">Protokol</th>
                            <th class="pb-3">Aksiyon</th>
                            <th class="pb-3">Yön</th>
                            <th class="pb-3">Kimden (Kaynak)</th>
                            <th class="pb-3 text-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--line)]">
                        @if (!_rules.Any())
                        {
                            <tr>
                                <td colspan="7" class="py-6 text-center text-[var(--ink-soft)]">
                                    Güvenlik duvarında tanımlanmış herhangi bir kural bulunmamaktadır.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rule in _rules)
                            {
                                <tr class="text-[var(--ink)] hover:bg-[var(--cream)] transition-colors">
                                    <td class="py-3 font-mono text-[var(--ink-soft)]">@rule.Number</td>
                                    <td class="py-3 font-semibold">
                                        <span class="bg-[var(--cream)] border border-[var(--line)] text-[var(--navy)] font-mono px-2 py-0.5 rounded font-bold">
                                            @rule.Port
                                        </span>
                                    </td>
                                    <td class="py-3 font-mono uppercase">@rule.Protocol</td>
                                    <td class="py-3">
                                        @if (rule.Action.Equals("ALLOW", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="pill pill-moss text-[10.5px]">
                                                ALLOW (İzinli)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="pill pill-rose text-[10.5px]">
                                                DENY (Engelli)
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 font-mono text-[var(--ink-soft)]">@rule.Direction</td>
                                    <td class="py-3 font-mono text-[var(--ink-soft)]">@rule.From</td>
                                    <td class="py-3 text-right">
                                        <button @onclick="@(() => DeleteRule(rule.Number))" disabled="@_deletingRuleNumbers.Contains(rule.Number)"
                                            class="text-[var(--rose)] hover:underline font-bold text-xs transition-colors disabled:opacity-50 inline-flex items-center gap-1">
                                            @if (_deletingRuleNumbers.Contains(rule.Number))
                                            {
                                                <span class="w-3 h-3 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-trash-can text-[11px]"></i>
                                            }
                                            <span>Kaldır</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- YENİ KURAL EKLEME MODALI -->
@if (_addRuleModalVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                <h3 class="text-base font-serif font-semibold text-[var(--navy)] flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved text-[var(--azure)]"></i> Yeni UFW Kuralı Ekle
                </h3>
                <button @onclick="CloseAddRuleModal" class="btn-ghost p-1 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
            
            <div class="space-y-4 text-xs">
                <div>
                    <label class="block text-[var(--ink-soft)] font-semibold mb-1">Hedef Port veya Port Aralığı</label>
                    <input type="text" @bind="_newRuleModel.Port" placeholder="örn: 80, 22, 3000-4000"
                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--navy)] font-mono focus:outline-none focus:border-[var(--azure)] font-bold">
                    <span class="text-[10px] text-[var(--ink-soft)] block mt-1">Tek bir port numarası veya aralık belirtebilirsiniz.</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Protokol</label>
                        <select @bind="_newRuleModel.Protocol"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] focus:outline-none focus:border-[var(--azure)] font-mono">
                            <option value="tcp">TCP</option>
                            <option value="udp">UDP</option>
                            <option value="any">TÜMÜ (Any)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Aksiyon</label>
                        <select @bind="_newRuleModel.Action"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]">
                            <option value="ALLOW">ALLOW (İzin Ver)</option>
                            <option value="DENY">DENY (Engelle)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-4 border-t border-[var(--line)]">
                <button type="button" @onclick="CloseAddRuleModal"
                    class="btn-secondary py-2 px-4 text-xs">İptal</button>
                <button type="button" @onclick="HandleCreateRule" disabled="@_isProcessingAdd"
                    class="btn-primary py-2 px-4 text-xs flex items-center gap-1.5">
                    @if (_isProcessingAdd)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Uygulanıyor...</span>
                    }
                    else
                    {
                        <span>Kuralı Uygula</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isForbidden = false;
    private bool _firewallActive = false;
    private List<FirewallRuleDto> _rules = new();

    private bool _isProcessingToggle = false;
    private bool _addRuleModalVisible = false;
    private bool _isProcessingAdd = false;
    private readonly CreateRuleModel _newRuleModel = new();
    private readonly HashSet<int> _deletingRuleNumbers = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFirewallDataAsync();
    }

    private async Task LoadFirewallDataAsync()
    {
        try
        {
            _isForbidden = false;
            var response = await Http.GetAsync("api/firewall");

            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _isForbidden = true;
                _isLoading = false;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Güvenlik duvarı yüklenemedi: {err}", Severity.Error);
                _isLoading = false;
                return;
            }

            var statusDto = await response.Content.ReadFromJsonAsync<FirewallStatusResponse>();
            if (statusDto != null)
            {
                _firewallActive = statusDto.Active;
                _rules = statusDto.Rules?.ToList() ?? new List<FirewallRuleDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Güvenlik duvarına bağlanırken hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleFirewall()
    {
        _isProcessingToggle = true;
        try
        {
            var nextState = !_firewallActive;
            var response = await Http.PostAsJsonAsync("api/firewall/toggle", new { Active = nextState });
            if (response.IsSuccessStatusCode)
            {
                _firewallActive = nextState;
                Snackbar.Add($"Güvenlik duvarı başarıyla {(nextState ? "etkinleştirildi ve tüm filtreleme kuralları aktif edildi" : "devre dışı bırakıldı. Sunucu portları açık!")}.", 
                    nextState ? Severity.Success : Severity.Warning);
                await LoadFirewallDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Güvenlik duvarı tetiklenemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"İşlem başarısız: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessingToggle = false;
        }
    }

    private void OpenAddRuleModal()
    {
        _newRuleModel.Port = "";
        _newRuleModel.Protocol = "tcp";
        _newRuleModel.Action = "ALLOW";
        _addRuleModalVisible = true;
    }

    private void CloseAddRuleModal()
    {
        _addRuleModalVisible = false;
    }

    private async Task HandleCreateRule()
    {
        if (string.IsNullOrWhiteSpace(_newRuleModel.Port))
        {
            Snackbar.Add("Port veya port aralığı alanı gereklidir!", Severity.Warning);
            return;
        }

        _isProcessingAdd = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/firewall", _newRuleModel);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Port {_newRuleModel.Port} ({_newRuleModel.Protocol}) kuralı başarıyla eklendi.", Severity.Success);
                _addRuleModalVisible = false;
                await LoadFirewallDataAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Kural eklenemedi: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessingAdd = false;
        }
    }

    private async Task DeleteRule(int number)
    {
        _deletingRuleNumbers.Add(number);
        StateHasChanged();
        try
        {
            var response = await Http.DeleteAsync($"api/firewall/{number}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Güvenlik duvarı kuralı #{number} başarıyla kaldırıldı.", Severity.Success);
                await LoadFirewallDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Kural silinemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _deletingRuleNumbers.Remove(number);
            StateHasChanged();
        }
    }

    // Alt sınıflar ve DTO modeller
    private class FirewallStatusResponse
    {
        public bool Active { get; set; }
        public List<FirewallRuleDto>? Rules { get; set; }
    }

    private class FirewallRuleDto
    {
        public int Number { get; set; }
        public string Port { get; set; } = string.Empty;
        public string Protocol { get; set; } = "tcp";
        public string Action { get; set; } = "ALLOW";
        public string Direction { get; set; } = "IN";
        public string From { get; set; } = "Anywhere";
    }

    private class CreateRuleModel
    {
        public string Port { get; set; } = string.Empty;
        public string Protocol { get; set; } = "tcp";
        public string Action { get; set; } = "ALLOW";
    }
}
