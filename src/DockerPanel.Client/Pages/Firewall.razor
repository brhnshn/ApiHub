@page "/firewall"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Güvenlik & Güvenlik Duvarı (UFW) - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div>
        <h2 class="text-2xl font-extrabold text-[#0b1c30] tracking-tight">Güvenlik & UFW Güvenlik Duvarı</h2>
        <p class="text-xs text-slate-500 font-medium mt-1">
            Sunucu port erişim limitlerini, IP kurallarını ve işletim sistemi UFW filtreleme servislerini tek bir panelden güvenle yönetin.
        </p>
    </div>

    @if (_isForbidden)
    {
        <!-- Yetkisiz Erişim Uyarısı (Customer Rolü İçin) -->
        <div class="bg-rose-950/20 border border-rose-500/30 rounded-xl p-6 text-center space-y-4 max-w-2xl mx-auto shadow-2xl">
            <div class="w-16 h-16 bg-rose-500/10 rounded-full flex items-center justify-center mx-auto text-rose-500 animate-pulse border border-rose-500/20">
                <i class="fa-solid fa-shield-halved text-3xl"></i>
            </div>
            <h3 class="text-lg font-bold text-rose-400">Yönetici Yetkisi Gerekli</h3>
            <p class="text-xs text-slate-300 max-w-md mx-auto leading-relaxed">
                UFW Güvenlik Duvarı yönetimi sunucu genelinde kritik kuralları kapsadığı için sadece <strong>Administrator</strong> (Yönetici) rolündeki hesaplara açıktır. Müşteri hesapları bu sayfaya erişemez.
            </p>
            <div class="pt-2">
                <a href="" class="bg-slate-800 hover:bg-slate-700 text-slate-100 text-xs font-bold px-4 py-2 rounded-lg border border-slate-700 transition-all">
                    Genel Bakışa Dön
                </a>
            </div>
        </div>
    }
    else if (_isLoading)
    {
        <!-- Yükleniyor Spinner Ekranı -->
        <div class="flex flex-col items-center justify-center py-20 space-y-4">
            <div class="w-12 h-12 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin"></div>
            <p class="text-xs text-slate-400 font-medium">UFW Güvenlik Duvarı verileri çekiliyor...</p>
        </div>
    }
    else
    {
        <!-- DURUM VE ORKESTRASYON BARKODU -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="p-3.5 rounded-lg border @(_firewallActive ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-400" : "bg-rose-500/10 border-rose-500/30 text-rose-500") shadow-md">
                    <i class="fa-solid fa-shield-halved text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-[#0b1c30] text-sm">Sunucu Güvenlik Duvarı Durumu</h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">
                        @if (_firewallActive)
                        {
                            <span>UFW Servisi şu anda aktif ve sunucunun dış kapılarını filtreliyor.</span>
                        }
                        else
                        {
                            <span>UFW şu anda kapalı. Tüm portlar dış dünyaya açık durumda (Kritik Güvenlik Riski)!</span>
                        }
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2 bg-white border border-[#bbcabf]/30 px-4 py-2.5 rounded-lg">
                    <span class="@(_firewallActive ? "pulse-green" : "pulse-red")"></span>
                    <span class="text-xs font-bold text-[#0b1c30] uppercase tracking-wider">
                        @(_firewallActive ? "AKTİF / KORUMADA" : "PASİF / GÜVENSİZ")
                    </span>
                </div>
                
                <button @onclick="ToggleFirewall" disabled="@_isProcessingToggle"
                    class="px-4 py-2.5 rounded-lg text-xs font-bold text-white transition-all shadow-md flex items-center gap-2 @(_firewallActive ? "bg-rose-600 hover:bg-rose-500" : "bg-emerald-600 hover:bg-emerald-500")">
                    @if (_isProcessingToggle)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>İşleniyor...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-power-off"></i>
                        <span>@(_firewallActive ? "Güvenlik Duvarını Kapat" : "Güvenlik Duvarını Aç")</span>
                    }
                </button>
            </div>
        </div>

        <!-- UFW Kurallar Tablosu -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl">
            <div class="flex justify-between items-center mb-4 border-b border-slate-200 pb-3">
                <div>
                    <h3 class="font-bold text-[#0b1c30] text-sm">UFW Filtreleme ve Geçiş Kuralları</h3>
                    <p class="text-[11px] text-slate-400 mt-0.5">Belirli portların dış trafiğe izin verilmesi veya engellenmesi kuralları listesi</p>
                </div>
                <button @onclick="OpenAddRuleModal"
                    class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition-all shadow-md">
                    <i class="fa-solid fa-plus"></i> Yeni Port Kuralı Ekle
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-slate-800 text-slate-400">
                            <th class="pb-3 font-semibold w-12">#No</th>
                            <th class="pb-3 font-semibold">Hedef Port</th>
                            <th class="pb-3 font-semibold">Protokol</th>
                            <th class="pb-3 font-semibold">Aksiyon</th>
                            <th class="pb-3 font-semibold">Yön</th>
                            <th class="pb-3 font-semibold">Kimden (Kaynak)</th>
                            <th class="pb-3 font-semibold text-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        @if (!_rules.Any())
                        {
                            <tr>
                                <td colspan="7" class="py-6 text-center text-slate-500">
                                    Güvenlik duvarında tanımlanmış herhangi bir kural bulunmamaktadır.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rule in _rules)
                            {
                                <tr class="text-slate-300 hover:bg-slate-950/20 transition-colors">
                                    <td class="py-3 font-mono text-slate-400">@rule.Number</td>
                                    <td class="py-3 font-semibold">
                                        <span class="bg-[#eff4ff] border border-[#bbcabf]/30 text-[#006c49] font-mono px-2 py-0.5 rounded font-bold">
                                            @rule.Port
                                        </span>
                                    </td>
                                    <td class="py-3 font-mono uppercase">@rule.Protocol</td>
                                    <td class="py-3">
                                        @if (rule.Action.Equals("ALLOW", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full font-bold">
                                                ALLOW (İzinli)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 px-2 py-0.5 rounded-full font-bold">
                                                DENY (Engelli)
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 font-mono text-slate-400">@rule.Direction</td>
                                    <td class="py-3 font-mono text-slate-400">@rule.From</td>
                                    <td class="py-3 text-right">
                                        <button @onclick="@(() => DeleteRule(rule.Number))" disabled="@_deletingRuleNumbers.Contains(rule.Number)"
                                            class="text-rose-500 hover:text-rose-400 font-bold text-xs transition-colors disabled:opacity-50 flex items-center gap-1 ml-auto">
                                            @if (_deletingRuleNumbers.Contains(rule.Number))
                                            {
                                                <span class="w-3 h-3 border-2 border-rose-500 border-t-transparent rounded-full animate-spin"></span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-trash-can"></i>
                                            }
                                            <span>Kaldır</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- YENİ KURAL EKLEME MODALI -->
@if (_addRuleModalVisible)
{
    <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center">
        <div class="bg-white border border-[#bbcabf]/30 rounded-xl w-full max-w-md p-6 space-y-4 text-[#0b1c30] shadow-2xl animate-fade-in">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                <h3 class="text-lg font-bold text-[#0b1c30] flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved text-[#006c49]"></i> Yeni UFW Kuralı Ekle
                </h3>
                <button @onclick="CloseAddRuleModal" class="text-slate-400 hover:text-white transition-colors">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <div class="space-y-4 text-xs">
                <div>
                    <label class="block text-slate-400 font-semibold mb-1">Hedef Port veya Port Aralığı</label>
                    <input type="text" @bind="_newRuleModel.Port" placeholder="örn: 80, 22, 3000-4000"
                        class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-white font-mono focus:outline-none focus:border-indigo-500">
                    <span class="text-[10px] text-slate-500 block mt-1">Tek bir port numarası veya aralık belirtebilirsiniz.</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">Protokol</label>
                        <select @bind="_newRuleModel.Protocol"
                            class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-white focus:outline-none focus:border-indigo-500">
                            <option value="tcp">TCP</option>
                            <option value="udp">UDP</option>
                            <option value="any">TÜMÜ (Any)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">Aksiyon</label>
                        <select @bind="_newRuleModel.Action"
                            class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-white focus:outline-none focus:border-indigo-500">
                            <option value="ALLOW">ALLOW (İzin Ver)</option>
                            <option value="DENY">DENY (Engelle)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
                <button type="button" @onclick="CloseAddRuleModal"
                    class="bg-slate-800 text-slate-300 px-4 py-2 rounded-lg hover:bg-slate-700 transition-colors text-xs font-semibold">İptal</button>
                <button type="button" @onclick="HandleCreateRule" disabled="@_isProcessingAdd"
                    class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg font-bold text-xs transition-all shadow-lg flex items-center gap-1.5">
                    @if (_isProcessingAdd)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Uygulanıyor...</span>
                    }
                    else
                    {
                        <span>Kuralı Uygula</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isForbidden = false;
    private bool _firewallActive = false;
    private List<FirewallRuleDto> _rules = new();

    private bool _isProcessingToggle = false;
    private bool _addRuleModalVisible = false;
    private bool _isProcessingAdd = false;
    private readonly CreateRuleModel _newRuleModel = new();
    private readonly HashSet<int> _deletingRuleNumbers = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFirewallDataAsync();
    }

    private async Task LoadFirewallDataAsync()
    {
        try
        {
            _isForbidden = false;
            var response = await Http.GetAsync("api/firewall");

            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _isForbidden = true;
                _isLoading = false;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Güvenlik duvarı yüklenemedi: {err}", Severity.Error);
                _isLoading = false;
                return;
            }

            var statusDto = await response.Content.ReadFromJsonAsync<FirewallStatusResponse>();
            if (statusDto != null)
            {
                _firewallActive = statusDto.Active;
                _rules = statusDto.Rules?.ToList() ?? new List<FirewallRuleDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Güvenlik duvarına bağlanırken hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleFirewall()
    {
        _isProcessingToggle = true;
        try
        {
            var nextState = !_firewallActive;
            var response = await Http.PostAsJsonAsync("api/firewall/toggle", new { Active = nextState });
            if (response.IsSuccessStatusCode)
            {
                _firewallActive = nextState;
                Snackbar.Add($"Güvenlik duvarı başarıyla {(nextState ? "etkinleştirildi ve tüm filtreleme kuralları aktif edildi" : "devre dışı bırakıldı. Sunucu portları açık!")}.", 
                    nextState ? Severity.Success : Severity.Warning);
                await LoadFirewallDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Güvenlik duvarı tetiklenemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"İşlem başarısız: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessingToggle = false;
        }
    }

    private void OpenAddRuleModal()
    {
        _newRuleModel.Port = "";
        _newRuleModel.Protocol = "tcp";
        _newRuleModel.Action = "ALLOW";
        _addRuleModalVisible = true;
    }

    private void CloseAddRuleModal()
    {
        _addRuleModalVisible = false;
    }

    private async Task HandleCreateRule()
    {
        if (string.IsNullOrWhiteSpace(_newRuleModel.Port))
        {
            Snackbar.Add("Port veya port aralığı alanı gereklidir!", Severity.Warning);
            return;
        }

        _isProcessingAdd = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/firewall", _newRuleModel);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Port {_newRuleModel.Port} ({_newRuleModel.Protocol}) kuralı başarıyla eklendi.", Severity.Success);
                _addRuleModalVisible = false;
                await LoadFirewallDataAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Kural eklenemedi: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessingAdd = false;
        }
    }

    private async Task DeleteRule(int number)
    {
        _deletingRuleNumbers.Add(number);
        StateHasChanged();
        try
        {
            var response = await Http.DeleteAsync($"api/firewall/{number}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Güvenlik duvarı kuralı #{number} başarıyla kaldırıldı.", Severity.Success);
                await LoadFirewallDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Kural silinemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _deletingRuleNumbers.Remove(number);
            StateHasChanged();
        }
    }

    // Alt sınıflar ve DTO modeller
    private class FirewallStatusResponse
    {
        public bool Active { get; set; }
        public List<FirewallRuleDto>? Rules { get; set; }
    }

    private class FirewallRuleDto
    {
        public int Number { get; set; }
        public string Port { get; set; } = string.Empty;
        public string Protocol { get; set; } = "tcp";
        public string Action { get; set; } = "ALLOW";
        public string Direction { get; set; } = "IN";
        public string From { get; set; } = "Anywhere";
    }

    private class CreateRuleModel
    {
        public string Port { get; set; } = string.Empty;
        public string Protocol { get; set; } = "tcp";
        public string Action { get; set; } = "ALLOW";
    }
}
