@page "/databases"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject PlatformInfo PlatformInfo
@inject DockerPanel.Client.Services.AppState AppState
@implements IDisposable

<PageTitle>Veritabanı Yönetimi - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="eyebrow">Veritabanı Servisleri</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">PostgreSQL Şema Yönetimi</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">
                PostgreSQL master sunucusu üzerinde izole veritabanı şemalarını ve özel kullanıcı yetkilendirmelerini yönetin.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- PostgreSQL Durum Kartı -->
        <div class="lg:col-span-4 card flex flex-col justify-between space-y-4">
            <div>
                <div class="flex items-center justify-between border-b border-[var(--line)] pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-database text-[var(--azure)] text-base"></i>
                        <h3 class="font-serif font-semibold text-[var(--navy)] text-base">PostgreSQL Cluster</h3>
                    </div>
                    <span class="pill pill-moss text-[10.5px]"><span class="dot"></span>Master 16</span>
                </div>

                <div class="space-y-3 text-xs">
                    <div class="flex items-center justify-between py-1.5 border-b border-[var(--line)]">
                        <span class="text-[var(--ink-soft)]">Internal Port:</span>
                        <strong class="font-mono text-[var(--moss)] font-bold">5432</strong>
                    </div>

                    <div class="flex items-center justify-between py-1.5 border-b border-[var(--line)]">
                        <span class="text-[var(--ink-soft)]">Güvenlik Politikası:</span>
                        <strong class="text-[var(--navy)] font-semibold">İç Ağ İzolasyonu</strong>
                    </div>

                    <div class="flex items-center justify-between py-1.5 border-b border-[var(--line)]">
                        <span class="text-[var(--ink-soft)]">Aktif Bağlantı:</span>
                        <strong class="text-[var(--navy)] font-mono">@_stats.ActiveConnections / @_stats.MaxConnections</strong>
                    </div>

                    <div class="flex items-center justify-between py-1.5">
                        <span class="text-[var(--ink-soft)]">Disk Kullanımı (DB):</span>
                        <strong class="text-[var(--rose)] font-mono font-bold">@FormatSize(_stats.TotalSizeBytes)</strong>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-[var(--line)] text-[11px] text-[var(--ink-soft)] italic">
                * PostgreSQL master portu (5432) dış ağa kapalıdır, sadece dockerpanel iç ağındaki konteynerler ve API erişebilir.
            </div>
        </div>

        <!-- Veritabanı Listesi Tablosu ve Yeni Ekleme -->
        <div class="lg:col-span-8 card space-y-4">
            <div class="flex items-center justify-between flex-wrap gap-3 border-b border-[var(--line)] pb-3">
                <div>
                    <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Aktif İzole Şemalar</h3>
                    <p class="text-xs text-[var(--ink-soft)] mt-0.5">Tanımlı veritabanı şemaları ve kullanıcıları</p>
                </div>
                <div class="flex items-center gap-2">
                    <button @onclick="OpenDiscoverModal" class="btn-secondary text-xs py-2 px-3 flex items-center gap-1.5">
                        <i class="fa-solid fa-magnifying-glass text-xs"></i> Eski DB Keşfet
                    </button>
                    <button @onclick="OpenCreateModal" class="btn-primary text-xs py-2 px-3 flex items-center gap-1.5">
                        <i class="fa-solid fa-plus text-xs"></i> Yeni Şema Oluştur
                    </button>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="flex flex-col items-center justify-center py-10 space-y-2">
                    <div class="w-8 h-8 border-3 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-xs text-[var(--ink-soft)]">Şemalar yükleniyor...</span>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-[var(--line)] text-[var(--ink-soft)] font-semibold">
                                <th class="pb-3">Veritabanı Şeması</th>
                                <th class="pb-3">Yetkili Kullanıcı</th>
                                <th class="pb-3">Veritabanı Tipi</th>
                                <th class="pb-3 text-right">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--line)]">
                            @if (!_databases.Any())
                            {
                                <tr>
                                    <td colspan="4" class="py-6 text-center text-[var(--ink-soft)]">
                                        Henüz oluşturulmuş bir veritabanı şeması bulunmamaktadır.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var context in _databases)
                                {
                                    <tr class="text-[var(--ink)] hover:bg-[var(--cream)] transition-colors">
                                        <td class="py-3">
                                            <div class="flex items-center gap-2">
                                                <span class="font-mono text-[var(--moss)] font-bold text-xs">@context.DbName</span>
                                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--cream)] border border-[var(--line)] text-[var(--ink-soft)] font-mono">@FormatSize(context.SizeBytes)</span>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="pill pill-azure text-[11px]">
                                                <i class="fa-solid fa-user text-[10px] mr-1"></i> @context.DbUser
                                            </span>
                                        </td>
                                        <td class="py-3 text-[var(--ink-soft)] font-medium">
                                            PostgreSQL 16
                                        </td>
                                        <td class="py-3 text-right">
                                            <button @onclick="@(() => DeleteSchema(context))"
                                                class="text-[var(--rose)] hover:underline font-bold text-xs transition-colors inline-flex items-center gap-1">
                                                <i class="fa-solid fa-trash-can text-[11px]"></i> Sil
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Yeni Şema Oluşturma Modalı -->
@if (_createModalVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                <h3 class="text-base font-serif font-semibold text-[var(--navy)] flex items-center gap-2">
                    <i class="fa-solid fa-database text-[var(--azure)]"></i> Yeni Veritabanı Şeması Yarat
                </h3>
                <button @onclick="CloseCreateModal" class="btn-ghost p-1 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <EditForm Model="@_createModel" OnValidSubmit="HandleCreate">
                <DataAnnotationsValidator />

                <div class="space-y-3.5 text-xs">
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1 uppercase tracking-wider">Veritabanı Adı (DbName)</label>
                        <InputText @bind-Value="_createModel.DbName" placeholder="örn: my_api_db"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--navy)] font-mono font-bold focus:outline-none focus:border-[var(--azure)]" />
                        <ValidationMessage For="@(() => _createModel.DbName)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1 uppercase tracking-wider">Kullanıcı Adı (DbUser)</label>
                        <InputText @bind-Value="_createModel.DbUser" placeholder="örn: my_api_user"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--navy)] font-mono font-bold focus:outline-none focus:border-[var(--azure)]" />
                        <ValidationMessage For="@(() => _createModel.DbUser)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1 uppercase tracking-wider">Veritabanı Parolası</label>
                        <InputText @bind-Value="_createModel.Password" type="password" placeholder="Master şifre"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]" />
                        <ValidationMessage For="@(() => _createModel.Password)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-4 border-t border-[var(--line)] mt-4">
                    <button type="button" @onclick="CloseCreateModal" class="btn-secondary py-2 px-4 text-xs">İptal</button>
                    <button type="submit" disabled="@_isCreating" class="btn-primary py-2 px-4 text-xs flex items-center gap-1.5">
                        @if (_isCreating)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                            <span>Veritabanı Sağlanıyor...</span>
                        }
                        else
                        {
                            <span>Şemayı Yarat</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Veritabanı Keşif Modalı -->
@if (_discoverModalVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-lg p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                <h3 class="text-base font-serif font-semibold text-[var(--navy)] flex items-center gap-2">
                    <i class="fa-solid fa-magnifying-glass text-[var(--azure)]"></i> Mevcut Veritabanlarını Keşfet
                </h3>
                <button @onclick="CloseDiscoverModal" class="btn-ghost p-1 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <p class="text-xs text-[var(--ink-soft)] leading-relaxed">
                PostgreSQL cluster'ınızda bulunan ancak panele henüz kaydedilmemiş (dışarıda oluşturulmuş) veritabanlarını tarar ve panele içe aktarmanıza olanak tanır.
            </p>

            @if (_isDiscovering)
            {
                <div class="flex flex-col items-center justify-center py-8 space-y-2">
                    <div class="w-8 h-8 border-3 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-xs text-[var(--ink-soft)]">PostgreSQL kataloğu taranıyor...</span>
                </div>
            }
            else if (!_discoveredDatabases.Any())
            {
                <div class="text-center py-8 text-xs text-[var(--ink-soft)]">
                    İçe aktarılabilecek yeni bir veritabanı bulunamadı veya tüm veritabanları zaten kayıtlı.
                </div>
            }
            else
            {
                <div class="overflow-x-auto max-h-60 overflow-y-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-[var(--line)] text-[var(--ink-soft)] font-semibold">
                                <th class="pb-2">Veritabanı Adı</th>
                                <th class="pb-2">Sahibi (Owner)</th>
                                <th class="pb-2">Boyut</th>
                                <th class="pb-2 text-right">Durum</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--line)]">
                            @foreach (var item in _discoveredDatabases)
                            {
                                <tr class="text-[var(--ink)] hover:bg-[var(--cream)] transition-colors">
                                    <td class="py-2.5 font-mono font-bold @(item.IsImported ? "text-[var(--ink-soft)]" : "text-[var(--moss)]")">
                                        @item.DbName
                                    </td>
                                    <td class="py-2.5 text-[var(--ink)]">
                                        @item.DbUser
                                    </td>
                                    <td class="py-2.5 font-mono text-[var(--ink-soft)]">
                                        @FormatSize(item.SizeInBytes)
                                    </td>
                                    <td class="py-2.5 text-right">
                                        @if (item.IsImported)
                                        {
                                            <span class="pill pill-moss text-[10.5px]">
                                                <i class="fa-solid fa-check mr-1"></i> Aktarıldı
                                            </span>
                                        }
                                        else
                                        {
                                            <button @onclick="@(() => ImportDatabase(item))" class="btn-primary text-[11px] py-1 px-2.5">
                                                İçe Aktar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="flex justify-end pt-4 border-t border-[var(--line)]">
                <button type="button" @onclick="CloseDiscoverModal" class="btn-secondary py-2 px-4 text-xs">Kapat</button>
            </div>
        </div>
    </div>
}

@code {
    private List<DatabaseSchemaDto> _databases = new();
    private List<DiscoveredDatabaseDto> _discoveredDatabases = new();
    private DatabaseStatsDto _stats = new();
    private bool _discoverModalVisible = false;
    private bool _isDiscovering = false;
    private bool _isLoading = true;
    private bool _createModalVisible = false;
    private bool _isCreating = false;
    private readonly CreateDatabaseModel _createModel = new();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnPullToRefresh += LoadDatabasesAsync;
        await LoadDatabasesAsync();
    }

    private async Task LoadDatabasesAsync()
    {
        _isLoading = true;
        try
        {
            var raw = await Http.GetFromJsonAsync<List<DatabaseSchemaDto>>("api/databases");
            _databases = raw ?? new List<DatabaseSchemaDto>();

            var statsRaw = await Http.GetFromJsonAsync<DatabaseStatsDto>("api/databases/stats");
            if (statsRaw != null)
            {
                _stats = statsRaw;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PostgreSQL şemaları çekilirken hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenCreateModal()
    {
        _createModel.DbName = "";
        _createModel.DbUser = "";
        _createModel.Password = "";
        _createModalVisible = true;
    }

    private void CloseCreateModal()
    {
        _createModalVisible = false;
    }

    private async Task HandleCreate()
    {
        _isCreating = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/databases", _createModel);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("PostgreSQL şeması ve yetkili kullanıcısı başarıyla oluşturuldu!", Severity.Success);
                _createModalVisible = false;
                await LoadDatabasesAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Veritabanı oluşturulamadı: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task DeleteSchema(DatabaseSchemaDto item)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"'{item.DbName}' veritabanı şemasını ve yetkili kullanıcısı '{item.DbUser}'ı silmek istediğinize emin misiniz?\nBu işlem veritabanını kalıcı olarak yok edecektir ve geri alınamaz!");
        if (!confirmed) return;

        try
        {
            var response = await Http.DeleteAsync($"api/databases/{item.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("PostgreSQL şeması ve kullanıcısı başarıyla silindi.", Severity.Success);
                await LoadDatabasesAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Şema silinemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenDiscoverModal()
    {
        _discoverModalVisible = true;
        await DiscoverDatabasesAsync();
    }

    private void CloseDiscoverModal()
    {
        _discoverModalVisible = false;
    }

    private async Task DiscoverDatabasesAsync()
    {
        _isDiscovering = true;
        try
        {
            var raw = await Http.GetFromJsonAsync<List<DiscoveredDatabaseDto>>("api/databases/discover");
            _discoveredDatabases = raw ?? new List<DiscoveredDatabaseDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Mevcut veritabanları keşfedilirken hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDiscovering = false;
        }
    }

    private async Task ImportDatabase(DiscoveredDatabaseDto item)
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/databases/import", new { DbName = item.DbName, DbUser = item.DbUser });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"'{item.DbName}' veritabanı başarıyla içe aktarıldı!", Severity.Success);
                item.IsImported = true;
                await LoadDatabasesAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"İçe aktarılamadı: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private string FormatSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB", "TB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:n1} {suffixes[counter]}";
    }

    public class DiscoveredDatabaseDto
    {
        public string DbName { get; set; } = string.Empty;
        public string DbUser { get; set; } = string.Empty;
        public long SizeInBytes { get; set; }
        public bool IsImported { get; set; }
    }

    // DTO Tanımları
    public class DatabaseSchemaDto
    {
        public Guid Id { get; set; }
        public string DbName { get; set; } = string.Empty;
        public string DbUser { get; set; } = string.Empty;
        public long SizeBytes { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class DatabaseStatsDto
    {
        public int ActiveConnections { get; set; } = 3;
        public int MaxConnections { get; set; } = 100;
        public long TotalSizeBytes { get; set; } = 0;
    }

    // Form Model Tanımı
    public class CreateDatabaseModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Veritabanı adı zorunludur!")]
        [System.ComponentModel.DataAnnotations.RegularExpression("^[a-zA-Z0-9_]+$", ErrorMessage = "Yalnızca harf, rakam veya alt çizgi (_) kullanabilirsiniz.")]
        public string DbName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Kullanıcı adı zorunludur!")]
        [System.ComponentModel.DataAnnotations.RegularExpression("^[a-zA-Z0-9_]+$", ErrorMessage = "Yalnızca harf, rakam veya alt çizgi (_) kullanabilirsiniz.")]
        public string DbUser { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Veritabanı parolası zorunludur!")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Parola en az 6 karakter olmalıdır.")]
        public string Password { get; set; } = string.Empty;
    }

    public void Dispose()
    {
        AppState.OnPullToRefresh -= LoadDatabasesAsync;
    }
}
