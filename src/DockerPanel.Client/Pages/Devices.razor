@page "/devices"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject DockerPanel.Client.Services.AppState AppState
@inject PlatformInfo PlatformInfo
@implements IDisposable


<PageTitle>Cihaz Yönetimi - ApiHub</PageTitle>



<div class="space-y-6">
    <!-- Başlık Alanı -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="eyebrow">Mobil Entegrasyon</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">Mobil Cihaz Yönetimi</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">ApiHub mobil uygulamasına bağlı cihazları ve aktif durumlarını izleyin.</p>
        </div>
        <button @onclick="LoadDevices" disabled="@_isRefreshing" class="btn-secondary text-xs py-2 px-3.5 flex items-center gap-1.5">
            @if (_isRefreshing)
            {
                <span class="w-3.5 h-3.5 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
                <span>Yenileniyor...</span>
            }
            else
            {
                <i class="fa-solid fa-arrows-rotate text-xs"></i>
                <span>Yenile</span>
            }
        </button>
    </div>

    @if (!AppState.IsFcmConfigured)
    {
        <div class="p-3.5 rounded-xl border border-[var(--amber)] bg-[var(--amber-bg)] flex items-center gap-3 font-semibold text-xs text-[var(--amber)]">
            <i class="fa-solid fa-triangle-exclamation text-base animate-pulse"></i>
            <span>Firebase (FCM) Simülasyon Modunda çalışıyor. Sunucuda <code>firebase-service-account.json</code> yetkilendirme dosyası bulunamadığı için mobil cihazlara gerçek push bildirimleri iletilemeyecektir!</span>
        </div>
    }

    <!-- Bento İstatistik Kartları -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-lbl">Toplam Cihaz</div>
            <div class="stat-val">@_totalCount</div>
            <div class="stat-sub">Kayıtlı mobil uygulama</div>
        </div>
        
        <div class="stat-card">
            <div class="stat-lbl">Aktif Cihazlar</div>
            <div class="stat-val text-[var(--moss)]">@_activeCount</div>
            <div class="stat-sub flex items-center gap-1.5 mt-1">
                <span class="pulse-green"></span> Anlık bağlı cihaz
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-lbl">Desteklenen Platform</div>
            <div class="stat-val text-base md:text-lg font-serif">Android (.APK)</div>
            <div class="stat-sub">Flutter Native Engine</div>
        </div>
    </div>

    <!-- Cihaz Tablosu -->
    <div class="card space-y-4">
        <div class="border-b border-[var(--line)] pb-3">
            <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Bağlı Cihazlar Listesi</h3>
            <p class="text-xs text-[var(--ink-soft)] mt-0.5">Uygulama üzerinden giriş yapmış yetkili cihazlar</p>
        </div>

        @if (_isLoading)
        {
            <div class="flex flex-col items-center justify-center py-10 space-y-2">
                <div class="w-8 h-8 border-3 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></div>
                <p class="text-xs text-[var(--ink-soft)]">Cihaz listesi yükleniyor...</p>
            </div>
        }
        else if (_devices == null || !_devices.Any())
        {
            <div class="text-center py-10">
                <i class="fa-solid fa-mobile-screen-button text-3xl text-[var(--slate)] mb-2"></i>
                <p class="font-semibold text-xs text-[var(--navy)]">Henüz kayıtlı cihaz yok</p>
                <p class="text-[11px] text-[var(--ink-soft)] mt-0.5">Uygulamayı bir telefona kurup giriş yaptığınızda cihazınız burada listelenecektir.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-[var(--line)] text-[var(--ink-soft)] font-semibold">
                            <th class="pb-3">Cihaz Adı</th>
                            <th class="pb-3">Platform</th>
                            <th class="pb-3">Kayıt Tarihi</th>
                            <th class="pb-3">Son Görülme</th>
                            <th class="pb-3">Durum</th>
                            <th class="pb-3 text-right">İşlem</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--line)]">
                        @foreach (var dev in _devices)
                        {
                            <tr class="text-[var(--ink)] hover:bg-[var(--cream)] transition-colors">
                                <td class="py-3 font-semibold text-[var(--navy)]">
                                    <div class="flex items-center gap-2">
                                        <i class="fa-solid fa-mobile-screen text-[var(--azure)]"></i>
                                        <span>@dev.DeviceName</span>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <span class="pill pill-moss text-[10.5px]">Android (.APK)</span>
                                </td>
                                <td class="py-3 font-mono text-[var(--ink-soft)]">@dev.CreatedAt.ToString("g")</td>
                                <td class="py-3 text-[var(--ink-soft)]">@GetRelativeTimeString(dev.LastUsedAt)</td>
                                <td class="py-3">
                                    @if (dev.IsActive)
                                    {
                                        <span class="pill pill-moss text-[10.5px]"><span class="dot"></span>Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="pill text-[10.5px] bg-[var(--cream)] text-[var(--ink-soft)]">Pasif</span>
                                    }
                                </td>
                                <td class="py-3 text-right space-x-2">
                                    <button @onclick="@(() => SendTestNotification(dev))" class="text-[var(--moss)] hover:underline font-bold text-xs" title="Test Bildirimi Gönder">
                                        <i class="fa-solid fa-paper-plane mr-1"></i> Test
                                    </button>
                                    <button @onclick="@(() => PromptUnregister(dev))" class="text-[var(--rose)] hover:underline font-bold text-xs ml-2" title="Cihazı Kaldır">
                                        <i class="fa-solid fa-trash-can mr-1"></i> Kaldır
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Cihaz Silme Onay Modalı -->
@if (_deleteConfirmVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-sm p-6 space-y-4 text-center">
            <div class="w-12 h-12 rounded-full bg-[var(--rose-bg)] text-[var(--rose)] flex items-center justify-center mx-auto text-xl">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 class="font-serif font-bold text-base text-[var(--navy)]">Cihaz Bağlantısını Kes</h3>
            <p class="text-xs text-[var(--ink-soft)] leading-relaxed">
                "<strong>@_deviceToDelete?.DeviceName</strong>" cihazının panelle olan bağlantısını kesmek istediğinizden emin misiniz?
            </p>
            <div class="flex justify-center gap-2 pt-3 border-t border-[var(--line)]">
                <button type="button" @onclick="@(() => _deleteConfirmVisible = false)" class="btn-secondary py-2 px-4 text-xs">
                    Vazgeç
                </button>
                <button type="button" @onclick="ConfirmUnregister" class="btn-danger py-2 px-4 text-xs">
                    Evet, Bağlantıyı Kes
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<DeviceResponseDto>? _devices;
    private bool _isLoading = true;
    private bool _isRefreshing = false;

    private int _totalCount = 0;
    private int _activeCount = 0;

    // Delete confirmation states
    private bool _deleteConfirmVisible = false;
    private DeviceResponseDto? _deviceToDelete;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnPullToRefresh += HandlePullToRefresh;
        await LoadDevices();
    }

    private async Task HandlePullToRefresh()
    {
        await LoadDevices();
    }

    private async Task LoadDevices()
    {
        _isRefreshing = true;
        try
        {
            using var cts = new System.Threading.CancellationTokenSource(3500);
            _devices = await Http.GetFromJsonAsync<List<DeviceResponseDto>>("api/devices", cts.Token);
            CalculateStats();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cihaz listesi yüklenemedi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private void CalculateStats()
    {
        if (_devices == null) return;
        _totalCount = _devices.Count;
        _activeCount = _devices.Count(d => d.IsActive);
    }

    private void PromptUnregister(DeviceResponseDto device)
    {
        _deviceToDelete = device;
        _deleteConfirmVisible = true;
    }

    private async Task ConfirmUnregister()
    {
        if (_deviceToDelete == null) return;
        _deleteConfirmVisible = false;

        try
        {
            var response = await Http.DeleteAsync($"api/devices/unregister/{Uri.EscapeDataString(_deviceToDelete.Token)}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Cihaz bağlantısı başarıyla kesildi.", Severity.Success);
                await LoadDevices();
            }
            else
            {
                Snackbar.Add("Cihaz silinemedi.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cihaz silinirken hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _deviceToDelete = null;
        }
    }

    private async Task SendTestNotification(DeviceResponseDto device)
    {
        try
        {
            var response = await Http.PostAsync($"api/devices/test-notification?token={Uri.EscapeDataString(device.Token)}", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"✅ '{device.DeviceName}' cihazına test bildirimi gönderildi!", Severity.Success);
            }
            else
            {
                string errorMsg = "Test bildirimi gönderilemedi.";
                try
                {
                    var errObj = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (errObj.TryGetProperty("message", out var msg) || errObj.TryGetProperty("Message", out msg))
                    {
                        errorMsg = msg.GetString() ?? errorMsg;
                    }
                }
                catch { /* JSON parse hatası — ham mesajı kullan */ }

                Snackbar.Add($"❌ {errorMsg}", Severity.Error, config =>
                {
                    config.ShowCloseIcon = true;
                    config.VisibleStateDuration = 6000;
                });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bildirim gönderilirken hata oluştu: {ex.Message}", Severity.Error);
        }
    }

    private string GetRelativeTimeString(DateTimeOffset time)
    {
        var diff = DateTimeOffset.UtcNow - time;
        if (diff.TotalSeconds < 60) return "Az önce";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} dk önce";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} saat önce";
        return $"{(int)diff.TotalDays} gün önce";
    }

    public class DeviceResponseDto
    {
        public string Token { get; set; } = string.Empty;
        public string Platform { get; set; } = "Android";
        public string DeviceName { get; set; } = "Bilinmeyen Cihaz";
        public DateTimeOffset CreatedAt { get; set; }
        public DateTimeOffset LastUsedAt { get; set; }
        public bool IsActive { get; set; }
    }

    public void Dispose()
    {
        AppState.OnPullToRefresh -= HandlePullToRefresh;
    }
}
