@page "/deployments/{Id:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Net.Http.Json
@using DockerPanel.Domain.Enums
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Deployment Durumu</PageTitle>

<div class="max-w-3xl mx-auto card space-y-5">
    <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
        <div>
            <div class="eyebrow">Dağıtım & Pipeline İzleyici</div>
            <h2 class="font-serif font-semibold text-lg text-[var(--navy)]">Deployment #@Id.ToString("N")[..8]</h2>
        </div>
        <span class="pill pill-azure text-xs">@_deployment?.Status</span>
    </div>

    @if (_deployment == null)
    {
        <div class="flex flex-col items-center justify-center py-10 space-y-2">
            <div class="w-8 h-8 border-3 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></div>
            <p class="text-xs text-[var(--ink-soft)]">Deployment durumu yükleniyor...</p>
        </div>
    }
    else
    {
        <div class="space-y-2 text-xs">
            @foreach (var step in _deployment.Steps.OrderBy(s => s.Order))
            {
                <div class="flex items-center justify-between p-3 rounded-lg bg-[var(--cream)] border border-[var(--line)]">
                    <span class="font-semibold text-[var(--navy)]">@step.Name</span>
                    @if (step.Status == "Failed")
                    {
                        <span class="pill pill-rose text-[10.5px]">Başarısız</span>
                    }
                    else if (step.Status == "Succeeded")
                    {
                        <span class="pill pill-moss text-[10.5px]">Başarılı</span>
                    }
                    else
                    {
                        <span class="pill pill-amber text-[10.5px]">@step.Status</span>
                    }
                </div>
            }
        </div>

        @if (_deployment.Status == DeploymentStatus.RollbackPending.ToString())
        {
            <div class="p-4 rounded-xl border border-[var(--amber)] bg-[var(--amber-bg)] space-y-2 text-xs">
                <div class="flex items-center gap-2 text-[var(--amber)] font-bold">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>Pipeline Başarısız Oldu</span>
                </div>
                <p class="text-[var(--ink)]">Geri alma (Rollback) için @_secondsRemaining saniye kaldı.</p>
                <button class="btn-primary py-2 px-4 text-xs font-bold mt-2" @onclick="RollbackAsync">Hemen Geri Al</button>
            </div>
        }
        @if (_deployment.Status == DeploymentStatus.RollbackFailed.ToString())
        {
            <div class="p-4 rounded-xl border border-[var(--rose)] bg-[var(--rose-bg)] space-y-2 text-xs">
                <div class="flex items-center gap-2 text-[var(--rose)] font-bold">
                    <i class="fa-solid fa-circle-xmark"></i>
                    <span>Rollback Tamamlanamadı</span>
                </div>
                <p class="text-[var(--ink)] text-[11px]">@_deployment.ErrorMessage</p>
                <button class="btn-danger py-2 px-4 text-xs font-bold mt-2" @onclick="RetryRollbackAsync">Tekrar Dene</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private DeploymentView? _deployment;
    private int _secondsRemaining;
    private CancellationTokenSource? _pollCancellation;

    protected override async Task OnInitializedAsync()
    {
        _pollCancellation = new CancellationTokenSource();
        await PollAsync(_pollCancellation.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            _deployment = await Http.GetFromJsonAsync<DeploymentView>($"api/deployments/{Id}", cancellationToken);
            if (_deployment?.Status == DeploymentStatus.RollbackPending.ToString())
            {
                _secondsRemaining = Math.Max(0, (int)Math.Ceiling(((_deployment.RollbackExpiresAt ?? DateTimeOffset.UtcNow) - DateTimeOffset.UtcNow).TotalSeconds));
                if (_secondsRemaining == 0)
                {
                    await Task.Delay(500, cancellationToken);
                    continue;
                }
            }
            else if (_deployment?.Status is nameof(DeploymentStatus.Succeeded) or nameof(DeploymentStatus.RolledBack) or nameof(DeploymentStatus.RollbackFailed))
            {
                await InvokeAsync(StateHasChanged);
                return;
            }
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1000, cancellationToken);
        }
    }

    private async Task RollbackAsync()
    {
        await Http.PostAsync($"api/deployments/{Id}/rollback", null);
        await RefreshAsync();
    }

    private async Task RetryRollbackAsync()
    {
        await Http.PostAsync($"api/deployments/{Id}/retry-rollback", null);
        await RefreshAsync();
    }

    private async Task RefreshAsync() => _deployment = await Http.GetFromJsonAsync<DeploymentView>($"api/deployments/{Id}");

    public ValueTask DisposeAsync()
    {
        _pollCancellation?.Cancel();
        _pollCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class DeploymentView
    {
        public string Status { get; set; } = string.Empty;
        public string? ErrorMessage { get; set; }
        public DateTimeOffset? RollbackExpiresAt { get; set; }
        public List<DeploymentStepView> Steps { get; set; } = new();
    }
    private sealed class DeploymentStepView { public int Order { get; set; } public string Name { get; set; } = string.Empty; public string Status { get; set; } = string.Empty; }
}
