                </div>
            </div>

            <!-- Alt Kota ve Hesap Kontrolleri -->
            <div class="space-y-4 pt-4 border-t border-white/5 shrink-0">
                <!-- Kota Barları -->
                <div class="p-2.5 bg-white/5 rounded-xl border border-white/5">
                    <div class="flex justify-between items-center mb-1 text-[8px] font-bold tracking-wider">
                        <span class="text-gray-500">KOTA KULLANIMI</span>
                        <span class="text-[#4edea3]">@_quotaPercent%</span>
                    </div>
                    <div class="w-full bg-white/10 h-1 rounded-full overflow-hidden">
                        <div class="bg-[#4edea3] h-full transition-all duration-500" style="width: @_quotaPercent%"></div>
                    </div>
                    <p class="text-[7px] text-gray-500 mt-0.5 text-right">@FormatBytes(_usedBytes) / @FormatBytes(_quotaBytes)</p>
                </div>
            </div>
        </div>

        <!-- 6. GÜZEL GOOGLE SWITCHER HESAP DEĞİŞTİRİCİ MODAL (CENTER OVERLAY) -->
        @if (_isAccountDropdownOpen)
        {
            <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-[999999] flex items-center justify-center p-4 animate-fade-in" @onclick="ToggleAccountDropdown">
                <div class="glass max-w-sm w-full rounded-2xl bg-[#171a21]/95 border border-white/10 p-5 text-[#e1e2ec] shadow-2xl relative space-y-4" @onclick:stopPropagation>
                    <div class="flex justify-between items-center border-b border-white/5 pb-2">
                        <span class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Hesap Değiştir</span>
                        <button @onclick="ToggleAccountDropdown" class="text-gray-500 hover:text-rose-500">
                            <span class="material-symbols-outlined text-sm">close</span>
