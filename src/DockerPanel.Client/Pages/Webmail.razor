                            <div class="border-t border-[#bbcabf]/10 pt-2 flex flex-col gap-1.5">
                                <a href="/email" 
                                   class="w-full py-1.5 bg-transparent text-center border border-[#bbcabf]/30 hover:border-[#006c49] hover:bg-[#006c49]/5 text-[10px] font-bold rounded-lg transition-all flex items-center justify-center gap-1 text-[#006c49]">
                                    <span class="material-symbols-outlined text-xs">settings</span>
                                    <span>Hesapları Yönet</span>
                                </a>
