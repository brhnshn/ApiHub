                                   placeholder="Etiket adı..." 
                                   @bind="_newLabelName" 
                                   @onkeyup="HandleNewLabelKeyup" />
                            <button @onclick="CreateLabelAsync" class="text-[#4edea3] hover:text-[#38c18c] flex items-center justify-center p-1">
                                <span class="material-symbols-outlined text-sm font-bold">check</span>
                            </button>
