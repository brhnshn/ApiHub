                        <span>Özel Etiketler</span>
                        <button @onclick="ToggleNewLabelInput" class="text-[#006c49] hover:text-[#005236] transition-colors flex items-center justify-center p-0.5 rounded hover:bg-[#eff4ff]">
                            <span class="material-symbols-outlined text-xs font-bold">add</span>
                        </button>
                    </div>

                    @if (_showNewLabelInput)
