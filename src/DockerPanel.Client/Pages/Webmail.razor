                         <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' @(_activeFolder == "spam" ? "1" : "0");">report</span>
                         <span class="flex-grow text-left text-xs font-semibold">Spam</span>
                     </button>
