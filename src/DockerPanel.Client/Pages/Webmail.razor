    private async Task SendQuickReply()
    {
        if (string.IsNullOrWhiteSpace(_quickReplyText) || _selectedMail == null || string.IsNullOrEmpty(_activeAccount)) return;

        _isSending = true;
        try
        {
            var finalBody = $"<p>Yanıtlanan Mesaj:</p><blockquote style='border-left: 2px solid #006c49; padding-left: 12px; color: #64748b;'>{_selectedMail.Body}</blockquote><br><p>{_quickReplyText}</p>";

            var payload = new
            {
                To = _selectedMail.SenderEmail,
                Subject = $"Re: {_selectedMail.Subject}",
                Body = finalBody,
                Attachments = _quickAttachments.Select(a => new
                {
                    FileName = a.FileName,
                    Base64Data = a.Base64Data,
                    ContentType = a.ContentType
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync($"api/mail/{Uri.EscapeDataString(_activeAccount)}/send", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Yanıtınız başarıyla gönderildi!", Severity.Success);
                _quickReplyText = "";
                _quickAttachments.Clear();
                _activeFolder = "sent";
                _selectedMail = null;
                await LoadMailsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Yanıt gönderilemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSending = false;
        }
    }

