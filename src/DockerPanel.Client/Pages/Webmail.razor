    private IEnumerable<MailItem> GetFilteredMails()
    {
        var filtered = _mails.Where(m => m.Folder == _activeFolder);
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            filtered = filtered.Where(m => m.Subject.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || 
                                           m.SenderName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || 
                                           m.To.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || 
                                           m.Body.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
        }
        return filtered.OrderByDescending(m => m.Date);
    }

    private void SelectMail(MailItem mail)
    {
        _selectedMail = mail;
        _isComposing = false;
        
        if (!mail.IsRead)
        {
            mail.IsRead = true;
            _unreadCount = _mails.Count(m => !m.IsRead && m.Folder == "inbox");
            _ = MarkSelectedMailAsReadAsync(mail);
        }
        
        if (_activeFolder == "draft")
        {
            _composeModel.To = mail.To;
            _composeModel.Subject = mail.Subject;
            _composeModel.Body = mail.Body;
            _isComposing = true;
            _shouldInitEditor = true;
        }
    }

