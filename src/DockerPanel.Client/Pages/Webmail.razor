                            <div class="flex justify-between items-center border-b border-[#bbcabf]/10 pb-1.5">
                                <span class="text-[9px] font-black text-[#3c4a42]/70 uppercase tracking-wider">Bağlı Hesaplar</span>
                                <button @onclick="ToggleAccountDropdown" class="text-slate-400 hover:text-rose-500 transition-colors flex items-center justify-center p-0.5 rounded-lg hover:bg-slate-100">
                                    <span class="material-symbols-outlined text-sm">close</span>
                                </button>
                            </div>

                            <!-- Hesaplar Listesi -->
                            @if (_accounts.Any())
                            {
                                <div class="flex flex-col gap-1 max-h-48 overflow-y-auto stitch-scrollbar pr-1">
                                    @foreach (var acc in _accounts)
                                    {
                                        var isActive = acc == _activeAccount;
                                        <button @onclick="() => SwitchAccount(acc)" 
                                                class="w-full text-left p-1.5 rounded-lg transition-all flex items-center gap-2 group border @(isActive ? "bg-[#006c49]/5 border-[#006c49]/20" : "border-transparent hover:bg-[#eff4ff]/40")">
                                            <div class="w-6 h-6 rounded-full flex items-center justify-center font-bold text-[10px] shrink-0 @(isActive ? "bg-[#006c49] text-white" : "bg-slate-100 text-[#3c4a42]")">
                                                @(acc.Substring(0, Math.Min(2, acc.Length)).ToUpper())
                                            </div>
                                            <div class="min-w-0 flex-grow">
                                                <p class="text-[11px] font-semibold truncate @(isActive ? "text-[#006c49]" : "text-[#0b1c30]")">@acc</p>
                                            </div>
                                            @if (isActive)
                                            {
                                                <span class="material-symbols-outlined text-[#006c49] text-sm shrink-0">check</span>
                                            }
                                        </button>
