    private async Task LoadAccountsAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true) return;

            var raw = await Http.GetFromJsonAsync<List<Email.MailAccountDto>>("api/mail");
            if (raw != null && raw.Any())
            {
                _accounts = raw.Select(a => a.EmailAddress).ToList();
                _activeAccount = _accounts.First();
                await LoadMailsAsync();
                _ = InvokeAsync(async () =>
                {
                    await Task.WhenAll(LoadCustomLabelsAsync(), LoadQuotaAsync());
                    StateHasChanged();
                });
            }
            else
            {
                _accounts = new List<string>();
                _mails = new List<MailItem>();
                _selectedMail = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"E-posta hesapları yüklenirken hata oluştu: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadMailsAsync()
    {
        if (string.IsNullOrEmpty(_activeAccount)) return;

        try
        {
            var rawMails = await Http.GetFromJsonAsync<List<BackendMailDto>>($"api/mail/{Uri.EscapeDataString(_activeAccount)}/emails?folder={Uri.EscapeDataString(_activeFolder)}&take=75");
            if (rawMails != null)
            {
                _mails = rawMails.Select(m => new MailItem
                {
                    Id = m.Id,
                    SenderName = m.SenderName,
                    SenderEmail = m.SenderEmail,
                    To = m.To,
                    Subject = m.Subject,
                    Snippet = m.Snippet,
                    Body = m.Body,
                    Date = m.Date.LocalDateTime,
                    IsRead = m.IsRead,
                    Folder = _activeFolder,
                    FilePath = m.FilePath,
                    Attachments = m.Attachments ?? new List<AttachmentDto>()
                }).ToList();

                if (_activeFolder == "inbox")
                {
                    _unreadCount = _mails.Count(m => !m.IsRead && m.Folder == "inbox");
                }
                _selectedMail = null;
                _isComposing = false;
                _mobileDrawerOpen = false;
            }
            else
            {
                _mails = new List<MailItem>();
                _selectedMail = null;
                _isComposing = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"E-postalar alınırken hata oluştu: {ex.Message}", Severity.Error);
        }
    }

