@page "/webmail"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject PlatformInfo Platform
@implements IDisposable

<PageTitle>ApiHubMail - E-posta</PageTitle>

<style>
    /* Scoped custom classes for smooth scrollbar and active row effects */
    .stitch-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .stitch-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .stitch-scrollbar::-webkit-scrollbar-thumb {
        background: #bbcabf;
        border-radius: 9999px;
    }
    .stitch-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #6c7a71;
    }
    
    .thread-row:active {
        transform: scale(0.98);
        background-color: #e5eeff !important;
    }

    /* Explicitly override global dark theme input/textarea/select styles inside Webmail container */
    .webmail-container-box input:not(.bg-transparent), 
    .webmail-container-box textarea:not(.bg-transparent) {
        background-color: #ffffff !important;
        color: #0b1c30 !important;
        border: 1px solid #bbcabf !important;
        border-radius: 8px !important;
        padding-left: 12px !important;
        padding-right: 12px !important;
    }
    
    .webmail-container-box input:focus:not(.bg-transparent), 
    .webmail-container-box textarea:focus:not(.bg-transparent) {
        border-color: #006c49 !important;
        outline: none !important;
        box-shadow: 0 0 0 2px rgba(0, 108, 73, 0.15) !important;
    }

    .webmail-container-box input::placeholder, 
    .webmail-container-box textarea::placeholder {
        color: #3c4a42 !important;
        opacity: 0.5 !important;
    }

    /* Quick Reply specific adjustments to prevent padding/border overrides */
    .webmail-container-box textarea.bg-transparent {
        background-color: transparent !important;
        color: #0b1c30 !important;
        border: none !important;
        box-shadow: none !important;
        padding: 4px !important;
    }

    /* WYSIWYG Editor styling */
    .webmail-mobile-editor:empty:before {
        content: attr(placeholder);
        color: #6b7280 !important;
        opacity: 0.6;
        pointer-events: none;
        display: block;
    }
    .webmail-desktop-editor:empty:before {
        content: attr(placeholder);
        color: #94a3b8 !important;
        opacity: 0.6;
        pointer-events: none;
        display: block;
    }
    .webmail-mobile-editor:focus, .webmail-desktop-editor:focus {
        outline: none !important;
    }
</style>

@if (Platform.IsMobileApp)
{
    <!-- ========================================== -->
    <!--          GMAIL-STYLE MOBILE VIEW           -->
    <!-- ========================================== -->
    <div class="fixed inset-0 h-[100dvh] bg-[#0b0e15] overflow-hidden flex flex-col text-[#e1e2ec] font-sans pt-safe z-10" 
         @ontouchstart="HandlePageTouchStart" 
         @ontouchmove="HandlePageTouchMove" 
         @ontouchend="HandlePageTouchEnd">
        
        @if (_selectedMail == null && !_isComposing)
        {
            <!-- 1. MOBİL ARAMA VE ÜST BAR (GMAIL STYLE SEARCH BAR) -->
            <div class="p-3 shrink-0">
                <div class="bg-[#171a21]/90 backdrop-blur-md rounded-2xl px-4 py-2.5 flex items-center justify-between border border-white/5 gap-3 shadow-lg shadow-black/20">
                    <button @onclick="OpenMobileDrawer" class="text-gray-400 hover:text-white flex items-center justify-center select-none cursor-pointer">
                        <span class="material-symbols-outlined text-xl">menu</span>
                    </button>
                    <input class="flex-grow bg-transparent border-none focus:outline-none text-xs text-white placeholder-gray-500 font-semibold outline-none py-1" 
                           placeholder="E-postalarda ara..." 
                           type="text" 
                           @bind="_searchQuery" 
                           @bind:event="oninput" />
                    <!-- Aktif Hesap Avatarlı Switcher -->
                    <button @onclick="ToggleAccountDropdown" 
                            class="w-7 h-7 rounded-full bg-[#4edea3] text-[#0f172a] flex items-center justify-center font-bold text-[10px] shadow-sm select-none cursor-pointer active:scale-90 transition-transform">
                        @if (!string.IsNullOrEmpty(_activeAccount))
                        {
                            @(_activeAccount.Substring(0, Math.Min(2, _activeAccount.Length)).ToUpper())
                        }
                        else
                        {
                            <span>??</span>
                        }
                    </button>
                </div>
            </div>

            <!-- MOBİL KLASÖR BAŞLIĞI VE YENİLEME -->
            <div class="px-4 py-2 flex justify-between items-center text-[10px] font-bold text-gray-500 uppercase tracking-widest shrink-0">
                <span>
                    @(_activeFolder switch {
                        "inbox" => "Gelen Kutusu",
                        "sent" => "Gönderilenler",
                        "draft" => "Taslaklar",
                        "spam" => "Spam",
                        "trash" => "Çöp Kutusu",
                        "archive" => "Arşiv",
                        _ => "Klasör"
                    })
                </span>
                <button @onclick="RefreshMailsAsync" class="text-[#4edea3] flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm @(_isRefreshing ? "animate-spin" : "")">refresh</span>
                    <span>@(_isRefreshing ? "Yenileniyor" : "Yenile")</span>
                </button>
            </div>

            <!-- 2. MOBİL E-POSTA AKIŞI (SWIPE DESTEKLİ LISTE) -->
            <div class="flex-grow overflow-y-auto p-3 space-y-2 no-scrollbar">
                @if (!GetFilteredMails().Any())
                {
                    <div class="py-24 text-center text-gray-500">
                        <span class="material-symbols-outlined text-6xl mb-3" style="font-variation-settings: 'wght' 200;">mail</span>
                        <p class="text-xs font-semibold">Bu klasörde e-posta bulunmuyor.</p>
                    </div>
                }
                else
                {
                    @foreach (var mail in GetFilteredMails())
                    {
                        var isSelected = mail.Id == _selectedMail?.Id;
                        var isUnread = !mail.IsRead && _activeFolder == "inbox";
                        
                        <!-- Kaydırma (Swipe) Kapsayıcı Kartı -->
                        <div class="relative overflow-hidden rounded-2xl bg-[#171a21]/40 border border-white/5 shadow-md shadow-black/10 select-none" style="border-radius: 16px;">
                            
                            <!-- Arka Plan Kaydırma Eylemleri Göstergeleri -->
                            <div class="absolute inset-0 flex items-center justify-between px-6 z-0 rounded-2xl overflow-hidden pointer-events-none">
                                <!-- Sağa Kaydırma: Arşivle (Yeşil) -->
                                <div class="absolute inset-y-0 left-0 bg-emerald-600 flex items-center pl-6 pr-16 transition-opacity duration-200"
                                     style="opacity: @(GetSwipeDirection(mail.Id) > 0 ? "1" : "0");">
                                    <span class="material-symbols-outlined text-white text-xl animate-pulse">archive</span>
                                </div>
                                
                                <!-- Sola Kaydırma: Sil (Kırmızı) -->
                                <div class="absolute inset-y-0 right-0 bg-rose-600 flex items-center pr-6 pl-16 transition-opacity duration-200"
                                     style="opacity: @(GetSwipeDirection(mail.Id) < 0 ? "1" : "0");">
                                    <span class="material-symbols-outlined text-white text-xl animate-pulse">delete</span>
                                </div>
                            </div>

                            <!-- Ön Plan Kart İçeriği (Tetikleyiciler Dahil) -->
                            <div class="relative z-10 p-4 transition-transform duration-150 bg-[#141720]/95 cursor-pointer"
                                 style="transform: translateX(@(GetSwipeOffset(mail.Id))px); border-radius: 16px;"
                                 @ontouchstart="(e) => HandleTouchStart(e, mail.Id)"
                                 @ontouchmove="HandleTouchMove"
                                 @ontouchend="() => HandleTouchEnd(mail)"
                                 @onclick="() => SelectMail(mail)">
                                
                                <div class="flex justify-between items-baseline mb-1">
                                    <span class="text-xs font-bold flex items-center gap-1.5 @(isUnread ? "text-[#4edea3] font-black" : "text-gray-300 font-medium")">
                                        @if (isUnread)
                                        {
                                            <span class="w-1.5 h-1.5 bg-[#4edea3] rounded-full shrink-0"></span>
                                        }
                                        @if (_activeFolder == "sent")
                                        {
                                            <span>Kime: @mail.To</span>
                                        }
                                        else
                                        {
                                            <span>@mail.SenderName</span>
                                        }
                                    </span>
                                    <span class="text-[10px] text-gray-500">@mail.Date.ToString("HH:mm")</span>
                                </div>
                                
                                <h3 class="text-xs text-white leading-snug truncate @(isUnread ? "font-extrabold" : "font-semibold")">
                                    @mail.Subject
                                </h3>
                                
                                <p class="text-[10px] text-gray-400 line-clamp-2 mt-1 font-medium">
                                    @mail.Snippet
                                </p>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- MOBİL YAZMA/OLUŞTUR FAB BUTONU -->
            <button class="fixed bottom-24 right-6 w-14 h-14 bg-[#4edea3] text-slate-900 rounded-full shadow-lg shadow-[#4edea3]/20 flex items-center justify-center z-40 hover:scale-105 active:scale-95 transition-transform" 
                    @onclick="OpenComposePane">
                <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'wght' 600;">edit</span>
            </button>
        }
        else if (_selectedMail != null)
        {
            <!-- 3. MOBİL E-POSTA OKUMA DETAY SAYFASI (GMAIL STYLE DETAIL VIEW) -->
            <div class="flex-grow flex flex-col bg-[#0b0e15] overflow-hidden relative">
                <!-- Üst Toolbar -->
                <div class="px-2 py-2 border-b border-white/5 flex items-center justify-between bg-[#10131a]">
                    <button type="button" @onclick="GoBackToList" class="flex items-center justify-center p-2 text-[#4edea3] rounded-lg active:scale-95 transition-transform bg-white/5">
                        <span class="material-symbols-outlined text-xl">arrow_back</span>
                    </button>
                    
                    <div class="flex gap-4 items-center">
                        <button class="text-gray-400 hover:text-white flex items-center justify-center" title="Arşivle" @onclick="ArchiveSelectedMail">
                            <span class="material-symbols-outlined text-xl">archive</span>
                        </button>
                        <button class="text-rose-400 hover:text-rose-500 flex items-center justify-center" title="Sil" @onclick="DeleteSelectedMail">
                            <span class="material-symbols-outlined text-xl">delete</span>
                        </button>
                        <button class="text-gray-400 hover:text-white flex items-center justify-center" title="Cevapla" @onclick="OpenReplyModal">
                            <span class="material-symbols-outlined text-xl">reply</span>
                        </button>
                    </div>
                </div>

                <!-- Başlık & Gönderici -->
                <div class="p-4 border-b border-white/5 bg-[#10131a]/40">
                    <h2 class="text-base font-extrabold text-white leading-tight mb-4">@_selectedMail.Subject</h2>
                    
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-[#171a21] border border-white/10 flex items-center justify-center text-[#4edea3] font-bold text-xs shrink-0">
                            @((_selectedMail.SenderName ?? "?").Substring(0, Math.Min(2, (_selectedMail.SenderName ?? "?").Length)).ToUpper())
                        </div>
                        <div class="min-w-0 flex-grow">
                            <div class="flex justify-between items-baseline">
                                <h4 class="font-bold text-gray-200 text-xs truncate">@_selectedMail.SenderName</h4>
                                <span class="text-[9px] text-gray-500">@_selectedMail.Date.ToString("dd MMM, HH:mm")</span>
                            </div>
                            <p class="text-[9px] text-gray-400 truncate mt-0.5">@_selectedMail.SenderEmail</p>
                        </div>
                    </div>
                </div>

                <!-- Gövde Metni (HTML render) -->
                <div class="flex-grow overflow-y-auto p-4 bg-[#0d1016]/40 text-xs leading-relaxed space-y-4 no-scrollbar">
                    <div class="p-4 rounded-2xl bg-[#171a21]/50 border border-white/5 max-w-4xl mx-auto shadow-sm">
                        @((MarkupString)(_selectedMail.Body ?? ""))
                    </div>

                    <!-- Dosya Ekleri listesi -->
                    @if (_selectedMail.Attachments != null && _selectedMail.Attachments.Any())
                    {
                        <div class="border-t border-white/5 pt-4 mt-6 max-w-4xl mx-auto text-left">
                            <p class="text-[9px] font-bold text-gray-500 uppercase tracking-wider mb-2">Dosya Ekleri (@_selectedMail.Attachments.Count)</p>
                            <div class="flex flex-col gap-2">
                                @foreach (var att in _selectedMail.Attachments)
                                {
                                    <div class="p-2.5 bg-white/5 rounded-xl border border-white/5 flex items-center justify-between text-[11px] text-slate-300">
                                        <div class="min-width-0 flex-grow truncate mr-2">
                                            <span>📂 @att.FileName</span>
                                            <span class="text-[9px] text-slate-400 ml-1.5">(@FormatBytes(att.FileSize))</span>
                                        </div>
                                        <a href="api/mail/@Uri.EscapeDataString(_activeAccount)/emails/attachment?folder=@Uri.EscapeDataString(_activeFolder)&mailFile=@Uri.EscapeDataString(_selectedMail.FilePath)&attachmentId=@Uri.EscapeDataString(att.Id)" 
                                           target="_blank" download="@att.FileName"
                                           class="text-[#4edea3] hover:underline font-bold text-[10px] shrink-0">İndir</a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Hızlı Yanıt Kutusu (Gmail-Style Quick Reply) -->
                <div class="p-3 border-t border-white/5 bg-[#10131a] flex flex-col gap-2">
                    <div class="flex items-end gap-2 bg-[#171a21] border border-white/10 rounded-2xl p-2">
                        <textarea @bind="_quickReplyText" placeholder="Hızlıca yanıt yazın..." 
                                  class="flex-grow bg-transparent border-none text-xs text-white placeholder-gray-500 focus:outline-none outline-none resize-none p-1 max-h-24 stitch-scrollbar"></textarea>
                        
                        <button @onclick="SendQuickReply" disabled="@(string.IsNullOrWhiteSpace(_quickReplyText))"
                                class="w-8 h-8 rounded-xl bg-[#4edea3] text-slate-900 flex items-center justify-center hover:scale-105 active:scale-95 transition-transform disabled:opacity-40 disabled:scale-100 shrink-0 select-none cursor-pointer">
                            <span class="material-symbols-outlined text-sm font-bold">send</span>
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (_isComposing)
        {
            <!-- 4. MOBİL OLUŞTURMA / YAZMA EKRANI (FULL SCREEN EDIT FORM) -->
            <div class="flex-grow flex flex-col bg-[#0b0e15] overflow-y-auto stitch-scrollbar h-full">
                <!-- Mobil Üst Bar -->
                <div class="px-2 py-2 bg-[#10131a] border-b border-white/5 flex items-center justify-between">
                    <button type="button" @onclick="GoBackToList" class="flex items-center justify-center p-2 text-[#4edea3] rounded-lg active:scale-95 transition-transform bg-white/5">
                        <span class="material-symbols-outlined text-xl">arrow_back</span>
                    </button>
                    <span class="text-xs font-bold text-white">Yeni İleti</span>
                    <button @onclick="HandleSendMail" disabled="@_isSending"
                            class="text-[#4edea3] font-bold text-xs flex items-center gap-1 select-none">
                        @if (_isSending)
                        {
                            <div class="w-3.5 h-3.5 border-2 border-[#4edea3] border-t-transparent rounded-full animate-spin"></div>
                        }
                        else
                        {
                            <span>Gönder</span>
                            <span class="material-symbols-outlined text-sm">send</span>
                        }
                    </button>
                </div>

                <!-- Form -->
                <div class="p-4 border-b border-white/5 flex flex-col gap-3 bg-[#10131a]/40">
                    <div class="flex items-center gap-3">
                        <span class="text-gray-400 font-bold text-xs w-12">Kime:</span>
                        <input class="flex-1 bg-white/5 border border-white/10 rounded-xl focus:outline-none py-1.5 px-3 text-xs text-white placeholder:text-gray-600 outline-none" 
                               type="text" 
                               @bind="_composeModel.To" 
                               placeholder="alici@domain.com" />
                    </div>
                    <div class="flex items-center gap-3 border-t border-white/5 pt-3">
                        <span class="text-gray-400 font-bold text-xs w-12">Konu:</span>
                        <input class="flex-1 bg-white/5 border border-white/10 rounded-xl focus:outline-none py-1.5 px-3 text-xs text-white placeholder:text-gray-600 outline-none" 
                               type="text" 
                               @bind="_composeModel.Subject" 
                               placeholder="Konu başlığı" />
                    </div>
                </div>

                <!-- Gövde Yazma -->
                <div class="p-4 bg-[#0d1016]/20 flex flex-col gap-2">
                    <!-- Premium WYSIWYG Toolbar -->
                    <div class="flex flex-wrap gap-1 bg-[#171a21]/80 border border-white/5 p-1.5 rounded-xl shadow-inner">
                        <button type="button" @onclick='() => ExecuteEditorCommand("bold")' class="px-2.5 py-1.5 bg-white/5 hover:bg-[#4edea3]/15 hover:text-[#4edea3] rounded-lg text-xs font-bold text-gray-300 transition-all duration-150 active:scale-95 flex items-center justify-center shadow-sm select-none cursor-pointer" title="Kalın">
                            <span class="material-symbols-outlined text-sm font-bold">format_bold</span>
                        </button>
                        <button type="button" @onclick='() => ExecuteEditorCommand("italic")' class="px-2.5 py-1.5 bg-white/5 hover:bg-[#4edea3]/15 hover:text-[#4edea3] rounded-lg text-xs font-bold text-gray-300 transition-all duration-150 active:scale-95 flex items-center justify-center shadow-sm select-none cursor-pointer" title="Eğik">
                            <span class="material-symbols-outlined text-sm font-bold">format_italic</span>
                        </button>
                        <button type="button" @onclick='() => ExecuteEditorCommand("underline")' class="px-2.5 py-1.5 bg-white/5 hover:bg-[#4edea3]/15 hover:text-[#4edea3] rounded-lg text-xs font-bold text-gray-300 transition-all duration-150 active:scale-95 flex items-center justify-center shadow-sm select-none cursor-pointer" title="Altı Çizili">
                            <span class="material-symbols-outlined text-sm font-bold">format_underlined</span>
                        </button>
                        <button type="button" @onclick='() => ExecuteEditorCommand("formatBlock", "<h3>")' class="px-2.5 py-1.5 bg-white/5 hover:bg-[#4edea3]/15 hover:text-[#4edea3] rounded-lg text-xs font-bold text-gray-300 transition-all duration-150 active:scale-95 flex items-center justify-center shadow-sm select-none cursor-pointer" title="Başlık (H3)">
                            <span class="material-symbols-outlined text-sm font-bold">title</span>
                        </button>
                        <button type="button" @onclick='() => ExecuteEditorCommand("formatBlock", "<p>")' class="px-2.5 py-1.5 bg-white/5 hover:bg-[#4edea3]/15 hover:text-[#4edea3] rounded-lg text-xs font-bold text-gray-300 transition-all duration-150 active:scale-95 flex items-center justify-center shadow-sm select-none cursor-pointer" title="Paragraf">
                            <span class="material-symbols-outlined text-sm font-bold">notes</span>
                        </button>
                    </div>
                    <div id="emailBodyEditorMobile" 
                         class="w-full h-auto min-h-[12rem] bg-white/5 border border-white/10 rounded-2xl p-4 text-xs text-white focus:outline-none outline-none overflow-y-auto stitch-scrollbar webmail-mobile-editor mb-4"
                         contenteditable="true"
                         placeholder="E-posta gövdesini yazın..."></div>
                </div>

                <!-- Dosya Ekleme -->
                <div class="p-3 bg-[#10131a] border-t border-white/5">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-[10px] font-bold text-gray-400 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">attachment</span> Ekler
                        </span>
                        <label class="text-[10px] font-bold text-[#4edea3] hover:underline cursor-pointer">
                            Dosya Ekle
                            <InputFile OnChange="OnInputFileChange" multiple style="display: none;" />
                        </label>
                    </div>

                    @if (_attachments.Any())
                    {
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var file in _attachments)
                            {
                                <div class="flex items-center gap-2 bg-white/5 px-2.5 py-1 rounded-lg border border-white/5 text-[10px] text-gray-300">
                                    <span class="truncate max-w-[150px]">📂 @file.FileName</span>
                                    <button class="text-rose-400 hover:text-rose-500 ml-1" @onclick="() => RemoveAttachment(file)">
                                        <span class="material-symbols-outlined text-xs">close</span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <!-- Ekstra boşluk (Klavye için) -->
                <div class="h-24"></div>
            </div>
        }

        <!-- 5. MOBİL SLIDING LEFT DRAWER (GMAIL DRAWERS OVERLAY) -->
        <div class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-[99999] transition-opacity duration-300 @(_mobileDrawerOpen ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none")" 
             @onclick="CloseMobileDrawer"></div>

        <div class="fixed top-0 bottom-0 left-0 w-[280px] bg-[#10131a] border-r border-white/10 z-[100000] shadow-2xl transition-transform duration-500 flex flex-col justify-between p-4 @(_mobileDrawerOpen ? "translate-x-0" : "-translate-x-full")"
             @ontouchstart="HandleDrawerTouchStart"
             @ontouchmove="HandleDrawerTouchMove"
             @ontouchend="HandleDrawerTouchEnd">
            <div class="space-y-6 overflow-y-auto no-scrollbar flex-grow">
                <!-- Drawer Header -->
                <div>
                    <h2 class="text-lg font-black text-[#4edea3] leading-none tracking-tight">ApiHubMail</h2>
                    
                    <!-- Mobil Drawer Hesap Değiştirici -->
                    <button type="button" @onclick="ToggleAccountDropdown" 
                            class="w-full mt-4 p-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl flex items-center justify-between gap-2 shadow-sm text-left transition-colors">
                        <div class="flex items-center gap-2 min-w-0">
                            <div class="w-8 h-8 rounded-full bg-[#4edea3] text-slate-900 flex items-center justify-center font-black text-xs shrink-0">
                                @if (!string.IsNullOrEmpty(_activeAccount))
                                {
                                    @(_activeAccount.Substring(0, Math.Min(2, _activeAccount.Length)).ToUpper())
                                }
                            </div>
                            <div class="min-w-0 flex-grow">
                                <p class="text-xs font-semibold text-white truncate">@(_activeAccount ?? "Hesap Seçin")</p>
                                <p class="text-[9px] text-gray-500 truncate">Hesap Değiştir</p>
                            </div>
                        </div>
                        <span class="material-symbols-outlined text-gray-400 text-sm shrink-0">expand_more</span>
                    </button>
                </div>

                <!-- Klasör Listesi -->
                <nav class="flex flex-col gap-1.5">
                    <button class="w-full flex items-center justify-start text-left gap-3 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold @(_activeFolder == "inbox" ? "bg-[#4edea3]/10 text-[#4edea3] border border-[#4edea3]/20" : "text-gray-400 hover:bg-white/5 hover:text-white")"
                            @onclick='() => SetFolder("inbox")'>
                        <span class="material-symbols-outlined text-base">inbox</span>
                        <span class="flex-grow text-left">Gelen Kutusu</span>
                        @if (_unreadCount > 0)
                        {
                            <span class="text-[9px] bg-[#4edea3]/20 text-[#4edea3] px-2 py-0.5 rounded-full font-bold">@_unreadCount</span>
                        }
                    </button>

                    <button class="w-full flex items-center justify-start text-left gap-3 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold @(_activeFolder == "sent" ? "bg-[#4edea3]/10 text-[#4edea3] border border-[#4edea3]/20" : "text-gray-400 hover:bg-white/5 hover:text-white")"
                            @onclick='() => SetFolder("sent")'>
                        <span class="material-symbols-outlined text-base">send</span>
                        <span class="flex-grow text-left">Gönderilenler</span>
                    </button>

                    <button class="w-full flex items-center justify-start text-left gap-3 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold @(_activeFolder == "draft" ? "bg-[#4edea3]/10 text-[#4edea3] border border-[#4edea3]/20" : "text-gray-400 hover:bg-white/5 hover:text-white")"
