                        <span class="flex-grow text-left text-xs font-semibold">Gelen Kutusu</span>
                        @if (_unreadCount > 0)
                        {
                            <span class="text-[10px] bg-[#006c49]/10 text-[#006c49] px-1.5 py-0.5 rounded-full font-bold">@_unreadCount</span>
