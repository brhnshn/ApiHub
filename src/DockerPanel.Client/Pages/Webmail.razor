    private async Task HandleSendMail()
    {
        if (string.IsNullOrEmpty(_activeAccount)) return;

        if (string.IsNullOrWhiteSpace(_composeModel.To) || string.IsNullOrWhiteSpace(_composeModel.Subject) || string.IsNullOrWhiteSpace(_composeModel.Body))
        {
            Snackbar.Add("Lütfen Alıcı, Konu ve İleti alanlarını doldurun!", Severity.Warning);
            return;
        }

        _isSending = true;
        try
        {
            var finalBody = _composeModel.Body;
            if (!finalBody.Contains("<p>") && !finalBody.Contains("<div>") && !finalBody.Contains("<br") && !finalBody.Contains("<b>") && !finalBody.Contains("<i>"))
            {
                finalBody = $"<p>{finalBody.Replace("\n", "<br/>")}</p>";
            }

            var payload = new
            {
                To = _composeModel.To,
                Subject = _composeModel.Subject,
                Body = finalBody,
                Attachments = _attachments.Select(a => new
                {
                    FileName = a.FileName,
                    Base64Data = a.Base64Data,
                    ContentType = a.ContentType
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync($"api/mail/{Uri.EscapeDataString(_activeAccount)}/send", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"E-posta {_composeModel.To} adresine başarıyla gönderildi!", Severity.Success);
                _isComposing = false;
                _attachments.Clear();
                _activeFolder = "sent";
                _selectedMail = null;
                await LoadMailsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"E-posta gönderilemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSending = false;
        }
    }

