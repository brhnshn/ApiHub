    protected override async Task OnInitializedAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.wrapTextareaSelection = (elementId, openTag, closeTag) => {
                    const textarea = document.getElementById(elementId);
                    if (!textarea) return '';
                    const start = textarea.selectionStart;
                    const end = textarea.selectionEnd;
                    const text = textarea.value;
                    const selected = text.substring(start, end);
                    const replacement = openTag + selected + closeTag;
                    textarea.value = text.substring(0, start) + replacement + text.substring(end);
                    textarea.focus();
                    textarea.setSelectionRange(start + openTag.length, start + openTag.length + selected.length);
                    
                    const event = new Event('input', { bubbles: true });
                    textarea.dispatchEvent(event);
                    
                    return textarea.value;
                };

                window.initWysiwygEditor = (elementId, dotNetRef) => {
                    const editor = document.getElementById(elementId);
                    if (!editor) return;
                    
                    editor.oninput = () => {
                        dotNetRef.invokeMethodAsync('UpdateEditorBody', editor.innerHTML);
                    };

                    editor.onpaste = () => {
                        setTimeout(() => {
                            dotNetRef.invokeMethodAsync('UpdateEditorBody', editor.innerHTML);
                        }, 20);
                    };
                };

                window.setWysiwygHtml = (elementId, html) => {
                    const editor = document.getElementById(elementId);
                    if (editor) {
                        editor.innerHTML = html || '';
                    }
                };

                window.execWysiwygCommand = (elementId, command, value) => {
                    const editor = document.getElementById(elementId);
                    if (!editor) return;
                    editor.focus();
                    document.execCommand(command, false, value || null);
                    if (editor.oninput) {
                        editor.oninput();
                    }
                };
            ");
        }
        catch { }
        
        await LoadAccountsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldInitEditor)
        {
            _shouldInitEditor = false;
            try
            {
                var editorId = Platform.IsMobileApp ? "emailBodyEditorMobile" : "emailBodyEditorDesktop";
                _dotNetRef ??= DotNetObjectReference.Create(this);
                
                await JSRuntime.InvokeVoidAsync("initWysiwygEditor", editorId, _dotNetRef);
                await JSRuntime.InvokeVoidAsync("setWysiwygHtml", editorId, _composeModel.Body);
            }
            catch (Exception ex)
            {
                Console.WriteLine("WYSIWYG Editor Init Error: " + ex.Message);
            }
        }
    }

