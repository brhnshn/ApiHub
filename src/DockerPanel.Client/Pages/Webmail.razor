                                {
                                    <span>??</span>
                                }
                            </div>
                            <div class="min-w-0 flex-grow">
                                <p class="text-[8px] font-bold leading-none text-[#3c4a42]/60 uppercase tracking-wider">E-POSTA HESABI</p>
                                <p class="text-[11px] font-bold text-[#0b1c30] truncate mt-0.5" title="@_activeAccount">@_activeAccount</p>
                            </div>
                        </div>
                        <span class="material-symbols-outlined text-[#3c4a42]/60 text-sm select-none shrink-0 transition-transform @(_isAccountDropdownOpen ? "rotate-180 text-[#006c49]" : "")">keyboard_arrow_down</span>
                    </button>
                    
                    @if (_isAccountDropdownOpen)
                    {
                        <div style="box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);" 
