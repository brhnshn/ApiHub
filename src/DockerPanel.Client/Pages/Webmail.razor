                                <div class="min-w-0 flex-grow">
                                    <p class="text-xs font-semibold truncate @(isActive ? "text-[#4edea3]" : "text-gray-300")">@acc</p>
                                </div>
                                @if (isActive)
                                {
                                    <span class="material-symbols-outlined text-[#4edea3] text-sm shrink-0">check</span>
                                }
                            </button>
                        }
                    </div>

                    <div class="border-t border-white/5 pt-3">
                        <a href="/email" @onclick="ToggleAccountDropdown"
                           class="w-full py-2 bg-transparent text-center border border-white/10 hover:border-[#4edea3] hover:bg-[#4edea3]/5 text-[10px] font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 text-[#4edea3]">
                            <span class="material-symbols-outlined text-xs">settings</span>
                            <span>E-Posta Hesaplarını Yönet</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- ========================================== -->
    <!--          DESKTOP 3-COLUMN VIEW             -->
    <!-- ========================================== -->
    <div class="flex flex-col h-full w-full overflow-hidden">
        <div class="webmail-container-box w-full flex-grow bg-[#f8f9ff] text-[#0b1c30] overflow-hidden flex font-sans relative">
        
        <!-- 1. Kolon: Sol Navigasyon Paneli (Sidebar - w-[280px] Alan Optimizasyonlu Tasarım) -->
        <aside style="background-color: #eff4ff !important; border-right: 1px solid rgba(187, 202, 191, 0.3) !important;" 
               class="hidden md:flex flex-col w-[280px] shrink-0 p-2.5 pt-16 gap-1.5 justify-between h-full overflow-y-auto stitch-scrollbar">
