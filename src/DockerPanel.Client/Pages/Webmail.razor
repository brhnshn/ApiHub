                        <div style="@(GetRowStyle(isSelected))" 
                             class="p-4 mx-1 my-1 rounded-xl cursor-pointer transition-all border-l-4 @(isSelected ? "border-l-[#006c49] shadow-sm" : "border-l-transparent hover:bg-[#eff4ff]/30")" 
                             @onclick="@(() => SelectMail(mail))">
                            
                            <div class="flex justify-between items-baseline mb-1">
                                <span class="text-xs font-bold text-[#0b1c30] truncate flex items-center gap-1.5 @(mail.IsRead ? "font-semibold opacity-70" : "font-black")">
                                    @if (!mail.IsRead && _activeFolder == "inbox")
                                    {
                                        <span class="w-2 h-2 bg-[#006c49] rounded-full shrink-0"></span>
                                    }
                                    @if (_activeFolder == "sent")
                                    {
                                        <span>Kime: @mail.To</span>
                                    }
                                    else
                                    {
                                        <span>@mail.SenderName</span>
                                    }
                                </span>
                                <span class="text-[10px] text-[#3c4a42]/60 font-semibold shrink-0">@mail.Date.ToString("HH:mm")</span>
                            </div>
                            
                            <h3 class="text-sm text-[#0b1c30] leading-snug truncate @(mail.IsRead ? "font-semibold" : "font-black")">
                                @mail.Subject
                            </h3>
                            
                            <p class="text-xs text-[#3c4a42]/80 line-clamp-2 mt-1 font-medium">
                                @mail.Snippet
                            </p>
                        </div>
                    }
                }
            </div>
        </section>

        <!-- 3. Kolon: Detay / Yazma Paneli (Açık Tema Okuma ve Editör Kartı) -->
        <section class="flex-grow flex flex-col bg-[#f8f9ff] overflow-hidden h-full @(IsShowingDetailOnMobile() ? "flex" : "hidden md:flex")">
            @if (_selectedMail == null && !_isComposing)
            {
                <div class="flex flex-col items-center justify-center flex-grow text-[#3c4a42]/50 p-8">
                    <span class="material-symbols-outlined text-6xl mb-3" style="font-variation-settings: 'wght' 200;">mail_outline</span>
                    <p class="font-medium text-sm">Okumak için bir e-posta seçin.</p>
                </div>
            }
            else if (_isComposing)
            {
                <!-- Yeni İleti Yazma Düzenleyicisi -->
                <div class="flex-grow flex flex-col overflow-hidden bg-white">
                    <div class="p-6 border-b border-[#bbcabf]/20 flex flex-col gap-4 bg-[#eff4ff]/20">
                        <div class="flex items-center gap-3">
                            <span class="text-[#3c4a42] font-bold text-xs w-16">Kime:</span>
                            <input class="flex-1 bg-white border border-[#bbcabf]/30 focus:outline-none py-1.5 px-3 text-sm text-[#0b1c30] placeholder:text-slate-400 font-sans outline-none" 
                                   type="text" 
                                   @bind="_composeModel.To" 
                                   placeholder="alici@domain.com" />
                        </div>
                        <div class="flex items-center gap-3 border-t border-[#bbcabf]/10 pt-3">
                            <span class="text-[#3c4a42] font-bold text-xs w-16">Konu:</span>
                            <input class="flex-1 bg-white border border-[#bbcabf]/30 focus:outline-none py-1.5 px-3 text-sm text-[#0b1c30] font-semibold placeholder:text-slate-400 font-sans outline-none" 
                                   type="text" 
                                   @bind="_composeModel.Subject" 
                                   placeholder="Konu başlığı" />
                        </div>
                    </div>
                    
                    <div class="px-6 py-2 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                        <div class="flex items-center gap-1">
                            <button type="button" class="p-1.5 hover:bg-slate-200/50 rounded-lg text-[#3c4a42] hover:text-[#006c49] transition-all flex items-center justify-center active:scale-95" title="Kalın" @onclick='() => ExecuteEditorCommand("bold")'>
                                <span class="material-symbols-outlined text-lg">format_bold</span>
                            </button>
                            <button type="button" class="p-1.5 hover:bg-slate-200/50 rounded-lg text-[#3c4a42] hover:text-[#006c49] transition-all flex items-center justify-center active:scale-95" title="Eğik" @onclick='() => ExecuteEditorCommand("italic")'>
                                <span class="material-symbols-outlined text-lg">format_italic</span>
                            </button>
                            <button type="button" class="p-1.5 hover:bg-slate-200/50 rounded-lg text-[#3c4a42] hover:text-[#006c49] transition-all flex items-center justify-center active:scale-95" title="Altı Çizili" @onclick='() => ExecuteEditorCommand("underline")'>
                                <span class="material-symbols-outlined text-lg">format_underlined</span>
                            </button>
                            <button type="button" class="p-1.5 hover:bg-slate-200/50 rounded-lg text-[#3c4a42] hover:text-[#006c49] transition-all flex items-center justify-center active:scale-95" title="Başlık (H3)" @onclick='() => ExecuteEditorCommand("formatBlock", "<h3>")'>
                                <span class="material-symbols-outlined text-lg">title</span>
                            </button>
                            <button type="button" class="p-1.5 hover:bg-slate-200/50 rounded-lg text-[#3c4a42] hover:text-[#006c49] transition-all flex items-center justify-center active:scale-95" title="Paragraf" @onclick='() => ExecuteEditorCommand("formatBlock", "<p>")'>
                                <span class="material-symbols-outlined text-lg">notes</span>
                            </button>
                        </div>
                    </div>
                    
                    <div class="flex-grow p-6 overflow-y-auto">
                        <div id="emailBodyEditorDesktop" 
                             class="w-full h-full min-h-[20rem] bg-white border border-[#bbcabf]/30 p-4 text-sm text-[#0b1c30] focus:outline-none outline-none overflow-y-auto stitch-scrollbar webmail-desktop-editor"
                             contenteditable="true"
                             placeholder="E-posta gövdesini yazın..."></div>
                    </div>

                    <div class="p-4 bg-slate-50 border-t border-slate-100">
                        <div class="flex justify-between items-center mb-3">
                            <span class="text-xs font-bold text-[#3c4a42] flex items-center gap-1">
                                <span class="material-symbols-outlined text-base">attachment</span> Dosya Ekleri
                            </span>
                            <label class="text-xs font-bold text-[#006c49] hover:underline cursor-pointer">
                                Dosya Ekle
                                <InputFile OnChange="OnInputFileChange" multiple style="display: none;" />
                            </label>
                        </div>

                        @if (_attachments.Any())
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var file in _attachments)
                                {
                                    <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-lg border border-[#bbcabf]/30 text-xs text-slate-700">
                                        <span>📂 @file.FileName (@(file.Size / 1024) KB)</span>
                                        <button class="text-rose-500 hover:text-rose-700 transition-colors ml-1" @onclick="() => RemoveAttachment(file)">
                                            <span class="material-symbols-outlined text-sm">close</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="p-6 border-t border-[#bbcabf]/10 flex items-center justify-between bg-slate-50">
                        <div class="flex items-center gap-3">
                            <button class="bg-[#006c49] hover:bg-[#005236] text-white font-bold px-6 py-2.5 rounded-full flex items-center gap-2 hover:shadow-md active:scale-95 transition-all" 
                                    @onclick="HandleSendMail" disabled="@_isSending">
                                @if (_isSending)
                                {
                                    <span>Gönderiliyor...</span>
                                }
                                else
                                {
                                    <span>Gönder</span>
                                    <span class="material-symbols-outlined text-sm">send</span>
                                }
                            </button>
                            <button class="p-2.5 text-[#3c4a42] hover:text-rose-500 hover:bg-rose-50 rounded-full transition-colors flex items-center justify-center" title="İptal" @onclick="GoBackToList">
                                <span class="material-symbols-outlined text-xl">delete</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Okuma Paneli -->
                <div class="flex-grow flex flex-col overflow-hidden bg-white">
                     <div class="px-6 py-3 border-b border-[#bbcabf]/20 flex items-center justify-between bg-[#eff4ff]/20">
                         <div class="flex gap-3 items-center">
                             <button @onclick="ArchiveSelectedMail" class="flex items-center gap-1.5 text-[#006c49] hover:bg-[#006c49]/5 px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all" title="Arşivle">
                                 <span class="material-symbols-outlined text-lg">archive</span> Arşivle
                             </button>
                             <button class="flex items-center gap-1.5 text-rose-600 hover:bg-rose-50 px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all" title="Sil" @onclick="DeleteSelectedMail">
                                 <span class="material-symbols-outlined text-lg">delete</span> Sil
                             </button>
                             <button class="flex items-center gap-1.5 text-slate-600 hover:bg-slate-100 px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all" title="Cevapla" @onclick="OpenReplyModal">
                                 <span class="material-symbols-outlined text-lg">reply</span> Cevapla
                             </button>
                         </div>
                     </div>

                    <div class="p-6 border-b border-slate-100 bg-[#eff4ff]/5">
                        <h2 class="text-2xl font-bold text-[#0b1c30] leading-tight mb-6">@_selectedMail?.Subject</h2>
                        
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-[#eff4ff] border border-[#bbcabf]/30 flex items-center justify-center text-[#006c49] font-bold text-lg">
                                @((_selectedMail?.SenderName ?? "?").Substring(0, Math.Min(2, (_selectedMail?.SenderName ?? "?").Length)).ToUpper())
                            </div>
                            <div class="flex-grow min-w-0">
                                <div class="flex justify-between items-baseline">
                                    <h4 class="font-bold text-[#0b1c30] text-base leading-none">@_selectedMail?.SenderName</h4>
                                    <span class="text-xs text-[#3c4a42]/70 font-semibold">@_selectedMail?.Date.ToString("dd MMM yyyy, HH:mm")</span>
                                </div>
                                <p class="text-xs text-[#3c4a42]/70 leading-normal mt-1">@_selectedMail?.SenderEmail</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex-grow overflow-y-auto p-6 bg-slate-50/20 text-slate-700 text-sm">
                        <div class="p-4 rounded-xl border bg-white max-w-4xl mx-auto leading-relaxed space-y-4">
                            @((MarkupString)(_selectedMail?.Body ?? ""))
                        </div>

                        <!-- Dosya Ekleri -->
                        @if (_selectedMail?.Attachments != null && _selectedMail.Attachments.Any())
                        {
                            <div class="border-t border-slate-100 pt-4 mt-6 max-w-4xl mx-auto text-left">
                                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Dosya Ekleri (@_selectedMail.Attachments.Count)</p>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var att in _selectedMail.Attachments)
                                    {
                                        <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-lg border border-slate-200 text-xs text-slate-700">
                                            <span>📂 @att.FileName (@(att.FileSize / 1024) KB)</span>
                                            <a href="api/mail/@Uri.EscapeDataString(_activeAccount)/emails/attachment?folder=@Uri.EscapeDataString(_activeFolder)&mailFile=@Uri.EscapeDataString(_selectedMail.FilePath)&attachmentId=@Uri.EscapeDataString(att.Id)" 
                                               target="_blank" download="@att.FileName"
                                               class="text-[#006c49] hover:underline font-bold ml-2">İndir</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Hızlı Yanıt Gönderme Kutusu -->
                    <div class="p-6 border-t border-[#bbcabf]/20 bg-slate-50">
                        <div class="flex flex-col gap-3 max-w-4xl mx-auto">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="material-symbols-outlined text-[#006c49] text-lg">quickreply</span>
                                <span class="text-xs font-bold text-slate-700">@_selectedMail?.SenderEmail Adresine Hızlı Yanıt</span>
                            </div>
                            <div class="bg-white border border-[#bbcabf]/30 rounded-2xl p-3 shadow-sm flex flex-col gap-2.5">
                                <textarea class="w-full bg-transparent border-none text-sm text-[#0b1c30] placeholder-slate-400 focus:outline-none outline-none resize-none p-1 min-h-[80px]" 
                                          placeholder="Hızlı yanıtınızı buraya yazın..."
                                          @bind="_quickReplyText"></textarea>
                                
                                <div class="flex justify-between items-center border-t border-slate-100 pt-2.5">
                                    <div class="flex items-center gap-2">
                                        <label class="p-1.5 hover:bg-slate-100 rounded-lg text-slate-500 cursor-pointer flex items-center justify-center transition-colors">
                                            <span class="material-symbols-outlined text-lg">attachment</span>
                                            <InputFile OnChange="OnQuickReplyFileChange" multiple style="display: none;" />
                                        </label>
                                        
                                        @if (_quickAttachments.Any())
                                        {
                                            <span class="text-[10px] font-bold text-[#006c49]">@_quickAttachments.Count dosya eklendi</span>
                                        }
                                    </div>
                                    <button class="bg-[#006c49] hover:bg-[#005236] text-white font-bold px-5 py-1.5 rounded-full text-xs shadow-sm hover:shadow active:scale-95 transition-all" 
                                            @onclick="SendQuickReply" disabled="@(string.IsNullOrWhiteSpace(_quickReplyText))">
                                        Gönder
                                    </button>
                                </div>
                            </div>

                            @if (_quickAttachments.Any())
                            {
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var file in _quickAttachments)
                                    {
                                        <div class="flex items-center gap-1.5 bg-white px-2.5 py-1 rounded-lg border border-slate-200 text-[10px] text-slate-600 shadow-sm">
                                            <span>📎 @file.FileName</span>
                                            <button class="text-rose-500 hover:text-rose-700 ml-1 font-bold" @onclick="() => RemoveQuickAttachment(file)">×</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </section>
        </div>
    </div>
}

@code {
    private List<string> _accounts = new();
    private string _activeAccount = "";
    private string _activeFolder = "inbox";
    private string _searchQuery = "";
    private string _quickReplyText = "";
    private int _unreadCount = 0;
    private bool _isAccountDropdownOpen = false;

    private bool _isRefreshing = false;
    private bool _showSnoozeMenu = false;
    private bool _showLabelsMenu = false;
    private bool _showNewLabelInput = false;
    private string _newLabelName = "";
    private List<string> _customLabels = new();

    // Swipe gestures ve Mobile Drawer state
    private double _touchStartX;
    private double _touchCurrentX;
    private Guid? _swipedMailId;

    private bool _isPageSwiping = false;
    private double _pageTouchStartX;
    private double _pageTouchCurrentX;
    private bool _mobileDrawerOpen = false;

    // Kota
    private long _usedBytes = 0;
    private long _quotaBytes = 1073741824; // 1 GB varsayılan
    private int _quotaPercent = 0;
    private List<AttachmentItem> _quickAttachments = new();

    private List<MailItem> _mails = new();
    private MailItem? _selectedMail;
    
    // Compose/Draft Editor Control
    private bool _isComposing = false;
    private bool _isSending = false;
    private readonly ComposeMailModel _composeModel = new();
    private DotNetObjectReference<Webmail>? _dotNetRef;
    private bool _shouldInitEditor = false;

    // Eklentiler Listesi
    private List<AttachmentItem> _attachments = new();

    public class AttachmentItem
    {
        public string FileName { get; set; } = "";
        public string Base64Data { get; set; } = "";
        public string ContentType { get; set; } = "";
        public long Size { get; set; }
    }

    private bool IsShowingDetailOnMobile() => _selectedMail != null || _isComposing;

    private void ToggleAccountDropdown()
    {
        _isAccountDropdownOpen = !_isAccountDropdownOpen;
    }

    private async Task SwitchAccount(string newAcc)
    {
        _isAccountDropdownOpen = false;
        await HandleAccountChanged(newAcc);
    }

    private void ToggleSnoozeMenu()
    {
        _showSnoozeMenu = !_showSnoozeMenu;
        _showLabelsMenu = false;
    }

    private void ToggleLabelsMenu()
    {
        _showLabelsMenu = !_showLabelsMenu;
        _showSnoozeMenu = false;
    }

    private void ToggleNewLabelInput()
    {
        _showNewLabelInput = !_showNewLabelInput;
        _newLabelName = "";
    }

    // Mobil Sola/Sağa Kaydırma (Swipe) C# İşleyicileri
    private void HandleTouchStart(TouchEventArgs e, Guid mailId)
    {
        if (_mobileDrawerOpen || IsShowingDetailOnMobile()) return;
        _swipedMailId = mailId;
        _touchStartX = e.Touches[0].ClientX;
        _touchCurrentX = _touchStartX;
    }

    private void HandleTouchMove(TouchEventArgs e)
    {
        if (_swipedMailId == null) return;
        _touchCurrentX = e.Touches[0].ClientX;
    }

    private async Task HandleTouchEnd(MailItem mail)
    {
        if (_swipedMailId == null) return;
        
        var deltaX = _touchCurrentX - _touchStartX;
        _swipedMailId = null; // Reset immediately

        if (deltaX > 120) // Swipe Right: Archive
        {
            await ArchiveMailDirect(mail);
        }
        else if (deltaX < -120) // Swipe Left: Delete
        {
            await DeleteMailDirect(mail);
        }

        _touchStartX = 0;
        _touchCurrentX = 0;
        StateHasChanged();
    }

    private double GetSwipeOffset(Guid mailId)
    {
        if (_swipedMailId != mailId) return 0;
        var offset = _touchCurrentX - _touchStartX;
        
        if (offset > 150) return 150;
        if (offset < -150) return -150;
        return offset;
    }

    private int GetSwipeDirection(Guid mailId)
    {
        if (_swipedMailId != mailId) return 0;
        var offset = _touchCurrentX - _touchStartX;
        if (offset > 15) return 1;
        if (offset < -15) return -1;
        return 0;
    }

    // Ekran Kenarından Çekerek Çekmeceyi Açma (Edge Swipe-to-Drawer)
    private void HandlePageTouchStart(TouchEventArgs e)
    {
        if (e.Touches[0].ClientX < 35 && !IsShowingDetailOnMobile())
        {
            _isPageSwiping = true;
            _pageTouchStartX = e.Touches[0].ClientX;
        }
    }

    private void HandlePageTouchMove(TouchEventArgs e)
    {
        if (_isPageSwiping)
        {
            _pageTouchCurrentX = e.Touches[0].ClientX;
            if (_pageTouchCurrentX - _pageTouchStartX > 60)
            {
                _mobileDrawerOpen = true;
                _isPageSwiping = false;
                StateHasChanged();
            }
        }
    }

    private void HandlePageTouchEnd()
    {
        _isPageSwiping = false;
    }

    private double _drawerTouchStartX;
    private double _drawerTouchCurrentX;
    private bool _isDrawerSwiping = false;

    private void HandleDrawerTouchStart(TouchEventArgs e)
    {
        if (!_mobileDrawerOpen) return;
        _isDrawerSwiping = true;
        _drawerTouchStartX = e.Touches[0].ClientX;
        _drawerTouchCurrentX = _drawerTouchStartX;
    }

    private void HandleDrawerTouchMove(TouchEventArgs e)
    {
        if (!_isDrawerSwiping) return;
        _drawerTouchCurrentX = e.Touches[0].ClientX;
    }

    private void HandleDrawerTouchEnd()
    {
        if (!_isDrawerSwiping) return;
        _isDrawerSwiping = false;
        var delta = _drawerTouchCurrentX - _drawerTouchStartX;
        if (delta < -60) // Swiped left to close
        {
            _mobileDrawerOpen = false;
            StateHasChanged();
        }
    }

    private void OpenMobileDrawer()
    {
        _mobileDrawerOpen = true;
    }

    private void CloseMobileDrawer()
    {
        _mobileDrawerOpen = false;
    }

    private async Task ArchiveMailDirect(MailItem mail)
    {
        if (string.IsNullOrEmpty(_activeAccount) || string.IsNullOrEmpty(mail.FilePath)) return;

        try
        {
            var payload = new
            {
                SourceFolder = _activeFolder,
                DestFolder = "archive",
                FileName = mail.FilePath
            };

            var response = await Http.PostAsJsonAsync($"api/mail/{Uri.EscapeDataString(_activeAccount)}/emails/move", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("E-posta arşivlendi.", Severity.Success);
                if (_selectedMail?.Id == mail.Id) _selectedMail = null;
                await LoadMailsAsync();
            }
            else
            {
                Snackbar.Add("Arşivlenirken hata oluştu.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteMailDirect(MailItem mail)
    {
        if (string.IsNullOrEmpty(_activeAccount) || string.IsNullOrEmpty(mail.FilePath)) return;

        try
        {
            var response = await Http.DeleteAsync($"api/mail/{Uri.EscapeDataString(_activeAccount)}/emails/{Uri.EscapeDataString(_activeFolder)}/{Uri.EscapeDataString(mail.FilePath)}");
            if (response.IsSuccessStatusCode)
            {
                if (_activeFolder == "trash")
                {
                    Snackbar.Add("E-posta kalıcı olarak silindi.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("E-posta Çöp Kutusu'na taşındı.", Severity.Success);
                }
                if (_selectedMail?.Id == mail.Id) _selectedMail = null;
                await LoadMailsAsync();
            }
            else
            {
                Snackbar.Add("Silinirken hata oluştu.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleNewLabelKeyup(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateLabelAsync();
        }
    }

    private async Task CreateLabelAsync()
    {
        if (string.IsNullOrWhiteSpace(_newLabelName) || string.IsNullOrEmpty(_activeAccount)) return;

        try
        {
            var payload = new { Name = _newLabelName.Trim() };
            var response = await Http.PostAsJsonAsync($"api/mail/{Uri.EscapeDataString(_activeAccount)}/labels", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"'{_newLabelName}' etiketi başarıyla oluşturuldu.", Severity.Success);
                _newLabelName = "";
                _showNewLabelInput = false;
                await LoadCustomLabelsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Etiket oluşturulamadı: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadCustomLabelsAsync()
    {
        if (string.IsNullOrEmpty(_activeAccount)) return;

        try
        {
            var raw = await Http.GetFromJsonAsync<List<string>>($"api/mail/{Uri.EscapeDataString(_activeAccount)}/labels");
            if (raw != null)
            {
                _customLabels = raw;
            }
        }
        catch
        {
            _customLabels = new List<string>();
        }
    }

    private async Task DeleteLabelAsync(string labelName)
    {
        if (string.IsNullOrEmpty(_activeAccount)) return;

        try
        {
            var response = await Http.DeleteAsync($"api/mail/{Uri.EscapeDataString(_activeAccount)}/labels/{Uri.EscapeDataString(labelName)}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"'{labelName}' etiketi silindi.", Severity.Success);
                if (_activeFolder == "label-" + labelName.ToLower())
                {
                    _activeFolder = "inbox";
                    await LoadMailsAsync();
                }
                await LoadCustomLabelsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Etiket silinemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
