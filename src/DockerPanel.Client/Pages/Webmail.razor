                            class="w-full mt-3 p-2 bg-white/50 hover:bg-white/90 border border-[#bbcabf]/30 rounded-xl transition-all duration-300 flex items-center justify-between gap-2 shadow-sm text-left group">
                        <div class="flex items-center gap-2 min-w-0">
                            <div class="w-7 h-7 rounded-full bg-[#006c49] text-white flex items-center justify-center font-black text-[10px] shrink-0 shadow-sm shadow-emerald-700/10">
                                @if (!string.IsNullOrEmpty(_activeAccount))
                                {
                                    @(_activeAccount.Substring(0, Math.Min(2, _activeAccount.Length)).ToUpper())
                                }
