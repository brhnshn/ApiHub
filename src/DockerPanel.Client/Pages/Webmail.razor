                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' @(_activeFolder == "sent" ? "1" : "0");">send</span>
                        <span class="flex-grow text-left text-xs font-semibold">Gönderilenler</span>
                    </button>
                    
                    <button style="@(GetFolderStyle("draft"))" 
                            class="w-full flex items-center gap-2.5 px-2.5 py-2 rounded-xl transition-all duration-200" 
                            @onclick='() => SetFolder("draft")'>
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' @(_activeFolder == "draft" ? "1" : "0");">draft</span>
                        <span class="flex-grow text-left text-xs font-semibold">Taslaklar</span>
                    </button>
                    
                    <button style="@(GetFolderStyle("archive"))" 
                            class="w-full flex items-center gap-2.5 px-2.5 py-2 rounded-xl transition-all duration-200" 
                            @onclick='() => SetFolder("archive")'>
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' @(_activeFolder == "archive" ? "1" : "0");">archive</span>
                        <span class="flex-grow text-left text-xs font-semibold">Arşiv</span>
                    </button>

                    <button style="@(GetFolderStyle("label"))" 
                            class="w-full flex items-center gap-2.5 px-2.5 py-2 rounded-xl transition-all duration-200" 
                            @onclick='() => SetFolder("label")'>
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' @(_activeFolder == "label" ? "1" : "0");">label</span>
                        <span class="flex-grow text-left text-xs font-semibold">Etiketler</span>
