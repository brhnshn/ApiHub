    private string GetReadableBytes(long bytes)
    {
        string[] suffix = { "B", "KB", "MB", "GB", "TB" };
        int i;
        double dblBytes = bytes;
        for (i = 0; i < suffix.Length && bytes >= 1024; i++, bytes /= 1024)
        {
            dblBytes = bytes / 1024.0;
        }
        return $"{dblBytes:0.##} {suffix[i]}";
    }

    private string GetUptimeText(DateTimeOffset startedAt)
    {
        var uptime = DateTimeOffset.UtcNow - startedAt.ToUniversalTime();
        if (uptime < TimeSpan.Zero)
        {
            uptime = TimeSpan.Zero;
        }

        var parts = new List<string>();
        if (uptime.Days > 0) parts.Add($"{uptime.Days}g");
        if (uptime.Hours > 0) parts.Add($"{uptime.Hours}s");
        if (uptime.Minutes > 0) parts.Add($"{uptime.Minutes}dk");
        if (parts.Count == 0) parts.Add("1dk altinda");

        return string.Join(" ", parts);
    }

    private string GetUptimeColor(DateTimeOffset startedAt)
    {
        var uptime = DateTimeOffset.UtcNow - startedAt.ToUniversalTime();
        return uptime.TotalDays < 7 ? "#10b981" : "#f59e0b";
    }

    private void OpenZipUploadModal(ProjectCardDto project)
    {
        _activeZipProject = project;
        _uploadedZipFile = null;
        _isValidatingZip = false;
        _zipValidationSuccess = false;
        _zipValidationError = null;
        _zipWarningMessage = null;
        _detectedRuntime = string.Empty;
        _detectedEntryFile = string.Empty;
        _isDeployingZip = false;
        _zipUploadModalVisible = true;
    }

    private void CloseZipUploadModal()
    {
        _zipUploadModalVisible = false;
        _activeZipProject = null;
        _uploadedZipFile = null;
        _detectedRuntime = string.Empty;
        _detectedEntryFile = string.Empty;
    }

    private async Task OnZipUploadSelected(InputFileChangeEventArgs e)
    {
        _uploadedZipFile = e.File;
        _isValidatingZip = true;
        _zipValidationSuccess = false;
        _zipValidationError = null;
        _zipWarningMessage = null;
        _detectedRuntime = string.Empty;
        _detectedEntryFile = string.Empty;
        StateHasChanged();

        try
        {
            var result = await JSRuntime.InvokeAsync<ZipAnalysisResult>("eval", "window.analyzeZipFile(document.getElementById('zip-upload-input'))");
            
            if (result == null || !result.Success)
            {
                _zipValidationError = result?.Error ?? "ZIP dosyası analiz edilemedi.";
            }
            else
            {
                _detectedRuntime = result.DetectedRuntime;
                _detectedEntryFile = result.DetectedEntryFile;
                
                // Validate Runtime Match
                if (_activeZipProject != null && _activeZipProject.Type == ProjectType.StaticSite && result.DetectedRuntime != "static" && result.DetectedRuntime != "unknown")
                {
                    _zipWarningMessage = $"Bu proje Statik Site olarak yapılandırılmış ancak yüklenen ZIP'te {result.DetectedRuntime.ToUpper()} dosyaları tespit edildi.";
                }
                else if (_activeZipProject != null && _activeZipProject.Type == ProjectType.NativeProject && result.DetectedRuntime == "static")
                {
                    _zipWarningMessage = "Bu proje Native (Süreç Yönetimli) olarak yapılandırılmış ancak yüklenen ZIP bir Statik Site (HTML/PHP) gibi görünüyor.";
                }

                // Name Match Check
                if (!string.IsNullOrEmpty(result.DetectedName) && _activeZipProject != null)
                {
                    string targetNameClean = _activeZipProject.Name.Replace("-", "").Replace("_", "").ToLowerInvariant();
                    string detectedNameClean = result.DetectedName.Replace("-", "").Replace("_", "").ToLowerInvariant();
                    
                    if (!targetNameClean.Contains(detectedNameClean) && !detectedNameClean.Contains(targetNameClean))
                    {
                        var warning = $"Proje isimleri uyuşmuyor! Hedef Proje: '{_activeZipProject.Name}', ZIP İçeriği: '{result.DetectedName}'. Yanlış projeyi güncelliyor olabilirsiniz.";
                        if (_zipWarningMessage != null)
                        {
                            _zipWarningMessage += " " + warning;
                        }
                        else
                        {
                            _zipWarningMessage = warning;
                        }
                    }
                }

                _zipValidationSuccess = true;
            }
        }
        catch (Exception ex)
        {
            _zipValidationError = $"Doğrulama hatası: {ex.Message}";
        }
        finally
        {
            _isValidatingZip = false;
            StateHasChanged();
        }
    }

    private async Task HandleZipDeploy()
    {
        if (_uploadedZipFile == null || _activeZipProject == null) return;

        _isDeployingZip = true;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(_uploadedZipFile.OpenReadStream(MaxZipUploadBytes));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            
            content.Add(fileContent, "ZipFile", _uploadedZipFile.Name);
            content.Add(new StringContent(_activeZipProject.Name), "Name");

            HttpResponseMessage response;
            if (_activeZipProject.Type == ProjectType.StaticSite)
            {
                content.Add(new StringContent(_activeZipProject.EnablePhp.ToString().ToLower()), "EnablePhp");
                response = await Http.PostAsync("api/projects/static-deploy", content);
            }
            else
            {
                content.Add(new StringContent(_activeZipProject.InternalPort.ToString()), "InternalPort");
                content.Add(new StringContent(_activeZipProject.MemoryLimitBytes.ToString()), "MemoryLimitBytes");
                content.Add(new StringContent(_activeZipProject.CpuCount.ToString(System.Globalization.CultureInfo.InvariantCulture)), "CpuCount");
                if (!string.IsNullOrEmpty(_detectedRuntime))
                {
                    content.Add(new StringContent(_detectedRuntime), "RuntimeType");
                }
                if (!string.IsNullOrEmpty(_detectedEntryFile))
                {
                    content.Add(new StringContent(_detectedEntryFile), "EntryFile");
                }
                response = await Http.PostAsync("api/projects/native-deploy", content);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Proje başarıyla yüklendi ve yeniden dağıtıldı!", Severity.Success);
                CloseZipUploadModal();
                await LoadProjectsAsync();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                var errorMsg = "Dağıtım başarısız oldu.";
                try
                {
                    var doc = JsonDocument.Parse(errorText);
                    if (doc.RootElement.TryGetProperty("Message", out var msgProp))
                    {
                        errorMsg = msgProp.GetString() ?? errorMsg;
                    }
                }
                catch {}
                Snackbar.Add(errorMsg, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDeployingZip = false;
            StateHasChanged();
        }
    }

