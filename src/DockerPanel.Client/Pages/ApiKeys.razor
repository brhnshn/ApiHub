@page "/apikeys"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject DockerPanel.Client.Services.AppState AppState
@inject PlatformInfo PlatformInfo
@implements IDisposable

<PageTitle>Integration Center (API Keys) - ApiHub</PageTitle>

<div class="space-y-6 @(PlatformInfo.IsMobileApp ? "text-[#e1e2ec]" : "text-[#0b1c30]")">
    <!-- Üst Başlık -->
    <div class="flex justify-between items-start gap-4">
        <div>
            <h2 class="text-2xl font-extrabold tracking-tight @(PlatformInfo.IsMobileApp ? "text-white" : "text-[#0b1c30]")">
                <i class="fa-solid fa-circle-nodes text-indigo-400 mr-1.5 animate-pulse"></i> Integration Center & API Keys
            </h2>
            <p class="text-xs font-medium mt-1 @(PlatformInfo.IsMobileApp ? "text-gray-400" : "text-slate-400")">
                Proje ve üçüncü parti (OpenAI, Anthropic, Custom vb.) API entegrasyonlarını, kimlik doğrulamalarını ve kotalarını merkezi olarak yönetin.
            </p>
        </div>
        <button @onclick="LoadKeys" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-bold transition-all active:scale-95 bg-slate-900 border-slate-800 text-white hover:bg-slate-800">
            <span class="material-symbols-outlined text-[16px] @(_isRefreshing ? "animate-spin" : "")">sync</span>
            Yenile
        </button>
    </div>

    <!-- Ana Panel Düzeni (Çift Kolon: Sol Liste, Sağ Detay & Dashboard) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- SOL KOLON: ANAHTAR LİSTESİ VE YENİ ANAHTAR EKLEME -->
        <div class="lg:col-span-4 space-y-6">
            
            <!-- Yeni Anahtar Ekleme Formu -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
                <h4 class="text-xs font-black uppercase tracking-wider text-indigo-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-plus-circle"></i> Yeni Entegrasyon Ekle
                </h4>
                
                <div class="space-y-3">
                    <div>
                        <label class="block text-[9px] font-bold uppercase text-slate-400 mb-1">İsim / Açıklama</label>
                        <input @bind="_newKeyName" class="w-full text-xs px-3 py-2 bg-slate-950 border border-slate-850 rounded-lg text-white outline-none focus:border-indigo-500" placeholder="Örn: OpenAI Anahtarım" />
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[9px] font-bold uppercase text-slate-400 mb-1">Sağlayıcı</label>
                            <select @bind="_provider" class="w-full text-xs px-2.5 py-2 bg-slate-950 border border-slate-850 rounded-lg text-white outline-none">
                                <option value="OpenAI">OpenAI</option>
                                <option value="Anthropic">Anthropic</option>
                                <option value="GoogleGemini">Google Gemini</option>
                                <option value="Groq">Groq</option>
                                <option value="Custom">Özel API (Custom)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[9px] font-bold uppercase text-slate-400 mb-1">Kategori</label>
                            <select @bind="_category" class="w-full text-xs px-2.5 py-2 bg-slate-950 border border-slate-850 rounded-lg text-white outline-none">
                                <option value="AI Services">Yapay Zeka (AI)</option>
                                <option value="Database">Veritabanı</option>
                                <option value="SMS/Mail">SMS / E-posta</option>
                                <option value="Payment">Ödeme Ağ Geçidi</option>
                                <option value="Other">Diğer Entegrasyonlar</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[9px] font-bold uppercase text-slate-400 mb-1">Base URL (İsteğe Bağlı)</label>
                        <input @bind="_baseUrl" class="w-full text-xs px-3 py-2 bg-slate-950 border border-slate-850 rounded-lg text-white outline-none focus:border-indigo-500 font-mono" placeholder="https://api.openai.com/v1" />
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[9px] font-bold uppercase text-slate-400 mb-1">Varsayılan Model</label>
                            <input @bind="_defaultModel" class="w-full text-xs px-3 py-2 bg-slate-950 border border-slate-850 rounded-lg text-white outline-none focus:border-indigo-500" placeholder="gpt-4o" />
                        </div>
                        <div>
                            <label class="block text-[9px] font-bold uppercase text-slate-400 mb-1">Aylık Limit</label>
                            <input type="number" @bind="_monthlyLimit" class="w-full text-xs px-3 py-2 bg-slate-950 border border-slate-850 rounded-lg text-white outline-none focus:border-indigo-500" placeholder="100000" />
                        </div>
                    </div>

                    <button @onclick="GenerateKey" disabled="@_isGenerating" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-xs font-bold text-white transition-all active:scale-95 flex items-center justify-center gap-1.5">
                        @if (_isGenerating)
                        {
                            <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-[16px]">add_circle</span>
                        }
                        Entegrasyon Anahtarı Üret
                    </button>
                </div>
            </div>

            <!-- Mevcut Entegrasyonların Listesi -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-3">
                <h4 class="text-xs font-black uppercase tracking-wider text-slate-300">Kayıtlı Entegrasyonlar</h4>
                
                <div class="space-y-2 max-h-[300px] overflow-y-auto pr-1">
                    @if (!_keys.Any())
                    {
                        <div class="p-8 text-center text-slate-500 text-xs">
                            Kayıtlı entegrasyon bulunamadı.
                        </div>
                    }
                    else
                    {
                        @foreach (var key in _keys)
                        {
                            <div @onclick="() => SelectKey(key)" 
                                class="p-3 rounded-xl border transition-all cursor-pointer flex items-center justify-between @(_selectedKey?.Id == key.Id ? "bg-indigo-950/20 border-indigo-500/40 text-white" : "bg-slate-950 border-slate-850 text-slate-300 hover:bg-slate-900/60")">
                                <div class="flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full @(key.IsActive ? "bg-emerald-400" : "bg-slate-600")"></span>
                                    <div>
                                        <div class="text-xs font-bold">@key.Name</div>
                                        <div class="text-[8px] text-slate-400 font-mono">@key.Provider | @key.MaskedKey</div>
                                    </div>
                                </div>
                                <span class="material-symbols-outlined text-xs">chevron_right</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ KOLON: SEÇİLİ ANAHTAR PANEL DETAYI -->
        <div class="lg:col-span-8">
            @if (_selectedKey == null)
            {
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-12 text-center text-slate-500 flex flex-col items-center justify-center min-h-[550px] shadow-xl">
                    <span class="material-symbols-outlined text-5xl mb-3 text-indigo-400 animate-pulse">hub</span>
                    <h3 class="text-sm font-bold text-white uppercase tracking-wider">Entegrasyon Seçilmedi</h3>
                    <p class="text-[10px] text-slate-400 max-w-sm mt-1">Detaylı kullanım istatistiklerini görmek, proje izinlerini yönetmek veya bağlantıyı test etmek için soldaki listeden bir API anahtarı seçin.</p>
                </div>
            }
            else
            {
                <!-- DETAY PANELİ -->
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6 flex flex-col justify-between min-h-[550px]">
                    <div>
                        <!-- Header / Başlık -->
                        <div class="flex justify-between items-start border-b border-slate-850 pb-3 mb-4">
                            <div>
                                <h3 class="text-base font-black text-white">@_selectedKey.Name</h3>
                                <p class="text-[10px] text-slate-400 font-mono mt-0.5">ID: @_selectedKey.Id | Maskeli: @_selectedKey.MaskedKey</p>
                            </div>
                            <div class="flex gap-2">
                                <button @onclick="() => RevealKey(_selectedKey)" class="px-2.5 py-1.5 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-400 border border-indigo-500/20 text-[10px] font-bold rounded-lg flex items-center gap-1 transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">visibility</span> Anahtarı Çöz
                                </button>
                                <button @onclick="() => ToggleKey(_selectedKey)" class="px-2.5 py-1.5 bg-slate-950 hover:bg-slate-850 text-white text-[10px] font-bold rounded-lg flex items-center gap-1 transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">power_settings_new</span> @(_selectedKey.IsActive ? "Pasifleştir" : "Aktifleştir")
                                </button>
                                <button @onclick="() => ConfirmDeleteKey(_selectedKey)" class="px-2.5 py-1.5 bg-rose-950/20 hover:bg-rose-950/30 text-rose-500 border border-rose-500/20 text-[10px] font-bold rounded-lg flex items-center gap-1 transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">delete</span> Sil
                                </button>
                            </div>
                        </div>

                        <!-- Sekme Seçici (Tab Controller) -->
                        <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-850 mb-5">
                            <button @onclick='() => SetActiveTab("dashboard")' class="flex-1 py-1.5 text-center text-xs font-bold rounded-lg transition-all @(GetTabClass("dashboard"))">
                                Dashboard (Özet)
                            </button>
                            <button @onclick='() => SetActiveTab("general")' class="flex-1 py-1.5 text-center text-xs font-bold rounded-lg transition-all @(GetTabClass("general"))">
                                Genel & Güvenlik
                            </button>
                            <button @onclick='() => SetActiveTab("permissions")' class="flex-1 py-1.5 text-center text-xs font-bold rounded-lg transition-all @(GetTabClass("permissions"))">
                                Proje İzinleri
                            </button>
                            <button @onclick='() => SetActiveTab("logs")' class="flex-1 py-1.5 text-center text-xs font-bold rounded-lg transition-all @(GetTabClass("logs"))">
                                İstek Geçmişi
                            </button>
                            <button @onclick='() => SetActiveTab("test")' class="flex-1 py-1.5 text-center text-xs font-bold rounded-lg transition-all @(GetTabClass("test"))">
                                Bağlantı Testi
                            </button>
                        </div>

                        <!-- TAB CONTENT 1: DASHBOARD -->
                        @if (_activeTab == "dashboard")
                        {
                            <div class="space-y-4 animate-fade-in">
                                <div class="grid grid-cols-3 gap-4">
                                    <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-850">
                                        <div class="text-[9px] font-bold text-slate-400 uppercase">Toplam İstek</div>
                                        <div class="text-xl font-extrabold text-white mt-0.5">@_selectedKey.TotalRequests</div>
                                    </div>
                                    <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-850">
                                        <div class="text-[9px] font-bold text-slate-400 uppercase">Başarı Oranı</div>
                                        <div class="text-xl font-extrabold text-emerald-400 mt-0.5">
                                            @(_selectedKey.TotalRequests > 0 ? ((double)_selectedKey.SuccessfulRequests * 100 / _selectedKey.TotalRequests).ToString("F1") + "%" : "0%")
                                        </div>
                                    </div>
                                    <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-850">
                                        <div class="text-[9px] font-bold text-slate-400 uppercase">Ort. Gecikme</div>
                                        <div class="text-xl font-extrabold text-indigo-400 mt-0.5">@_selectedKey.AverageResponseTimeMs.ToString("F0") ms</div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div class="p-4 bg-slate-950/50 rounded-xl border border-slate-850 space-y-2 text-xs">
                                        <h5 class="font-bold text-white uppercase text-[9px] tracking-wider border-b border-slate-850 pb-1.5">Kota Bilgileri</h5>
                                        <div class="flex justify-between">
                                            <span class="text-slate-400">Kalan Kota:</span>
                                            <span class="text-emerald-400 font-bold">@_selectedKey.RemainingQuota</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-slate-400">Kullanılan Kota:</span>
                                            <span class="text-white font-semibold">@_selectedKey.UsedQuota</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-slate-400">Aylık Limit:</span>
                                            <span class="text-white">@(_selectedKey.MonthlyLimit?.ToString() ?? "Sınırsız")</span>
                                        </div>
                                    </div>

                                    <div class="p-4 bg-slate-950/50 rounded-xl border border-slate-850 space-y-2 text-xs">
                                        <h5 class="font-bold text-white uppercase text-[9px] tracking-wider border-b border-slate-850 pb-1.5">Son İstek ve Senkronizasyon</h5>
                                        <div class="flex justify-between">
                                            <span class="text-slate-400">Son İstek:</span>
                                            <span class="text-white">@(_selectedKey.LastUsedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Hiç yok")</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-slate-400">Son Güncelleme:</span>
                                            <span class="text-white">@(_selectedKey.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Girilmedi")</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-slate-400">Son Hata:</span>
                                            <span class="text-rose-400 font-medium truncate max-w-[150px]" title="@_selectedKey.LastError">@(_selectedKey.LastError ?? "Temiz")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- TAB CONTENT 2: GENERAL & SECURITY -->
                        else if (_activeTab == "general")
                        {
                            <div class="space-y-3 text-xs animate-fade-in">
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="p-3 bg-slate-950/40 rounded-lg border border-slate-850">
                                        <span class="text-[9px] text-slate-400 uppercase block mb-0.5">Sağlayıcı</span>
                                        <span class="text-white font-bold">@_selectedKey.Provider</span>
                                    </div>
                                    <div class="p-3 bg-slate-950/40 rounded-lg border border-slate-850">
                                        <span class="text-[9px] text-slate-400 uppercase block mb-0.5">Kategori</span>
                                        <span class="text-white font-bold">@_selectedKey.Category</span>
                                    </div>
                                </div>
                                <div class="p-3 bg-slate-950/40 rounded-lg border border-slate-850">
                                    <span class="text-[9px] text-slate-400 uppercase block mb-0.5">Base URL</span>
                                    <span class="text-white font-mono break-all">@(_selectedKey.BaseUrl ?? "Varsayılan API Uç Noktası")</span>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="p-3 bg-slate-950/40 rounded-lg border border-slate-850">
                                        <span class="text-[9px] text-slate-400 uppercase block mb-0.5">Varsayılan Model</span>
                                        <span class="text-indigo-300 font-mono font-bold">@(_selectedKey.DefaultModel ?? "Belirtilmedi")</span>
                                    </div>
                                    <div class="p-3 bg-slate-950/40 rounded-lg border border-slate-850">
                                        <span class="text-[9px] text-slate-400 uppercase block mb-0.5">Bitiş Tarihi</span>
                                        <span class="text-white">@(_selectedKey.ExpiresAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Süresiz")</span>
                                    </div>
                                </div>
                                <div class="p-3.5 bg-indigo-950/15 border border-indigo-500/10 rounded-xl space-y-1.5">
                                    <h5 class="text-[10px] font-black uppercase text-indigo-400 tracking-wider">Güvenlik Yapılandırması</h5>
                                    <p class="text-[9px] text-slate-400">Bu entegrasyon anahtarı veritabanımızda AES-256-GCM ile şifrelenmiştir. Çözümlemek için yukarıdaki 'Anahtarı Çöz' butonuna tıklayabilirsiniz.</p>
                                </div>
                            </div>
                        }

                        <!-- TAB CONTENT 3: PROJECT PERMISSIONS -->
                        else if (_activeTab == "permissions")
                        {
                            <div class="space-y-4 animate-fade-in text-xs">
                                <p class="text-slate-400 text-[10px]">Aşağıdan bu API anahtarını kullanmaya yetkili kılınacak projeleri seçin. İzin verilmeyen projeler bu anahtarla entegrasyon yapamaz.</p>
                                
                                <div class="grid grid-cols-2 gap-2 max-h-[220px] overflow-y-auto pr-1">
                                    @foreach (var proj in _allProjects)
                                    {
                                        <div class="flex items-center justify-between p-2.5 bg-slate-950 rounded-lg border border-slate-850">
                                            <span class="font-bold text-white">@proj.Name</span>
                                            <input type="checkbox" checked="@_permittedProjectIds.Contains(proj.Id)"
                                                @onchange="(e) => ToggleProjectPermission(proj.Id, e.Value)"
                                                class="w-4 h-4 rounded border-slate-800 text-indigo-600 focus:ring-indigo-500">
                                        </div>
                                    }
                                </div>

                                <button @onclick="SaveProjectPermissions" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-bold float-right">
                                    İzinleri Kaydet
                                </button>
                            </div>
                        }

                        <!-- TAB CONTENT 4: USAGE LOGS -->
                        else if (_activeTab == "logs")
                        {
                            <div class="space-y-3 animate-fade-in">
                                <div class="overflow-x-auto w-full max-h-[250px] overflow-y-auto border border-slate-850 rounded-xl">
                                    <table class="w-full text-left border-collapse text-[10px]">
                                        <thead>
                                            <tr class="bg-slate-950 border-b border-slate-850 text-slate-400">
                                                <th class="p-2">Tarih / Saat</th>
                                                <th class="p-2">Proje</th>
                                                <th class="p-2">Uç Nokta</th>
                                                <th class="p-2">Süre (ms)</th>
                                                <th class="p-2">HTTP</th>
                                                <th class="p-2">Token</th>
                                                <th class="p-2 text-right">Maliyet</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-850 text-slate-300">
                                            @if (!_usageLogs.Any())
                                            {
                                                <tr>
                                                    <td colspan="7" class="p-4 text-center text-slate-500">Bu anahtar için istek geçmişi bulunmamaktadır.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var log in _usageLogs)
                                                {
                                                    <tr class="hover:bg-slate-900">
                                                        <td class="p-2">@log.RequestDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                                                        <td class="p-2 font-bold text-white">@log.ProjectName</td>
                                                        <td class="p-2 font-mono">@log.Endpoint</td>
                                                        <td class="p-2 text-indigo-300">@log.ResponseTimeMs ms</td>
                                                        <td class="p-2">
                                                            <span class="px-1.5 py-0.5 rounded text-[8px] font-bold @(log.HttpStatus == 200 ? "bg-emerald-500/10 text-emerald-400" : "bg-rose-500/10 text-rose-400")">
                                                                @log.HttpStatus
                                                            </span>
                                                        </td>
                                                        <td class="p-2 font-mono">@(log.TokenUsage?.ToString() ?? "-")</td>
                                                        <td class="p-2 text-right font-mono text-emerald-400">@(log.Cost.HasValue ? "$" + log.Cost.Value.ToString("F5") : "-")</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        <!-- TAB CONTENT 5: CONNECTION TEST -->
                        else if (_activeTab == "test")
                        {
                            <div class="space-y-4 animate-fade-in text-xs">
                                <p class="text-slate-400 text-[10px]">API servis bağlantısını tek tıkla simüle edin. Erişim durumunu, kimlik doğrulamayı ve gecikmeyi ölçün.</p>

                                <div class="p-4 bg-slate-950/40 rounded-xl border border-slate-850 flex items-center justify-between">
                                    <div>
                                        <h5 class="font-bold text-white">Entegrasyon Durumu</h5>
                                        <p class="text-[10px] text-slate-400 mt-0.5">Uç Nokta: @(_selectedKey.BaseUrl ?? "https://api.openai.com/v1")</p>
                                    </div>
                                    <button @onclick="RunConnectionTest" disabled="@_isTestingConnection" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-bold flex items-center gap-1.5">
                                        @if (_isTestingConnection)
                                        {
                                            <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                        }
                                        <span>Bağlantıyı Test Et</span>
                                    </button>
                                </div>

                                @if (_testResult != null)
                                {
                                    <div class="p-4 rounded-xl border space-y-2 animate-fade-in @(_testResult.Success ? "bg-emerald-950/10 border-emerald-500/20" : "bg-rose-950/10 border-rose-500/20")">
                                        <div class="flex items-center justify-between font-bold">
                                            <span class="text-white">Bağlantı Sonucu:</span>
                                            <span class="@(_testResult.Success ? "text-emerald-400" : "text-rose-400")">
                                                @(_testResult.Success ? "BAŞARILI" : "BAŞARISIZ")
                                            </span>
                                        </div>
                                        <div class="text-[11px] text-slate-300 leading-relaxed font-medium">@_testResult.Message</div>
                                        <div class="grid grid-cols-2 gap-3 text-[10px] pt-1">
                                            <div>Gecikme Süresi: <span class="text-indigo-400 font-bold">@_testResult.LatencyMs ms</span></div>
                                            <div>Test Zamanı: <span class="text-slate-400 font-bold">@_testResult.ConnectionTime.ToLocalTime().ToString("HH:mm:ss")</span></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <button type="button" @onclick="() => _selectedKey = null" class="w-full mt-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-lg">
                        Paneli Kapat
                    </button>
                </div>
            }
        </div>

    </div>
</div>

<!-- Silme Onay Modalı -->
@if (_keyToDelete != null)
{
    <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-[99999] flex items-center justify-center p-4 animate-fade-in">
        <div class="glass max-w-sm w-full rounded-2xl p-6 text-left relative space-y-4 shadow-2xl bg-slate-900 border border-slate-800 text-white" style="border-radius: 16px;">
            <div class="flex items-center gap-3 text-rose-500">
                <span class="material-symbols-outlined text-3xl">warning</span>
                <div>
                    <h3 class="text-base font-extrabold" style="margin:0;">Anahtarı Sil?</h3>
                    <p class="text-[10px] text-rose-500" style="margin:2px 0 0 0;">Bu işlem geri alınamaz</p>
                </div>
            </div>

            <p class="text-xs text-slate-300 leading-relaxed">
                <strong>@_keyToDelete.Name</strong> entegrasyonu tamamen silinecektir. Bu anahtarı kullanan projeleriniz entegrasyon erişimini **anında kaybedecektir.**
            </p>

            <div class="flex gap-2 pt-2">
                <button @onclick="() => _keyToDelete = null" class="flex-1 text-xs font-bold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 py-2 rounded-xl transition-all" style="border-radius: 8px;">
                    İptal
                </button>
                <button @onclick="DeleteKey" class="flex-1 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 py-2 rounded-xl transition-all shadow-lg shadow-rose-600/20 flex items-center justify-center gap-2" style="border-radius: 8px;">
                    Evet, Sil!
                </button>
            </div>
        </div>
    </div>
}

