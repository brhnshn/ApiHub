@code {
    private List<ApiKeyDetailDto> _keys = new();
    private bool _isLoading = true;
    private bool _isRefreshing = false;
    private bool _isGenerating = false;
    
    // New Key details
    private string _newKeyName = "";
    private string _provider = "OpenAI";
    private string _category = "AI Services";
    private string _baseUrl = "";
    private string _defaultModel = "gpt-4o";
    private int? _monthlyLimit = 100000;

    // Selection
    private ApiKeyDetailDto? _selectedKey;
    private string _activeTab = "dashboard";

    private ApiKeyDetailDto? _keyToDelete;
    private string? _revealedRawKey;
    private string? _revealedKeyName;

    // Lists
    private List<ProjectItemDto> _allProjects = new();
    private List<Guid> _permittedProjectIds = new();
    private List<UsageLogDto> _usageLogs = new();
    private ConnectionTestResult? _testResult;
    private bool _isTestingConnection = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadKeys();
        await LoadProjects();
    }

    private async Task LoadKeys()
    {
        _isRefreshing = true;
        StateHasChanged();
        try
        {
            _keys = await Http.GetFromJsonAsync<List<ApiKeyDetailDto>>("api/apikeys") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Entegrasyon anahtarları yüklenirken hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task LoadProjects()
    {
        try
        {
            _allProjects = await Http.GetFromJsonAsync<List<ProjectItemDto>>("api/projects") ?? new();
        }
        catch { }
    }

    private async Task SelectKey(ApiKeyDetailDto key)
    {
        _selectedKey = key;
        _activeTab = "dashboard";
        _testResult = null;
        await LoadPermissionsAndLogs(key.Id);
    }

    private async Task LoadPermissionsAndLogs(Guid keyId)
    {
        try
        {
            _permittedProjectIds = await Http.GetFromJsonAsync<List<Guid>>($"api/apikeys/{keyId}/permissions") ?? new();
            _usageLogs = await Http.GetFromJsonAsync<List<UsageLogDto>>($"api/apikeys/{keyId}/logs") ?? new();
        }
        catch { }
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }

    private string GetTabClass(string tab)
    {
        return _activeTab == tab 
            ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/20" 
            : "text-slate-400 hover:text-slate-200";
    }

    private async Task GenerateKey()
    {
        if (string.IsNullOrWhiteSpace(_newKeyName))
        {
            Snackbar.Add("Lütfen açıklayıcı bir isim yazın!", Severity.Warning);
            return;
        }

        _isGenerating = true;
        _revealedRawKey = "";
        StateHasChanged();

        try
        {
            var payload = new
            {
                Name = _newKeyName,
                Provider = _provider,
                Category = _category,
                BaseUrl = _baseUrl,
                DefaultModel = _defaultModel,
                MonthlyLimit = _monthlyLimit
            };

            var response = await Http.PostAsJsonAsync("api/apikeys/generate", payload);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GenerateKeyResponse>();
                if (result != null)
                {
                    _revealedRawKey = result.RawKey;
                    _revealedKeyName = result.Name;
                    _newKeyName = "";
                    Snackbar.Add("Entegrasyon API Anahtarı başarıyla üretildi!", Severity.Success);
                    await LoadKeys();
                    
                    // Render QR Code via JS
                    await Task.Delay(100);
                    await JSRuntime.InvokeVoidAsync("renderQrCode", "revealed-qr-canvas", GetConfigString(_revealedRawKey));
                }
            }
            else
            {
                Snackbar.Add("API Anahtarı oluşturulamadı!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task ToggleKey(ApiKeyDetailDto key)
    {
        try
        {
            var response = await Http.PostAsync($"api/apikeys/{key.Id}/toggle", null);
            if (response.IsSuccessStatusCode)
            {
                key.IsActive = !key.IsActive;
                Snackbar.Add($"Anahtar başarıyla {(key.IsActive ? "aktif edildi" : "pasifleştirildi")}.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private void ConfirmDeleteKey(ApiKeyDetailDto key)
    {
        _keyToDelete = key;
    }

    private async Task DeleteKey()
    {
        if (_keyToDelete == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/apikeys/{_keyToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("API Anahtarı başarıyla iptal edildi ve silindi.", Severity.Success);
                _keys.Remove(_keyToDelete);
                if (_selectedKey?.Id == _keyToDelete.Id)
                {
                    _selectedKey = null;
                }
                _keyToDelete = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task RevealKey(ApiKeyDetailDto key)
    {
        try
        {
            var result = await Http.GetFromJsonAsync<RevealKeyResponseDto>($"api/apikeys/{key.Id}/reveal");
            if (result != null)
            {
                _revealedRawKey = result.RawKey;
                _revealedKeyName = key.Name;
                Snackbar.Add("Anahtar şifresi başarıyla çözüldü.", Severity.Success);
                
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("renderQrCode", "revealed-qr-canvas", GetConfigString(_revealedRawKey));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task RunConnectionTest()
    {
        if (_selectedKey == null) return;

        _isTestingConnection = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync($"api/apikeys/{_selectedKey.Id}/test-connection", null);
            if (response.IsSuccessStatusCode)
            {
                _testResult = await response.Content.ReadFromJsonAsync<ConnectionTestResult>();
                if (_testResult != null && _testResult.Success)
                {
                    Snackbar.Add("Bağlantı testi başarılı!", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Bağlantı testi başarısız oldu.", Severity.Warning);
                }
                await LoadKeys(); // Refresh limits & counts
                await LoadPermissionsAndLogs(_selectedKey.Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTestingConnection = false;
            StateHasChanged();
        }
    }

    private void ToggleProjectPermission(Guid projectId, object? isChecked)
    {
        var checkedState = isChecked is bool b && b;
        if (checkedState)
        {
            if (!_permittedProjectIds.Contains(projectId))
            {
                _permittedProjectIds.Add(projectId);
            }
        }
        else
        {
            _permittedProjectIds.Remove(projectId);
        }
    }

    private async Task SaveProjectPermissions()
    {
        if (_selectedKey == null) return;

        try
        {
            var response = await Http.PostAsJsonAsync($"api/apikeys/{_selectedKey.Id}/permissions", _permittedProjectIds);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Proje yetkileri başarıyla güncellendi.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private string GetConfigString(string rawKey)
    {
        var serverUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        return System.Text.Json.JsonSerializer.Serialize(new { serverUrl, apiKey = rawKey });
    }

    private async Task CopyConfigString(string rawKey)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", GetConfigString(rawKey));
            Snackbar.Add("Bağlantı yapılandırması panoya kopyalandı!", Severity.Success);
        }
        catch { }
    }

    private async Task CopyRevealedKey()
    {
        if (string.IsNullOrEmpty(_revealedRawKey)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _revealedRawKey);
            Snackbar.Add("API Anahtarı panoya kopyalandı!", Severity.Success);
        }
        catch { }
    }

    public void Dispose() { }

    public class ApiKeyDetailDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string MaskedKey { get; set; } = "";
        public bool IsActive { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
        public DateTimeOffset? LastUsedAt { get; set; }
        public DateTimeOffset? ExpiresAt { get; set; }
        public string? Provider { get; set; }
        public string? Description { get; set; }
        public string? Category { get; set; }
        public string? BaseUrl { get; set; }
        public string? DefaultModel { get; set; }
        public string? LastModifiedBy { get; set; }
        public DateTimeOffset? UpdatedAt { get; set; }

        public int TotalRequests { get; set; }
        public int SuccessfulRequests { get; set; }
        public int FailedRequests { get; set; }
        public double AverageResponseTimeMs { get; set; }
        public string? LastError { get; set; }
        public DateTimeOffset? LastErrorDate { get; set; }

        public DateTimeOffset? StartDate { get; set; }
        public DateTimeOffset? EndDate { get; set; }
        public int? DailyLimit { get; set; }
        public int? MonthlyLimit { get; set; }
        public int UsedQuota { get; set; }
        public int RemainingQuota { get; set; }
    }

    public class ProjectItemDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class UsageLogDto
    {
        public Guid Id { get; set; }
        public DateTimeOffset RequestDate { get; set; }
        public string? ProjectName { get; set; }
        public string? Endpoint { get; set; }
        public double ResponseTimeMs { get; set; }
        public int HttpStatus { get; set; }
        public int? TokenUsage { get; set; }
        public decimal? Cost { get; set; }
    }

    public class ConnectionTestResult
    {
        public bool Success { get; set; }
        public double LatencyMs { get; set; }
        public string Message { get; set; } = "";
        public string[] ModelList { get; set; } = Array.Empty<string>();
        public DateTimeOffset ConnectionTime { get; set; }
    }

    public class GenerateKeyResponse
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string MaskedKey { get; set; } = "";
        public string RawKey { get; set; } = "";
    }

    public class RevealKeyResponseDto
    {
        public string RawKey { get; set; } = "";
    }
}
