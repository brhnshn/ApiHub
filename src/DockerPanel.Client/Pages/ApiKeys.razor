@page "/apikeys"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject DockerPanel.Client.Services.AppState AppState
@inject PlatformInfo PlatformInfo
@implements IDisposable

<PageTitle>API Anahtarları - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex justify-between items-start gap-4 flex-wrap">
        <div>
            <div class="eyebrow">Geliştirici & Entegrasyon</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">API Anahtarları</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">Mobil uygulamanız veya dış servisleriniz için güvenli erişim anahtarları oluşturun ve yönetin.</p>
        </div>
        <button @onclick="LoadKeys" class="btn-secondary text-xs py-2 px-3.5 flex items-center gap-1.5">
            <i class="fa-solid fa-arrows-rotate text-xs @(_isRefreshing ? "animate-spin" : "")"></i>
            <span>Yenile</span>
        </button>
    </div>

    <!-- Bento Grid İstatistikler -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-lbl">Toplam Anahtar</div>
            <div class="stat-val">@_keys.Count</div>
            <div class="stat-sub">Sistemde kayıtlı anahtarlar</div>
        </div>

        <div class="stat-card">
            <div class="stat-lbl">Aktif Anahtarlar</div>
            <div class="stat-val text-[var(--moss)]">@_keys.Count(k => k.IsActive)</div>
            <div class="stat-sub">Yetkilendirilmiş erişim</div>
        </div>

        <div class="stat-card">
            <div class="stat-lbl">Güvenlik Katmanı</div>
            <div class="stat-val text-base md:text-lg font-serif">SHA-256</div>
            <div class="stat-sub">Tek yönlü karma şifreleme</div>
        </div>
    </div>

    <!-- Yeni Anahtar Üretme Formu -->
    <div class="card space-y-4">
        <div class="border-b border-[var(--line)] pb-3">
            <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Yeni API Anahtarı Oluştur</h3>
            <p class="text-xs text-[var(--ink-soft)] mt-0.5">Mobil istemci veya harici entegrasyonlar için yetki belirteci</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-5">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-[var(--ink-soft)] mb-1">Anahtar Adı</label>
                <input @bind="_newKeyName" class="w-full text-xs px-3 py-2.5 rounded-lg outline-none bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:border-[var(--azure)]" placeholder="Örn: Mobil Telefonum" />
            </div>
            <div class="md:col-span-4">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-[var(--ink-soft)] mb-1">Geçerlilik Süresi</label>
                <select @bind="_durationDays" class="w-full text-xs px-3 py-2.5 rounded-lg outline-none bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:border-[var(--azure)]">
                    <option value="">Süresiz (Sonsuz)</option>
                    <option value="7">7 Gün</option>
                    <option value="30">30 Gün</option>
                    <option value="90">90 Gün</option>
                    <option value="365">1 Yıl</option>
                </select>
            </div>
            <div class="md:col-span-3">
                <button @onclick="GenerateKey" disabled="@_isGenerating" class="btn-primary w-full py-2.5 text-xs flex items-center justify-center gap-2">
                    @if (_isGenerating)
                    {
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Üretiliyor...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-key text-xs"></i>
                        <span>Anahtar Üret</span>
                    }
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_generatedRawKey))
        {
            <!-- Oluşturulan Anahtar Bölümü -->
            <div class="mt-4 p-4 rounded-xl border border-[var(--amber)] bg-[var(--amber-bg)] space-y-3 text-xs">
                <div class="flex items-start gap-2.5 text-[var(--amber)]">
                    <i class="fa-solid fa-triangle-exclamation text-base mt-0.5"></i>
                    <div>
                        <h5 class="font-bold text-xs">Önemli Güvenlik Uyarısı</h5>
                        <p class="text-[11px] mt-0.5 text-[var(--ink)] leading-relaxed">Bu API anahtarını güvenli bir yere kaydedin. API anahtarınız veritabanımızda güvenli şifreleme algoritmalarıyla saklanmaktadır. Dilerseniz bu sayfadan veya aşağıdaki listeden göz simgesine tıklayarak anahtarınızı daha sonra da görüntüleyebilirsiniz.</p>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <span class="text-[10px] font-bold uppercase text-[var(--navy)] tracking-wider">Ham API Anahtarı</span>
                    <div class="flex items-center gap-2 bg-[#1C2630] border border-[var(--navy)] rounded-lg p-2.5 justify-between">
                        <span class="font-mono text-xs select-all text-[#8FD6B4] break-all">@_generatedRawKey</span>
                        <button @onclick="CopyGeneratedKey" class="p-1.5 hover:bg-white/10 rounded-lg transition-colors flex items-center text-[#8FA6BB] hover:text-white" title="Kopyala">
                            <i class="fa-regular fa-copy text-sm"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Mevcut Anahtarlar Tablosu -->
    <div class="card space-y-4">
        <div class="border-b border-[var(--line)] pb-3">
            <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Aktif API Anahtarlarınız</h3>
            <p class="text-xs text-[var(--ink-soft)] mt-0.5">Sistem erişimine açık anahtar listesi</p>
        </div>

        @if (_isLoading)
        {
            <div class="flex flex-col justify-center items-center py-10 space-y-2">
                <div class="w-8 h-8 border-3 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></div>
                <p class="text-xs text-[var(--ink-soft)]">Anahtarlar yükleniyor...</p>
            </div>
        }
        else if (!_keys.Any())
        {
            <div class="text-center py-10 text-[var(--ink-soft)]">
                <i class="fa-solid fa-key text-3xl text-[var(--slate)] mb-2"></i>
                <p class="text-xs font-semibold text-[var(--navy)]">Kayıtlı API anahtarı bulunamadı.</p>
                <p class="text-[11px] text-[var(--ink-soft)] mt-0.5">Mobil uygulamanızdan erişmek için yukarıdaki formu kullanarak yeni bir anahtar oluşturabilirsiniz.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto w-full">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-[var(--line)] text-[var(--ink-soft)] font-semibold">
                            <th class="pb-3">İsim</th>
                            <th class="pb-3">API Anahtarı</th>
                            <th class="pb-3">Oluşturma</th>
                            <th class="pb-3">Son Kullanım</th>
                            <th class="pb-3">Bitiş</th>
                            <th class="pb-3 text-center">Durum</th>
                            <th class="pb-3 text-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--line)] text-[var(--ink)]">
                        @foreach (var key in _keys)
                        {
                            <tr class="hover:bg-[var(--cream)] transition-colors">
                                <td class="py-3 font-semibold text-[var(--navy)]">@key.Name</td>
                                <td class="py-3 font-mono text-[var(--ink-soft)] select-all">@key.MaskedKey</td>
                                <td class="py-3 font-mono text-[var(--ink-soft)]">@key.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="py-3 text-[var(--ink-soft)]">
                                    @(key.LastUsedAt.HasValue ? key.LastUsedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Hiç kullanılmadı")
                                </td>
                                <td class="py-3 text-[var(--ink-soft)]">
                                    @(key.ExpiresAt.HasValue ? key.ExpiresAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Süresiz")
                                </td>
                                <td class="py-3 text-center">
                                    <input type="checkbox" checked="@key.IsActive" @onchange="() => ToggleKey(key)" class="w-4 h-4 rounded text-[var(--azure)]" />
                                </td>
                                <td class="py-3 text-right space-x-2">
                                    <button @onclick="() => RevealKey(key)" class="text-[var(--moss)] hover:underline font-bold text-xs" title="Anahtarı Göster">
                                        <i class="fa-solid fa-eye mr-1"></i> Göster
                                    </button>
                                    <button @onclick="() => ConfirmDeleteKey(key)" class="text-[var(--rose)] hover:underline font-bold text-xs ml-2" title="Anahtarı Sil (Revoke)">
                                        <i class="fa-solid fa-trash-can mr-1"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Silme Onay Modalı -->
@if (_keyToDelete != null)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-sm p-6 space-y-4 text-center">
            <div class="w-12 h-12 rounded-full bg-[var(--rose-bg)] text-[var(--rose)] flex items-center justify-center mx-auto text-xl">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 class="font-serif font-bold text-base text-[var(--navy)]">Anahtarı İptal Et?</h3>
            <p class="text-xs text-[var(--ink-soft)] leading-relaxed">
                <strong>@_keyToDelete.Name</strong> isimli API anahtarı tamamen silinecektir. Bu anahtarı kullanan tüm mobil uygulamalar sunucuya erişimini <strong>anında kaybedecektir.</strong>
            </p>
            <div class="flex justify-center gap-2 pt-3 border-t border-[var(--line)]">
                <button @onclick="() => _keyToDelete = null" class="btn-secondary py-2 px-4 text-xs">
                    İptal
                </button>
                <button @onclick="DeleteKey" class="btn-danger py-2 px-4 text-xs">
                    Evet, Sil!
                </button>
            </div>
        </div>
    </div>
}

<!-- Anahtarı Göster Modalı -->
@if (!string.IsNullOrEmpty(_revealedRawKey))
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-sm p-6 space-y-4">
            <div class="flex items-center gap-3 text-[var(--moss)] border-b border-[var(--line)] pb-3">
                <div class="p-2.5 bg-[var(--moss-bg)] text-[var(--moss)] rounded-xl">
                    <i class="fa-solid fa-key text-lg"></i>
                </div>
                <div>
                    <h3 class="font-serif font-bold text-base text-[var(--navy)] m-0">API Anahtarı Çözüldü</h3>
                    <p class="text-[11px] text-[var(--ink-soft)] m-0">@_revealedKeyName</p>
                </div>
            </div>

            <div class="space-y-1.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--ink-soft)]">API Anahtarı</span>
                <div class="flex items-center gap-2 bg-[#1C2630] border border-[var(--navy)] rounded-lg p-2.5 justify-between">
                    <span class="font-mono text-xs select-all text-[#8FD6B4] break-all">@_revealedRawKey</span>
                    <button @onclick="CopyRevealedKey" class="p-1.5 hover:bg-white/10 rounded-lg transition-colors flex items-center text-[#8FA6BB] hover:text-white" title="Kopyala">
                        <i class="fa-regular fa-copy text-sm"></i>
                    </button>
                </div>
            </div>

            <div class="pt-2 border-t border-[var(--line)]">
                <button @onclick="() => { _revealedRawKey = null; _revealedKeyName = null; }" class="btn-secondary w-full py-2 text-xs font-semibold">
                    Kapat
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ApiKeyDto> _keys = new();
    private bool _isLoading = true;
    private bool _isRefreshing = false;
    private bool _isGenerating = false;
    private string _newKeyName = "";
    private int? _durationDays = null;
    private string _generatedRawKey = "";
    private ApiKeyDto? _keyToDelete = null;
    private string? _revealedRawKey = null;
    private string? _revealedKeyName = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadKeys();
    }

    private async Task LoadKeys()
    {
        _isRefreshing = true;
        StateHasChanged();
        try
        {
            _keys = await Http.GetFromJsonAsync<List<ApiKeyDto>>("api/apikeys") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Anahtarlar yüklenirken hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task GenerateKey()
    {
        if (string.IsNullOrWhiteSpace(_newKeyName))
        {
            Snackbar.Add("Lütfen API anahtarı için açıklayıcı bir isim yazın!", Severity.Warning);
            return;
        }

        _isGenerating = true;
        _generatedRawKey = "";
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/apikeys/generate", new { Name = _newKeyName, DurationDays = _durationDays });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GenerateKeyResponse>();
                if (result != null)
                {
                    _generatedRawKey = result.RawKey;
                    _newKeyName = "";
                    _durationDays = null;
                    Snackbar.Add("API Anahtarı başarıyla üretildi!", Severity.Success);
                    await LoadKeys();

                }
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Snackbar.Add(error?.Message ?? "Anahtar oluşturulamadı!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task ToggleKey(ApiKeyDto key)
    {
        try
        {
            var response = await Http.PostAsync($"api/apikeys/{key.Id}/toggle", null);
            if (response.IsSuccessStatusCode)
            {
                key.IsActive = !key.IsActive;
                Snackbar.Add($"Anahtar başarıyla {(key.IsActive ? "aktif edildi" : "pasifleştirildi")}.", Severity.Success);
            }
            else
            {
                Snackbar.Add("İşlem gerçekleştirilemedi!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private void ConfirmDeleteKey(ApiKeyDto key)
    {
        _keyToDelete = key;
    }

    private async Task DeleteKey()
    {
        if (_keyToDelete == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/apikeys/{_keyToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("API Anahtarı silindi.", Severity.Success);
                _keys.Remove(_keyToDelete);
                _keyToDelete = null;
            }
            else
            {
                Snackbar.Add("Silme işlemi başarısız!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task CopyGeneratedKey()
    {
        if (string.IsNullOrEmpty(_generatedRawKey)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _generatedRawKey);
            Snackbar.Add("API Anahtarı panoya kopyalandı!", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Kopyalama başarısız oldu, lütfen manuel kopyalayın.", Severity.Warning);
        }
    }

    private async Task RevealKey(ApiKeyDto key)
    {
        try
        {
            var result = await Http.GetFromJsonAsync<RevealKeyResponse>($"api/apikeys/{key.Id}/reveal");
            if (result != null)
            {
                _revealedRawKey = result.RawKey;
                _revealedKeyName = key.Name;
                Snackbar.Add("API Anahtarı başarıyla çözüldü.", Severity.Success);
            }
            else
            {
                Snackbar.Add("API Anahtarı alınamadı!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task CopyRevealedKey()
    {
        if (string.IsNullOrEmpty(_revealedRawKey)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _revealedRawKey);
            Snackbar.Add("API Anahtarı panoya kopyalandı!", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Kopyalama başarısız oldu, lütfen manuel kopyalayın.", Severity.Warning);
        }
    }

    public void Dispose()
    {
    }

    public class RevealKeyResponse
    {
        public string RawKey { get; set; } = "";
    }

    public class ApiKeyDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string MaskedKey { get; set; } = "";
        public bool IsActive { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
        public DateTimeOffset? LastUsedAt { get; set; }
        public DateTimeOffset? ExpiresAt { get; set; }
    }

    public class GenerateKeyResponse
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string MaskedKey { get; set; } = "";
        public DateTimeOffset CreatedAt { get; set; }
        public DateTimeOffset? ExpiresAt { get; set; }
        public string RawKey { get; set; } = "";
    }

    public class ErrorResponse
    {
        public string Message { get; set; } = "";
    }
}
