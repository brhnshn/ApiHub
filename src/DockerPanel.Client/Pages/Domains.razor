    // SSL CERTBOT UYGULAMASI VE ONAYLANMA EKRANI TETİKLEYİCİ
    private async Task GenerateSslForSubdomain(SubdomainDto item)
    {
        _sslTargetDomain = string.IsNullOrWhiteSpace(item.SubdomainName) ? item.DomainName : $"{item.SubdomainName}.{item.DomainName}";
        _sslErrorMessage = string.Empty;
        _sslStep = 1;
        _sslVerificationState = SslState.Processing;
        _sslOverlayVisible = true;

        StateHasChanged();

        // 1. Aşama Simülasyonu
        await Task.Delay(1000);
        _sslStep = 2;
        StateHasChanged();

        // 2. Aşama Simülasyonu
        await Task.Delay(1500);
        _sslStep = 3;
        StateHasChanged();

        try
        {
            // Gerçek API tetiklemesi (30 saniyeye kadar sürebilir)
            var response = await Http.PostAsync($"api/nginx/{item.Id}/ssl", null);
            
            if (response.IsSuccessStatusCode)
            {
                _sslStep = 4;
                StateHasChanged();
                await Task.Delay(1000);
                
                _sslVerificationState = SslState.Success;
                StateHasChanged();
                
                await LoadDataAsync();
            }
            else
            {
                _sslErrorMessage = await response.Content.ReadAsStringAsync();
                _sslVerificationState = SslState.Error;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _sslErrorMessage = ex.Message;
            _sslVerificationState = SslState.Error;
            StateHasChanged();
        }
    }

    private void CloseSslOverlay()
    {
        _sslOverlayVisible = false;
    }

    private async Task DeleteProxyRule(SubdomainDto item)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/nginx/{item.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Reverse Proxy yönlendirme kaydı başarıyla silindi ve Nginx güvenle reload edildi.", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Silme hatası: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
    }

    // MODAL 3: DNS
    private void OpenDnsModal()
    {
        if (!_rootDomains.Any())
        {
            Snackbar.Add("DNS kaydı eklemek için lütfen önce en az bir ana alan adı (Root Domain) ekleyin!", Severity.Warning);
            return;
        }

        _dnsModel.Type = "A";
        _dnsPrefix = "";
        _dnsRootDomainName = _rootDomains.First().Name;
        _dnsModel.Value = "";
        _dnsModel.Ttl = 3600;
        _dnsModel.Proxied = true;
        _dnsModalVisible = true;
    }

    private void CloseDnsModal()
    {
        _dnsModalVisible = false;
    }

    private async Task HandleCreateDnsRecord()
    {
        if (string.IsNullOrEmpty(_dnsRootDomainName))
        {
            Snackbar.Add("Lütfen bir ana alan adı seçiniz!", Severity.Warning);
            return;
        }

        if (string.IsNullOrEmpty(_dnsModel.Value))
        {
            Snackbar.Add("Hedef değer alanı zorunludur!", Severity.Warning);
            return;
        }

        // Ön ek ve domain adını birleştir
        string prefix = _dnsPrefix.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(prefix) || prefix == "@")
        {
            _dnsModel.Name = _dnsRootDomainName;
        }
        else
        {
            _dnsModel.Name = $"{prefix}.{_dnsRootDomainName}";
        }

        _isProcessingDns = true;
        try
        {
            var apiPayload = new
            {
                Type = _dnsModel.Type,
                Name = _dnsModel.Name,
                Value = _dnsModel.Value,
                Ttl = _dnsModel.Ttl,
                Proxied = _dnsModel.Proxied,
                UseCloudflare = true
            };

            var response = await Http.PostAsJsonAsync("api/dns", apiPayload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("DNS kaydı başarıyla oluşturuldu!", Severity.Success);
                _dnsModalVisible = false;
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"DNS oluşturma hatası: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessingDns = false;
        }
    }

    private async Task DeleteDnsRecord(DnsRecordDto record)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/dns/{record.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("DNS alan kaydı silindi.", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"DNS silme hatası: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
    }

