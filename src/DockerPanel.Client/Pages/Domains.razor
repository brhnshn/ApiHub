                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">TTL (Saniye)</label>
                        <input type="number" @bind="_dnsModel.Ttl" min="120" max="86400"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]">
                    </div>
                    <div class="flex items-center gap-2 pt-6">
                        <input type="checkbox" id="proxied-checkbox" @bind="_dnsModel.Proxied" class="w-4 h-4 rounded text-[var(--azure)] focus:ring-[var(--azure)]">
                        <label for="proxied-checkbox" class="text-[var(--ink)] font-medium">Proxy (CDN)</label>
