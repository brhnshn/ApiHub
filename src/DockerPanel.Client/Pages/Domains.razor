@page "/domains"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Domain & DNS Yönetimi - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="eyebrow">Ağ ve Yönlendirme</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">Domain & DNS Yönetimi</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">Nginx Reverse Proxy yönlendirmelerini yapın ve Cloudflare API entegrasyonlu DNS alanlarını tek bir noktadan yönetin.</p>
        </div>
    </div>

    <!-- ANA ALAN ADLARI (ROOT DOMAINS) BÖLÜMÜ -->
    <div class="card space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--line)] pb-3 flex-wrap gap-2">
            <div class="flex items-center gap-2">
                <div class="stat-icon ic-azure w-8 h-8 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-globe text-sm"></i>
                </div>
                <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Kayıtlı Ana Alan Adları (Root Domains)</h3>
            </div>
            <button @onclick="OpenRootDomainModal"
                class="btn-primary py-1.5 px-3 text-xs">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Yeni Alan Adı Ekle</span>
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-[var(--line)] bg-[var(--cream)] text-[var(--ink-soft)]">
                        <th class="py-2.5 px-3 font-semibold">Alan Adı</th>
                        <th class="py-2.5 px-3 font-semibold">Cloudflare Entegrasyon Durumu</th>
                        <th class="py-2.5 px-3 font-semibold">Kayıt Tarihi</th>
                        <th class="py-2.5 px-3 font-semibold text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--line)] text-[var(--ink)]">
                    @if (!_rootDomains.Any())
                    {
                        <tr>
                            <td colspan="4" class="py-6 text-center text-[var(--ink-soft)]">Kayıtlı ana alan adı bulunmamaktadır. DNS ve Proxy işlemlerinden önce bir root domain ekleyin.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var rd in _rootDomains)
                        {
                            <tr class="hover:bg-[var(--cream)] transition-colors">
                                <td class="py-3 px-3 font-bold font-mono text-[var(--navy)]">@rd.Name</td>
                                <td class="py-3 px-3">
                                    @if (!string.IsNullOrEmpty(rd.CloudflareToken) && !string.IsNullOrEmpty(rd.CloudflareZoneId))
                                    {
                                        <span class="pill pill-moss text-[11px]"><span class="dot"></span>Bulut Entegrasyonu Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="pill text-[11px] bg-[var(--cream)] text-[var(--ink-soft)]">Entegrasyon Yok</span>
                                    }
                                </td>
                                <td class="py-3 px-3 text-[var(--ink-soft)]">@rd.CreatedAt.ToString("g")</td>
                                <td class="py-3 px-3 text-right">
                                    <button @onclick="@(() => DeleteRootDomain(rd))" class="btn-ghost text-[var(--rose)] hover:text-red-700 py-1 px-2 text-xs">
                                        <i class="fa-solid fa-trash-can"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Nginx Proxy Kuralları -->
    <div class="card space-y-4">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 border-b border-[var(--line)] pb-3">
            <div>
                <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Nginx Reverse Proxy Konfigürasyonu</h3>
                <p class="text-xs text-[var(--ink-soft)] mt-0.5">Alt alan adlarının sunucu üzerindeki konteynerlere yönlendirilmesi</p>
            </div>
            <div class="flex items-center gap-2 flex-wrap w-full md:w-auto">
                <button @onclick="TriggerNginxSync" disabled="@_isSyncing"
                    class="btn-secondary py-1.5 px-3 text-xs">
                    @if (_isSyncing)
                    {
                        <span class="w-3 h-3 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
                        <span>Taranıyor...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-arrows-rotate text-xs text-[var(--azure)]"></i>
                        <span>Nginx Yapılandırmalarını Eşitle</span>
                    }
                </button>
                <button @onclick="TriggerNginxRebuild" disabled="@_isRebuilding"
                    class="btn-ghost text-[var(--rose)] border border-[rgba(224,104,90,0.3)] py-1.5 px-3 text-xs">
                    @if (_isRebuilding)
                    {
                        <span class="w-3 h-3 border-2 border-rose-400 border-t-transparent rounded-full animate-spin"></span>
                        <span>Onarılıyor...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-wrench text-xs text-[var(--rose)]"></i>
                        <span>Yeniden Oluştur / Onar</span>
                    }
                </button>

                <button @onclick="OpenProxyModal"
                    class="btn-primary py-1.5 px-3 text-xs whitespace-nowrap">
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span>Yeni Proxy Kaydı</span>
                </button>
            </div>
        </div>

        <!-- Arama ve Filtreleme Bölümü -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-[var(--cream)] p-3 rounded-xl border border-[var(--line)]">
            <div class="sm:col-span-2 relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-magnifying-glass text-xs"></i>
                </span>
                <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Subdomain veya alan adı ara..."
                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg pl-9 pr-3 py-2 text-xs text-[var(--ink)] placeholder-[var(--ink-soft)] focus:outline-none focus:border-[var(--azure)]">
            </div>
            <div>
                <select @bind="_sslFilter"
                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg px-2.5 py-2 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]">
                    <option value="all">Filtrele: Tümü (SSL / HTTP)</option>
                    <option value="ssl">Sadece SSL Aktif</option>
                    <option value="nossl">Sadece HTTP Standart</option>
                </select>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-[var(--line)] bg-[var(--cream)] text-[var(--ink-soft)]">
                        <th class="py-2.5 px-3 font-semibold">Subdomain Adresi</th>
                        <th class="py-2.5 px-3 font-semibold">Hedef Konteyner (IP:Port)</th>
                        <th class="py-2.5 px-3 font-semibold">Proxy Durumu</th>
                        <th class="py-2.5 px-3 font-semibold">SSL Sertifikası (Let's Encrypt)</th>
                        <th class="py-2.5 px-3 font-semibold text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--line)] text-[var(--ink)]">
                    @if (!FilteredSubdomains.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-6 text-center text-[var(--ink-soft)]">
                                @if (_subdomains.Any())
                                {
                                    <span>Arama kriterlerinize uyan reverse proxy kuralı bulunamadı.</span>
                                }
                                else
                                {
                                    <span>Kayıtlı reverse proxy kuralı bulunmamaktadır.</span>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var context in FilteredSubdomains)
                        {
                            <tr class="hover:bg-[var(--cream)] transition-colors">
                                <td class="py-3 px-3 font-bold font-mono text-[var(--navy)]">
                                    @(string.IsNullOrWhiteSpace(context.SubdomainName) ? context.DomainName : $"{context.SubdomainName}.{context.DomainName}")
                                </td>
                                <td class="py-3 px-3 font-mono">
                                    @if (context.ProjectId.HasValue && context.ProjectId.Value != Guid.Empty)
                                    {
                                        <span class="pill pill-azure text-[11px] font-bold">
                                            <i class="fa-solid fa-cube text-[10px]"></i> @context.ContainerName (Port: @context.ContainerPort)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill text-[11px] bg-[var(--cream)] text-[var(--ink-soft)]">
                                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> Dış Servis (Port: @context.ContainerPort)
                                        </span>
                                    }
                                </td>
                                <td class="py-3 px-3">
                                    <span class="pill pill-moss text-[11px]"><span class="dot"></span>AKTİF</span>
                                </td>
                                <td class="py-3 px-3">
                                    @if (context.SslEnabled)
                                    {
                                        <span class="ssl-chip">
                                            <i class="fa-solid fa-lock text-[10px]"></i> Let's Encrypt SSL
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-2">
                                            <span class="pill text-[11px] bg-[var(--cream)] text-[var(--ink-soft)]">
                                                HTTP Standart
                                            </span>
                                            <button @onclick="@(() => GenerateSslForSubdomain(context))"
                                                class="btn-secondary py-0.5 px-2 text-[10.5px]">
                                                <i class="fa-solid fa-shield-halved text-[10px] text-[var(--azure)]"></i> SSL Kur
                                            </button>
                                        </div>
                                    }
                                </td>
                                <td class="py-3 px-3 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <button @onclick="@(() => OpenEditModal(context))" class="btn-ghost text-[var(--azure)] hover:text-blue-700 py-1 px-2 text-xs">
                                            <i class="fa-regular fa-pen-to-square"></i> Düzenle
                                        </button>
                                        <button @onclick="@(() => DeleteProxyRule(context))" class="btn-ghost text-[var(--rose)] hover:text-red-700 py-1 px-2 text-xs">
                                            <i class="fa-solid fa-trash-can"></i> Sil
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- DNS Zone Kayıtları Tablosu -->
    <div class="card space-y-4">
        <div class="flex justify-between items-center mb-1 border-b border-[var(--line)] pb-3 flex-wrap gap-2">
            <div>
                <h3 class="font-serif font-semibold text-[var(--navy)] text-base">DNS Bölge (Zone) Kayıtları</h3>
                <p class="text-xs text-[var(--ink-soft)] mt-0.5">Subdomainlerin dünya genelinde çözümlenmesi için Cloudflare DNS kayıtları</p>
            </div>
            <div class="flex items-center gap-2">
                <select @bind="_selectedDnsFilterDomain"
                    class="bg-[var(--paper)] border border-[var(--line)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]">
                    <option value="">Filtrele: Tüm Alan Adları</option>
                    @foreach (var rd in _rootDomains)
                    {
                        <option value="@rd.Name">@rd.Name</option>
                    }
                </select>
                <button @onclick="OpenDnsModal"
                    class="btn-primary py-1.5 px-3 text-xs">
                    <i class="fa-solid fa-plus-square text-xs"></i>
                    <span>Yeni DNS Kaydı Ekle</span>
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-[var(--line)] bg-[var(--cream)] text-[var(--ink-soft)]">
                        <th class="py-2.5 px-3 font-semibold">Tip</th>
                        <th class="py-2.5 px-3 font-semibold">İsim</th>
                        <th class="py-2.5 px-3 font-semibold">Değer (Hedef IP / Host)</th>
                        <th class="py-2.5 px-3 font-semibold">TTL</th>
                        <th class="py-2.5 px-3 font-semibold">Proxy Durumu</th>
                        <th class="py-2.5 px-3 font-semibold text-right">Aksiyonlar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--line)] text-[var(--ink)]">
                    @if (!FilteredDnsRecords.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-6 text-center text-[var(--ink-soft)]">
                                Kayıtlı DNS kaydı bulunmamaktadır.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var context in FilteredDnsRecords)
                        {
                            <tr class="hover:bg-[var(--cream)] transition-colors">
                                <td class="py-3 px-3">
                                    <span class="pill pill-amber text-[10px] font-bold">
                                        @context.Type
                                    </span>
                                </td>
                                <td class="py-3 px-3 font-mono font-semibold text-[var(--navy)]">@context.Name</td>
                                <td class="py-3 px-3 font-mono flex items-center">
                                    <span>@TruncateDnsValue(context.Value, 30)</span>
                                    @if (context.Value != null && context.Value.Length > 30)
                                    {
                                        <button @onclick="@(() => ShowFullDnsValue(context))" class="ml-2 btn-ghost py-0.5 px-1.5 text-[10px]">
                                            <i class="fa-solid fa-eye text-xs"></i> Gerçeğini Gör
                                        </button>
                                    }
                                </td>
                                <td class="py-3 px-3 font-mono text-[var(--ink-soft)]">@context.Ttl sn</td>
                                <td class="py-3 px-3">
                                    @if (context.Proxied)
                                    {
                                        <span class="pill pill-amber text-[10.5px]">
                                            <i class="fa-brands fa-cloudflare text-[10px]"></i> Proxied
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill text-[10.5px] bg-[var(--cream)] text-[var(--ink-soft)]">
                                            DNS Only
                                        </span>
                                    }
                                </td>
                                <td class="py-3 px-3 text-right">
                                    <button @onclick="@(() => DeleteDnsRecord(context))" class="btn-ghost text-[var(--rose)] hover:text-red-700 py-1 px-2 text-xs">
                                        <i class="fa-solid fa-trash-can"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODALLAR ================= -->

<!-- 1. MODAL: YENİ PROXY KAYDI -->
@if (_proxyModalVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                <h3 class="text-base font-serif font-semibold text-[var(--navy)]">Yeni Proxy Kuralı Ekle</h3>
                <button @onclick="CloseProxyModal" class="btn-ghost p-1 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
            
            <div class="space-y-3.5 text-xs">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Subdomain Ön Eki</label>
                        <input type="text" @bind="_proxyModel.SubdomainName" @bind:event="oninput" placeholder="örn: api"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]">
                    </div>
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Ana Alan Adı</label>
                        <select @bind="_proxyModel.DomainName"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]">
                            <option value="">Seçiniz...</option>
                            @foreach (var rd in _rootDomains)
                            {
                                <option value="@rd.Name">@rd.Name</option>
                            }
                        </select>
                    </div>
                </div>

                @if (_proxyModel.SubdomainName != null && _proxyModel.SubdomainName.Contains("*"))
                {
                    <div class="bg-[var(--amber-bg)] text-[var(--amber)] border border-[var(--line)] rounded-lg p-3 flex gap-2.5 items-start">
                        <i class="fa-solid fa-triangle-exclamation mt-0.5 text-sm"></i>
                        <div>
                            <span class="font-bold block text-[11px] uppercase tracking-wider mb-0.5">DNS-01 Doğrulama Uyarısı</span>
                            <span class="text-[11px] leading-relaxed block text-[var(--ink-soft)]">
                                Yaban karakter (*.domain.com) alt alan adları <strong>DNS-01 doğrulaması</strong> gerektirir. Standart HTTP Let's Encrypt doğrulamaları başarısız olacaktır.
                            </span>
                        </div>
                    </div>
                }

                <div>
                    <label class="block text-[var(--ink-soft)] font-semibold mb-1">Hedef Konteyner / Servis</label>
                    <select @bind="_proxyModel.ProjectId"
                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]">
                        <option value="@Guid.Empty">Bağımsız / Dış Servis (Projesiz)</option>
                        @foreach (var c in _activeContainers)
                        {
                            <option value="@c.Id">@c.Name (Port: @c.HostPort)</option>
                        }
                    </select>
                </div>

                @if (_proxyModel.ProjectId == Guid.Empty)
                {
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Harici Bağlantı Portu (Independent Port)</label>
                        <input type="number" @bind="_proxyModel.ExternalPort" min="1" max="65535"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]">
                    </div>
                }

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="ssl-checkbox" @bind="_proxyModel.SslEnabled" class="w-4 h-4 rounded text-[var(--azure)] focus:ring-[var(--azure)]">
                    <label for="ssl-checkbox" class="text-[var(--ink)] font-medium">Let's Encrypt SSL sertifikası üret</label>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-3 border-t border-[var(--line)]">
                <button type="button" @onclick="CloseProxyModal"
                    class="btn-secondary py-2 px-4 text-xs">İptal</button>
                <button type="button" @onclick="HandleCreateProxyRule"
                    class="btn-primary py-2 px-4 text-xs">
                    @if (_isProcessingProxy)
                    {
                        <span class="w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Ekleniyor...</span>
                    }
                    else
                    {
                        <span>Yönlendirmeyi Aktif Et</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- 2. MODAL: DÜZENLEME MODALI -->
@if (_editModalVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                <h3 class="text-base font-serif font-semibold text-[var(--navy)] flex items-center gap-2">
                    <i class="fa-regular fa-pen-to-square text-[var(--azure)]"></i> Proxy Yönlendirmesini Düzenle
                </h3>
                <button @onclick="CloseEditModal" class="btn-ghost p-1 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
            
            <div class="space-y-3.5 text-xs">
                <div class="bg-[var(--cream)] p-3 rounded-lg border border-[var(--line)]">
                    <span class="text-[10px] text-[var(--ink-soft)] block font-semibold">DÜZENLENEN ALAN ADI</span>
                    @if (string.IsNullOrWhiteSpace(_editModel.SubdomainName))
                    {
                        <span class="font-mono text-sm font-bold text-[var(--navy)]">@_editModel.DomainName</span>
                    }
                    else
                    {
                        <span class="font-mono text-sm font-bold text-[var(--navy)]">@_editModel.SubdomainName</span><span class="font-mono text-sm font-bold text-[var(--ink-soft)]">.@_editModel.DomainName</span>
                    }
                </div>

                <div>
                    <label class="block text-[var(--ink-soft)] font-semibold mb-1">Hedef Konteyner / Servis</label>
                    <select @bind="_editModel.ProjectId"
                        class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]">
                        <option value="@Guid.Empty">Bağımsız / Dış Servis (Projesiz)</option>
                        @foreach (var c in _activeContainers)
                        {
                            <option value="@c.Id">@c.Name (Port: @c.HostPort)</option>
                        }
                    </select>
                </div>

                @if (_editModel.ProjectId == Guid.Empty)
                {
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Harici Bağlantı Portu (Independent Port)</label>
                        <input type="number" @bind="_editModel.ExternalPort" min="1" max="65535"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]">
                    </div>
                }

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="edit-ssl-checkbox" @bind="_editModel.SslEnabled" class="w-4 h-4 rounded text-[var(--azure)] focus:ring-[var(--azure)]">
                    <label for="edit-ssl-checkbox" class="text-[var(--ink)] font-medium">SSL Sertifikasını Aktifleştir</label>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-3 border-t border-[var(--line)]">
                <button type="button" @onclick="CloseEditModal"
                    class="btn-secondary py-2 px-4 text-xs">İptal</button>
                <button type="button" @onclick="HandleUpdateProxyRule" disabled="@_isProcessingEdit"
                    class="btn-primary py-2 px-4 text-xs">
                    @if (_isProcessingEdit)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Güncelleniyor...</span>
                    }
                    else
                    {
                        <span>Değişiklikleri Kaydet</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- 3. MODAL: YENİ DNS KAYDI -->
@if (_dnsModalVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
