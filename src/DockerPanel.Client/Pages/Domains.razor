<!-- MODAL: YENİ ANA ALAN ADI EKLE -->
@if (_rootDomainModalVisible)
{
    <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center">
        <div class="bg-white border border-[#bbcabf]/30 rounded-xl w-full max-w-md p-6 space-y-4 text-[#0b1c30] shadow-2xl animate-fade-in">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                <h3 class="text-lg font-bold text-[#0b1c30]">Yeni Ana Alan Adı Ekle</h3>
                <button @onclick="CloseRootDomainModal" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <div class="space-y-4 text-xs">
                <div>
                    <label class="block text-slate-400 font-semibold mb-1">Alan Adı (Root Domain)</label>
                    <input type="text" @bind="_rootDomainModel.Name" placeholder="örn: site.com"
                        class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white font-mono focus:outline-none focus:border-indigo-500">
                </div>

                <div class="border-t border-slate-200 pt-3">
                    <h4 class="font-bold text-xs text-[#0b1c30] mb-2 flex items-center gap-1.5">
                        <i class="fa-brands fa-cloudflare text-orange-400 text-sm"></i> Cloudflare DNS Entegrasyonu (İsteğe Bağlı)
                    </h4>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-slate-400 font-semibold mb-1">Cloudflare API Token</label>
                            <input type="password" @bind="_rootDomainModel.CloudflareToken" placeholder="c8b2...a8f2"
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white font-mono focus:outline-none focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-slate-400 font-semibold mb-1">Zone ID</label>
                            <input type="text" @bind="_rootDomainModel.CloudflareZoneId" placeholder="89b88...238fc"
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white font-mono focus:outline-none focus:border-indigo-500">
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-slate-200">
                <button type="button" @onclick="CloseRootDomainModal"
                    class="bg-slate-200 text-slate-700 px-4 py-2 rounded-lg hover:bg-slate-300 transition-colors text-xs font-semibold">İptal</button>
                <button type="button" @onclick="HandleCreateRootDomain"
                    class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg font-bold text-xs transition-all shadow-lg flex items-center gap-1.5">
                    @if (_isProcessingRootDomain)
                    {
                        <span class="w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Ekleniyor...</span>
                    }
                    else
                    {
                        <span>Kaydet</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<SubdomainDto> _subdomains = new();
    private List<DnsRecordDto> _dnsRecords = new();
    private List<ContainerSelectDto> _activeContainers = new();
    private List<RootDomainDto> _rootDomains = new();

    private bool _rootDomainModalVisible = false;
    private bool _isProcessingRootDomain = false;
    private readonly CreateRootDomainModel _rootDomainModel = new();

    private string _dnsPrefix = string.Empty;
    private string _dnsRootDomainName = string.Empty;

    private string _cfToken = string.Empty;
    private string _cfZoneId = string.Empty;
    private bool _cfConnected => _rootDomains.Any(r => !string.IsNullOrEmpty(r.CloudflareToken) && !string.IsNullOrEmpty(r.CloudflareZoneId));

    // Modals & States
    private bool _dnsValueModalVisible = false;
    private string _selectedDnsRecordName = string.Empty;
    private string _selectedDnsRecordValue = string.Empty;

    private string TruncateDnsValue(string? value, int maxChars = 30)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return value.Length <= maxChars ? value : value.Substring(0, maxChars) + "...";
    }

    private void ShowFullDnsValue(DnsRecordDto record)
    {
        _selectedDnsRecordName = record.Name;
        _selectedDnsRecordValue = record.Value;
        _dnsValueModalVisible = true;
    }

    private void CloseDnsValueModal()
    {
        _dnsValueModalVisible = false;
    }

    private bool _proxyModalVisible = false;
    private bool _isProcessingProxy = false;
    private readonly CreateProxyModel _proxyModel = new();

    private bool _editModalVisible = false;
    private bool _isProcessingEdit = false;
    private readonly EditProxyModel _editModel = new();

    private bool _dnsModalVisible = false;
    private bool _isProcessingDns = false;
    private readonly CreateDnsModel _dnsModel = new();

    private bool _isSyncing = false;

    // Search & Filter
    private string _searchQuery = string.Empty;
    private string _sslFilter = "all";

    // SSL Processing Overlay
    private bool _sslOverlayVisible = false;
    private SslState _sslVerificationState = SslState.Processing;
    private int _sslStep = 1;
    private string _sslTargetDomain = string.Empty;
    private string _sslErrorMessage = string.Empty;

    private string _selectedDnsFilterDomain = string.Empty;

    private IEnumerable<DnsRecordDto> FilteredDnsRecords => _dnsRecords.Where(d =>
        string.IsNullOrEmpty(_selectedDnsFilterDomain) || 
        d.Name.Equals(_selectedDnsFilterDomain, StringComparison.OrdinalIgnoreCase) || 
        d.Name.EndsWith("." + _selectedDnsFilterDomain, StringComparison.OrdinalIgnoreCase)
    );

    private IEnumerable<SubdomainDto> FilteredSubdomains => _subdomains.Where(s => 
        (string.IsNullOrEmpty(_searchQuery) 
            || s.SubdomainName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) 
            || s.DomainName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) 
        && (_sslFilter == "all" 
            || (_sslFilter == "ssl" && s.SslEnabled) 
            || (_sslFilter == "nossl" && !s.SslEnabled))
    );

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "cf_token");
                var savedZoneId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "cf_zone_id");

                bool updated = false;
                if (!string.IsNullOrEmpty(savedToken)) { _cfToken = savedToken; updated = true; }
                if (!string.IsNullOrEmpty(savedZoneId)) { _cfZoneId = savedZoneId; updated = true; }

                if (updated)
                {
                    StateHasChanged();
                    await LoadDataAsync();
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore early JS interop failures
            }
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            // Ana Alan Adları
            var rawRoots = await Http.GetFromJsonAsync<List<RootDomainDto>>("api/domains/roots");
            _rootDomains = rawRoots ?? new List<RootDomainDto>();

            // Reverse Proxy Yönlendirmeleri
            var rawProxies = await Http.GetFromJsonAsync<List<SubdomainDto>>("api/nginx");
            _subdomains = rawProxies ?? new List<SubdomainDto>();

            // DNS Kayıtları
            var rawDns = await Http.GetFromJsonAsync<List<DnsRecordDto>>("api/dns");
            _dnsRecords = rawDns ?? new List<DnsRecordDto>();

            // Hedef Konteynerler / Projeler (api/projects)
            var rawProjects = await Http.GetFromJsonAsync<List<ContainerSelectDto>>("api/projects");
            _activeContainers = rawProjects ?? new List<ContainerSelectDto>();
        }
        catch (OperationCanceledException)
        {
            // Page navigation can cancel in-flight domain/DNS requests; avoid noisy transient toasts.
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Veriler yüklenirken bir hata oluştu: {ex.Message}", Severity.Error);
        }
    }

    private void OpenRootDomainModal()
    {
        _rootDomainModel.Name = "";
        _rootDomainModel.CloudflareToken = "";
        _rootDomainModel.CloudflareZoneId = "";
        _rootDomainModalVisible = true;
    }

    private void CloseRootDomainModal()
    {
        _rootDomainModalVisible = false;
    }

    private async Task HandleCreateRootDomain()
    {
        if (string.IsNullOrEmpty(_rootDomainModel.Name))
        {
            Snackbar.Add("Alan adı zorunludur!", Severity.Warning);
            return;
        }

        _isProcessingRootDomain = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/domains/roots", _rootDomainModel);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ana alan adı başarıyla eklendi!", Severity.Success);
                _rootDomainModalVisible = false;
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Hata: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessingRootDomain = false;
        }
    }

    private async Task DeleteRootDomain(RootDomainDto rd)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/domains/roots/{rd.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ana alan adı başarıyla silindi.", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Silme hatası: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
    }

    // NGINX TARAMA VE EŞİTLEME TETİKLEMESİ
    private async Task TriggerNginxSync()
    {
        _isSyncing = true;
        try
        {
            var response = await Http.PostAsync("api/nginx/sync", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Nginx sites-enabled yapılandırmaları taranıp veritabanıyla başarıyla eşitlendi!", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Nginx senkronizasyon hatası: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Senkronizasyon sırasında hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncing = false;
        }
    }

    // MODAL 1: PROXY EKLE
    private void OpenProxyModal()
    {
        _proxyModel.SubdomainName = "";
        _proxyModel.DomainName = "";
        _proxyModel.ProjectId = Guid.Empty;
        _proxyModel.ExternalPort = 80;
        _proxyModel.SslEnabled = true;
        _proxyModalVisible = true;
    }

    private void CloseProxyModal()
    {
        _proxyModalVisible = false;
    }

    private async Task HandleCreateProxyRule()
    {
        if (string.IsNullOrEmpty(_proxyModel.SubdomainName) || string.IsNullOrEmpty(_proxyModel.DomainName))
        {
            Snackbar.Add("Subdomain ve domain alanları zorunludur!", Severity.Warning);
            return;
        }

        _isProcessingProxy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/nginx", _proxyModel);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Reverse Proxy yönlendirme kuralı başarıyla aktif edildi!", Severity.Success);
                _proxyModalVisible = false;
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Kural ekleme hatası: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessingProxy = false;
        }
    }

