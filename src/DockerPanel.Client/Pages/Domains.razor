    // MODAL 1: PROXY EKLE
    private void OpenProxyModal()
    {
        _proxyModel.SubdomainName = "";
        _proxyModel.DomainName = "";
        _proxyModel.ProjectId = Guid.Empty;
        _proxyModel.ExternalPort = 80;
        _proxyModel.SslEnabled = true;
        _proxyModalVisible = true;
    }

    private void CloseProxyModal()
    {
        _proxyModalVisible = false;
    }

    private async Task HandleCreateProxyRule()
    {
        if (string.IsNullOrEmpty(_proxyModel.SubdomainName) || string.IsNullOrEmpty(_proxyModel.DomainName))
        {
            Snackbar.Add("Subdomain ve domain alanları zorunludur!", Severity.Warning);
            return;
        }

        _isProcessingProxy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/nginx", _proxyModel);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Reverse Proxy yönlendirme kuralı başarıyla aktif edildi!", Severity.Success);
                _proxyModalVisible = false;
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Kural ekleme hatası: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessingProxy = false;
        }
    }

