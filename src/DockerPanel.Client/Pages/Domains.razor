                <button type="button" @onclick="HandleCreateDnsRecord"
                    class="btn-primary py-2 px-4 text-xs">
                    @if (_isProcessingDns)
                    {
                        <span class="w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Zone Güncelleniyor...</span>
                    }
                    else
                    {
                        <span>Zone Kaydı Ekle</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= 4. PREMIUM ONAYLANMA / SSL YÜKLENİYOR EKRANI ================= -->
@if (_sslOverlayVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4 animate-fade-in">
        <div class="modal-dialog max-w-md w-full p-8 text-center space-y-5">
            
            @if (_sslVerificationState == SslState.Processing)
            {
                <!-- Yükleniyor / Doğrulanıyor Animasyonu -->
                <div class="relative w-24 h-24 mx-auto flex items-center justify-center">
                    <div class="absolute inset-0 border-4 border-[var(--line)] rounded-full"></div>
                    <div class="absolute inset-0 border-4 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></div>
                    <div class="w-14 h-14 bg-[var(--accent-bg)] rounded-full flex items-center justify-center text-[var(--azure)]">
                        <i class="fa-solid fa-shield-halved text-xl"></i>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <h3 class="text-lg font-serif font-semibold text-[var(--navy)]">Onaylanıyor...</h3>
                    <p class="text-xs text-[var(--azure)] font-semibold uppercase tracking-wider font-mono">Let's Encrypt SSL Doğrulaması</p>
                    <p class="text-xs text-[var(--ink-soft)]">Sunucu Certbot modülü aracılığıyla HTTPS geçiş doğrulamalarını gerçekleştiriyor. Lütfen bekleyin.</p>
                </div>

                <!-- Süreç Adımları -->
                <div class="text-left bg-[var(--cream)] p-4 rounded-xl border border-[var(--line)] space-y-2 text-xs">
                    <div class="flex items-center gap-2">
                        @if (_sslStep >= 1)
                        {
                            <i class="fa-solid fa-circle-check text-[var(--moss)]"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-circle text-[var(--ink-soft)]"></i>
                        }
                        <span class="@(_sslStep == 1 ? "text-[var(--navy)] font-bold" : "text-[var(--ink-soft)]")">Adım 1: DNS A kaydı doğrulanıyor...</span>
                    </div>

                    <div class="flex items-center gap-2">
                        @if (_sslStep >= 2)
                        {
                            <i class="fa-solid fa-circle-check text-[var(--moss)]"></i>
                        }
                        else if (_sslStep == 1)
                        {
                            <i class="fa-solid fa-spinner animate-spin text-[var(--azure)]"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-circle text-[var(--ink-soft)]"></i>
                        }
                        <span class="@(_sslStep == 2 ? "text-[var(--navy)] font-bold" : "text-[var(--ink-soft)]")">Adım 2: Let's Encrypt HTTP sorgusu iletiliyor...</span>
                    </div>

                    <div class="flex items-center gap-2">
                        @if (_sslStep >= 3)
                        {
                            <i class="fa-solid fa-circle-check text-[var(--moss)]"></i>
                        }
                        else if (_sslStep == 2)
                        {
                            <i class="fa-solid fa-spinner animate-spin text-[var(--azure)]"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-circle text-[var(--ink-soft)]"></i>
                        }
                        <span class="@(_sslStep == 3 ? "text-[var(--navy)] font-bold" : "text-[var(--ink-soft)]")">Adım 3: Certbot challenge token doğrulandı...</span>
                    </div>

                    <div class="flex items-center gap-2">
                        @if (_sslStep >= 4)
                        {
                            <i class="fa-solid fa-circle-check text-[var(--moss)]"></i>
                        }
                        else if (_sslStep == 3)
                        {
                            <i class="fa-solid fa-spinner animate-spin text-[var(--azure)]"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-circle text-[var(--ink-soft)]"></i>
                        }
                        <span class="@(_sslStep == 4 ? "text-[var(--navy)] font-bold" : "text-[var(--ink-soft)]")">Adım 4: Nginx SSL yönlendirmesi kuruluyor...</span>
                    </div>
                </div>
            }
            else if (_sslVerificationState == SslState.Success)
            {
                <!-- Başarı Ekranı -->
                <div class="w-16 h-16 bg-[var(--moss-bg)] rounded-full flex items-center justify-center mx-auto text-[var(--moss)] border border-[var(--moss)]">
                    <i class="fa-solid fa-circle-check text-3xl"></i>
                </div>

                <div class="space-y-2">
                    <h3 class="text-xl font-serif font-semibold text-[var(--moss)]">Tamamdır!</h3>
                    <p class="text-xs text-[var(--ink-soft)]">
                        Let's Encrypt SSL sertifikası başarıyla üretildi ve Nginx proxy kuralınıza dahil edildi.
                    </p>
                    <div class="font-mono text-xs bg-[var(--cream)] p-2.5 rounded-lg border border-[var(--line)] text-[var(--navy)] break-all font-bold">
                        HTTPS://@_sslTargetDomain
                    </div>
                </div>

                <div class="pt-3">
                    <button @onclick="CloseSslOverlay"
                        class="btn-primary w-full py-2.5">
                        Harika, Devam Et
                    </button>
                </div>
            }
            else
            {
                <!-- Hata Ekranı -->
                <div class="w-16 h-16 bg-[var(--rose-bg)] rounded-full flex items-center justify-center mx-auto text-[var(--rose)] border border-[var(--rose)]">
                    <i class="fa-solid fa-circle-xmark text-3xl"></i>
                </div>

                <div class="space-y-2">
                    <h3 class="text-xl font-serif font-semibold text-[var(--rose)]">İşlem Başarısız</h3>
                    <p class="text-xs text-[var(--ink-soft)]">
                        Certbot doğrulaması sırasında bir sunucu hatası oluştu. Lütfen A/DNS kayıtlarınızı kontrol edin.
                    </p>
                    <div class="text-left font-mono text-xs bg-[var(--rose-bg)] p-3 rounded-lg border border-[rgba(224,104,90,0.3)] text-[var(--rose)] max-h-32 overflow-y-auto break-all">
                        @_sslErrorMessage
                    </div>
                </div>

                <div class="pt-3">
                    <button @onclick="CloseSslOverlay"
                        class="btn-secondary w-full py-2.5">
                        Pencereyi Kapat
                    </button>
                </div>
            }

        </div>
    </div>
}

