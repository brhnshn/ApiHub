@page "/email"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject PlatformInfo PlatformInfo

<PageTitle>E-Posta Yönetimi - ApiHub</PageTitle>

<div class="space-y-6">
    <!-- Üst Başlık -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="eyebrow">İletişim ve E-Posta</div>
            <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--navy)]">E-Posta Sunucusu Yönetimi</h1>
            <p class="text-xs md:text-sm text-[var(--ink-soft)] mt-1">
                E-posta hesaplarınızı, SMTP ayarlarınızı ve yönlendirmeleri buradan yönetin.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- E-Posta İstemci Bilgileri Kartı -->
        <div class="lg:col-span-4 card flex flex-col justify-between space-y-4">
            <div>
                <div class="flex items-center justify-between border-b border-[var(--line)] pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-envelope text-[var(--azure)] text-base"></i>
                        <h3 class="font-serif font-semibold text-[var(--navy)] text-base">İstemci Bilgileri</h3>
                    </div>
                    <span class="pill pill-moss text-[10.5px]"><span class="dot"></span>SSL/TLS</span>
                </div>
                
                <div class="space-y-3 text-xs">
                    <div>
                        <span class="text-[10px] font-bold uppercase text-[var(--ink-soft)] block mb-1">IMAP (Gelen Posta)</span>
                        <div class="font-mono text-xs text-[var(--navy)] bg-[var(--cream)] p-2.5 rounded-lg border border-[var(--line)]">
                            <div>Host: <span class="font-bold">mail.burhansahin.com.tr</span></div>
                            <div>Port: <span class="font-bold text-[var(--moss)]">993</span> (SSL)</div>
                        </div>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold uppercase text-[var(--ink-soft)] block mb-1">SMTP (Giden Posta)</span>
                        <div class="font-mono text-xs text-[var(--navy)] bg-[var(--cream)] p-2.5 rounded-lg border border-[var(--line)]">
                            <div>Host: <span class="font-bold">mail.burhansahin.com.tr</span></div>
                            <div>Port: <span class="font-bold text-[var(--moss)]">587</span> (TLS)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-3 border-t border-[var(--line)] text-[11px] text-[var(--ink-soft)]">
                <a href="/webmail" class="btn-secondary w-full py-2 text-center block text-xs font-semibold">
                    <i class="fa-solid fa-arrow-up-right-from-square mr-1"></i> Webmail İstemcisini Aç
                </a>
            </div>
        </div>

        <!-- Kayıtlı E-Postalar Tablosu -->
        <div class="lg:col-span-8 card space-y-4">
            <div class="flex items-center justify-between flex-wrap gap-3 border-b border-[var(--line)] pb-3">
                <div>
                    <h3 class="font-serif font-semibold text-[var(--navy)] text-base">Aktif E-Posta Hesapları</h3>
                    <p class="text-xs text-[var(--ink-soft)] mt-0.5">Sunucuda tanımlı posta kutuları</p>
                </div>
                <button @onclick="OpenCreateModal" class="btn-primary text-xs py-2 px-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-plus text-xs"></i> Yeni Hesap Ekle
                </button>
            </div>

            @if (_isLoading)
            {
                <div class="flex flex-col items-center justify-center py-10 space-y-2">
                    <div class="w-8 h-8 border-3 border-[var(--azure)] border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-xs text-[var(--ink-soft)]">Hesaplar yükleniyor...</span>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-[var(--line)] text-[var(--ink-soft)] font-semibold">
                                <th class="pb-3">Görünen Ad</th>
                                <th class="pb-3">E-Posta Adresi</th>
                                <th class="pb-3">Durum</th>
                                <th class="pb-3 text-right">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--line)]">
                            @if (!_accounts.Any())
                            {
                                <tr>
                                    <td colspan="4" class="py-6 text-center text-[var(--ink-soft)]">
                                        Henüz açılmış bir e-posta hesabı bulunmamaktadır.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var context in _accounts)
                                {
                                    <tr class="text-[var(--ink)] hover:bg-[var(--cream)] transition-colors">
                                        <td class="py-3 font-semibold text-[var(--navy)]">
                                            @(string.IsNullOrEmpty(context.DisplayName) ? "-" : context.DisplayName)
                                        </td>
                                        <td class="py-3 font-mono font-bold text-[var(--moss)]">
                                            @context.EmailAddress
                                        </td>
                                        <td class="py-3">
                                            @if (context.ForwardingEnabled)
                                            {
                                                <span class="pill pill-amber text-[10.5px]">Yönlendiriliyor</span>
                                            }
                                            else
                                            {
                                                <span class="pill pill-moss text-[10.5px]"><span class="dot"></span>Aktif</span>
                                            }
                                        </td>
                                        <td class="py-3 text-right space-x-2">
                                            <button @onclick="@(() => OpenEditModal(context))" class="text-[var(--azure)] hover:underline font-bold text-xs">
                                                <i class="fa-solid fa-pen-to-square"></i> Düzenle
                                            </button>
                                            <button @onclick="@(() => DeleteAccount(context))" class="text-[var(--rose)] hover:underline font-bold text-xs ml-2">
                                                <i class="fa-solid fa-trash-can"></i> Sil
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Yeni E-Posta Modalı -->
@if (_createModalVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                <h3 class="text-base font-serif font-semibold text-[var(--navy)] flex items-center gap-2">
                    <i class="fa-solid fa-envelope text-[var(--azure)]"></i> Yeni E-Posta Hesabı Ekle
                </h3>
                <button @onclick="() => _createModalVisible = false" class="btn-ghost p-1 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <EditForm Model="@_createModel" OnValidSubmit="HandleCreate">
                <DataAnnotationsValidator />
                
                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">E-Posta Adresi</label>
                        <InputText @bind-Value="_createModel.EmailAddress" placeholder="örn: info@alanadi.com"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--navy)] font-mono font-bold focus:outline-none focus:border-[var(--azure)]" />
                        <ValidationMessage For="@(() => _createModel.EmailAddress)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>
                    
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Görünen Ad</label>
                        <InputText @bind-Value="_createModel.DisplayName" placeholder="örn: ApiHub Destek"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]" />
                        <ValidationMessage For="@(() => _createModel.DisplayName)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Hesap Şifresi</label>
                        <InputText @bind-Value="_createModel.Password" type="password" placeholder="Güçlü şifre"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]" />
                        <ValidationMessage For="@(() => _createModel.Password)" class="text-[var(--rose)] text-[10px] mt-0.5" />
                    </div>

                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Kota Sınırı (MB)</label>
                        <InputNumber @bind-Value="_createModel.QuotaMb" min="100" max="10240"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]" />
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-4 border-t border-[var(--line)] mt-4">
                    <button type="button" @onclick="() => _createModalVisible = false" class="btn-secondary py-2 px-4 text-xs">İptal</button>
                    <button type="submit" disabled="@_isProcessing" class="btn-primary py-2 px-4 text-xs flex items-center gap-1.5">
                        @if (_isProcessing)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                            <span>Oluşturuluyor...</span>
                        }
                        else
                        {
                            <span>Oluştur</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Düzenleme Modalı -->
@if (_editModalVisible)
{
    <div class="fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
        <div class="modal-dialog w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                <h3 class="text-base font-serif font-semibold text-[var(--navy)] flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-[var(--azure)]"></i> Düzenle: <span class="font-mono text-xs">@_editModel.EmailAddress</span>
                </h3>
                <button @onclick="() => _editModalVisible = false" class="btn-ghost p-1 text-[var(--ink-soft)]">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <EditForm Model="@_editModel" OnValidSubmit="HandleEdit">
                <DataAnnotationsValidator />
                
                <div class="space-y-3.5 text-xs">
                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Görünen Ad</label>
                        <InputText @bind-Value="_editModel.DisplayName"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] focus:outline-none focus:border-[var(--azure)]" />
                    </div>

                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Kota Sınırı (MB)</label>
                        <InputNumber @bind-Value="_editModel.QuotaMb" min="100" max="10240"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]" />
                    </div>

                    <div class="p-3 bg-[var(--cream)] border border-[var(--line)] rounded-xl space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-semibold text-[var(--navy)]">Yönlendirme Aktif</span>
                            <input type="checkbox" @bind="_editModel.ForwardingEnabled" class="w-4 h-4 rounded text-[var(--azure)]" />
                        </div>
                        @if (_editModel.ForwardingEnabled)
                        {
                            <div>
                                <label class="block text-[10px] text-[var(--ink-soft)] font-semibold mb-1">Yönlendirilecek E-Posta</label>
                                <InputText @bind-Value="_editModel.ForwardingAddress" placeholder="hedef@domain.com"
                                    class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2 text-xs text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]" />
                            </div>
                        }
                        <p class="text-[10px] text-[var(--ink-soft)]">Bu hesaba gelen tüm postalar arka planda girilen adrese iletilir.</p>
                    </div>

                    <div>
                        <label class="block text-[var(--ink-soft)] font-semibold mb-1">Yeni Şifre</label>
                        <InputText @bind-Value="_editModel.NewPassword" type="password" placeholder="Değiştirmek istemiyorsanız boş bırakın"
                            class="w-full bg-[var(--paper)] border border-[var(--line)] rounded-lg p-2.5 text-[var(--ink)] font-mono focus:outline-none focus:border-[var(--azure)]" />
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-4 border-t border-[var(--line)] mt-4">
                    <button type="button" @onclick="() => _editModalVisible = false" class="btn-secondary py-2 px-4 text-xs">İptal</button>
                    <button type="submit" disabled="@_isProcessing" class="btn-primary py-2 px-4 text-xs flex items-center gap-1.5">
                        @if (_isProcessing)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                            <span>Kaydediliyor...</span>
                        }
                        else
                        {
                            <span>Kaydet</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}


@code {
    private List<MailAccountDto> _accounts = new();
    private SmtpSettingsDto _smtpSettings = new();
    
    private bool _isLoading = true;
    private bool _createModalVisible = false;
    private bool _editModalVisible = false;
    private bool _isProcessing = false;
    
    private readonly CreateMailModel _createModel = new();
    private readonly UpdateMailModel _editModel = new();
    private Guid _editingAccountId;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var rawAccounts = await Http.GetFromJsonAsync<List<MailAccountDto>>("api/mail");
            _accounts = rawAccounts ?? new List<MailAccountDto>();

            var smtp = await Http.GetFromJsonAsync<SmtpSettingsDto>("api/settings/smtp");
            if (smtp != null) _smtpSettings = smtp;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Veriler çekilirken hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _createModel.EmailAddress = "";
        _createModel.DisplayName = "";
        _createModel.Password = "";
        _createModel.QuotaMb = 1024;
        _createModalVisible = true;
    }

    private async Task HandleCreate()
    {
        _isProcessing = true;
        try
        {
            var apiPayload = new
            {
                EmailAddress = _createModel.EmailAddress,
                DisplayName = _createModel.DisplayName,
                Password = _createModel.Password,
                QuotaBytes = (long)_createModel.QuotaMb * 1048576
            };

            var response = await Http.PostAsJsonAsync("api/mail", apiPayload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Hesap oluşturuldu!", Severity.Success);
                _createModalVisible = false;
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Hata: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void OpenEditModal(MailAccountDto account)
    {
        _editingAccountId = account.Id;
        _editModel.EmailAddress = account.EmailAddress;
        _editModel.DisplayName = account.DisplayName;
        _editModel.QuotaMb = (int)(account.QuotaBytes / 1048576);
        _editModel.ForwardingEnabled = account.ForwardingEnabled;
        _editModel.ForwardingAddress = account.ForwardingAddress;
        _editModel.NewPassword = "";
        _editModalVisible = true;
    }

    private async Task HandleEdit()
    {
        _isProcessing = true;
        try
        {
            var apiPayload = new
            {
                DisplayName = _editModel.DisplayName,
                QuotaBytes = (long)_editModel.QuotaMb * 1048576,
                ForwardingEnabled = _editModel.ForwardingEnabled,
                ForwardingAddress = _editModel.ForwardingAddress,
                NewPassword = _editModel.NewPassword
            };

            var response = await Http.PutAsJsonAsync($"api/mail/{_editingAccountId}", apiPayload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ayarlar kaydedildi!", Severity.Success);
                _editModalVisible = false;
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Hata: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task DeleteAccount(MailAccountDto item)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/mail/{item.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Hesap silindi.", Severity.Success);
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveSmtpSettings()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/settings/smtp", _smtpSettings);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("SMTP Ayarları Kaydedildi", Severity.Success);
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task TestSmtpConnection()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/settings/smtp/test", _smtpSettings);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Bağlantı Başarılı!", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Test Başarısız: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    public class MailAccountDto
    {
        public Guid Id { get; set; }
        public string EmailAddress { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public long QuotaBytes { get; set; }
        public string? ForwardingAddress { get; set; }
        public bool ForwardingEnabled { get; set; }
    }

    public class CreateMailModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Zorunlu")]
        public string EmailAddress { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Zorunlu")]
        public string Password { get; set; } = string.Empty;
        public int QuotaMb { get; set; } = 1024;
    }

    public class UpdateMailModel
    {
        public string EmailAddress { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public int QuotaMb { get; set; } = 1024;
        public bool ForwardingEnabled { get; set; }
        public string? ForwardingAddress { get; set; }
        public string? NewPassword { get; set; }
    }

    public class SmtpSettingsDto
    {
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; } = 587;
        public bool EnableSsl { get; set; } = true;
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool IsEnabled { get; set; } = false;
        public bool HasPassword { get; set; } = false;
        public bool AcceptSelfSignedCert { get; set; } = false;
    }
}
