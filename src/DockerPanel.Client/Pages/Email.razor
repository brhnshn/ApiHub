@page "/email"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject PlatformInfo PlatformInfo

<PageTitle>E-Posta Yönetimi - ApiHub</PageTitle>



<div class="mb-6">
    <MudText Typo="Typo.h4" Style="font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--text-main); letter-spacing: 0.5px;">E-Posta Sunucusu Yönetimi</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">docker-mailserver kurumsal posta sunucusu altyapısı üzerindeki e-posta hesaplarını ve kotalarını yönetin.</MudText>
</div>

<MudGrid Class="mb-6">
    <!-- E-Posta İstemci Bilgileri Kartı -->
    <MudItem xs="12" md="4">
        <div class="glass-panel pa-6 h-100 d-flex flex-column justify-between" style="border-radius: 12px !important;">
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--text-main); font-family: 'Outfit', sans-serif;" Class="mb-4">E-Posta İstemci Bilgileri</MudText>
                
                <div class="mb-4">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; display: block; margin-bottom: 4px;">IMAP (Gelen Posta)</span>
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--text-main); background: var(--bg-sub); padding: 8px; border-radius: 6px; border: 1px solid var(--border-color);">
                        Host: mail.burhansahin.com.tr<br>
                        Port: 993 (SSL/TLS)
                    </div>
                </div>

                <div class="mb-4">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; display: block; margin-bottom: 4px;">SMTP (Giden Posta)</span>
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--text-main); background: var(--bg-sub); padding: 8px; border-radius: 6px; border: 1px solid var(--border-color);">
                        Host: mail.burhansahin.com.tr<br>
                        Port: 587 (STARTTLS)
                    </div>
                </div>
            </div>

            <div class="pt-4" style="border-top: 1px solid rgba(255,255,255,0.05); font-size: 11px; color: #64748b; font-style: italic;">
                * Outlook, Thunderbird veya mobil cihazlarınıza posta kurulumu yaparken yukarıdaki parametreleri ve hesap şifrenizi kullanın.
            </div>
        </div>
    </MudItem>

    <!-- Kayıtlı E-Postalar Tablosu -->
    <MudItem xs="12" md="8">
        <div class="glass-panel pa-6 h-100" style="border-radius: 12px !important;">
            <div class="d-flex align-center justify-between mb-6">
                <MudText Typo="Typo.h6" Style="font-family: 'Outfit', sans-serif; font-weight: 700; color: var(--text-main);">Aktif E-Posta Hesapları</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateModal" Style="text-transform: none; border-radius: 8px;">Yeni E-Posta Ekle</MudButton>
            </div>

            @if (_isLoading)
            {
                <div class="d-flex align-center justify-center py-6">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else
            {
                <MudTable Items="_accounts" Elevation="0" Hover="true" Breakpoint="Breakpoint.Sm" Class="glass-panel" Style="border: none !important;">
                    <HeaderContent>
                        <MudTh Style="color: #94a3b8; font-weight: 700;">E-Posta Adresi</MudTh>
                        <MudTh Style="color: #94a3b8; font-weight: 700;">Posta Kutusu Kotası</MudTh>
                        <MudTh Style="color: #94a3b8; font-weight: 700;">Güvenlik & Spam</MudTh>
                        <MudTh Style="color: #94a3b8; font-weight: 700; text-align: right;">İşlemler</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="E-Posta Adresi">
                            <span style="font-family: 'JetBrains Mono', monospace; color: #10b981; font-weight: 700;">@context.EmailAddress</span>
                        </MudTd>
                        <MudTd DataLabel="Posta Kutusu Kotası">
                            <div style="width: 150px;">
                                <div class="d-flex justify-between" style="font-size: 11px; margin-bottom: 2px;">
                                    <span style="color: #64748b;">Kullanılan: %0.0</span>
                                    <span style="color: var(--text-main);">@(context.QuotaBytes / 1048576) MB</span>
                                </div>
                                <MudProgressLinear Color="Color.Primary" Value="0" Class="rounded-pill" Style="height: 4px;" />
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Güvenlik & Spam">
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Icon="@Icons.Material.Filled.Security" Variant="Variant.Text">
                                SpamAssassin Aktif
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="İşlemler" Style="text-align: right;">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAccount(context))" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Class="text-center py-6 mud-text-secondary">Henüz açılmış bir kurumsal e-posta hesabı bulunmamaktadır.</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </div>
    </MudItem>
</MudGrid>

<!-- Yeni Hesap Ekleme Modalı -->
<MudDialog @bind-Visible="_createModalVisible">
    <TitleContent>
        <MudText Typo="Typo.h5" Style="font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--text-main);">Yeni E-Posta Hesabı Ekle</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_createModel" OnValidSubmit="HandleCreate">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #94a3b8; margin-bottom: 8px;">E-Posta Adresi</label>
                <MudTextField @bind-Value="_createModel.EmailAddress" Placeholder="örn: info@alanadi.com" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _createModel.EmailAddress)" />
            </div>

            <div class="mb-4">
                <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #94a3b8; margin-bottom: 8px;">Hesap Şifresi</label>
                <MudTextField @bind-Value="_createModel.Password" Placeholder="Hesap güvenli şifresi" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _createModel.Password)" />
            </div>

            <div class="mb-6">
                <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #94a3b8; margin-bottom: 8px;">Kota Sınırı (MB)</label>
                <MudNumericField T="int" @bind-Value="_createModel.QuotaMb" Min="100" Max="10240" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>

            <div class="d-flex justify-end gap-2">
                <MudButton OnClick="CloseCreateModal" Variant="Variant.Outlined" Color="Color.Secondary" Style="text-transform: none;">İptal</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_isCreating" Style="text-transform: none; font-weight: 700;">
                    @if (_isCreating)
                    {
                        <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Posta Kutusu Yaratılıyor...</span>
                    }
                    else
                    {
                        <span>Hesabı Oluştur</span>
                    }
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    private List<MailAccountDto> _accounts = new();
    private bool _isLoading = true;
    private bool _createModalVisible = false;
    private bool _isCreating = false;
    private readonly CreateMailModel _createModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        try
        {
            var raw = await Http.GetFromJsonAsync<List<MailAccountDto>>("api/mail");
            _accounts = raw ?? new List<MailAccountDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"E-posta hesapları çekilirken hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _createModel.EmailAddress = "";
        _createModel.Password = "";
        _createModel.QuotaMb = 1024;
        _createModalVisible = true;
    }

    private void CloseCreateModal()
    {
        _createModalVisible = false;
    }

    private async Task HandleCreate()
    {
        _isCreating = true;
        try
        {
            var apiPayload = new
            {
                EmailAddress = _createModel.EmailAddress,
                Password = _createModel.Password,
                QuotaBytes = (long)_createModel.QuotaMb * 1048576 // MB to Bytes
            };

            var response = await Http.PostAsJsonAsync("api/mail", apiPayload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("E-posta hesabı docker-mailserver üzerinde başarıyla oluşturuldu!", Severity.Success);
                _createModalVisible = false;
                await LoadAccountsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Hesap oluşturulamadı: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task DeleteAccount(MailAccountDto item)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/mail/{item.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("E-posta hesabı ve posta kutusu dizinleri başarıyla yok edildi.", Severity.Success);
                await LoadAccountsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Hesap silinemedi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    // DTO Sınıfları
    public class MailAccountDto
    {
        public Guid Id { get; set; }
        public string EmailAddress { get; set; } = string.Empty;
        public long QuotaBytes { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    // Form Model Tanımları
    public class CreateMailModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-posta adresi zorunludur!")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Geçerli bir e-posta formatı girin.")]
        public string EmailAddress { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Hesap şifresi zorunludur!")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Şifre en az 6 karakter olmalıdır.")]
        public string Password { get; set; } = string.Empty;

        public int QuotaMb { get; set; } = 1024;
    }
}
