    private async Task HandleRetryConnection()
    {
        if (_isRetryingConnection) return;
        _isRetryingConnection = true;
        StateHasChanged();
        
        try
        {
            await AppState.ForceReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Yeniden bağlantı denemesi başarısız oldu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRetryingConnection = false;
            StateHasChanged();
        }
    }

    private async Task HandleSaveAndReconnect()
