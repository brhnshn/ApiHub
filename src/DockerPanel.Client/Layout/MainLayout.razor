                        @Body
                    </div>
                </main>
            </div>
        }

        @if (_hasUpdate)
        {
            <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-[9999999] flex items-center justify-center p-4 animate-fade-in">
                <div class="glass max-w-sm w-full rounded-2xl bg-[#171a21]/95 border border-white/10 p-6 text-[#e1e2ec] shadow-2xl relative space-y-4" style="border-radius: 16px;">
                    <div class="flex items-center gap-3">
                        <div class="p-3 bg-[#006c49]/10 rounded-xl text-[#006c49] flex-shrink-0" style="border-radius: 12px;">
                            <span class="material-symbols-outlined text-2xl animate-pulse">auto_awesome</span>
                        </div>
                        <div class="text-left">
                            <h3 class="text-base font-extrabold text-white" style="margin: 0;">Yenilikler Hazır!</h3>
                            <p class="text-[10px] text-gray-400" style="margin: 2px 0 0 0;">Yeni Sürüm Mevcut: v@_serverVersion</p>
                        </div>
                    </div>

                    <div class="border-t border-white/5 pt-3">
                        <p class="text-[10px] font-bold text-gray-400 tracking-wider uppercase mb-1.5" style="text-align: left;">Neler Değişti?</p>
                        <div class="bg-white/5 border border-white/5 p-3 rounded-lg max-h-32 overflow-y-auto webmail-scroll font-mono text-[10.5px] leading-relaxed text-gray-300 text-left" style="white-space: pre-wrap; word-break: break-all; border-radius: 8px;">
                            @_changelog
                        </div>
                    </div>

                    <div class="flex gap-2 pt-2">
                        <button @onclick='() => _hasUpdate = false' disabled="@_downloadingUpdate"
                                class="flex-1 text-xs font-bold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 py-2 rounded-xl transition-all" style="border-radius: 8px;">
                            Sonra Hatırlat
                        </button>
                        <button @onclick="StartUpdateAsync" disabled="@_downloadingUpdate"
                                class="flex-1 text-xs font-bold text-white bg-[#006c49] hover:bg-[#006c49]/90 py-2 rounded-xl transition-all shadow-lg shadow-[#006c49]/20 flex items-center justify-center gap-2" style="border-radius: 8px;">
                            @if (_downloadingUpdate)
                            {
                                <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                <span>İndiriliyor...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-sm">download</span>
                                <span>Güncelle</span>
                            }
