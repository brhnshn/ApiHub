    private bool _showPasscodeScreen = false;
    private string _appPinCode = "";
    private string _enteredPin = "";
    private string _passcodeError = "";
    private bool _biometricEnabled = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (PlatformInfo.IsMobileApp)
            {
                try
                {
                    var dotNetHelper = DotNetObjectReference.Create(this);
                    await JSRuntime.InvokeVoidAsync("window.setupPullToRefresh", dotNetHelper);
                }
                catch {}
            }

            // Check passcode lock status
            try
            {
                var pinEnabledVal = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "app_pin_enabled");
                if (pinEnabledVal == "true")
                {
                    var pinCode = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "app_pin_code");
                    if (!string.IsNullOrEmpty(pinCode))
                    {
                        _appPinCode = pinCode;
                        _showPasscodeScreen = true;
                        
                        var bioEnabledVal = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "app_biometric_enabled");
                        _biometricEnabled = bioEnabledVal == "true";
                        
                        StateHasChanged();
                        
                        if (_biometricEnabled)
                        {
                            _ = TriggerBiometricAuthAsync();
                        }
                    }
                }
            }
            catch {}
        }
    }

    private async Task AppendDigit(string digit)
    {
        if (_enteredPin.Length < 4)
        {
            _enteredPin += digit;
            _passcodeError = "";
            StateHasChanged();

            if (_enteredPin.Length == 4)
            {
                await Task.Delay(150); // Small delay to let user see dot fill
                if (_enteredPin == _appPinCode)
                {
                    _showPasscodeScreen = false;
                    _enteredPin = "";
                    Snackbar.Add("Giriş Başarılı!", Severity.Success);
                }
                else
                {
                    _enteredPin = "";
                    _passcodeError = "Hatalı PIN Kodu! Tekrar Deneyin.";
                }
                StateHasChanged();
            }
        }
    }

    private void RemoveLastDigit()
    {
        if (_enteredPin.Length > 0)
        {
            _enteredPin = _enteredPin.Substring(0, _enteredPin.Length - 1);
            _passcodeError = "";
            StateHasChanged();
        }
    }

    private async Task TriggerBiometricAuthAsync()
    {
        if (PlatformInfo.AuthenticateBiometricFunc != null)
        {
            var success = await PlatformInfo.AuthenticateBiometricFunc.Invoke("Girişinizi onaylamak için biyometrik doğrulama kullanın.");
            if (success)
            {
                _showPasscodeScreen = false;
                _enteredPin = "";
                _passcodeError = "";
                await InvokeAsync(StateHasChanged);
                Snackbar.Add("Biyometrik Doğrulama Başarılı!", Severity.Success);
            }
            else
            {
                _passcodeError = "Biyometrik doğrulama başarısız veya iptal edildi.";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public async Task TriggerPullToRefresh()
    {
        try
        {
            await AppState.TriggerPullToRefreshAsync();
        }
        catch {}
    }

    protected override async Task OnInitializedAsync()
    {
        _lastSignalRConnected = AppState.IsSignalRConnected;
        AppState.OnStateChanged += HandleAppStateChanged;
        DeepLinkService.OnDeepLinkReceived += HandleDeepLinkReceived;

        // Process pending deep link from App Shortcuts (Cold Start fix)
        if (!string.IsNullOrEmpty(DeepLinkService.PendingDeepLinkPath))
        {
            var path = DeepLinkService.PendingDeepLinkPath;
            DeepLinkService.PendingDeepLinkPath = null;
            HandleDeepLinkReceived(path);
        }

        // Cihaz algılaması MAUI Hybrid App tarafından DI ile enjekte edilir. Web panelinde responsive masaüstü görünümü korunur.

        // Mobil uygulamada her durumda sunucu bağlantısını doğrula (ki bağlantı yoksa hata ekranı gelsin)
        if (PlatformInfo.IsMobileApp)
        {
            _ = AppState.InitializeAsync();
            
            // Editör URL'sini yükle
            if (PlatformInfo.GetServerUrlFunc != null)
            {
                _ = Task.Run(async () =>
                {
                    _editServerUrl = await PlatformInfo.GetServerUrlFunc();
                    await InvokeAsync(StateHasChanged);
                });
            }
        }

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // Eşzamanlı global ön-yüklemeyi (pre-fetching) başlat
            if (!PlatformInfo.IsMobileApp)
            {
                _ = AppState.InitializeAsync();
            }
            _ = LoadSidebarStats();
            // Mobil bildirim sayacını yükle ve her 30sn yenile
            if (PlatformInfo.IsMobileApp)
            {
                _ = LoadNotifUnreadCount();
                _notifRefreshTimer = new System.Threading.Timer(
                    async _ => { await LoadNotifUnreadCount(); },
                    null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
            }
        }
        else
        {
            // Oturum açılmamışsa, yükleme ekranını derhal kaldır (ki giriş sayfası görünebilsin)
            try
            {
                await JSRuntime.InvokeVoidAsync("window.hideLoader");
            }
            catch {}
        }

        if (PlatformInfo.IsMobileApp)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(3000); // Smooth delay
                    var response = await Http.GetFromJsonAsync<VersionResponse>("api/downloads/version");
                    if (response?.ApkAvailable == true &&
                        Version.TryParse(response.Version, out var serverVer) &&
                        Version.TryParse(PlatformInfo.LocalVersion, out var localVer))
                    {
                        if (serverVer > localVer)
                        {
                            _serverVersion = response.Version;
                            _changelog = response.Changelog ?? "Hata düzeltmeleri ve iyileştirmeler.";
                            _hasUpdate = true;
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                }
                catch {}
            });
        }

        // Start metric simulation loop
        _simTimer = new System.Threading.Timer((state) =>
        {
            InvokeAsync(() =>
            {
                var rand = new Random();
                _topCpu = Math.Round(8.0 + rand.NextDouble() * 12.0, 1);
                _topRam = Math.Round(35.0 + rand.NextDouble() * 8.0, 1);
                StateHasChanged();
            });
        }, null, 0, 3000);

    }

    private void HandleAppStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await InvokeAsync(StateHasChanged);

            if (AppState.IsSignalRConnected == _lastSignalRConnected)
            {
                return;
            }

            _lastSignalRConnected = AppState.IsSignalRConnected;
            var version = ++_signalRBannerVersion;

            if (AppState.IsSignalRConnected)
            {
                if (!_hasConnectedOnce)
                {
                    _hasConnectedOnce = true;
                    return;
                }

                _signalRBannerSeverity = "success";
                _signalRBannerText = "Baglanti yeniden kuruldu";
                _showSignalRBanner = true;
                Snackbar.Add("Baglanti yeniden kuruldu", Severity.Success);
                StateHasChanged();

                await Task.Delay(2500);
                if (version == _signalRBannerVersion)
                {
                    _showSignalRBanner = false;
                    StateHasChanged();
                }
            }
            else
            {
                _signalRBannerSeverity = "warning";
                _signalRBannerText = "Canli veri baglantisi kesildi, yeniden baglaniliyor...";
                _showSignalRBanner = true;
                Snackbar.Add("Canli veri baglantisi kesildi, yeniden baglaniliyor...", Severity.Warning);
                StateHasChanged();
            }
        });
    }

    private async Task LoadSidebarStats()
    {
        try
        {
            using var cts = new System.Threading.CancellationTokenSource(3500);

            var containersTask = Http.GetFromJsonAsync<List<ContainerDto>>("api/projects", cts.Token);
            var mailAccountsTask = Http.GetFromJsonAsync<List<MailAccountDto>>("api/mail", cts.Token);

            await Task.WhenAll(containersTask, mailAccountsTask);

            var containers = await containersTask;
            _containerCount = containers?.Count ?? 0;

            var mailAccounts = await mailAccountsTask;
            _unreadMailCount = 0;

            var unreadTasks = (mailAccounts ?? new List<MailAccountDto>())
                .Take(10)
                .Select(LoadUnreadCountAsync)
                .ToList();

            var unreadCounts = await Task.WhenAll(unreadTasks);
            _unreadMailCount = unreadCounts.Sum();

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _containerCount = 0;
            _unreadMailCount = 0;
        }
    }

    private async Task<int> LoadUnreadCountAsync(MailAccountDto account)
    {
        try
        {
            using var ctsMail = new System.Threading.CancellationTokenSource(2500);
            var mails = await Http.GetFromJsonAsync<List<MailItemDto>>($"api/mail/{Uri.EscapeDataString(account.EmailAddress)}/emails?folder=inbox&take=50", ctsMail.Token);
            return mails?.Count(m => !m.IsRead) ?? 0;
        }
        catch
        {
            // Ignore mailbox-level read errors; the email page will show the detailed failure.
            return 0;
        }
    }

    private void ToggleDesktopSidebar()
    {
        _desktopSidebarOpen = !_desktopSidebarOpen;
    }

    private void ToggleMobileSidebar()
    {
        _mobileSidebarOpen = !_mobileSidebarOpen;
    }

    private void CloseMobileSidebar()
    {
        _mobileSidebarOpen = false;
    }

    private async Task HandleLogout()
    {
        if (_simTimer != null)
        {
            await _simTimer.DisposeAsync();
        }
        AppState.Reset();
        await AuthProvider.LogoutAsync();
        NavigationManager.NavigateTo("/login", replace: true);
    }

    private void HandleDeepLinkReceived(string path)
    {
        InvokeAsync(() =>
        {
            try
            {
                NavigationManager.NavigateTo(path);
                Snackbar.Add($"Sayfaya yönlendiriliyor: {path}", Severity.Info);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Deep link yönlendirme hatası: {ex.Message}", Severity.Error);
            }
        });
    }

    private async Task LoadNotifUnreadCount()
    {
        try
        {
            using var cts = new System.Threading.CancellationTokenSource(3000);
            var result = await Http.GetFromJsonAsync<UnreadCountDto>("api/notifications/unread-count", cts.Token);
            if (result != null && result.Count != AppState.NotificationUnreadCount)
            {
                AppState.UpdateNotificationUnreadCount(result.Count);
            }
        }
        catch { /* Sessizce geç — sayaç kritik değil */ }
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= HandleAppStateChanged;
        DeepLinkService.OnDeepLinkReceived -= HandleDeepLinkReceived;
        _simTimer?.Dispose();
        _notifRefreshTimer?.Dispose();
    }

    // Lightweight inline DTO for container query
    private class ContainerDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    private class MailAccountDto
    {
        public string EmailAddress { get; set; } = string.Empty;
    }

    private class MailItemDto
    {
        public bool IsRead { get; set; }
    }

    private class UnreadCountDto
    {
        public int Count { get; set; }
    }
}
