    {
        if (_checkingUpdates) return;
        _checkingUpdates = true;
        StateHasChanged();

        try
        {
            await Task.Delay(800); // Premium micro-interaction feel
            
            var result = await JSRuntime.InvokeAsync<string>("checkForPwaUpdates");
            if (result == "updated")
            {
                Snackbar.Add("Yeni güncelleme uygulandı! Sayfa yenileniyor...", Severity.Success);
                await Task.Delay(800);
                await JSRuntime.InvokeVoidAsync("location.reload");
            }
            else if (result == "installing")
            {
                Snackbar.Add("Yeni sürüm indiriliyor... Lütfen bekleyin.", Severity.Info);
            }
            else if (result == "up-to-date")
            {
                Snackbar.Add("Uygulama zaten en son sürümde (v2.0).", Severity.Success);
            }
            else if (result == "no-sw")
            {
                Snackbar.Add("Hızlı önbellek aktif değil. Sayfayı yenileyerek deneyebilirsiniz.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("Güncelleme bu tarayıcıda desteklenmiyor veya sunucuya erişilemiyor.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
