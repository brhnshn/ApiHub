@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject JwtAuthenticationStateProvider AuthProvider
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject AppState AppState
@inject DockerPanel.Client.Services.DeepLinkService DeepLinkService
@inject PlatformInfo PlatformInfo
@implements IDisposable

<style>
    :root {
        --bg-sub: #ffffff;
        --border-color: #e2e8f0;
        --accent-indigo: #006c49;
        --text-secondary: #64748b;
    }

    a.active-link {
        background-color: rgba(0, 108, 73, 0.12) !important;
        color: var(--accent-indigo) !important;
        border-left: 4px solid var(--accent-indigo) !important;
        border-radius: 0 8px 8px 0 !important;
    }

    /* Siber-Hibrit Sidebar Base */
    .cyber-sidebar {
        background-color: var(--bg-sub) !important;
        border-right: 1px solid var(--border-color) !important;
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-right 0.3s ease !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
        height: 100vh !important;
        z-index: 50 !important;
        position: fixed !important;
        top: 0 !important;
        bottom: 0 !important;
        left: 0 !important;
        overflow-x: hidden !important;
    }

    /* Mobile state */
    .cyber-sidebar.mobile-open {
        width: 256px !important;
        transform: translateX(0) !important;
    }
    .cyber-sidebar.mobile-closed {
        width: 256px !important;
        transform: translateX(-100%) !important;
    }

    /* Desktop View Overrides (md: >= 768px) */
    @@media (min-width: 768px) {
        .cyber-sidebar {
            position: relative !important;
            height: 100% !important;
        }
        .cyber-sidebar.desktop-open {
            width: 256px !important;
            transform: translateX(0) !important;
            border-right: 1px solid var(--border-color) !important;
        }
        .cyber-sidebar.desktop-closed {
            width: 0px !important;
            transform: translateX(0) !important;
            border-right: 0px solid transparent !important;
        }
    }

    /* Logo Container styling */
    .cyber-logo-container {
        padding: 1.25rem 1rem !important;
        border-bottom: 1px solid var(--border-color) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 0.5rem !important;
        transition: all 0.3s ease !important;
    }
    @@media (min-width: 768px) {
        .cyber-sidebar.desktop-closed .cyber-logo-container {
            justify-content: center !important;
            padding: 1.25rem 0.5rem !important;
        }
    }

    /* NavLinks custom stylesheet to prevent dynamic tailwind compilation issues */
    .cyber-navlink {
        width: 100% !important;
        display: flex !important;
        align-items: center !important;
        border-radius: 0.5rem !important;
        font-size: 0.79rem !important;
        font-weight: 600 !important;
        color: var(--text-secondary) !important;
        transition: all 0.2s ease-in-out !important;
        border: 1px solid transparent !important;
        padding: 0.5rem 0.7rem !important;
        gap: 0.6rem !important;
        justify-content: flex-start !important;
        text-decoration: none !important;
    }
    .cyber-navlink:hover {
        background-color: rgba(0, 108, 73, 0.08) !important;
        color: var(--accent-indigo) !important;
    }
    @@media (min-width: 768px) {
        .cyber-sidebar.desktop-closed .cyber-navlink {
            padding: 0.65rem !important;
            justify-content: center !important;
            gap: 0 !important;
        }
    }

    /* Profile / Footer Box */
    .cyber-profile-box {
        padding: 1rem !important;
        border-top: 1px solid var(--border-color) !important;
        background-color: rgba(0, 108, 73, 0.02) !important;
        transition: all 0.3s ease !important;
    }

    .signalr-status-banner {
        position: sticky;
        top: 0;
        z-index: 35;
        padding: 0.55rem 1rem;
        font-size: 0.82rem;
        font-weight: 800;
        text-align: center;
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        animation: signalr-slide 0.22s ease-out;
    }

    .signalr-status-banner.warning {
        background: #fef3c7;
        color: #92400e;
    }

    .signalr-status-banner.success {
        background: #d1fae5;
        color: #065f46;
    }

    @@keyframes signalr-slide {
        from { transform: translateY(-100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .cyber-profile-flex {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        width: 100% !important;
    }

    @@media (min-width: 768px) {
        .cyber-sidebar.desktop-closed .cyber-profile-box {
            padding: 0.75rem 0.5rem !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .cyber-sidebar.desktop-closed .cyber-profile-flex {
            justify-content: center !important;
            width: auto !important;
            gap: 0 !important;
        }
    }

    /* Element visibility control for responsive collapsing */
    .cyber-logo-text,
    .cyber-nav-text,
    .cyber-profile-details,
    .cyber-ip-details {
        display: block !important;
        opacity: 1;
        transition: opacity 0.2s ease, visibility 0.2s ease !important;
    }

    .cyber-nav-text {
        display: inline-block !important;
    }

    .cyber-close-btn {
        display: none !important;
    }

    .cyber-logout-btn-full {
        display: block !important;
    }

    .cyber-logout-btn-collapsed {
        display: none !important;
    }

    /* Desktop Collapsed View (md: >= 768px and sidebar is .desktop-closed) */
    @@media (min-width: 768px) {
        .cyber-sidebar.desktop-closed .cyber-logo-text,
        .cyber-sidebar.desktop-closed .cyber-nav-text,
        .cyber-sidebar.desktop-closed .cyber-nav-badge,
        .cyber-sidebar.desktop-closed .cyber-profile-details,
        .cyber-sidebar.desktop-closed .cyber-ip-details,
        .cyber-sidebar.desktop-closed .cyber-logout-btn-full {
            display: none !important;
            opacity: 0 !important;
            visibility: hidden !important;
        }

        .cyber-sidebar.desktop-closed .cyber-logout-btn-collapsed {
            display: block !important;
        }
    }

    /* Mobile View Overrides */
    @@media (max-width: 767px) {
        .cyber-logout-btn-collapsed {
            display: none !important;
        }
        .cyber-close-btn {
            display: block !important;
        }
    }
</style>

@if (_showSpotlightSearch)
{
    <div class="fixed inset-0 bg-[#07090d]/80 backdrop-blur-md z-[9999999] transition-opacity animate-fade-in" @onclick="CloseSpotlightSearch"></div>
    <div class="fixed top-16 left-4 right-4 max-w-md mx-auto bg-[#10131a]/95 border border-white/10 rounded-2xl p-4 z-[9999999] flex flex-col shadow-2xl space-y-4 text-white" @onclick:stopPropagation>
        <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3 text-slate-400">search</span>
            <input @ref="_searchInput"
                   class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-10 py-2.5 text-xs text-white focus:outline-none focus:border-[#4edea3] focus:ring-1 focus:ring-[#4edea3]/30 transition-all font-medium outline-none"
                   placeholder="Ara: konteyner, sayfa, veri tabanı..."
                   @bind="_spotlightQuery"
                   @bind:event="oninput" />
            <button @onclick="CloseSpotlightSearch" class="absolute right-3 text-slate-400 hover:text-white transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>

        <div class="flex-grow overflow-y-auto max-h-[300px] space-y-1.5 pr-1.5 webmail-scroll">
            @if (GetSpotlightResults().Any())
            {
                @foreach (var result in GetSpotlightResults())
                {
                    <button @onclick="() => NavigateToSearchResult(result.Url)" class="w-full text-left p-2.5 hover:bg-[#4edea3]/10 hover:text-[#4edea3] rounded-xl flex items-center gap-3 transition-colors border border-transparent hover:border-[#4edea3]/20">
                        <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-slate-400">
                            <span class="material-symbols-outlined text-sm">@result.Icon</span>
                        </div>
                        <div class="flex-1">
                            <p class="text-xs font-bold leading-tight">@result.Title</p>
                            <p class="text-[9px] text-slate-500 font-medium">@result.Category</p>
                        </div>
                        <span class="material-symbols-outlined text-xs text-slate-600">chevron_right</span>
                    </button>
                }
            }
            else
            {
                <div class="text-center py-6 text-slate-500 text-xs font-semibold">
                    <span class="material-symbols-outlined text-2xl mb-1 block">search_off</span>
                    Arama sonucu bulunamadı
                </div>
            }
        </div>
    </div>
}

@if (_showPasscodeScreen)
{
    <div class="fixed inset-0 bg-[#07090d]/98 backdrop-blur-2xl z-[9999999] flex flex-col items-center justify-center p-4 font-sans select-none" style="background-image: radial-gradient(circle at center, #10141f 0%, #05070a 100%);">
        <!-- Shield Lock Icon -->
        <div class="mb-6 flex flex-col items-center">
            <div class="w-16 h-16 rounded-full bg-[#006c49]/15 border border-[#006c49]/30 flex items-center justify-center text-[#4edea3] mb-4 shadow-lg shadow-[#006c49]/10">
                <span class="material-symbols-outlined text-3xl">security</span>
            </div>
            <h3 class="text-lg font-black text-white tracking-wide">ApiHub Güvenlik Kilidi</h3>
            <p class="text-[11px] text-slate-400 mt-1 font-medium">Uygulamaya erişmek için PIN kodunu girin</p>
        </div>

        <!-- Dot Indicators -->
        <div class="flex gap-4 mb-10">
            @for (int i = 0; i < 4; i++)
            {
                <div class='@($"w-3.5 h-3.5 rounded-full border-2 transition-all duration-150 {(i < _enteredPin.Length ? "bg-[#4edea3] border-[#4edea3] scale-110 shadow-[0_0_8px_#4edea3]" : "border-slate-600 bg-transparent")}")'></div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_passcodeError))
        {
            <p class="text-rose-400 text-xs font-bold mb-6 animate-pulse">@_passcodeError</p>
        }

        <!-- Virtual Keypad Grid (3x4) -->
        <div class="grid grid-cols-3 gap-y-4 gap-x-8 max-w-[280px] w-full">
            @for (int i = 1; i <= 9; i++)
            {
                var num = i.ToString();
                <button @onclick="() => AppendDigit(num)" class="w-16 h-16 rounded-full bg-white/5 border border-white/5 text-xl font-bold text-white hover:bg-white/10 active:scale-95 transition-all flex items-center justify-center">@num</button>
            }
            <!-- Row 4: Biometrics, 0, Backspace -->
            @if (PlatformInfo.IsMobileApp && _biometricEnabled)
            {
                <button @onclick="TriggerBiometricAuthAsync" class="w-16 h-16 rounded-full bg-[#006c49]/20 border border-[#006c49]/30 text-[#4edea3] hover:bg-[#006c49]/30 active:scale-95 transition-all flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">fingerprint</span>
                </button>
            }
            else
            {
                <div></div>
            }
            <button @onclick='() => AppendDigit("0")' class="w-16 h-16 rounded-full bg-white/5 border border-white/5 text-xl font-bold text-white hover:bg-white/10 active:scale-95 transition-all flex items-center justify-center">0</button>
            <button @onclick="RemoveLastDigit" class="w-16 h-16 rounded-full bg-white/5 border border-white/5 text-white hover:bg-white/10 active:scale-95 transition-all flex items-center justify-center">
                <span class="material-symbols-outlined text-xl">backspace</span>
            </button>
        </div>
    </div>
}

@if (AppState.IsConnectionFailed)
{
    <div class="fixed inset-0 bg-[#07090d]/95 backdrop-blur-xl z-[999999] flex items-center justify-center p-4 font-sans text-[#e1e2ec]" style="background-image: radial-gradient(circle at top right, rgba(239, 68, 68, 0.05), transparent 40%), radial-gradient(circle at bottom left, rgba(78, 222, 163, 0.03), transparent 45%);">
        <div class="glass max-w-md w-full rounded-3xl bg-[#13161f]/85 border border-rose-500/15 p-8 text-center shadow-2xl relative space-y-6" style="border-radius: 24px; box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7); backdrop-filter: blur(25px);">
            <!-- Neon Warning Icon Shield -->
            <div class="mx-auto w-20 h-20 rounded-2xl bg-rose-500/10 border border-rose-500/25 flex items-center justify-center text-rose-400 shadow-lg shadow-rose-500/5 animate-pulse" style="border-radius: 20px;">
                <span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1, 'wght' 500;">wifi_off</span>
            </div>

            <div class="space-y-2">
                <h3 class="text-xl font-black text-white tracking-wide">Sunucu Bağlantı Hatası</h3>
                <p class="text-xs text-rose-400/90 font-semibold px-2">Sunucuya bağlanamadı veya sunucu bağlantı hatası verdi.</p>
                <p class="text-[11px] text-gray-400 leading-relaxed px-4">
                    Uygulama sunucu ile güvenli bir veri alışverişi kuramadı. Lütfen internet bağlantınızı veya yazdığınız sunucu adresini kontrol edin.
                </p>
            </div>

            @if (PlatformInfo.IsMobileApp)
            {
                <!-- Mobil Özel: Sunucu Adresi Düzenleme Paneli -->
                <div class="space-y-3 p-4 rounded-2xl bg-white/5 border border-white/5 text-left" style="border-radius: 16px;">
                    <label class="block text-[10px] uppercase font-bold tracking-wider text-gray-400">Aktif Sunucu Adresi</label>
                    <div class="relative flex items-center">
                        <span class="material-symbols-outlined absolute left-3 text-gray-500 text-sm" style="color: #9ba3b8;">dns</span>
                        <input class="w-full rounded-xl pl-9 pr-4 py-2.5 bg-[#0a0c12]/90 border border-white/10 text-xs text-white outline-none focus:border-[#4edea3] focus:ring-1 focus:ring-[#4edea3]/50 transition-all font-mono"
                               placeholder="https://api.domain.com"
                               @bind-value="_editServerUrl"
                               style="border-radius: 10px;" />
                    </div>
                    <button @onclick="HandleSaveAndReconnect"
                            class="w-full py-2.5 rounded-xl bg-gradient-to-r from-[#006c49] to-[#008f60] hover:brightness-110 active:scale-[0.98] transition-all text-xs font-bold text-white shadow-lg shadow-[#006c49]/20 flex items-center justify-center gap-2"
                            style="border-radius: 10px;">
                        <span class="material-symbols-outlined text-sm">save</span>
                        <span>Adresi Kaydet & Bağlan</span>
                    </button>
                </div>
            }
            else
            {
                <!-- Desktop / PWA Modu Bilgi Şeridi -->
                <div class="p-3.5 rounded-2xl bg-white/5 border border-white/5 text-xs text-gray-400 font-mono text-center flex items-center justify-center gap-2" style="border-radius: 14px;">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>
                    <span>Hedef: @Http.BaseAddress</span>
                </div>
            }

            <!-- Alt Kontroller / Yeniden Bağlan Butonu -->
            <div class="pt-2 flex gap-3">
                @if (PlatformInfo.IsMobileApp)
                {
                    <button @onclick="HandleRetryConnection" disabled="@_isRetryingConnection"
                            class="flex-1 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-bold text-white transition-all flex items-center justify-center gap-2 active:scale-95"
                            style="border-radius: 12px;">
                        @if (_isRetryingConnection)
                        {
                            <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                            <span>Bağlanılıyor...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-sm">sync</span>
                            <span>Yeniden Dene</span>
                        }
                    </button>
                }
                else
                {
                    <button @onclick="HandleRetryConnection" disabled="@_isRetryingConnection"
                            class="w-full py-3 rounded-2xl bg-[#006c49] hover:bg-[#006c49]/90 text-xs font-bold text-white transition-all flex items-center justify-center gap-2 active:scale-95 shadow-lg shadow-[#006c49]/20"
                            style="border-radius: 12px;">
                        @if (_isRetryingConnection)
                        {
                            <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                            <span>Bağlanılıyor...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-sm">sync</span>
                            <span>Sistemi Yeniden Yükle</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}
else
{
    <AuthorizeView>
    <Authorized>
        @if (PlatformInfo.IsMobileApp)
        {
            <!-- STITCH MOBILE VIEW -->
            <style>
                .glass-card {
                    background: rgba(29, 32, 39, 0.6);
                    backdrop-filter: blur(20px);
                    border: 1px solid rgba(255, 255, 255, 0.08);
                    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
                }
                .material-symbols-outlined {
                    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                    display: inline-block;
                    vertical-align: middle;
                }
                ::-webkit-scrollbar { display: none !important; width: 0 !important; height: 0 !important; }
                * { scrollbar-width: none !important; -ms-overflow-style: none !important; }

                /* Custom bottom sheet transition transitions */
                .mobile-bottom-sheet {
                    position: fixed;
                    bottom: 88px; /* Perfectly aligned above the bottom nav bar */
                    left: 16px;
                    right: 16px;
                    max-width: 448px; /* max-w-md */
                    margin-left: auto;
                    margin-right: auto;
                    border-radius: 24px; /* rounded-3xl */
                    background-color: rgba(23, 26, 33, 0.96);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    padding: 20px;
                    z-index: 45;
                    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
                    max-height: calc(100vh - 160px);
                    overflow-y: auto;
                    scrollbar-width: none;
                    
                    /* Initial hidden state */
                    transform: translateY(120%) scale(0.95);
                    opacity: 0;
                    pointer-events: none;
                    
                    /* Ultra premium smooth cubic bezier transition (same as sidebar drawer) */
                    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                                opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                                scale 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                }

                .mobile-bottom-sheet.sheet-open {
                    transform: translateY(0) scale(1);
                    opacity: 1;
                    pointer-events: auto;
                }

                .mobile-sheet-backdrop {
                    position: fixed;
                    inset: 0;
                    background-color: rgba(5, 5, 8, 0.4);
                    backdrop-filter: blur(6px);
                    z-index: 40;
                    
                    /* Initial hidden state */
                    opacity: 0;
                    pointer-events: none;
                    
                    transition: opacity 0.4s ease-out;
                }

                .mobile-sheet-backdrop.backdrop-open {
                    opacity: 1;
                    pointer-events: auto;
                }

                /* Mobile custom navigation cut-out glow button styling */
                .floating-action-container {
                    position: relative;
                    top: -24px; /* Raised above the bar */
                    z-index: 51;
                }

                .floating-action-button {
                    width: 56px;
                    height: 56px;
                    background: #4edea3;
                    border-radius: 9999px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #0f172a; /* text-slate-900 */
                    box-shadow: 0 10px 25px rgba(78, 222, 163, 0.35);
                    border: 4px solid #0b0e15; /* Seamless notch cut-out */
                    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
                }

                .floating-action-button:active {
                    transform: scale(0.92);
                    box-shadow: 0 4px 10px rgba(78, 222, 163, 0.2);
                }

                .floating-action-button.btn-active {
                    background: #adc6ff;
                    color: #0f172a;
                    box-shadow: 0 10px 25px rgba(173, 198, 255, 0.35);
                    transform: rotate(45deg);
                }
            </style>

            <div class="fixed inset-0 bg-[#0b0e15] overflow-y-auto p-4 z-10 text-[#e1e2ec] font-sans no-scrollbar">
                <!-- Top Navigation Bar -->
                <header class="fixed top-0 left-0 right-0 w-full z-50 flex justify-between items-center px-4 h-16 bg-[#10131a]/60 backdrop-blur-xl border-b border-white/10">
                    <div class="flex items-center">
                        <div class="font-black text-xl tracking-wider font-sans py-1">
                            <span class="text-[#4edea3]">API</span><span class="text-[#adc6ff]">HUB</span>
                        </div>
                    </div>
                    <!-- Sağ üst: Bildirim Çanı -->
                    <div class="flex items-center gap-2">
                        @if (!AppState.IsFcmConfigured)
                        {
                            <span class="px-2 py-0.5 rounded-lg bg-rose-500/10 border border-rose-500/25 text-rose-400 text-[9px] font-black animate-pulse flex items-center gap-1">
                                <span class="w-1 h-1 rounded-full bg-rose-500 shrink-0"></span>
                                FCM Simülasyon
                            </span>
                        }
                        <button @onclick="OpenSpotlightSearch"
                                style="width:40px; height:40px; border-radius:12px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.2s;"
                                title="Hızlı Arama">
                            <span class="material-symbols-outlined" style="font-size:22px; color:#9ba3b8;">search</span>
                        </button>
                        <button @onclick='() => NavigateToMobilePage("/notifications")'
                                style="position:relative; width:40px; height:40px; border-radius:12px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.2s;">
                            <span class="material-symbols-outlined" style="font-size:22px; color:@(_notifUnreadCount > 0 ? "#4edea3" : "#9ba3b8"); font-variation-settings:'FILL' @(_notifUnreadCount > 0 ? "1" : "0");">notifications</span>
                            @if (_notifUnreadCount > 0)
                            {
                                <span style="position:absolute; top:-4px; right:-4px; background:#ef4444; color:white; border-radius:999px; font-size:9px; font-weight:900; min-width:18px; height:18px; display:flex; align-items:center; justify-content:center; padding:0 4px; border:2px solid #10131a; font-family:sans-serif;">@(_notifUnreadCount > 99 ? "99+" : _notifUnreadCount.ToString())</span>
                            }
                        </button>
                    </div>
                </header>

                <!-- Mobil Canlı Bağlantı Durum Şeridi -->
                <div class="fixed top-16 left-4 right-4 z-40 transition-all duration-500 ease-out @(_showSignalRBanner ? "translate-y-0 opacity-100" : "-translate-y-20 opacity-0 pointer-events-none") max-w-md mx-auto">
