                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div style="background-color: #05030f; min-height: 100vh;">
            @Body
        </div>
    </NotAuthorized>
</AuthorizeView>
}

@code {
    private string _editServerUrl = "";
