{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dockerpanel_db;Username=dp_admin;Password=YOUR_DATABASE_PASSWORD_HERE;Include Error Detail=true",
    "MasterPostgresConnection": "Host=localhost;Port=5432;Database=postgres;Username=dp_admin;Password=YOUR_DATABASE_PASSWORD_HERE;Include Error Detail=true"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS",
    "Issuer": "DockerPanelAPI",
    "Audience": "DockerPanelClient"
  }
}